{
  "name": "Jazz",
  "scopeName": "source.jazz",
  "patterns": [
    {"include": "#comments"},
    {"include": "#strings"},
    {"include": "#characters"},
    {"include": "#numbers"},
    {"include": "#data-declarations"},
    {"include": "#exports"},
    {"include": "#keywords"},
    {"include": "#builtins"},
    {"include": "#purity"},
    {"include": "#types"},
    {"include": "#signatures"},
    {"include": "#lambdas"},
    {"include": "#operators"},
    {"include": "#punctuation"}
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.jazz",
          "match": "#.*$"
        }
      ]
    },
    "escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.jazz",
          "match": "\\\\(?:[\\\\'\"nrt0]|u\\{[0-9A-Fa-f]{1,6}\\})"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.jazz",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {"include": "#escapes"}
          ]
        }
      ]
    },
    "characters": {
      "patterns": [
        {
          "name": "string.quoted.single.jazz",
          "match": "'(?:\\\\(?:[\\\\'\"nrt0]|u\\{[0-9A-Fa-f]{1,6}\\})|[^\\\\'\\r\\n])'"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.jazz",
          "match": "(?<![\\p{Alphabetic}\\p{Number}_'!])(?:[0-9]+\\.[0-9]+(?:f16|f32|f64)?|[0-9]+)(?![0-9])"
        }
      ]
    },
    "data-declarations": {
      "name": "meta.declaration.type.data.jazz",
      "begin": "(?<![\\p{Alphabetic}\\p{Number}_'!])(data)(?![\\p{Alphabetic}\\p{Number}_'!])\\s+(\\p{Lu}[\\p{Alphabetic}\\p{Number}_'!]*)",
      "beginCaptures": {
        "1": {"name": "keyword.declaration.jazz"},
        "2": {"name": "entity.name.type.jazz"}
      },
      "end": "\\.",
      "endCaptures": {
        "0": {"name": "punctuation.terminator.statement.jazz"}
      },
      "patterns": [
        {
          "match": "(=|\\|)\\s*(\\p{Lu}[\\p{Alphabetic}\\p{Number}_'!]*)",
          "captures": {
            "1": {"name": "keyword.operator.constructor.jazz"},
            "2": {"name": "entity.name.function.constructor.jazz"}
          }
        },
        {"include": "#comments"},
        {"include": "#keywords"},
        {"include": "#builtins"},
        {"include": "#types"},
        {"include": "#punctuation"}
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.other.reserved.jazz",
          "match": "(?<![\\p{Alphabetic}\\p{Number}_'!])value(?![\\p{Alphabetic}\\p{Number}_'!])"
        },
        {
          "name": "keyword.control.jazz",
          "match": "(?<![\\p{Alphabetic}\\p{Number}_'!])(?:if|then|else|case)(?![\\p{Alphabetic}\\p{Number}_'!])"
        },
        {
          "name": "keyword.declaration.jazz",
          "match": "(?<![\\p{Alphabetic}\\p{Number}_'!])(?:module|import|as|data|class|impl|operator|tier|precedence|left|right|nonassoc)(?![\\p{Alphabetic}\\p{Number}_'!])"
        }
      ]
    },
    "exports": {
      "name": "meta.module.exports.jazz",
      "begin": "(?<![\\p{Alphabetic}\\p{Number}_'!])(module)(?![\\p{Alphabetic}\\p{Number}_'!])\\s+(\\p{Lu}[\\p{Alphabetic}\\p{Number}_'!]*(?:::\\p{Lu}[\\p{Alphabetic}\\p{Number}_'!]*)*)\\s*(\\()",
      "beginCaptures": {
        "1": {"name": "keyword.declaration.jazz"},
        "2": {"name": "entity.name.namespace.jazz"},
        "3": {"name": "punctuation.section.group.begin.jazz"}
      },
      "end": "\\)",
      "endCaptures": {
        "0": {"name": "punctuation.section.group.end.jazz"}
      },
      "patterns": [
        {
          "name": "meta.export.type.grouped.jazz",
          "begin": "(?<![\\p{Alphabetic}\\p{Number}_'!])(type)(?![\\p{Alphabetic}\\p{Number}_'!])\\s+(\\p{Lu}[\\p{Alphabetic}\\p{Number}_'!]*)(\\s*\\()",
          "beginCaptures": {
            "1": {"name": "storage.modifier.export.jazz"},
            "2": {"name": "entity.name.type.jazz"},
            "3": {"name": "punctuation.section.group.begin.jazz"}
          },
          "end": "\\)",
          "endCaptures": {
            "0": {"name": "punctuation.section.group.end.jazz"}
          },
          "patterns": [
            {
              "name": "entity.name.function.constructor.jazz",
              "match": "(?<![\\p{Alphabetic}\\p{Number}_'!])\\p{Lu}[\\p{Alphabetic}\\p{Number}_'!]*(?![\\p{Alphabetic}\\p{Number}_'!])"
            },
            {
              "name": "keyword.operator.wildcard.jazz",
              "match": "\\.\\."
            },
            {"include": "#comments"},
            {"include": "#punctuation"}
          ]
        },
        {
          "match": "(?<![\\p{Alphabetic}\\p{Number}_'!])(type)(?![\\p{Alphabetic}\\p{Number}_'!])\\s+(\\p{Lu}[\\p{Alphabetic}\\p{Number}_'!]*)",
          "captures": {
            "1": {"name": "storage.modifier.export.jazz"},
            "2": {"name": "entity.name.type.jazz"}
          }
        },
        {
          "name": "storage.modifier.export.jazz",
          "match": "(?<![\\p{Alphabetic}\\p{Number}_'!])(?:value|constructor|type|class)(?![\\p{Alphabetic}\\p{Number}_'!])"
        },
        {"include": "#comments"},
        {"include": "#punctuation"}
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.type.builtin.jazz",
          "match": "(?<![\\p{Alphabetic}\\p{Number}_'!])(?:Bool|Char|Text|Int|Float|Int8|Int16|Int32|Int64|UInt8|UInt16|UInt32|UInt64|Float16|Float32|Float64|List)(?![\\p{Alphabetic}\\p{Number}_'!])"
        },
        {
          "name": "constant.language.jazz",
          "match": "(?<![\\p{Alphabetic}\\p{Number}_'!])(?:True|False)(?![\\p{Alphabetic}\\p{Number}_'!])"
        }
      ]
    },
    "purity": {
      "patterns": [
        {
          "name": "entity.name.function.effectful.jazz",
          "match": "(?<![\\p{Alphabetic}\\p{Number}_'!])[\\p{Alphabetic}_][\\p{Alphabetic}\\p{Number}_']*!(?![\\p{Alphabetic}\\p{Number}_'!])"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.jazz",
          "match": "(?<![\\p{Alphabetic}\\p{Number}_'!])\\p{Lu}[\\p{Alphabetic}\\p{Number}_'!]*(?![\\p{Alphabetic}\\p{Number}_'!])"
        }
      ]
    },
    "signatures": {
      "patterns": [
        {
          "name": "keyword.operator.signature.jazz",
          "match": "::|@|:"
        }
      ]
    },
    "lambdas": {
      "patterns": [
        {
          "name": "keyword.operator.lambda.jazz",
          "match": "\\\\\\|"
        },
        {
          "name": "keyword.operator.lambda.jazz",
          "match": "\\\\|->"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.jazz",
          "match": "==|!=|<=|>=|=>|[$+\\-*/|%&?^~<>:=@!]+"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.jazz",
          "match": "[.,]"
        },
        {
          "name": "punctuation.section.group.jazz",
          "match": "[(){}\\[\\]]"
        }
      ]
    }
  }
}
