cabal-version: 3.0
name: jazz-next
version: 0.1.0.0
build-type: Simple
synopsis: Active compiler and interpreter for the Jazz language
description: The unreleased active Jazz compiler, module loader, analyzer, interpreter, and command-line interface.
license: GPL-3.0-only
maintainer: un3qual
category: Language

extra-doc-files:
    README.md
    PERFORMANCE.md
    programs/README.md

extra-source-files:
    jazz/stdlib/*.jz
    jazz/compiler/*.jz
    programs/corpus.json
    programs/**/*.jz
    programs/**/*.stdout
    editors/vscode-jazz/README.md
    editors/vscode-jazz/package.json
    editors/vscode-jazz/language-configuration.json
    editors/vscode-jazz/syntaxes/*.json
    editors/vscode-jazz/fixtures/*.jz
    test/fixtures/runtime-observation/*.jz
    test/fixtures/runtime-observation/module-success/src/App/*.jz
    test/fixtures/runtime-observation/module-cache/src/App/*.jz
    test/fixtures/runtime-observation/module-profile/src/App/*.jz

flag development
  description: Treat compiler warnings as build failures in the repository workspace.
  default: False
  manual: True

flag profiling-workflow
  description: Link opt-in profiling executables with unrestricted RTS options.
  default: False
  manual: True

common warning-settings
  ghc-options:
      -Wall
      -Wcompat
      -Widentities
      -Wincomplete-record-updates
      -Wincomplete-uni-patterns
      -Wredundant-constraints
  if flag(development)
    ghc-options: -Werror

library jazz-next-internal
  import: warning-settings
  visibility: private
  hs-source-dirs: src
  default-language: Haskell2010
  exposed-modules:
      JazzNext.CLI.Main
      JazzNext.Compiler.AST
      JazzNext.Compiler.Analyzer
      JazzNext.Compiler.Analyzer.UnusedBindings
      JazzNext.Compiler.BuiltinCatalog
      JazzNext.Compiler.BundledPrelude
      JazzNext.Compiler.CapabilityFacts
      JazzNext.Compiler.Diagnostics
      JazzNext.Compiler.Diagnostics.Render
      JazzNext.Compiler.DiagnosticCatalog
      JazzNext.Compiler.Driver
      JazzNext.Compiler.Force
      JazzNext.Compiler.FractionalLiteral
      JazzNext.Compiler.ModuleGraph
      JazzNext.Compiler.ModuleExports
      JazzNext.Compiler.ModuleInterface
      JazzNext.Compiler.ModuleCompiler
      JazzNext.Compiler.ModuleResolver
      JazzNext.Compiler.ModuleRuntime
      JazzNext.Compiler.Name
      JazzNext.Compiler.Parser
      JazzNext.Compiler.Parser.AST
      JazzNext.Compiler.Parser.Context
      JazzNext.Compiler.Parser.Declaration
      JazzNext.Compiler.Parser.Expression
      JazzNext.Compiler.Parser.Failure
      JazzNext.Compiler.Parser.Lexer
      JazzNext.Compiler.Parser.Lower
      JazzNext.Compiler.Parser.Operator
      JazzNext.Compiler.Parser.Pattern
      JazzNext.Compiler.Parser.Signature
      JazzNext.Compiler.Parser.TokenParser
      JazzNext.Compiler.Pattern
      JazzNext.Compiler.PreludeContract
      JazzNext.Compiler.Prelude
      JazzNext.Compiler.Profiling
      JazzNext.Compiler.Purity
      JazzNext.Compiler.RecursiveBindings
      JazzNext.Compiler.Runtime
      JazzNext.Compiler.Runtime.Observation
      JazzNext.Compiler.Runtime.Observation.Profile
      JazzNext.Compiler.Runtime.Observation.Render
      JazzNext.Compiler.Runtime.Primitives
      JazzNext.Compiler.Runtime.ScopePlan
      JazzNext.Compiler.Runtime.Semantics
      JazzNext.Compiler.Runtime.Types
      JazzNext.Compiler.RuntimeHost
      JazzNext.Compiler.RuntimeHints
      JazzNext.Compiler.SignatureRendering
      JazzNext.Compiler.SourceProgram
      JazzNext.Compiler.TypeInference
      JazzNext.Compiler.TypeInference.Capabilities
      JazzNext.Compiler.TypeInference.Diagnostics
      JazzNext.Compiler.TypeInference.Operator
      JazzNext.Compiler.TypeInference.Pattern
      JazzNext.Compiler.TypeInference.Scope
      JazzNext.Compiler.TypeInference.Signature
      JazzNext.Compiler.TypeInference.State
      JazzNext.Compiler.TypeInference.Solver
      JazzNext.Compiler.TypeInference.TypeOps
      JazzNext.Compiler.TypeInference.Types
      JazzNext.Compiler.WarningConfig
  build-depends:
      aeson >= 2.2 && < 2.3,
      base >= 4.22 && < 4.23,
      bytestring >= 0.12 && < 0.13,
      containers >= 0.8 && < 0.9,
      directory >= 1.3 && < 1.4,
      filepath >= 1.5 && < 1.6,
      megaparsec >= 9 && < 10,
      text >= 2.1 && < 2.2,
      transformers >= 0.6 && < 0.7
  if flag(profiling-workflow)
    cpp-options: -DJAZZ_GHC_PROFILING

executable jazz-next
  import: warning-settings
  hs-source-dirs: app
  main-is: Main.hs
  default-language: Haskell2010
  build-depends:
      base >= 4.22 && < 4.23,
      jazz-next:jazz-next-internal
  if flag(profiling-workflow)
    ghc-options: -rtsopts

common test-common
  import: warning-settings
  hs-source-dirs: test
  default-extensions: MultilineStrings
  other-modules:
      JazzNext.TestHarness
  default-language: Haskell2010
  build-depends:
      base >= 4.22 && < 4.23,
      bytestring >= 0.12 && < 0.13,
      containers >= 0.8 && < 0.9,
      directory >= 1.3 && < 1.4,
      filepath >= 1.5 && < 1.6,
      jazz-next:jazz-next-internal,
      text >= 2.1 && < 2.2,
      transformers >= 0.6 && < 0.7

common program-support
  hs-source-dirs: program-support
  other-modules:
      JazzNext.ProgramCorpus.Manifest
      JazzNext.ProgramCorpus.Runner
      JazzNext.ProgramCorpus.Types
  build-depends:
      aeson >= 2.2 && < 2.3,
      base >= 4.22 && < 4.23,
      bytestring >= 0.12 && < 0.13,
      directory >= 1.3 && < 1.4,
      filepath >= 1.5 && < 1.6,
      jazz-next:jazz-next-internal,
      text >= 2.1 && < 2.2

test-suite program-corpus-spec
  import: test-common, program-support
  type: exitcode-stdio-1.0
  main-is: JazzNext/ProgramCorpus/ProgramCorpusSpec.hs

benchmark jazz-next-bench
  import: warning-settings, program-support
  type: exitcode-stdio-1.0
  hs-source-dirs: benchmark
  main-is: Main.hs
  other-modules:
      JazzNext.Benchmark.Force
      JazzNext.Benchmark.Metadata
      JazzNext.Benchmark.StageInputs
      JazzNext.Benchmark.Stages
      Paths_jazz_next
  autogen-modules: Paths_jazz_next
  default-language: Haskell2010
  ghc-options: -fproc-alignment=64
  if flag(profiling-workflow)
    ghc-options: -rtsopts
  build-depends:
      aeson >= 2.2 && < 2.3,
      base >= 4.22 && < 4.23,
      bytestring >= 0.12 && < 0.13,
      containers >= 0.8 && < 0.9,
      deepseq >= 1.5 && < 1.6,
      directory >= 1.3 && < 1.4,
      filepath >= 1.5 && < 1.6,
      jazz-next:jazz-next-internal,
      process >= 1.6 && < 1.7,
      tasty >= 1.5 && < 1.6,
      tasty-bench >= 0.4.1 && < 0.6,
      text >= 2.1 && < 2.2,
      time >= 1.15 && < 1.16

