module CoreLower (
  value lowerFoundationExpression,
  value lowerControlFlowPatternsExpression,
  value lowerSignaturesDeclarationsOperatorsExpression
) {
  import CoreTypes.
  import LexerTypes (CanonicalSpan).
  import List (listPrepend, listReverse).
  import Maybe.
  import NonEmpty (NonEmpty).
  import ParserTypes.
  import Text (textIsEmpty, textSplit, textStartsWith).

  data LoweringProfile = FoundationProfile | ControlFlowPatternsProfile | SignaturesDeclarationsOperatorsProfile.

  allowsControlFlowPatterns :: LoweringProfile -> Bool.
  allowsControlFlowPatterns = \(profile) -> case profile {
    | FoundationProfile -> False
    | ControlFlowPatternsProfile -> True
    | SignaturesDeclarationsOperatorsProfile -> True
  }.

  allowsSignaturesDeclarationsOperators :: LoweringProfile -> Bool.
  allowsSignaturesDeclarationsOperators = \(profile) -> case profile {
    | FoundationProfile -> False
    | ControlFlowPatternsProfile -> False
    | SignaturesDeclarationsOperatorsProfile -> True
  }.

  lowerFoundationNumericType :: SurfaceNumericType -> CoreNumericType.
  lowerFoundationNumericType = \(numericType) -> case numericType {
    | Int8Type -> CoreInt8Type
    | Int16Type -> CoreInt16Type
    | Int32Type -> CoreInt32Type
    | Int64Type -> CoreInt64Type
    | UInt8Type -> CoreUInt8Type
    | UInt16Type -> CoreUInt16Type
    | UInt32Type -> CoreUInt32Type
    | UInt64Type -> CoreUInt64Type
    | Float16Type -> CoreFloat16Type
    | Float32Type -> CoreFloat32Type
    | Float64Type -> CoreFloat64Type
  }.

  lowerFoundationOptionalNumericType :: Maybe(SurfaceNumericType) -> Maybe(CoreNumericType).
  lowerFoundationOptionalNumericType = \(maybeNumericType) -> case maybeNumericType {
    | Nothing -> Nothing
    | Just numericType -> Just (lowerFoundationNumericType numericType)
  }.

  lowerFoundationLiteral :: SurfaceLiteral -> CoreLiteral.
  lowerFoundationLiteral = \(literal) -> case literal {
    | IntegerLiteral value -> CoreIntegerLiteral value
    | FractionalLiteral whole fractional maybeWidth ->
      CoreFractionalLiteral whole fractional (lowerFoundationOptionalNumericType maybeWidth)
    | BooleanLiteral value -> CoreBooleanLiteral value
    | CharacterLiteral value -> CoreCharacterLiteral value
    | TextLiteral value -> CoreTextLiteral value
  }.

  lowerFoundationSpan :: CanonicalSpan -> CoreSpan.
  lowerFoundationSpan = \(span) -> case span {
    | CanonicalSpan line column -> CoreSpan Nothing line column
  }.

  lowerSignatureName :: Text -> CoreName.
  lowerSignatureName = \(name) -> case textSplit "::" name {
    | [qualifier, member] -> if textIsEmpty qualifier then CoreSourceName name else
      if textIsEmpty member then CoreSourceName name else CoreQualifiedName qualifier member
    | other -> CoreSourceName name
  }.

  lowerBindingName :: Text -> CoreName.
  lowerBindingName = \(name) -> if textStartsWith "$operator:" name then
    CoreGeneratedName (CoreOperatorBinding name)
  else CoreSourceName name.

  lowerSignatureTypesFrom :: [SurfaceSignatureType] -> [CoreSignatureType] -> [CoreSignatureType].
  lowerSignatureTypesFrom = \(signatureTypes, reversed) -> case signatureTypes {
    | [] -> listReverse reversed
    | [first | rest] -> lowerSignatureTypesFrom rest (listPrepend (lowerSignatureType first) reversed)
  }.

  lowerSignatureTypes :: [SurfaceSignatureType] -> [CoreSignatureType].
  lowerSignatureTypes = \(signatureTypes) -> lowerSignatureTypesFrom signatureTypes [].

  lowerSignatureType :: SurfaceSignatureType -> CoreSignatureType.
  lowerSignatureType = \(signatureType) -> case signatureType {
    | IntType -> CoreIntType
    | FloatType -> CoreFloatType
    | NumericType numericType -> CoreNumericType (lowerFoundationNumericType numericType)
    | BoolType -> CoreBoolType
    | CharType -> CoreCharType
    | TextType -> CoreTextType
    | TypeVariable name -> CoreTypeVariable (CoreSourceName name)
    | NamedType name -> CoreNamedType (lowerSignatureName name)
    | AppliedType name arguments -> CoreAppliedType (lowerSignatureName name) (lowerSignatureTypes arguments)
    | ListType elementType -> CoreListType (lowerSignatureType elementType)
    | TupleType elementTypes -> CoreTupleType (lowerSignatureTypes elementTypes)
    | FunctionType argumentType resultType ->
      CoreFunctionType (lowerSignatureType argumentType) (lowerSignatureType resultType)
  }.

  lowerSignatureConstraint :: SurfaceSignatureConstraint -> CoreSignatureConstraint.
  lowerSignatureConstraint = \(constraint) -> case constraint {
    | SurfaceSignatureConstraint name arguments ->
      CoreSignatureConstraint (lowerSignatureName name) (lowerSignatureTypes arguments)
  }.

  lowerSignatureConstraintsFrom :: [SurfaceSignatureConstraint] -> [CoreSignatureConstraint] -> [CoreSignatureConstraint].
  lowerSignatureConstraintsFrom = \(constraints, reversed) -> case constraints {
    | [] -> listReverse reversed
    | [first | rest] ->
      lowerSignatureConstraintsFrom rest (listPrepend (lowerSignatureConstraint first) reversed)
  }.

  lowerSignatureConstraints :: [SurfaceSignatureConstraint] -> [CoreSignatureConstraint].
  lowerSignatureConstraints = \(constraints) -> lowerSignatureConstraintsFrom constraints [].

  lowerSignatureToken :: SurfaceSignatureToken -> CoreSignatureToken.
  lowerSignatureToken = \(token) -> case token {
    | SignatureNameToken name -> CoreSignatureNameToken (CoreSourceName name)
    | SignatureIntegerToken value -> CoreSignatureIntegerToken value
    | SignatureArrowToken -> CoreSignatureArrowToken
    | SignatureAtToken -> CoreSignatureAtToken
    | SignatureColonToken -> CoreSignatureColonToken
    | SignatureLeftParenToken -> CoreSignatureLeftParenToken
    | SignatureRightParenToken -> CoreSignatureRightParenToken
    | SignatureLeftBraceToken -> CoreSignatureLeftBraceToken
    | SignatureRightBraceToken -> CoreSignatureRightBraceToken
    | SignatureLeftBracketToken -> CoreSignatureLeftBracketToken
    | SignatureRightBracketToken -> CoreSignatureRightBracketToken
    | SignatureCommaToken -> CoreSignatureCommaToken
    | SignatureOperatorToken symbol -> CoreSignatureOperatorToken symbol
    | SignatureOtherToken value -> CoreSignatureOtherToken value
  }.

  lowerSignatureTokensFrom :: [SurfaceSignatureToken] -> [CoreSignatureToken] -> [CoreSignatureToken].
  lowerSignatureTokensFrom = \(tokens, reversed) -> case tokens {
    | [] -> listReverse reversed
    | [first | rest] -> lowerSignatureTokensFrom rest (listPrepend (lowerSignatureToken first) reversed)
  }.

  lowerSignatureTokens :: [SurfaceSignatureToken] -> [CoreSignatureToken].
  lowerSignatureTokens = \(tokens) -> lowerSignatureTokensFrom tokens [].

  lowerSignaturePayload :: SurfaceSignaturePayload -> CoreSignaturePayload.
  lowerSignaturePayload = \(payload) -> case payload {
    | TypeSignature signatureType -> CoreTypeSignature (lowerSignatureType signatureType)
    | ConstrainedSignature constraints signatureType ->
      CoreConstrainedSignature (lowerSignatureConstraints constraints) (lowerSignatureType signatureType)
    | UnsupportedSignature tokens -> CoreUnsupportedSignature (lowerSignatureTokens tokens)
  }.

  lowerSourceNamesFrom :: [Text] -> [CoreName] -> [CoreName].
  lowerSourceNamesFrom = \(names, reversed) -> case names {
    | [] -> listReverse reversed
    | [first | rest] -> lowerSourceNamesFrom rest (listPrepend (CoreSourceName first) reversed)
  }.

  lowerSourceNames :: [Text] -> [CoreName].
  lowerSourceNames = \(names) -> lowerSourceNamesFrom names [].

  lowerDataConstructorArgument :: SurfaceDataConstructorArgument -> CoreDataConstructorArgument.
  lowerDataConstructorArgument = \(argument) -> case argument {
    | NamedConstructorArgument name -> CoreNamedConstructorArgument (CoreSourceName name)
    | OpaqueConstructorArgument -> CoreOpaqueConstructorArgument
  }.

  lowerDataConstructorArgumentsFrom :: [SurfaceDataConstructorArgument] -> [CoreDataConstructorArgument] -> [CoreDataConstructorArgument].
  lowerDataConstructorArgumentsFrom = \(arguments, reversed) -> case arguments {
    | [] -> listReverse reversed
    | [first | rest] ->
      lowerDataConstructorArgumentsFrom rest (listPrepend (lowerDataConstructorArgument first) reversed)
  }.

  lowerDataConstructorArguments :: [SurfaceDataConstructorArgument] -> [CoreDataConstructorArgument].
  lowerDataConstructorArguments = \(arguments) -> lowerDataConstructorArgumentsFrom arguments [].

  lowerDataConstructor :: SurfaceDataConstructor -> CoreDataConstructor.
  lowerDataConstructor = \(constructor) -> case constructor {
    | SurfaceDataConstructor name arguments ->
      CoreDataConstructor (CoreSourceName name) (lowerDataConstructorArguments arguments)
  }.

  lowerDataConstructorsFrom :: [SurfaceDataConstructor] -> [CoreDataConstructor] -> [CoreDataConstructor].
  lowerDataConstructorsFrom = \(constructors, reversed) -> case constructors {
    | [] -> listReverse reversed
    | [first | rest] -> lowerDataConstructorsFrom rest (listPrepend (lowerDataConstructor first) reversed)
  }.

  lowerDataConstructors :: [SurfaceDataConstructor] -> [CoreDataConstructor].
  lowerDataConstructors = \(constructors) -> lowerDataConstructorsFrom constructors [].

  lowerClassMethodSignature :: SurfaceClassMethodSignature -> CoreClassMethodSignature.
  lowerClassMethodSignature = \(method) -> case method {
    | SurfaceClassMethodSignature name span payload ->
      CoreClassMethodSignature (CoreSourceName name) (lowerFoundationSpan span) (lowerSignaturePayload payload)
  }.

  lowerClassMethodSignaturesFrom :: [SurfaceClassMethodSignature] -> [CoreClassMethodSignature] -> [CoreClassMethodSignature].
  lowerClassMethodSignaturesFrom = \(methods, reversed) -> case methods {
    | [] -> listReverse reversed
    | [first | rest] ->
      lowerClassMethodSignaturesFrom rest (listPrepend (lowerClassMethodSignature first) reversed)
  }.

  lowerClassMethodSignatures :: [SurfaceClassMethodSignature] -> [CoreClassMethodSignature].
  lowerClassMethodSignatures = \(methods) -> lowerClassMethodSignaturesFrom methods [].

  lowerImplMethod :: LoweringProfile -> SurfaceImplMethod -> Maybe(CoreImplMethod).
  lowerImplMethod = \(profile, method) -> case method {
    | SurfaceImplMethod name span body -> case lowerExpressionWithProfile profile body {
      | Nothing -> Nothing
      | Just loweredBody -> Just (CoreImplMethod (CoreSourceName name) (lowerFoundationSpan span) loweredBody)
    }
  }.

  lowerImplMethodsFrom :: LoweringProfile -> [SurfaceImplMethod] -> [CoreImplMethod] -> Maybe([CoreImplMethod]).
  lowerImplMethodsFrom = \(profile, methods, reversed) -> case methods {
    | [] -> Just (listReverse reversed)
    | [first | rest] -> case lowerImplMethod profile first {
      | Nothing -> Nothing
      | Just lowered -> lowerImplMethodsFrom profile rest (listPrepend lowered reversed)
    }
  }.

  lowerImplMethods :: LoweringProfile -> [SurfaceImplMethod] -> Maybe([CoreImplMethod]).
  lowerImplMethods = \(profile, methods) -> lowerImplMethodsFrom profile methods [].

  lowerExpressionsFrom :: LoweringProfile -> [SurfaceExpr] -> [CoreExpr] -> Maybe([CoreExpr]).
  lowerExpressionsFrom = \(profile, expressions, reversed) -> case expressions {
    | [] -> Just (listReverse reversed)
    | [first | rest] -> case lowerExpressionWithProfile profile first {
      | Nothing -> Nothing
      | Just lowered -> lowerExpressionsFrom profile rest (listPrepend lowered reversed)
    }
  }.

  lowerExpressions :: LoweringProfile -> [SurfaceExpr] -> Maybe([CoreExpr]).
  lowerExpressions = \(profile, expressions) -> lowerExpressionsFrom profile expressions [].

  lowerLetStatement :: LoweringProfile -> Text -> CanonicalSpan -> SurfaceExpr -> Maybe(CoreStatement).
  lowerLetStatement = \(profile, name, span, expression) ->
    case lowerExpressionWithProfile profile expression {
      | Nothing -> Nothing
      | Just lowered -> Just (CoreLetStatement (lowerBindingName name) (lowerFoundationSpan span) lowered)
    }.

  lowerStatement :: LoweringProfile -> SurfaceStatement -> Maybe(CoreStatement).
  lowerStatement = \(profile, statement) -> case statement {
    | LetStatement name span expression -> if textStartsWith "$operator:" name then
      if allowsSignaturesDeclarationsOperators profile then
        lowerLetStatement profile name span expression
      else Nothing
    else lowerLetStatement profile name span expression
    | SignatureStatement name span payload -> if allowsSignaturesDeclarationsOperators profile then
      Just (CoreSignatureStatement (lowerBindingName name) (lowerFoundationSpan span) (lowerSignaturePayload payload))
      else Nothing
    | DataStatement span name parameters constructors ->
      if allowsSignaturesDeclarationsOperators profile then
        Just
          (CoreDataStatement
            (lowerFoundationSpan span)
            (CoreSourceName name)
            (lowerSourceNames parameters)
            (lowerDataConstructors constructors))
      else Nothing
    | ClassStatement span name parameters methods ->
      if allowsSignaturesDeclarationsOperators profile then
        Just
          (CoreClassStatement
            (lowerFoundationSpan span)
            (CoreSourceName name)
            (lowerSourceNames parameters)
            (lowerClassMethodSignatures methods))
      else Nothing
    | ImplStatement span name arguments methods ->
      if allowsSignaturesDeclarationsOperators profile then
        case lowerImplMethods profile methods {
          | Nothing -> Nothing
          | Just loweredMethods ->
            Just
              (CoreImplStatement
                (lowerFoundationSpan span)
                (CoreSourceName name)
                (lowerSignatureTypes arguments)
                loweredMethods)
        }
      else Nothing
    | ModuleStatement span path exports -> Nothing
    | ImportStatement span path alias symbols -> Nothing
    | ExpressionStatement span expression -> case lowerExpressionWithProfile profile expression {
      | Nothing -> Nothing
      | Just lowered -> Just (CoreExpressionStatement (lowerFoundationSpan span) lowered)
    }
  }.

  lowerStatementsFrom :: LoweringProfile -> [SurfaceStatement] -> [CoreStatement] -> Maybe([CoreStatement]).
  lowerStatementsFrom = \(profile, statements, reversed) -> case statements {
    | [] -> Just (listReverse reversed)
    | [first | rest] -> case lowerStatement profile first {
      | Nothing -> Nothing
      | Just lowered -> lowerStatementsFrom profile rest (listPrepend lowered reversed)
    }
  }.

  lowerStatements :: LoweringProfile -> [SurfaceStatement] -> Maybe([CoreStatement]).
  lowerStatements = \(profile, statements) -> lowerStatementsFrom profile statements [].

  lowerPattern :: SurfacePattern -> CorePattern.
  lowerPattern = \(pattern) -> case pattern {
    | WildcardPattern -> CoreWildcardPattern
    | VariablePattern name -> CoreVariablePattern (CoreSourceName name)
    | LiteralPattern literal -> CoreLiteralPattern (lowerFoundationLiteral literal)
    | ConstructorPattern name patterns ->
      CoreConstructorPattern (CoreSourceName name) (lowerPatterns patterns)
    | ListPattern patterns -> CoreListPattern (lowerPatterns patterns)
    | ConsListPattern headPattern tailPattern ->
      CoreConsListPattern (lowerPattern headPattern) (lowerPattern tailPattern)
    | TuplePattern patterns -> CoreTuplePattern (lowerPatterns patterns)
    | AsPattern name nested -> CoreAsPattern (CoreSourceName name) (lowerPattern nested)
    | OrPattern patterns -> CoreOrPattern (lowerPatterns patterns)
  }.

  lowerPatternsFrom :: [SurfacePattern] -> [CorePattern] -> [CorePattern].
  lowerPatternsFrom = \(patterns, reversed) -> case patterns {
    | [] -> listReverse reversed
    | [first | rest] -> lowerPatternsFrom rest (listPrepend (lowerPattern first) reversed)
  }.

  lowerPatterns :: [SurfacePattern] -> [CorePattern].
  lowerPatterns = \(patterns) -> lowerPatternsFrom patterns [].

  lowerOptionalExpression :: LoweringProfile -> Maybe(SurfaceExpr) -> Maybe(Maybe(CoreExpr)).
  lowerOptionalExpression = \(profile, maybeExpression) -> case maybeExpression {
    | Nothing -> Just Nothing
    | Just expression -> case lowerExpressionWithProfile profile expression {
      | Nothing -> Nothing
      | Just lowered -> Just (Just lowered)
    }
  }.

  lowerCaseArm :: LoweringProfile -> SurfaceCaseArm -> Maybe(CoreCaseArm).
  lowerCaseArm = \(profile, arm) -> case arm {
    | SurfaceCaseArm pattern guard body -> case lowerOptionalExpression profile guard {
      | Nothing -> Nothing
      | Just loweredGuard -> case lowerExpressionWithProfile profile body {
        | Nothing -> Nothing
        | Just loweredBody -> Just (CoreCaseArm (lowerPattern pattern) loweredGuard loweredBody)
      }
    }
  }.

  lowerCaseArmsFrom :: LoweringProfile -> [SurfaceCaseArm] -> [CoreCaseArm] -> Maybe([CoreCaseArm]).
  lowerCaseArmsFrom = \(profile, arms, reversed) -> case arms {
    | [] -> Just (listReverse reversed)
    | [first | rest] -> case lowerCaseArm profile first {
      | Nothing -> Nothing
      | Just lowered -> lowerCaseArmsFrom profile rest (listPrepend lowered reversed)
    }
  }.

  lowerCaseArms :: LoweringProfile -> [SurfaceCaseArm] -> Maybe([CoreCaseArm]).
  lowerCaseArms = \(profile, arms) -> lowerCaseArmsFrom profile arms [].

  lowerLambdaParameter :: Int -> SurfaceLambdaParameter -> CoreExpr -> CoreExpr.
  lowerLambdaParameter = \(parameterIndex, parameter, loweredBody) -> case parameter {
    | IdentifierParameter name -> CoreLambdaExpression (CoreSourceName name) loweredBody
    | PatternParameter pattern ->
      CoreLambdaExpression
        (CoreGeneratedName (CoreLambdaPatternArgument parameterIndex))
        (CorePatternCaseExpression
          (CoreVariableExpression (CoreGeneratedName (CoreLambdaPatternArgument parameterIndex)))
          [CoreCaseArm (lowerPattern pattern) Nothing loweredBody])
  }.

  lowerLambdaParameterTail :: Int -> [SurfaceLambdaParameter] -> CoreExpr -> CoreExpr.
  lowerLambdaParameterTail = \(parameterIndex, parameters, loweredBody) -> case parameters {
    | [] -> loweredBody
    | [first | rest] ->
      lowerLambdaParameter
        parameterIndex
        first
        (lowerLambdaParameterTail (parameterIndex + 1) rest loweredBody)
  }.

  lowerLambdaParameters :: NonEmpty(SurfaceLambdaParameter) -> CoreExpr -> CoreExpr.
  lowerLambdaParameters = \(parameters, loweredBody) -> case parameters {
    | NonEmpty first rest ->
      lowerLambdaParameter 1 first (lowerLambdaParameterTail 2 rest loweredBody)
  }.

  lowerExpressionWithProfile :: LoweringProfile -> SurfaceExpr -> Maybe(CoreExpr).
  lowerExpressionWithProfile = \(profile, expression) -> case expression {
    | LiteralExpression literal -> Just (CoreLiteralExpression (lowerFoundationLiteral literal))
    | VariableExpression name -> Just (CoreVariableExpression (CoreSourceName name))
    | QualifiedVariableExpression qualifier member ->
      Just (CoreVariableExpression (CoreQualifiedName qualifier member))
    | LambdaExpression parameters body -> if allowsControlFlowPatterns profile then
      case lowerExpressionWithProfile profile body {
        | Nothing -> Nothing
        | Just loweredBody -> Just (lowerLambdaParameters parameters loweredBody)
      } else Nothing
    | OperatorValueExpression symbol -> Just (CoreOperatorValueExpression symbol)
    | ListExpression elements -> case lowerExpressions profile elements {
      | Nothing -> Nothing
      | Just lowered -> Just (CoreListExpression lowered)
    }
    | TupleExpression elements -> case lowerExpressions profile elements {
      | Nothing -> Nothing
      | Just lowered -> Just (CoreTupleExpression lowered)
    }
    | ApplyExpression function argument -> case lowerExpressionWithProfile profile function {
      | Nothing -> Nothing
      | Just loweredFunction -> case lowerExpressionWithProfile profile argument {
        | Nothing -> Nothing
        | Just loweredArgument -> Just (CoreApplyExpression loweredFunction loweredArgument)
      }
    }
    | TypeApplicationExpression function span signatureType ->
      if allowsSignaturesDeclarationsOperators profile then
        case lowerExpressionWithProfile profile function {
          | Nothing -> Nothing
          | Just loweredFunction ->
            Just (CoreTypeApplicationExpression loweredFunction (lowerFoundationSpan span) (lowerSignatureType signatureType))
        }
      else Nothing
    | IfExpression condition thenBranch elseBranch -> if allowsControlFlowPatterns profile then
      case lowerExpressionWithProfile profile condition {
        | Nothing -> Nothing
        | Just loweredCondition -> case lowerExpressionWithProfile profile thenBranch {
          | Nothing -> Nothing
          | Just loweredThen -> case lowerExpressionWithProfile profile elseBranch {
            | Nothing -> Nothing
            | Just loweredElse -> Just (CoreIfExpression loweredCondition loweredThen loweredElse)
          }
        }
      } else Nothing
    | CaseExpression scrutinee arms -> if allowsControlFlowPatterns profile then
      case lowerExpressionWithProfile profile scrutinee {
        | Nothing -> Nothing
        | Just loweredScrutinee -> case lowerCaseArms profile arms {
          | Nothing -> Nothing
          | Just loweredArms -> Just (CorePatternCaseExpression loweredScrutinee loweredArms)
        }
      } else Nothing
    | BinaryExpression symbol left right -> if symbol == "$" then
      if allowsSignaturesDeclarationsOperators profile then
        case lowerExpressionWithProfile profile left {
          | Nothing -> Nothing
          | Just loweredLeft -> case lowerExpressionWithProfile profile right {
            | Nothing -> Nothing
            | Just loweredRight -> Just (CoreApplyExpression loweredLeft loweredRight)
          }
        }
      else Nothing
    else case lowerExpressionWithProfile profile left {
      | Nothing -> Nothing
      | Just loweredLeft -> case lowerExpressionWithProfile profile right {
        | Nothing -> Nothing
        | Just loweredRight -> Just (CoreBinaryExpression symbol loweredLeft loweredRight)
      }
    }
    | LeftSectionExpression left symbol -> case lowerExpressionWithProfile profile left {
      | Nothing -> Nothing
      | Just lowered -> Just (CoreLeftSectionExpression lowered symbol)
    }
    | RightSectionExpression symbol right -> case lowerExpressionWithProfile profile right {
      | Nothing -> Nothing
      | Just lowered -> Just (CoreRightSectionExpression symbol lowered)
    }
    | BlockExpression statements -> case lowerStatements profile statements {
      | Nothing -> Nothing
      | Just lowered -> Just (CoreBlockExpression lowered)
    }
  }.

  lowerFoundationExpression :: SurfaceExpr -> Maybe(CoreExpr).
  lowerFoundationExpression = lowerExpressionWithProfile FoundationProfile.

  lowerControlFlowPatternsExpression :: SurfaceExpr -> Maybe(CoreExpr).
  lowerControlFlowPatternsExpression = lowerExpressionWithProfile ControlFlowPatternsProfile.

  lowerSignaturesDeclarationsOperatorsExpression :: SurfaceExpr -> Maybe(CoreExpr).
  lowerSignaturesDeclarationsOperatorsExpression =
    lowerExpressionWithProfile SignaturesDeclarationsOperatorsProfile.
}
