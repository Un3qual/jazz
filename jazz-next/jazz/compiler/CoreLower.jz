module CoreLower (
  value lowerFoundationExpression,
  value lowerControlFlowPatternsExpression
) {
  import CoreTypes.
  import LexerTypes (CanonicalSpan).
  import List (listPrepend, listReverse).
  import Maybe.
  import NonEmpty (NonEmpty).
  import ParserTypes.
  import Text (textStartsWith).

  data LoweringProfile = FoundationProfile | ControlFlowPatternsProfile.

  allowsControlFlowPatterns :: LoweringProfile -> Bool.
  allowsControlFlowPatterns = \(profile) -> case profile {
    | FoundationProfile -> False
    | ControlFlowPatternsProfile -> True
  }.

  lowerFoundationNumericType :: SurfaceNumericType -> CoreNumericType.
  lowerFoundationNumericType = \(numericType) -> case numericType {
    | Int8Type -> CoreInt8Type
    | Int16Type -> CoreInt16Type
    | Int32Type -> CoreInt32Type
    | Int64Type -> CoreInt64Type
    | UInt8Type -> CoreUInt8Type
    | UInt16Type -> CoreUInt16Type
    | UInt32Type -> CoreUInt32Type
    | UInt64Type -> CoreUInt64Type
    | Float16Type -> CoreFloat16Type
    | Float32Type -> CoreFloat32Type
    | Float64Type -> CoreFloat64Type
  }.

  lowerFoundationOptionalNumericType :: Maybe(SurfaceNumericType) -> Maybe(CoreNumericType).
  lowerFoundationOptionalNumericType = \(maybeNumericType) -> case maybeNumericType {
    | Nothing -> Nothing
    | Just numericType -> Just (lowerFoundationNumericType numericType)
  }.

  lowerFoundationLiteral :: SurfaceLiteral -> CoreLiteral.
  lowerFoundationLiteral = \(literal) -> case literal {
    | IntegerLiteral value -> CoreIntegerLiteral value
    | FractionalLiteral whole fractional maybeWidth ->
      CoreFractionalLiteral whole fractional (lowerFoundationOptionalNumericType maybeWidth)
    | BooleanLiteral value -> CoreBooleanLiteral value
    | CharacterLiteral value -> CoreCharacterLiteral value
    | TextLiteral value -> CoreTextLiteral value
  }.

  lowerFoundationSpan :: CanonicalSpan -> CoreSpan.
  lowerFoundationSpan = \(span) -> case span {
    | CanonicalSpan line column -> CoreSpan Nothing line column
  }.

  lowerExpressionsFrom :: LoweringProfile -> [SurfaceExpr] -> [CoreExpr] -> Maybe([CoreExpr]).
  lowerExpressionsFrom = \(profile, expressions, reversed) -> case expressions {
    | [] -> Just (listReverse reversed)
    | [first | rest] -> case lowerExpressionWithProfile profile first {
      | Nothing -> Nothing
      | Just lowered -> lowerExpressionsFrom profile rest (listPrepend lowered reversed)
    }
  }.

  lowerExpressions :: LoweringProfile -> [SurfaceExpr] -> Maybe([CoreExpr]).
  lowerExpressions = \(profile, expressions) -> lowerExpressionsFrom profile expressions [].

  lowerStatement :: LoweringProfile -> SurfaceStatement -> Maybe(CoreStatement).
  lowerStatement = \(profile, statement) -> case statement {
    | LetStatement name span expression -> if textStartsWith "$operator:" name then Nothing else
      case lowerExpressionWithProfile profile expression {
        | Nothing -> Nothing
        | Just lowered -> Just (CoreLetStatement (CoreSourceName name) (lowerFoundationSpan span) lowered)
      }
    | SignatureStatement name span payload -> Nothing
    | DataStatement span name parameters constructors -> Nothing
    | ClassStatement span name parameters methods -> Nothing
    | ImplStatement span name arguments methods -> Nothing
    | ModuleStatement span path exports -> Nothing
    | ImportStatement span path alias symbols -> Nothing
    | ExpressionStatement span expression -> case lowerExpressionWithProfile profile expression {
      | Nothing -> Nothing
      | Just lowered -> Just (CoreExpressionStatement (lowerFoundationSpan span) lowered)
    }
  }.

  lowerStatementsFrom :: LoweringProfile -> [SurfaceStatement] -> [CoreStatement] -> Maybe([CoreStatement]).
  lowerStatementsFrom = \(profile, statements, reversed) -> case statements {
    | [] -> Just (listReverse reversed)
    | [first | rest] -> case lowerStatement profile first {
      | Nothing -> Nothing
      | Just lowered -> lowerStatementsFrom profile rest (listPrepend lowered reversed)
    }
  }.

  lowerStatements :: LoweringProfile -> [SurfaceStatement] -> Maybe([CoreStatement]).
  lowerStatements = \(profile, statements) -> lowerStatementsFrom profile statements [].

  lowerPattern :: SurfacePattern -> CorePattern.
  lowerPattern = \(pattern) -> case pattern {
    | WildcardPattern -> CoreWildcardPattern
    | VariablePattern name -> CoreVariablePattern (CoreSourceName name)
    | LiteralPattern literal -> CoreLiteralPattern (lowerFoundationLiteral literal)
    | ConstructorPattern name patterns ->
      CoreConstructorPattern (CoreSourceName name) (lowerPatterns patterns)
    | ListPattern patterns -> CoreListPattern (lowerPatterns patterns)
    | ConsListPattern headPattern tailPattern ->
      CoreConsListPattern (lowerPattern headPattern) (lowerPattern tailPattern)
    | TuplePattern patterns -> CoreTuplePattern (lowerPatterns patterns)
    | AsPattern name nested -> CoreAsPattern (CoreSourceName name) (lowerPattern nested)
    | OrPattern patterns -> CoreOrPattern (lowerPatterns patterns)
  }.

  lowerPatternsFrom :: [SurfacePattern] -> [CorePattern] -> [CorePattern].
  lowerPatternsFrom = \(patterns, reversed) -> case patterns {
    | [] -> listReverse reversed
    | [first | rest] -> lowerPatternsFrom rest (listPrepend (lowerPattern first) reversed)
  }.

  lowerPatterns :: [SurfacePattern] -> [CorePattern].
  lowerPatterns = \(patterns) -> lowerPatternsFrom patterns [].

  lowerOptionalExpression :: LoweringProfile -> Maybe(SurfaceExpr) -> Maybe(Maybe(CoreExpr)).
  lowerOptionalExpression = \(profile, maybeExpression) -> case maybeExpression {
    | Nothing -> Just Nothing
    | Just expression -> case lowerExpressionWithProfile profile expression {
      | Nothing -> Nothing
      | Just lowered -> Just (Just lowered)
    }
  }.

  lowerCaseArm :: LoweringProfile -> SurfaceCaseArm -> Maybe(CoreCaseArm).
  lowerCaseArm = \(profile, arm) -> case arm {
    | SurfaceCaseArm pattern guard body -> case lowerOptionalExpression profile guard {
      | Nothing -> Nothing
      | Just loweredGuard -> case lowerExpressionWithProfile profile body {
        | Nothing -> Nothing
        | Just loweredBody -> Just (CoreCaseArm (lowerPattern pattern) loweredGuard loweredBody)
      }
    }
  }.

  lowerCaseArmsFrom :: LoweringProfile -> [SurfaceCaseArm] -> [CoreCaseArm] -> Maybe([CoreCaseArm]).
  lowerCaseArmsFrom = \(profile, arms, reversed) -> case arms {
    | [] -> Just (listReverse reversed)
    | [first | rest] -> case lowerCaseArm profile first {
      | Nothing -> Nothing
      | Just lowered -> lowerCaseArmsFrom profile rest (listPrepend lowered reversed)
    }
  }.

  lowerCaseArms :: LoweringProfile -> [SurfaceCaseArm] -> Maybe([CoreCaseArm]).
  lowerCaseArms = \(profile, arms) -> lowerCaseArmsFrom profile arms [].

  lowerLambdaParameter :: Int -> SurfaceLambdaParameter -> CoreExpr -> CoreExpr.
  lowerLambdaParameter = \(parameterIndex, parameter, loweredBody) -> case parameter {
    | IdentifierParameter name -> CoreLambdaExpression (CoreSourceName name) loweredBody
    | PatternParameter pattern ->
      CoreLambdaExpression
        (CoreGeneratedName (CoreLambdaPatternArgument parameterIndex))
        (CorePatternCaseExpression
          (CoreVariableExpression (CoreGeneratedName (CoreLambdaPatternArgument parameterIndex)))
          [CoreCaseArm (lowerPattern pattern) Nothing loweredBody])
  }.

  lowerLambdaParameterTail :: Int -> [SurfaceLambdaParameter] -> CoreExpr -> CoreExpr.
  lowerLambdaParameterTail = \(parameterIndex, parameters, loweredBody) -> case parameters {
    | [] -> loweredBody
    | [first | rest] ->
      lowerLambdaParameter
        parameterIndex
        first
        (lowerLambdaParameterTail (parameterIndex + 1) rest loweredBody)
  }.

  lowerLambdaParameters :: NonEmpty(SurfaceLambdaParameter) -> CoreExpr -> CoreExpr.
  lowerLambdaParameters = \(parameters, loweredBody) -> case parameters {
    | NonEmpty first rest ->
      lowerLambdaParameter 1 first (lowerLambdaParameterTail 2 rest loweredBody)
  }.

  lowerExpressionWithProfile :: LoweringProfile -> SurfaceExpr -> Maybe(CoreExpr).
  lowerExpressionWithProfile = \(profile, expression) -> case expression {
    | LiteralExpression literal -> Just (CoreLiteralExpression (lowerFoundationLiteral literal))
    | VariableExpression name -> Just (CoreVariableExpression (CoreSourceName name))
    | QualifiedVariableExpression qualifier member ->
      Just (CoreVariableExpression (CoreQualifiedName qualifier member))
    | LambdaExpression parameters body -> if allowsControlFlowPatterns profile then
      case lowerExpressionWithProfile profile body {
        | Nothing -> Nothing
        | Just loweredBody -> Just (lowerLambdaParameters parameters loweredBody)
      } else Nothing
    | OperatorValueExpression symbol -> Just (CoreOperatorValueExpression symbol)
    | ListExpression elements -> case lowerExpressions profile elements {
      | Nothing -> Nothing
      | Just lowered -> Just (CoreListExpression lowered)
    }
    | TupleExpression elements -> case lowerExpressions profile elements {
      | Nothing -> Nothing
      | Just lowered -> Just (CoreTupleExpression lowered)
    }
    | ApplyExpression function argument -> case lowerExpressionWithProfile profile function {
      | Nothing -> Nothing
      | Just loweredFunction -> case lowerExpressionWithProfile profile argument {
        | Nothing -> Nothing
        | Just loweredArgument -> Just (CoreApplyExpression loweredFunction loweredArgument)
      }
    }
    | TypeApplicationExpression function span signatureType -> Nothing
    | IfExpression condition thenBranch elseBranch -> if allowsControlFlowPatterns profile then
      case lowerExpressionWithProfile profile condition {
        | Nothing -> Nothing
        | Just loweredCondition -> case lowerExpressionWithProfile profile thenBranch {
          | Nothing -> Nothing
          | Just loweredThen -> case lowerExpressionWithProfile profile elseBranch {
            | Nothing -> Nothing
            | Just loweredElse -> Just (CoreIfExpression loweredCondition loweredThen loweredElse)
          }
        }
      } else Nothing
    | CaseExpression scrutinee arms -> if allowsControlFlowPatterns profile then
      case lowerExpressionWithProfile profile scrutinee {
        | Nothing -> Nothing
        | Just loweredScrutinee -> case lowerCaseArms profile arms {
          | Nothing -> Nothing
          | Just loweredArms -> Just (CorePatternCaseExpression loweredScrutinee loweredArms)
        }
      } else Nothing
    | BinaryExpression symbol left right -> if symbol == "$" then Nothing else
      case lowerExpressionWithProfile profile left {
        | Nothing -> Nothing
        | Just loweredLeft -> case lowerExpressionWithProfile profile right {
          | Nothing -> Nothing
          | Just loweredRight -> Just (CoreBinaryExpression symbol loweredLeft loweredRight)
        }
      }
    | LeftSectionExpression left symbol -> case lowerExpressionWithProfile profile left {
      | Nothing -> Nothing
      | Just lowered -> Just (CoreLeftSectionExpression lowered symbol)
    }
    | RightSectionExpression symbol right -> case lowerExpressionWithProfile profile right {
      | Nothing -> Nothing
      | Just lowered -> Just (CoreRightSectionExpression symbol lowered)
    }
    | BlockExpression statements -> case lowerStatements profile statements {
      | Nothing -> Nothing
      | Just lowered -> Just (CoreBlockExpression lowered)
    }
  }.

  lowerFoundationExpression :: SurfaceExpr -> Maybe(CoreExpr).
  lowerFoundationExpression = lowerExpressionWithProfile FoundationProfile.

  lowerControlFlowPatternsExpression :: SurfaceExpr -> Maybe(CoreExpr).
  lowerControlFlowPatternsExpression = lowerExpressionWithProfile ControlFlowPatternsProfile.
}
