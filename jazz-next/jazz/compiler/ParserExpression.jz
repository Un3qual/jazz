module ParserExpression (
  value parseFoundationalExpression,
  value parseFoundationalExpressionWithContext
) {
  import Char (charToUInt32).
  import LexerTypes (
    CanonicalToken,
    IdentifierKind,
    IntegerKind,
    CharacterKind,
    TextKind,
    OperatorKind,
    KeywordKind,
    PunctuationKind,
    IfKeyword,
    ThenKeyword,
    ElseKeyword,
    CaseKeyword,
    ArrowPunctuation,
    DoubleColonPunctuation,
    LeftBracePunctuation,
    RightBracePunctuation,
    LeftParenPunctuation,
    RightParenPunctuation,
    LeftBracketPunctuation,
    RightBracketPunctuation,
    CommaPunctuation,
    LambdaPunctuation,
    DotPunctuation,
    AtPunctuation
  ).
  import List (listAll, listAny, listFoldLeft, listPrepend, listReverse).
  import Maybe.
  import NonEmpty (NonEmpty).
  import ParserContext.
  import ParserOperator.
  import ParserPattern (parseCaseArmPattern, parseLambdaParameter).
  import ParserSignature (parseSignatureType).
  import ParserToken (
    ParserGrammarFailure,
    TokenParser,
    canonicalTokenKind,
    canonicalTokenLexeme,
    canonicalTokenSpan,
    canonicalTokenEncountered,
    tokensAreAdjacent,
    tokenSucceed,
    tokenAndThen,
    tokenKeepRight,
    tokenChoice,
    tokenAttempt,
    tokenOptional,
    tokenLookAhead,
    tokenPeek,
    tokenRemaining,
    tokenFailAt,
    tokenFailAtSpan,
    tokenTakeIf,
    tokenIdentifier,
    tokenKeyword,
    tokenInteger,
    tokenCharacter,
    tokenText,
    tokenOperator,
    tokenPunctuation
  ).
  # ParserTypes currently needs a complete import because explicit import lists
  # expose constructors and values, but not the abstract type names required by
  # recursive signatures. ParserCore stays isolated behind TokenParser.
  import ParserTypes.
  import Set.
  import Text (textLength, textUncons, textAppend).

  # This FIRST set intentionally mirrors parsePrimary. Classifying into an
  # intermediate value adds allocation and evaluator work at every application
  # boundary in the hosted parser.
  startsPrimary :: CanonicalToken -> Bool.
  startsPrimary = \(token) -> case canonicalTokenKind token {
    | IdentifierKind name -> True
    | IntegerKind value -> True
    | CharacterKind value -> True
    | TextKind value -> True
    | KeywordKind IfKeyword -> True
    | KeywordKind CaseKeyword -> True
    | PunctuationKind LeftBracePunctuation -> True
    | PunctuationKind LeftParenPunctuation -> True
    | PunctuationKind LeftBracketPunctuation -> True
    | PunctuationKind LambdaPunctuation -> True
    | other -> False
  }.

  float64MaximumWhole :: Text.
  float64MaximumWhole = "".

  decimalDigitsGreater :: Text -> Text -> Bool.
  decimalDigitsGreater = \(left, right) -> case textUncons left {
    | Nothing -> False
    | Just (leftDigit, leftRest) -> case textUncons right {
      | Nothing -> True
      | Just (rightDigit, rightRest) -> if charToUInt32 leftDigit > charToUInt32 rightDigit then
        True
        else if charToUInt32 leftDigit < charToUInt32 rightDigit then
          False
          else decimalDigitsGreater leftRest rightRest
    }
  }.

  decimalDigitsContainNonZero :: Text -> Bool.
  decimalDigitsContainNonZero = \(digits) -> case textUncons digits {
    | Nothing -> False
    | Just (digit, rest) -> if digit == '0' then decimalDigitsContainNonZero rest else True
  }.

  fractionalExceedsFloat64 :: Text -> Text -> Bool.
  fractionalExceedsFloat64 = \(wholeDigits, fractionalDigits) ->
    if textLength wholeDigits > textLength float64MaximumWhole then
      True
      else if textLength wholeDigits < textLength float64MaximumWhole then
        False
        else if decimalDigitsGreater wholeDigits float64MaximumWhole then
          True
          else if wholeDigits == float64MaximumWhole then
            decimalDigitsContainNonZero fractionalDigits
            else False.

  consumeSuffixIfAdjacent :: CanonicalToken -> CanonicalToken -> SurfaceNumericType -> TokenParser(Maybe(SurfaceNumericType)).
  consumeSuffixIfAdjacent = \(fractionalToken, suffixToken, targetType) ->
    if tokensAreAdjacent fractionalToken suffixToken then
      tokenKeepRight tokenIdentifier (tokenSucceed (Just targetType))
      else tokenSucceed Nothing.

  parseFractionalSuffix :: CanonicalToken -> TokenParser(Maybe(SurfaceNumericType)).
  parseFractionalSuffix = \(fractionalToken) -> tokenAndThen
    (\(current) -> case current {
      | Just suffixToken -> case canonicalTokenKind suffixToken {
        | IdentifierKind "f16" -> consumeSuffixIfAdjacent fractionalToken suffixToken Float16Type
        | IdentifierKind "f32" -> consumeSuffixIfAdjacent fractionalToken suffixToken Float32Type
        | IdentifierKind "f64" -> consumeSuffixIfAdjacent fractionalToken suffixToken Float64Type
        | other -> tokenSucceed Nothing
      }
      | Nothing -> tokenSucceed Nothing
    })
    tokenPeek.

  parseFractional :: CanonicalToken -> Text -> TokenParser(SurfaceExpr).
  parseFractional = \(wholeToken, whole) -> tokenAndThen
    (\(dotToken) -> tokenAndThen
      (\(fractionalToken) -> tokenAndThen
        (\(targetType) -> {
          fractionalDigits = canonicalTokenLexeme fractionalToken.
          literalText = textAppend (textAppend (canonicalTokenLexeme wholeToken) ".") fractionalDigits.
          if fractionalExceedsFloat64 whole fractionalDigits then
            tokenFailAtSpan (canonicalTokenSpan wholeToken) (InvalidFractionalLiteral literalText)
            else tokenSucceed (LiteralExpression (FractionalLiteral whole fractionalDigits targetType)).
        })
        (parseFractionalSuffix fractionalToken))
      tokenInteger)
    (tokenPunctuation DotPunctuation).

  fractionalCandidate :: CanonicalToken -> TokenParser(CanonicalToken).
  fractionalCandidate = \(wholeToken) -> tokenAndThen
    (\(dotToken) -> tokenAndThen
      (\(fractionalToken) -> if tokensAreAdjacent wholeToken dotToken then
        if tokensAreAdjacent dotToken fractionalToken then
          tokenSucceed fractionalToken
          else tokenFailAtSpan
            (canonicalTokenSpan fractionalToken)
            (ExpectedSyntax "adjacent fractional digits" (FoundToken (canonicalTokenKind fractionalToken) (canonicalTokenLexeme fractionalToken)))
        else tokenFailAtSpan
          (canonicalTokenSpan dotToken)
          (ExpectedSyntax "adjacent decimal point" (FoundToken (canonicalTokenKind dotToken) (canonicalTokenLexeme dotToken))))
      tokenInteger)
    (tokenPunctuation DotPunctuation).

  parseNumeric :: CanonicalToken -> Text -> TokenParser(SurfaceExpr).
  parseNumeric = \(wholeToken, whole) -> tokenChoice
    (tokenAndThen
      (\(candidate) -> parseFractional wholeToken whole)
      (tokenLookAhead (fractionalCandidate wholeToken)))
    (tokenSucceed (LiteralExpression (IntegerLiteral whole))).

  parseQualifiedMember :: CanonicalToken -> Text -> TokenParser(SurfaceExpr).
  parseQualifiedMember = \(separatorToken, qualifier) -> tokenAndThen
    (\(current) -> case current {
      | Nothing -> tokenFailAt Nothing (ExpectedSyntax "member name" (EndOfInputAfter "'::'"))
      | Just memberToken -> case canonicalTokenKind memberToken {
        | IdentifierKind member -> if tokensAreAdjacent separatorToken memberToken then
          tokenKeepRight
            tokenIdentifier
            (tokenSucceed (QualifiedVariableExpression qualifier member))
          else tokenFailAtSpan
            (canonicalTokenSpan memberToken)
            (ExpectedSyntax "adjacent member name after '::'" (canonicalTokenEncountered current))
        | other -> tokenFailAtSpan
          (canonicalTokenSpan memberToken)
          (ExpectedSyntax "member name after '::'" (canonicalTokenEncountered current))
      }
    })
    tokenPeek.

  parseName :: CanonicalToken -> Text -> TokenParser(SurfaceExpr).
  parseName = \(identifierToken, name) -> tokenAndThen
    (\(current) -> case current {
      | Just separator -> case canonicalTokenKind separator {
        | PunctuationKind DoubleColonPunctuation -> if tokensAreAdjacent identifierToken separator then
          tokenKeepRight
            (tokenPunctuation DoubleColonPunctuation)
            (parseQualifiedMember separator name)
          else tokenSucceed (VariableExpression name)
        | other -> tokenSucceed (VariableExpression name)
      }
      | Nothing -> tokenSucceed (VariableExpression name)
    })
    tokenPeek.

  neverStops :: [CanonicalToken] -> Bool.
  neverStops = \(tokens) -> False.

  parseTupleElements :: (([CanonicalToken] -> Bool) -> TokenParser(SurfaceExpr)) -> [SurfaceExpr] -> TokenParser(SurfaceExpr).
  parseTupleElements = \(parseExpressionUntil, reversed) -> tokenAndThen
    (\(next) -> tokenAndThen
      (\(current) -> case current {
        | Just token -> case canonicalTokenKind token {
          | PunctuationKind CommaPunctuation -> tokenKeepRight
            (tokenPunctuation CommaPunctuation)
            (parseTupleElements parseExpressionUntil (listPrepend next reversed))
          | other -> tokenKeepRight
            (tokenPunctuation RightParenPunctuation)
            (tokenSucceed (TupleExpression (listReverse (listPrepend next reversed))))
        }
        | Nothing -> tokenKeepRight
          (tokenPunctuation RightParenPunctuation)
          (tokenSucceed (TupleExpression (listReverse (listPrepend next reversed))))
      })
      tokenPeek)
    (parseExpressionUntil neverStops).

  tokensStartLeftSection :: [CanonicalToken] -> Bool.
  tokensStartLeftSection = \(tokens) -> case tokens {
    | [operatorToken | afterOperator] -> case canonicalTokenKind operatorToken {
      | OperatorKind symbol -> case afterOperator {
        | [rightParen | rest] -> case canonicalTokenKind rightParen {
          | PunctuationKind RightParenPunctuation -> True
          | other -> False
        }
        | [] -> False
      }
      | other -> False
    }
    | [] -> False
  }.

  requireOperatorVisible :: ParserContext -> CanonicalToken -> Text -> TokenParser(()).
  requireOperatorVisible = \(context, operatorToken, symbol) -> case parserContextLookupOperator context symbol {
    | Just info -> tokenSucceed ()
    | Nothing -> tokenFailAtSpan
      (canonicalTokenSpan operatorToken)
      (UndeclaredOperator symbol ExpressionOperatorUse)
  }.

  parseParenthesizedTail :: ParserContext -> (([CanonicalToken] -> Bool) -> TokenParser(SurfaceExpr)) -> SurfaceExpr -> TokenParser(SurfaceExpr).
  parseParenthesizedTail = \(context, parseExpressionUntil, first) -> tokenAndThen
    (\(current) -> case current {
      | Just token -> case canonicalTokenKind token {
        | PunctuationKind CommaPunctuation -> tokenKeepRight
          (tokenPunctuation CommaPunctuation)
          (parseTupleElements parseExpressionUntil [first])
        | OperatorKind symbol -> tokenAndThen
          (\(remaining) -> case remaining {
            | [operatorToken | afterOperator] -> case afterOperator {
              | [rightParen | rest] -> case canonicalTokenKind rightParen {
                | PunctuationKind RightParenPunctuation -> tokenKeepRight
                  (requireOperatorVisible context operatorToken symbol)
                  (tokenKeepRight
                    tokenOperator
                    (tokenKeepRight
                      (tokenPunctuation RightParenPunctuation)
                      (tokenSucceed (LeftSectionExpression first symbol))))
                | other -> tokenKeepRight
                  (tokenPunctuation RightParenPunctuation)
                  (tokenSucceed first)
              }
            }
          })
          tokenRemaining
        | other -> tokenKeepRight (tokenPunctuation RightParenPunctuation) (tokenSucceed first)
      }
      | Nothing -> tokenKeepRight
        (tokenPunctuation RightParenPunctuation)
        (tokenSucceed first)
    })
    tokenPeek.

  parseParenthesized :: ParserContext -> (([CanonicalToken] -> Bool) -> TokenParser(SurfaceExpr)) -> TokenParser(SurfaceExpr).
  parseParenthesized = \(context, parseExpressionUntil) -> tokenAndThen
    (\(current) -> case current {
      | Just token -> case canonicalTokenKind token {
        | PunctuationKind RightParenPunctuation -> tokenKeepRight
          (tokenPunctuation RightParenPunctuation)
          (tokenSucceed (TupleExpression []))
        | OperatorKind symbol -> tokenAndThen
          (\(operatorToken) -> tokenKeepRight
            (requireOperatorVisible context operatorToken symbol)
            (tokenAndThen
              (\(afterOperator) -> case afterOperator {
                | Just next -> case canonicalTokenKind next {
                  | PunctuationKind RightParenPunctuation -> tokenKeepRight
                    (tokenPunctuation RightParenPunctuation)
                    (tokenSucceed (OperatorValueExpression symbol))
                  | other -> tokenAndThen
                    (\(right) -> tokenKeepRight
                      (tokenPunctuation RightParenPunctuation)
                      (tokenSucceed (RightSectionExpression symbol right)))
                    (parseExpressionUntil neverStops)
                }
                | Nothing -> tokenFailAt Nothing (ExpectedSyntax "expression" EndOfInput)
              })
              tokenPeek))
          tokenOperator
        | other -> tokenAndThen
          (\(first) -> parseParenthesizedTail context parseExpressionUntil first)
          (parseExpressionUntil tokensStartLeftSection)
      }
      | Nothing -> tokenFailAt Nothing (ExpectedSyntax "expression" EndOfInput)
    })
    tokenPeek.

  parseListElements :: (([CanonicalToken] -> Bool) -> TokenParser(SurfaceExpr)) -> [SurfaceExpr] -> TokenParser(SurfaceExpr).
  parseListElements = \(parseExpressionUntil, reversed) -> tokenAndThen
    (\(current) -> case current {
      | Just token -> case canonicalTokenKind token {
        | PunctuationKind CommaPunctuation -> tokenKeepRight
          (tokenPunctuation CommaPunctuation)
          (tokenAndThen
            (\(next) -> parseListElements parseExpressionUntil (listPrepend next reversed))
            (parseExpressionUntil neverStops))
        | other -> tokenKeepRight
          (tokenPunctuation RightBracketPunctuation)
          (tokenSucceed (ListExpression (listReverse reversed)))
      }
      | Nothing -> tokenKeepRight
        (tokenPunctuation RightBracketPunctuation)
        (tokenSucceed (ListExpression (listReverse reversed)))
    })
    tokenPeek.

  parseList :: (([CanonicalToken] -> Bool) -> TokenParser(SurfaceExpr)) -> TokenParser(SurfaceExpr).
  parseList = \(parseExpressionUntil) -> tokenAndThen
    (\(current) -> case current {
      | Just token -> case canonicalTokenKind token {
        | PunctuationKind RightBracketPunctuation -> tokenKeepRight
          (tokenPunctuation RightBracketPunctuation)
          (tokenSucceed (ListExpression []))
        | other -> tokenAndThen
          (\(first) -> parseListElements parseExpressionUntil [first])
          (parseExpressionUntil neverStops)
      }
      | Nothing -> tokenFailAt Nothing (ExpectedSyntax "expression" EndOfInput)
    })
    tokenPeek.

  stopsAtThen :: ([CanonicalToken] -> Bool) -> [CanonicalToken] -> Bool.
  stopsAtThen = \(outerStop, tokens) -> if outerStop tokens then True else case tokens {
    | [token | rest] -> case canonicalTokenKind token {
      | KeywordKind ThenKeyword -> True
      | other -> False
    }
    | [] -> False
  }.

  parseConditionalElse :: (([CanonicalToken] -> Bool) -> TokenParser(SurfaceExpr)) -> ([CanonicalToken] -> Bool) -> TokenParser([SurfaceStatement]) -> CanonicalToken -> SurfaceExpr -> SurfaceExpr -> TokenParser(SurfaceExpr).
  parseConditionalElse = \(parseExpressionUntil, stop, parseBlock, ifToken, condition, trueBranch) -> tokenAndThen
    (\(current) -> case current {
      | Just token -> case canonicalTokenKind token {
        | KeywordKind ElseKeyword -> tokenKeepRight
          (tokenKeyword ElseKeyword)
          (tokenAndThen
            (\(falseBranch) -> tokenSucceed (IfExpression condition trueBranch falseBranch))
            (parseExpressionUntil stop))
        | other -> tokenFailAtSpan
          (canonicalTokenSpan token)
          (ExpectedSyntax "'else'" (FoundToken (canonicalTokenKind token) (canonicalTokenLexeme token)))
      }
      | Nothing -> tokenFailAtSpan
        (canonicalTokenSpan ifToken)
        (ExpectedSyntax "'else'" (EndOfInputAfter "'if'"))
    })
    tokenPeek.

  parseConditionalThen :: (([CanonicalToken] -> Bool) -> TokenParser(SurfaceExpr)) -> ([CanonicalToken] -> Bool) -> TokenParser([SurfaceStatement]) -> CanonicalToken -> SurfaceExpr -> TokenParser(SurfaceExpr).
  parseConditionalThen = \(parseExpressionUntil, stop, parseBlock, ifToken, condition) -> tokenAndThen
    (\(current) -> case current {
      | Just token -> case canonicalTokenKind token {
        | KeywordKind ThenKeyword -> tokenKeepRight
          (tokenKeyword ThenKeyword)
          (tokenAndThen
            (\(trueBranch) -> parseConditionalElse parseExpressionUntil stop parseBlock ifToken condition trueBranch)
            (parseExpressionUntil stop))
        | other -> tokenFailAtSpan
          (canonicalTokenSpan token)
          (ExpectedSyntax "'then'" (FoundToken (canonicalTokenKind token) (canonicalTokenLexeme token)))
      }
      | Nothing -> tokenFailAtSpan
        (canonicalTokenSpan ifToken)
        (ExpectedSyntax "'then'" (EndOfInputAfter "'if'"))
    })
    tokenPeek.

  parseConditional :: (([CanonicalToken] -> Bool) -> TokenParser(SurfaceExpr)) -> ([CanonicalToken] -> Bool) -> TokenParser([SurfaceStatement]) -> CanonicalToken -> TokenParser(SurfaceExpr).
  parseConditional = \(parseExpressionUntil, stop, parseBlock, ifToken) -> tokenAndThen
    (\(condition) -> parseConditionalThen parseExpressionUntil stop parseBlock ifToken condition)
    (parseExpressionUntil (\(tokens) -> stopsAtThen stop tokens)).

  decrementDepth :: Int -> Int.
  decrementDepth = \(depth) -> if depth > 0 then depth - 1 else 0.

  hasTopLevelArrowBeforeTerminatorFrom :: [CanonicalToken] -> Int -> Int -> Int -> Bool.
  hasTopLevelArrowBeforeTerminatorFrom = \(tokens, parenDepth, braceDepth, bracketDepth) -> case tokens {
    | [] -> False
    | [token | rest] -> {
      topLevel = if parenDepth == 0 then
        if braceDepth == 0 then bracketDepth == 0 else False
        else False.
      case canonicalTokenKind token {
        | PunctuationKind ArrowPunctuation -> if topLevel then True else
          hasTopLevelArrowBeforeTerminatorFrom rest parenDepth braceDepth bracketDepth
        | PunctuationKind DotPunctuation -> if topLevel then False else
          hasTopLevelArrowBeforeTerminatorFrom rest parenDepth braceDepth bracketDepth
        | PunctuationKind LeftParenPunctuation ->
          hasTopLevelArrowBeforeTerminatorFrom rest (parenDepth + 1) braceDepth bracketDepth
        | PunctuationKind RightParenPunctuation ->
          hasTopLevelArrowBeforeTerminatorFrom rest (decrementDepth parenDepth) braceDepth bracketDepth
        | PunctuationKind LeftBracePunctuation ->
          hasTopLevelArrowBeforeTerminatorFrom rest parenDepth (braceDepth + 1) bracketDepth
        | PunctuationKind RightBracePunctuation -> if topLevel then False else
          hasTopLevelArrowBeforeTerminatorFrom rest parenDepth (decrementDepth braceDepth) bracketDepth
        | PunctuationKind LeftBracketPunctuation ->
          hasTopLevelArrowBeforeTerminatorFrom rest parenDepth braceDepth (bracketDepth + 1)
        | PunctuationKind RightBracketPunctuation ->
          hasTopLevelArrowBeforeTerminatorFrom rest parenDepth braceDepth (decrementDepth bracketDepth)
        | other -> hasTopLevelArrowBeforeTerminatorFrom rest parenDepth braceDepth bracketDepth
      }.
    }
  }.

  hasTopLevelArrowBeforeTerminator :: [CanonicalToken] -> Bool.
  hasTopLevelArrowBeforeTerminator = \(tokens) -> hasTopLevelArrowBeforeTerminatorFrom tokens 0 0 0.

  hasTopLevelElseBeforeArrowFrom :: [CanonicalToken] -> Int -> Int -> Int -> Bool.
  hasTopLevelElseBeforeArrowFrom = \(tokens, parenDepth, braceDepth, bracketDepth) -> case tokens {
    | [] -> False
    | [token | rest] -> {
      topLevel = if parenDepth == 0 then
        if braceDepth == 0 then bracketDepth == 0 else False
        else False.
      case canonicalTokenKind token {
        | KeywordKind ElseKeyword -> if topLevel then True else
          hasTopLevelElseBeforeArrowFrom rest parenDepth braceDepth bracketDepth
        | PunctuationKind ArrowPunctuation -> if topLevel then False else
          hasTopLevelElseBeforeArrowFrom rest parenDepth braceDepth bracketDepth
        | PunctuationKind LeftParenPunctuation ->
          hasTopLevelElseBeforeArrowFrom rest (parenDepth + 1) braceDepth bracketDepth
        | PunctuationKind RightParenPunctuation ->
          hasTopLevelElseBeforeArrowFrom rest (decrementDepth parenDepth) braceDepth bracketDepth
        | PunctuationKind LeftBracePunctuation ->
          hasTopLevelElseBeforeArrowFrom rest parenDepth (braceDepth + 1) bracketDepth
        | PunctuationKind RightBracePunctuation ->
          hasTopLevelElseBeforeArrowFrom rest parenDepth (decrementDepth braceDepth) bracketDepth
        | PunctuationKind LeftBracketPunctuation ->
          hasTopLevelElseBeforeArrowFrom rest parenDepth braceDepth (bracketDepth + 1)
        | PunctuationKind RightBracketPunctuation ->
          hasTopLevelElseBeforeArrowFrom rest parenDepth braceDepth (decrementDepth bracketDepth)
        | other -> hasTopLevelElseBeforeArrowFrom rest parenDepth braceDepth bracketDepth
      }.
    }
  }.

  hasTopLevelElseBeforeArrow :: [CanonicalToken] -> Bool.
  hasTopLevelElseBeforeArrow = \(tokens) -> hasTopLevelElseBeforeArrowFrom tokens 0 0 0.

  guardTokensEndAtArrow :: [CanonicalToken] -> Bool.
  guardTokensEndAtArrow = \(tokens) ->
    if hasTopLevelArrowBeforeTerminator tokens then
      if hasTopLevelElseBeforeArrow tokens then False else True
      else False.

  hasTopLevelArmArrowFrom :: [CanonicalToken] -> Int -> Int -> Int -> Bool.
  hasTopLevelArmArrowFrom = \(tokens, parenDepth, braceDepth, bracketDepth) -> case tokens {
    | [] -> False
    | [token | rest] -> {
      topLevel = if parenDepth == 0 then
        if braceDepth == 0 then bracketDepth == 0 else False
        else False.
      case canonicalTokenKind token {
        | PunctuationKind ArrowPunctuation -> if topLevel then True else
          hasTopLevelArmArrowFrom rest parenDepth braceDepth bracketDepth
        | OperatorKind "|" -> if topLevel then False else
          hasTopLevelArmArrowFrom rest parenDepth braceDepth bracketDepth
        | PunctuationKind LeftParenPunctuation ->
          hasTopLevelArmArrowFrom rest (parenDepth + 1) braceDepth bracketDepth
        | PunctuationKind RightParenPunctuation ->
          hasTopLevelArmArrowFrom rest (decrementDepth parenDepth) braceDepth bracketDepth
        | PunctuationKind LeftBracePunctuation ->
          hasTopLevelArmArrowFrom rest parenDepth (braceDepth + 1) bracketDepth
        | PunctuationKind RightBracePunctuation -> if topLevel then False else
          hasTopLevelArmArrowFrom rest parenDepth (decrementDepth braceDepth) bracketDepth
        | PunctuationKind LeftBracketPunctuation ->
          hasTopLevelArmArrowFrom rest parenDepth braceDepth (bracketDepth + 1)
        | PunctuationKind RightBracketPunctuation ->
          hasTopLevelArmArrowFrom rest parenDepth braceDepth (decrementDepth bracketDepth)
        | other -> hasTopLevelArmArrowFrom rest parenDepth braceDepth bracketDepth
      }.
    }
  }.

  startsCasePatternTokens :: [CanonicalToken] -> Bool.
  startsCasePatternTokens = \(tokens) -> case tokens {
    | [first | rest] -> case canonicalTokenKind first {
      | IntegerKind value -> True
      | IdentifierKind name -> True
      | PunctuationKind LeftBracketPunctuation -> True
      | PunctuationKind LeftParenPunctuation -> True
      | other -> False
    }
    | [] -> False
  }.

  caseBodyStarts :: [CanonicalToken] -> Bool.
  caseBodyStarts = \(tokens) -> case tokens {
    | [leftBrace | rest] -> case canonicalTokenKind leftBrace {
      | PunctuationKind LeftBracePunctuation -> case rest {
        | [first | remaining] -> case canonicalTokenKind first {
          | OperatorKind "|" -> True
          | PunctuationKind RightBracePunctuation -> True
          | other -> hasTopLevelArrowBeforeTerminator rest
        }
        | [] -> False
      }
      | other -> False
    }
    | [] -> False
  }.

  patternBinderNames :: SurfacePattern -> Set(Text).
  patternBinderNames = \(pattern) -> case pattern {
    | WildcardPattern -> setEmpty
    | VariablePattern name -> setSingleton name
    | LiteralPattern literal -> setEmpty
    | ConstructorPattern name arguments -> listFoldLeft
      (\(names, argument) -> setUnion names (patternBinderNames argument))
      setEmpty
      arguments
    | ListPattern elements -> listFoldLeft
      (\(names, element) -> setUnion names (patternBinderNames element))
      setEmpty
      elements
    | ConsListPattern headPattern tailPattern ->
      setUnion (patternBinderNames headPattern) (patternBinderNames tailPattern)
    | TuplePattern elements -> listFoldLeft
      (\(names, element) -> setUnion names (patternBinderNames element))
      setEmpty
      elements
    | AsPattern name nested -> setInsert (patternBinderNames nested) name
    | OrPattern alternatives -> commonPatternBinderNames alternatives
  }.

  commonPatternBinderNames :: [SurfacePattern] -> Set(Text).
  commonPatternBinderNames = \(alternatives) -> case alternatives {
    | [] -> setEmpty
    | [first | rest] -> listFoldLeft
      (\(names, alternative) -> setIntersection names (patternBinderNames alternative))
      (patternBinderNames first)
      rest
  }.

  setsEqual :: Set(Text) -> Set(Text) -> Bool.
  setsEqual = \(left, right) -> if setIsSubset left right then setIsSubset right left else False.

  alternativesBindSameNames :: [SurfacePattern] -> Bool.
  alternativesBindSameNames = \(alternatives) -> case alternatives {
    | [] -> False
    | [first | rest] -> {
      expected = patternBinderNames first.
      if setIsEmpty expected then False else listAll
        (\(alternative) -> setsEqual expected (patternBinderNames alternative))
        rest.
    }
  }.

  patternIsWildcard :: SurfacePattern -> Bool.
  patternIsWildcard = \(pattern) -> case pattern { | WildcardPattern -> True | other -> False }.

  patternIsVariable :: SurfacePattern -> Bool.
  patternIsVariable = \(pattern) -> case pattern { | VariablePattern name -> True | other -> False }.

  patternIsLiteral :: SurfacePattern -> Bool.
  patternIsLiteral = \(pattern) -> case pattern { | LiteralPattern literal -> True | other -> False }.

  patternCanStartOrArmBoundary :: SurfacePattern -> Bool.
  patternCanStartOrArmBoundary = \(pattern) -> case pattern {
    | ConstructorPattern name arguments -> True
    | ListPattern elements -> True
    | ConsListPattern headPattern tailPattern -> True
    | TuplePattern elements -> True
    | AsPattern name nested -> True
    | other -> False
  }.

  orPatternStartsDefiniteArmBoundary :: [SurfacePattern] -> Bool.
  orPatternStartsDefiniteArmBoundary = \(alternatives) ->
    if listAny patternIsWildcard alternatives then True
    else if listAll patternIsVariable alternatives then True
    else if listAll patternIsLiteral alternatives then True
    else if alternativesBindSameNames alternatives then True
    else case alternatives {
      | [first | rest] -> patternCanStartOrArmBoundary first
      | [] -> False
    }.

  expressionHasPipeRoot :: SurfaceExpr -> Bool.
  expressionHasPipeRoot = \(expression) -> case expression {
    | BinaryExpression "|" left right -> True
    | other -> False
  }.

  parsedPatternStartsArmBoundary :: SurfaceExpr -> SurfacePattern -> Bool.
  parsedPatternStartsArmBoundary = \(left, pattern) -> case pattern {
    | OrPattern alternatives -> if listAll patternIsLiteral alternatives then
      expressionHasPipeRoot left
      else orPatternStartsDefiniteArmBoundary alternatives
    | other -> True
  }.

  guardBoundaryPatternIsDefinite :: SurfacePattern -> Bool.
  guardBoundaryPatternIsDefinite = \(pattern) -> case pattern {
    | VariablePattern name -> False
    | other -> True
  }.

  peekCaseArmPatternPrefix :: TokenParser(Maybe((SurfacePattern, [CanonicalToken]))).
  peekCaseArmPatternPrefix = tokenOptional (tokenAttempt (tokenLookAhead
    (tokenKeepRight
      tokenOperator
      (tokenAndThen
        (\(pattern) -> tokenAndThen
          (\(remaining) -> tokenSucceed (pattern, remaining))
          tokenRemaining)
        parseCaseArmPattern)))).

  pipeStartsCaseArmBoundary :: SurfaceExpr -> TokenParser(Bool).
  pipeStartsCaseArmBoundary = \(left) -> tokenAndThen
    (\(prefix) -> case prefix {
      | Just (pattern, remaining) -> case remaining {
        | [first | rest] -> case canonicalTokenKind first {
          | PunctuationKind ArrowPunctuation -> tokenSucceed (parsedPatternStartsArmBoundary left pattern)
          | KeywordKind IfKeyword -> tokenSucceed
            (if parsedPatternStartsArmBoundary left pattern then guardTokensEndAtArrow rest else False)
          | other -> tokenSucceed False
        }
        | [] -> tokenSucceed False
      }
      | Nothing -> tokenAndThen
        (\(remaining) -> case remaining {
          | [pipe | afterPipe] -> if startsCasePatternTokens afterPipe then
            tokenSucceed (hasTopLevelArmArrowFrom afterPipe 0 0 0)
            else tokenSucceed False
          | [] -> tokenSucceed False
        })
        tokenRemaining
    })
    peekCaseArmPatternPrefix.

  pipeStartsCaseGuardBoundary :: SurfaceExpr -> TokenParser(Bool).
  pipeStartsCaseGuardBoundary = \(left) -> tokenAndThen
    (\(prefix) -> case prefix {
      | Just (pattern, remaining) -> case remaining {
        | [first | rest] -> case canonicalTokenKind first {
          | PunctuationKind ArrowPunctuation -> tokenSucceed
            (if guardBoundaryPatternIsDefinite pattern then expressionHasPipeRoot left else False)
          | KeywordKind IfKeyword -> tokenSucceed
            (if guardBoundaryPatternIsDefinite pattern then guardTokensEndAtArrow rest else False)
          | other -> tokenSucceed False
        }
        | [] -> tokenSucceed False
      }
      | Nothing -> tokenSucceed False
    })
    peekCaseArmPatternPrefix.

  stopsAtPipeOr :: ([CanonicalToken] -> Bool) -> [CanonicalToken] -> Bool.
  stopsAtPipeOr = \(outerStop, tokens) -> if outerStop tokens then True else case tokens {
    | [token | rest] -> case canonicalTokenKind token {
      | OperatorKind "|" -> True
      | other -> False
    }
    | [] -> False
  }.

  stopsAtCaseBodyTerminator :: [CanonicalToken] -> Bool.
  stopsAtCaseBodyTerminator = \(tokens) -> case tokens {
    | [token | rest] -> case canonicalTokenKind token {
      | PunctuationKind RightBracePunctuation -> True
      | other -> False
    }
    | [] -> False
  }.

  stopsAtCaseGuardTerminator :: [CanonicalToken] -> Bool.
  stopsAtCaseGuardTerminator = \(tokens) -> case tokens {
    | [token | rest] -> case canonicalTokenKind token {
      | PunctuationKind ArrowPunctuation -> True
      | PunctuationKind RightBracePunctuation -> True
      | other -> False
    }
    | [] -> False
  }.

  tokensStartRightParen :: [CanonicalToken] -> Bool.
  tokensStartRightParen = \(tokens) -> case tokens {
    | [first | rest] -> case canonicalTokenKind first {
      | PunctuationKind RightParenPunctuation -> True
      | other -> False
    }
    | [] -> False
  }.

  operatorNextMinimum :: OperatorInfo -> Int.
  operatorNextMinimum = \(info) -> case operatorInfoAssociativity info {
    | RightAssociative -> operatorInfoPrecedence info
    | LeftAssociative -> operatorInfoPrecedence info + 1
    | NonAssociative -> operatorInfoPrecedence info + 1
  }.

  operatorIsNonAssociative :: OperatorInfo -> Bool.
  operatorIsNonAssociative = \(info) -> case operatorInfoAssociativity info {
    | NonAssociative -> True
    | other -> False
  }.

  samePrecedenceNonAssociativeStop :: ParserContext -> OperatorInfo -> ([CanonicalToken] -> Bool) -> [CanonicalToken] -> Bool.
  samePrecedenceNonAssociativeStop = \(context, info, outerStop, tokens) -> if outerStop tokens then True else case tokens {
    | [token | rest] -> case canonicalTokenKind token {
      | OperatorKind symbol -> case parserContextLookupOperator context symbol {
        | Just next -> if operatorInfoPrecedence next == operatorInfoPrecedence info then
          if operatorIsNonAssociative info then True else operatorIsNonAssociative next
          else False
        | Nothing -> False
      }
      | other -> False
    }
    | [] -> False
  }.

  rejectNonAssociativeContinuation :: ParserContext -> OperatorInfo -> CanonicalToken -> TokenParser(()).
  rejectNonAssociativeContinuation = \(context, info, operatorToken) -> tokenAndThen
    (\(current) -> case current {
      | Just token -> case canonicalTokenKind token {
        | OperatorKind symbol -> case parserContextLookupOperator context symbol {
          | Just next -> if operatorInfoPrecedence next == operatorInfoPrecedence info then
            if operatorIsNonAssociative info then tokenFailAtSpan
              (canonicalTokenSpan operatorToken)
              (NonAssociativeOperatorChain (operatorInfoSymbol info))
              else if operatorIsNonAssociative next then tokenFailAtSpan
                (canonicalTokenSpan operatorToken)
                (NonAssociativeOperatorChain (operatorInfoSymbol next))
                else tokenSucceed ()
            else tokenSucceed ()
          | Nothing -> tokenSucceed ()
        }
        | other -> tokenSucceed ()
      }
      | Nothing -> tokenSucceed ()
    })
    tokenPeek.

  parseCaseOperatorContinuation :: ParserContext -> Bool -> ([CanonicalToken] -> Bool) -> TokenParser([SurfaceStatement]) -> Int -> SurfaceExpr -> CanonicalToken -> Text -> TokenParser(SurfaceExpr).
  parseCaseOperatorContinuation = \(context, guardMode, stop, parseBlock, minimum, left, operatorToken, symbol) ->
    case parserContextLookupOperator context symbol {
      | Nothing -> tokenFailAtSpan
        (canonicalTokenSpan operatorToken)
        (UndeclaredOperator symbol ExpressionOperatorUse)
      | Just info -> if operatorInfoPrecedence info < minimum then tokenSucceed left else
        tokenKeepRight
          tokenOperator
          (tokenAndThen
            (\(right) -> tokenKeepRight
              (rejectNonAssociativeContinuation context info operatorToken)
              (parseCasePipeExpressionTail
                context
                guardMode
                stop
                parseBlock
                minimum
                (BinaryExpression symbol left right)))
            (parseCasePipeExpressionWithMinimum
              context
              guardMode
              (\(tokens) -> samePrecedenceNonAssociativeStop context info stop tokens)
              parseBlock
              (operatorNextMinimum info)))
    }.

  parseCasePipeExpressionTail :: ParserContext -> Bool -> ([CanonicalToken] -> Bool) -> TokenParser([SurfaceStatement]) -> Int -> SurfaceExpr -> TokenParser(SurfaceExpr).
  parseCasePipeExpressionTail = \(context, guardMode, stop, parseBlock, minimum, left) -> tokenAndThen
    (\(remaining) -> if stop remaining then tokenSucceed left else case remaining {
      | [operatorToken | afterOperator] -> case canonicalTokenKind operatorToken {
        | OperatorKind symbol -> if tokensStartRightParen afterOperator then tokenSucceed left else
          if symbol == "|" then tokenAndThen
            (\(isBoundary) -> if isBoundary then tokenSucceed left else
              parseCaseOperatorContinuation
                context
                guardMode
                stop
                parseBlock
                minimum
                left
                operatorToken
                symbol)
            (if guardMode then pipeStartsCaseGuardBoundary left else pipeStartsCaseArmBoundary left)
            else parseCaseOperatorContinuation
              context
              guardMode
              stop
              parseBlock
              minimum
              left
              operatorToken
              symbol
        | other -> tokenSucceed left
      }
      | [] -> tokenSucceed left
    })
    tokenRemaining.

  parseCasePipeExpressionWithMinimum :: ParserContext -> Bool -> ([CanonicalToken] -> Bool) -> TokenParser([SurfaceStatement]) -> Int -> TokenParser(SurfaceExpr).
  parseCasePipeExpressionWithMinimum = \(context, guardMode, stop, parseBlock, minimum) -> {
    parseExpressionUntil = \(nestedStop) ->
      parseCasePipeExpressionWithMinimum context guardMode nestedStop parseBlock 1.
    tokenAndThen
      (\(left) -> parseCasePipeExpressionTail context guardMode stop parseBlock minimum left)
      (parseApplicationExpression context (Just stop) parseExpressionUntil parseBlock).
  }.

  parseCasePipeExpression :: ParserContext -> Bool -> ([CanonicalToken] -> Bool) -> TokenParser([SurfaceStatement]) -> TokenParser(SurfaceExpr).
  parseCasePipeExpression = \(context, guardMode, stop, parseBlock) ->
    parseCasePipeExpressionWithMinimum context guardMode stop parseBlock 1.

  parseCaseScrutinee :: (([CanonicalToken] -> Bool) -> TokenParser(SurfaceExpr)) -> TokenParser(SurfaceExpr).
  parseCaseScrutinee = \(parseExpressionUntil) -> parseExpressionUntil caseBodyStarts.

  consumeCaseArrow :: ParserEncountered -> TokenParser(()).
  consumeCaseArrow = \(endOfInputEncountered) -> tokenAndThen
    (\(current) -> case current {
      | Just token -> case canonicalTokenKind token {
        | PunctuationKind ArrowPunctuation -> tokenKeepRight
          (tokenPunctuation ArrowPunctuation)
          (tokenSucceed ())
        | other -> tokenFailAtSpan
          (canonicalTokenSpan token)
          (ExpectedSyntax "'->'" (FoundToken (canonicalTokenKind token) (canonicalTokenLexeme token)))
      }
      | Nothing -> tokenFailAt Nothing (ExpectedSyntax "'->'" endOfInputEncountered)
    })
    tokenPeek.

  parseCaseGuard :: ParserContext -> TokenParser([SurfaceStatement]) -> TokenParser(SurfaceExpr).
  parseCaseGuard = \(context, parseBlock) -> tokenAndThen
    (\(current) -> case current {
      | Nothing -> tokenFailAt Nothing (ExpectedSyntax "guard expression" (EndOfInputAfter "'if'"))
      | Just token -> case canonicalTokenKind token {
        | PunctuationKind ArrowPunctuation -> tokenFailAt Nothing
          (ExpectedSyntax "guard expression" (BeforeToken (PunctuationKind ArrowPunctuation) "->" Nothing))
        | PunctuationKind RightBracePunctuation -> tokenFailAt Nothing
          (ExpectedSyntax "guard expression" (BeforeToken (PunctuationKind RightBracePunctuation) "}" Nothing))
        | OperatorKind "|" -> tokenFailAt Nothing
          (ExpectedSyntax "guard expression" (BeforeBoundary "next case arm"))
        | other -> parseCasePipeExpression context True stopsAtCaseGuardTerminator parseBlock
      }
    })
    tokenPeek.

  parseCaseArmBody :: ParserContext -> TokenParser([SurfaceStatement]) -> TokenParser(SurfaceExpr).
  parseCaseArmBody = \(context, parseBlock) -> parseCasePipeExpression context False stopsAtCaseBodyTerminator parseBlock.

  parseCaseArmAfterPattern :: ParserContext -> TokenParser([SurfaceStatement]) -> SurfacePattern -> TokenParser(SurfaceCaseArm).
  parseCaseArmAfterPattern = \(context, parseBlock, pattern) -> tokenAndThen
    (\(current) -> case current {
      | Just token -> case canonicalTokenKind token {
        | KeywordKind IfKeyword -> tokenKeepRight
          (tokenKeyword IfKeyword)
          (tokenAndThen
            (\(guard) -> tokenKeepRight
              (consumeCaseArrow (EndOfInputAfter "case guard"))
              (tokenAndThen
                (\(body) -> tokenSucceed (SurfaceCaseArm pattern (Just guard) body))
                (parseCaseArmBody context parseBlock)))
            (parseCaseGuard context parseBlock))
        | other -> tokenKeepRight
          (consumeCaseArrow (EndOfInputAfter "case pattern"))
          (tokenAndThen
            (\(body) -> tokenSucceed (SurfaceCaseArm pattern Nothing body))
            (parseCaseArmBody context parseBlock))
      }
      | Nothing -> tokenKeepRight
        (consumeCaseArrow (EndOfInputAfter "case pattern"))
        (tokenFailAt Nothing (ExpectedSyntax "expression" EndOfInput))
    })
    tokenPeek.

  parseCaseArm :: ParserContext -> TokenParser([SurfaceStatement]) -> TokenParser(SurfaceCaseArm).
  parseCaseArm = \(context, parseBlock) -> tokenAndThen
    (\(current) -> case current {
      | Just token -> case canonicalTokenKind token {
        | OperatorKind "|" -> tokenKeepRight
          tokenOperator
          (tokenAndThen
            (\(pattern) -> parseCaseArmAfterPattern context parseBlock pattern)
            parseCaseArmPattern)
        | other -> tokenFailAtSpan
          (canonicalTokenSpan token)
          (ExpectedSyntax "'|' to start case arm" (AtToken (canonicalTokenKind token) (canonicalTokenLexeme token)))
      }
      | Nothing -> tokenFailAt Nothing (ExpectedSyntax "'|'" (EndOfInputIn "case expression"))
    })
    tokenPeek.

  collectCaseArms :: ParserContext -> TokenParser([SurfaceStatement]) -> [SurfaceCaseArm] -> TokenParser([SurfaceCaseArm]).
  collectCaseArms = \(context, parseBlock, reversed) -> tokenAndThen
    (\(current) -> case current {
      | Just token -> case canonicalTokenKind token {
        | PunctuationKind RightBracePunctuation -> tokenKeepRight
          (tokenPunctuation RightBracePunctuation)
          (tokenSucceed (listReverse reversed))
        | other -> tokenAndThen
          (\(next) -> collectCaseArms context parseBlock (listPrepend next reversed))
          (parseCaseArm context parseBlock)
      }
      | Nothing -> tokenAndThen
        (\(next) -> collectCaseArms context parseBlock (listPrepend next reversed))
        (parseCaseArm context parseBlock)
    })
    tokenPeek.

  parseCaseArms :: ParserContext -> TokenParser([SurfaceStatement]) -> TokenParser([SurfaceCaseArm]).
  parseCaseArms = \(context, parseBlock) -> tokenAndThen
    (\(current) -> case current {
      | Just token -> case canonicalTokenKind token {
        | PunctuationKind RightBracePunctuation -> tokenFailAtSpan
          (canonicalTokenSpan token)
          (ExpectedSyntax "case arm" (BeforeToken (PunctuationKind RightBracePunctuation) "}" Nothing))
        | other -> tokenAndThen
          (\(first) -> collectCaseArms context parseBlock [first])
          (parseCaseArm context parseBlock)
      }
      | Nothing -> tokenAndThen
        (\(first) -> tokenSucceed [first])
        (parseCaseArm context parseBlock)
    })
    tokenPeek.

  parseCaseAfterScrutinee :: ParserContext -> TokenParser([SurfaceStatement]) -> CanonicalToken -> SurfaceExpr -> TokenParser(SurfaceExpr).
  parseCaseAfterScrutinee = \(context, parseBlock, caseToken, scrutinee) -> tokenAndThen
    (\(current) -> case current {
      | Just token -> case canonicalTokenKind token {
        | PunctuationKind LeftBracePunctuation -> tokenKeepRight
          (tokenPunctuation LeftBracePunctuation)
          (tokenAndThen
            (\(arms) -> tokenSucceed (CaseExpression scrutinee arms))
            (parseCaseArms context parseBlock))
        | other -> tokenFailAtSpan
          (canonicalTokenSpan token)
          (ExpectedSyntax "'{'" (FoundToken (canonicalTokenKind token) (canonicalTokenLexeme token)))
      }
      | Nothing -> tokenFailAtSpan
        (canonicalTokenSpan caseToken)
        (ExpectedSyntax "'{'" (EndOfInputAfter "'case'"))
    })
    tokenPeek.

  parseCase :: ParserContext -> (([CanonicalToken] -> Bool) -> TokenParser(SurfaceExpr)) -> TokenParser([SurfaceStatement]) -> CanonicalToken -> TokenParser(SurfaceExpr).
  parseCase = \(context, parseExpressionUntil, parseBlock, caseToken) -> tokenAndThen
    (\(scrutinee) -> parseCaseAfterScrutinee context parseBlock caseToken scrutinee)
    (parseCaseScrutinee parseExpressionUntil).

  collectLambdaParameters :: SurfaceLambdaParameter -> [SurfaceLambdaParameter] -> TokenParser(NonEmpty(SurfaceLambdaParameter)).
  collectLambdaParameters = \(first, reversed) -> tokenAndThen
    (\(current) -> case current {
      | Just token -> case canonicalTokenKind token {
        | PunctuationKind CommaPunctuation -> tokenKeepRight
          (tokenPunctuation CommaPunctuation)
          (tokenAndThen
            (\(next) -> collectLambdaParameters first (listPrepend next reversed))
            parseLambdaParameter)
        | PunctuationKind RightParenPunctuation -> tokenKeepRight
          (tokenPunctuation RightParenPunctuation)
          (tokenSucceed (NonEmpty first (listReverse reversed)))
        | other -> tokenFailAtSpan
          (canonicalTokenSpan token)
          (ExpectedSyntax "',' or ')'" (FoundToken (canonicalTokenKind token) (canonicalTokenLexeme token)))
      }
      | Nothing -> tokenFailAt Nothing (ExpectedSyntax "')'" (EndOfInputIn "lambda parameter list"))
    })
    tokenPeek.

  parseLambdaParameters :: TokenParser(NonEmpty(SurfaceLambdaParameter)).
  parseLambdaParameters = tokenAndThen
    (\(current) -> case current {
      | Just token -> case canonicalTokenKind token {
        | PunctuationKind RightParenPunctuation -> tokenKeepRight
          (tokenPunctuation RightParenPunctuation)
          (tokenSucceed (NonEmpty (PatternParameter (TuplePattern [])) []))
        | other -> tokenAndThen
          (\(first) -> collectLambdaParameters first [])
          parseLambdaParameter
      }
      | Nothing -> tokenFailAt Nothing (ExpectedSyntax "identifier" (EndOfInputIn "lambda parameter list"))
    })
    tokenPeek.

  parseLambdaBody :: (([CanonicalToken] -> Bool) -> TokenParser(SurfaceExpr)) -> ([CanonicalToken] -> Bool) -> TokenParser([SurfaceStatement]) -> CanonicalToken -> NonEmpty(SurfaceLambdaParameter) -> TokenParser(SurfaceExpr).
  parseLambdaBody = \(parseExpressionUntil, stop, parseBlock, lambdaToken, parameters) -> tokenAndThen
    (\(current) -> case current {
      | Just token -> case canonicalTokenKind token {
        | PunctuationKind ArrowPunctuation -> tokenKeepRight
          (tokenPunctuation ArrowPunctuation)
          (tokenAndThen
            (\(body) -> tokenSucceed (LambdaExpression parameters body))
            (parseExpressionUntil stop))
        | other -> tokenFailAtSpan
          (canonicalTokenSpan token)
          (ExpectedSyntax "'->'" (FoundToken (canonicalTokenKind token) (canonicalTokenLexeme token)))
      }
      | Nothing -> tokenFailAtSpan
        (canonicalTokenSpan lambdaToken)
        (ExpectedSyntax "'->'" (EndOfInputAfter "lambda parameters"))
    })
    tokenPeek.

  parseLambda :: (([CanonicalToken] -> Bool) -> TokenParser(SurfaceExpr)) -> ([CanonicalToken] -> Bool) -> TokenParser([SurfaceStatement]) -> CanonicalToken -> TokenParser(SurfaceExpr).
  parseLambda = \(parseExpressionUntil, stop, parseBlock, lambdaToken) -> tokenAndThen
    (\(current) -> case current {
      | Just token -> case canonicalTokenKind token {
        | PunctuationKind LeftParenPunctuation -> tokenKeepRight
          (tokenPunctuation LeftParenPunctuation)
          (tokenAndThen
            (\(parameters) -> parseLambdaBody parseExpressionUntil stop parseBlock lambdaToken parameters)
            parseLambdaParameters)
        | other -> tokenFailAtSpan
          (canonicalTokenSpan token)
          (ExpectedSyntax "'(' after lambda introducer" (AtToken (canonicalTokenKind token) (canonicalTokenLexeme token)))
      }
      | Nothing -> tokenFailAtSpan
        (canonicalTokenSpan lambdaToken)
        (ExpectedSyntax "'('" (EndOfInputAfter "lambda introducer"))
    })
    tokenPeek.

  parsePrimary :: ParserContext -> (([CanonicalToken] -> Bool) -> TokenParser(SurfaceExpr)) -> ([CanonicalToken] -> Bool) -> TokenParser([SurfaceStatement]) -> TokenParser(SurfaceExpr).
  parsePrimary = \(context, parseExpressionUntil, stop, parseBlock) -> {
    tokenAndThen
      (\(current) -> case current {
        | Nothing -> tokenFailAt Nothing (ExpectedSyntax "expression" EndOfInput)
        | Just token -> case canonicalTokenKind token {
          | IntegerKind whole -> tokenAndThen
            (\(wholeToken) -> parseNumeric wholeToken whole)
            tokenInteger
          | CharacterKind value -> tokenKeepRight
            tokenCharacter
            (tokenSucceed (LiteralExpression (CharacterLiteral value)))
          | TextKind value -> tokenKeepRight
            tokenText
            (tokenSucceed (LiteralExpression (TextLiteral value)))
          | KeywordKind IfKeyword -> tokenAndThen
            (\(ifToken) -> parseConditional parseExpressionUntil stop parseBlock ifToken)
            (tokenKeyword IfKeyword)
          | KeywordKind CaseKeyword -> tokenAndThen
            (\(caseToken) -> parseCase context parseExpressionUntil parseBlock caseToken)
            (tokenKeyword CaseKeyword)
          | IdentifierKind "True" -> tokenKeepRight
            tokenIdentifier
            (tokenSucceed (LiteralExpression (BooleanLiteral True)))
          | IdentifierKind "False" -> tokenKeepRight
            tokenIdentifier
            (tokenSucceed (LiteralExpression (BooleanLiteral False)))
          | IdentifierKind name -> tokenAndThen
            (\(identifierToken) -> parseName identifierToken name)
            tokenIdentifier
          | PunctuationKind LambdaPunctuation -> tokenAndThen
            (\(lambdaToken) -> parseLambda parseExpressionUntil stop parseBlock lambdaToken)
            (tokenPunctuation LambdaPunctuation)
          | PunctuationKind LeftParenPunctuation -> tokenKeepRight
            (tokenPunctuation LeftParenPunctuation)
            (parseParenthesized context parseExpressionUntil)
          | PunctuationKind LeftBracketPunctuation -> tokenKeepRight
            (tokenPunctuation LeftBracketPunctuation)
            (parseList parseExpressionUntil)
          | PunctuationKind LeftBracePunctuation -> tokenKeepRight
            (tokenPunctuation LeftBracePunctuation)
            (tokenAndThen (\(statements) -> tokenSucceed (BlockExpression statements)) parseBlock)
          | other -> tokenKeepRight
            (tokenTakeIf (\(ignored) -> True) "token")
            (tokenFailAtSpan (canonicalTokenSpan token) (UnexpectedSyntax (canonicalTokenEncountered current) "expression"))
        }
      })
      tokenPeek.
  }.

  parseTypeApplicationArgument :: CanonicalToken -> TokenParser(SurfaceSignatureType).
  parseTypeApplicationArgument = \(applicationToken) -> tokenAndThen
    (\(maybeType) -> case maybeType {
      | Just signatureType -> tokenSucceed signatureType
      | Nothing -> tokenFailAtSpan
        (canonicalTokenSpan applicationToken)
        (UnsupportedSyntax ExplicitTypeApplicationArgument)
    })
    (tokenOptional (tokenAttempt parseSignatureType)).

  parseApplicationTail :: Maybe(([CanonicalToken] -> Bool)) -> TokenParser(SurfaceExpr) -> SurfaceExpr -> TokenParser(SurfaceExpr).
  parseApplicationTail = \(maybeStop, primary, function) -> tokenAndThen
    (\(remaining) -> case remaining {
      | [token | rest] -> {
        continue = case canonicalTokenKind token {
          | PunctuationKind AtPunctuation -> tokenAndThen
            (\(applicationToken) -> tokenAndThen
              (\(signatureType) -> parseApplicationTail
                maybeStop
                primary
                (TypeApplicationExpression function (canonicalTokenSpan applicationToken) signatureType))
              (parseTypeApplicationArgument applicationToken))
            (tokenPunctuation AtPunctuation)
          | other -> if startsPrimary token then
            tokenAndThen
              (\(argument) -> parseApplicationTail maybeStop primary (ApplyExpression function argument))
              primary
            else tokenSucceed function
        }.
        case maybeStop {
          | Just stop -> if stop remaining then tokenSucceed function else continue
          | Nothing -> continue
        }.
      }
      | [] -> tokenSucceed function
    })
    tokenRemaining.

  parseApplicationExpression :: ParserContext -> Maybe(([CanonicalToken] -> Bool)) -> (([CanonicalToken] -> Bool) -> TokenParser(SurfaceExpr)) -> TokenParser([SurfaceStatement]) -> TokenParser(SurfaceExpr).
  parseApplicationExpression = \(context, maybeStop, parseExpressionUntil, parseBlock) -> {
    primary = case maybeStop {
      | Just stop -> parsePrimary context parseExpressionUntil stop parseBlock
      | Nothing -> parsePrimary context parseExpressionUntil neverStops parseBlock
    }.
    tokenAndThen (\(first) -> parseApplicationTail maybeStop primary first) primary.
  }.

  parseInfixTail :: ParserContext -> ([CanonicalToken] -> Bool) -> TokenParser([SurfaceStatement]) -> Int -> SurfaceExpr -> TokenParser(SurfaceExpr).
  parseInfixTail = \(context, stop, parseBlock, minimum, left) -> tokenAndThen
    (\(remaining) -> if stop remaining then tokenSucceed left else case remaining {
      | [operatorToken | afterOperator] -> case canonicalTokenKind operatorToken {
        | OperatorKind symbol -> if tokensStartRightParen afterOperator then tokenSucceed left else
          case parserContextLookupOperator context symbol {
            | Nothing -> tokenFailAtSpan
              (canonicalTokenSpan operatorToken)
              (UndeclaredOperator symbol ExpressionOperatorUse)
            | Just info -> if operatorInfoPrecedence info < minimum then tokenSucceed left else
              tokenKeepRight
                tokenOperator
                (tokenAndThen
                  (\(right) -> tokenKeepRight
                    (rejectNonAssociativeContinuation context info operatorToken)
                    (parseInfixTail
                      context
                      stop
                      parseBlock
                      minimum
                      (BinaryExpression symbol left right)))
                  (parseExpressionWithMinimum
                    context
                    (\(tokens) -> samePrecedenceNonAssociativeStop context info stop tokens)
                    parseBlock
                    (operatorNextMinimum info)))
          }
        | other -> tokenSucceed left
      }
      | [] -> tokenSucceed left
    })
    tokenRemaining.

  parseExpressionWithMinimum :: ParserContext -> ([CanonicalToken] -> Bool) -> TokenParser([SurfaceStatement]) -> Int -> TokenParser(SurfaceExpr).
  parseExpressionWithMinimum = \(context, stop, parseBlock, minimum) -> {
    parseExpressionUntil = \(nestedStop) -> parseExpressionWithMinimum context nestedStop parseBlock 1.
    tokenAndThen
      (\(left) -> parseInfixTail context stop parseBlock minimum left)
      (parseApplicationExpression context (Just stop) parseExpressionUntil parseBlock).
  }.

  parseFoundationalExpression :: TokenParser([SurfaceStatement]) -> TokenParser(SurfaceExpr).
  parseFoundationalExpression = \(parseBlock) ->
    parseExpressionWithMinimum parserContextInitial neverStops parseBlock 1.

  parseFoundationalExpressionWithContext :: ParserContext -> TokenParser([SurfaceStatement]) -> TokenParser(SurfaceExpr).
  parseFoundationalExpressionWithContext = \(context, parseBlock) ->
    parseExpressionWithMinimum context neverStops parseBlock 1.
}
