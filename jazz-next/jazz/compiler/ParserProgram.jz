module ParserProgram (value parseFoundationalProgram) {
  import LexerTypes (
    IdentifierKind,
    ImportKeyword,
    KeywordKind,
    ModuleKeyword,
    PunctuationKind,
    RightBracePunctuation
  ).
  import List (listFoldLeft, listPrepend, listReverse).
  import Maybe.
  import ParserContext.
  import ParserDeclaration (
    parseImportWithContext,
    parseModuleWithContext,
    parseStatementWithContext
  ).
  import ParserExpression (parseFoundationalExpressionWithContext).
  import ParserToken (
    TokenParser,
    canonicalTokenKind,
    canonicalTokenSpan,
    canonicalTokenEncountered,
    tokenSucceed,
    tokenTransform,
    tokenAndThen,
    tokenKeepRight,
    tokenPeek,
    tokenFailAt,
    tokenFailAtSpan,
    tokenPunctuation
  ).
  # Complete ParserTypes import keeps surface statement/expression types
  # available to recursive orchestration signatures.
  import ParserTypes.

  prependStatements :: [SurfaceStatement] -> [SurfaceStatement] -> [SurfaceStatement].
  prependStatements = \(statements, reversed) -> listFoldLeft
    (\(result, statement) -> listPrepend statement result)
    reversed
    statements.

  parseExpressionInContext :: ParserContext -> TokenParser(SurfaceExpr).
  parseExpressionInContext = \(context) -> parseFoundationalExpressionWithContext
    context
    (parseStatementList (parserContextNestedBlock context)).

  parseStatementList :: ParserContext -> TokenParser([SurfaceStatement]).
  parseStatementList = \(context) -> parseScopedStatements context [].

  parseScopedNextStatement :: ParserContext -> [SurfaceStatement] -> TokenParser([SurfaceStatement]).
  parseScopedNextStatement = \(context, reversed) -> tokenAndThen
    (\(result) -> case result {
      | (statements, nextContext) -> parseScopedStatements
        nextContext
        (prependStatements statements reversed)
    })
    (parseStatementWithContext parseExpressionInContext parseStatementList context).

  parseScopedImportStatement :: ParserContext -> [SurfaceStatement] -> TokenParser([SurfaceStatement]).
  parseScopedImportStatement = \(context, reversed) -> tokenAndThen
    (\(result) -> case result {
      | (statements, nextContext) -> parseScopedStatements
        nextContext
        (prependStatements statements reversed)
    })
    (parseImportWithContext context).

  parseScopedStatements :: ParserContext -> [SurfaceStatement] -> TokenParser([SurfaceStatement]).
  parseScopedStatements = \(context, reversed) -> tokenAndThen
    (\(current) -> case current {
      | Nothing -> tokenFailAt Nothing (ExpectedSyntax "'}'" EndOfInput)
      | Just token -> case canonicalTokenKind token {
        | PunctuationKind RightBracePunctuation -> tokenKeepRight
          (tokenPunctuation RightBracePunctuation)
          (tokenSucceed (listReverse reversed))
        | KeywordKind ModuleKeyword -> parseModuleNextStatement context reversed False
        | KeywordKind ImportKeyword -> parseScopedImportStatement context reversed
        | other -> parseScopedNextStatement context reversed
      }
    })
    tokenPeek.

  parseTopLevelOrdinaryStatement :: ParserContext -> [SurfaceStatement] -> TokenParser([SurfaceStatement]).
  parseTopLevelOrdinaryStatement = \(context, reversed) -> tokenAndThen
    (\(result) -> case result {
      | (statements, nextContext) -> parseTopLevelStatementsAfterFirst
        nextContext
        (prependStatements statements reversed)
    })
    (parseStatementWithContext parseExpressionInContext parseStatementList context).

  parseTopLevelImportStatement :: ParserContext -> [SurfaceStatement] -> TokenParser([SurfaceStatement]).
  parseTopLevelImportStatement = \(context, reversed) -> tokenAndThen
    (\(result) -> case result {
      | (statements, nextContext) -> parseTopLevelStatementsAfterFirst
        nextContext
        (prependStatements statements reversed)
    })
    (parseImportWithContext context).

  parseModuleNextStatement :: ParserContext -> [SurfaceStatement] -> Bool -> TokenParser([SurfaceStatement]).
  parseModuleNextStatement = \(context, reversed, seenPriorTopLevelForm) -> tokenAndThen
    (\(result) -> case result {
      | (statements, nextContext) -> case statements {
        | [first | rest] -> case first {
          | ModuleStatement moduleSpan path exports -> if seenPriorTopLevelForm then tokenFailAtSpan
            moduleSpan
            (DeclarationFailure ModuleMustBeFirstTopLevelForm)
            else tokenAndThen
              (\(trailing) -> case trailing {
                | Nothing -> tokenSucceed (listReverse (prependStatements statements reversed))
                | Just token -> tokenFailAtSpan
                  (canonicalTokenSpan token)
                  (UnexpectedSyntaxAfter (canonicalTokenEncountered trailing) "module declaration")
              })
              tokenPeek
          | other -> parseTopLevelStatementsAfterFirst
            nextContext
            (prependStatements statements reversed)
        }
        | [] -> parseTopLevelStatementsAfterFirst nextContext reversed
      }
    })
    (parseModuleWithContext parseStatementList context).

  parseTopLevelStatementsInitial :: ParserContext -> [SurfaceStatement] -> TokenParser([SurfaceStatement]).
  parseTopLevelStatementsInitial = \(context, reversed) -> tokenAndThen
    (\(current) -> case current {
      | Nothing -> tokenSucceed (listReverse reversed)
      | Just token -> case canonicalTokenKind token {
        | IdentifierKind name -> parseTopLevelOrdinaryStatement context reversed
        | KeywordKind ModuleKeyword -> parseModuleNextStatement context reversed False
        | KeywordKind ImportKeyword -> parseTopLevelImportStatement context reversed
        | other -> parseTopLevelOrdinaryStatement context reversed
      }
    })
    tokenPeek.

  parseTopLevelStatementsAfterFirst :: ParserContext -> [SurfaceStatement] -> TokenParser([SurfaceStatement]).
  parseTopLevelStatementsAfterFirst = \(context, reversed) -> tokenAndThen
    (\(current) -> case current {
      | Nothing -> tokenSucceed (listReverse reversed)
      | Just token -> case canonicalTokenKind token {
        | IdentifierKind name -> parseTopLevelOrdinaryStatement context reversed
        | KeywordKind ModuleKeyword -> parseModuleNextStatement context reversed True
        | KeywordKind ImportKeyword -> parseTopLevelImportStatement context reversed
        | other -> parseTopLevelOrdinaryStatement context reversed
      }
    })
    tokenPeek.

  parseFoundationalProgram :: TokenParser(SurfaceExpr).
  parseFoundationalProgram = tokenTransform
    (\(statements) -> BlockExpression statements)
    (parseTopLevelStatementsInitial parserContextInitial []).
}
