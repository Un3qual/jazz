module ParserProgram (value parseFoundationalProgram) {
  import LexerTypes (
    CanonicalToken,
    IdentifierKind,
    PunctuationKind,
    EqualsPunctuation,
    DoubleColonPunctuation,
    DotPunctuation,
    AtPunctuation,
    LeftBracePunctuation,
    RightBracePunctuation,
    LeftParenPunctuation,
    LeftBracketPunctuation
  ).
  import Char (charIsUpper).
  import List (listPrepend, listReverse).
  import Maybe.
  import ParserExpression (parseFoundationalExpression).
  import ParserToken (
    TokenParser,
    canonicalTokenKind,
    canonicalTokenSpan,
    canonicalTokenEncountered,
    tokensAreAdjacent,
    tokenSucceed,
    tokenTransform,
    tokenAndThen,
    tokenKeepRight,
    tokenAttempt,
    tokenOptional,
    tokenLookAhead,
    tokenPeek,
    tokenFailAt,
    tokenFailAtSpan,
    tokenTakeIf,
    tokenIdentifier,
    tokenPunctuation
  ).
  import Text (textLength, textUncons).
  # Complete ParserTypes imports are required while explicit import lists do
  # not expose the surface type names used by recursive grammar signatures.
  import ParserTypes.

  bindingStart :: TokenParser(Maybe(CanonicalToken)).
  bindingStart = tokenLookAhead
    (tokenOptional
      (tokenAttempt
        (tokenKeepRight tokenIdentifier (tokenPunctuation EqualsPunctuation)))).

  isAbstractionName :: Text -> Bool.
  isAbstractionName = \(name) -> if name == "class" then True else if name == "impl" then True else name == "trait".

  abstractionHeaderStart :: TokenParser(CanonicalToken).
  abstractionHeaderStart = tokenTakeIf
    (\(token) -> case canonicalTokenKind token {
      | IdentifierKind name -> True
      | PunctuationKind AtPunctuation -> True
      | other -> False
    })
    "abstraction declaration header".

  anyToken :: TokenParser(CanonicalToken).
  anyToken = tokenTakeIf (\(token) -> True) "token".

  operatorKeyword :: TokenParser(CanonicalToken).
  operatorKeyword = tokenTakeIf
    (\(token) -> case canonicalTokenKind token {
      | IdentifierKind name -> name == "operator"
      | other -> False
    })
    "'operator'".

  operatorFixityBeforeTerminator :: () -> TokenParser(()).
  operatorFixityBeforeTerminator = \() -> tokenAndThen
    (\(current) -> case current {
      | Nothing -> tokenFailAt Nothing (ExpectedSyntax "operator declaration fixity" EndOfInput)
      | Just token -> case canonicalTokenKind token {
        | PunctuationKind DotPunctuation -> tokenFailAtSpan
          (canonicalTokenSpan token)
          (ExpectedSyntax "operator declaration fixity" (canonicalTokenEncountered current))
        | IdentifierKind name -> if name == "tier" then tokenSucceed () else if name == "precedence" then
          tokenSucceed ()
          else tokenKeepRight anyToken (operatorFixityBeforeTerminator ())
        | other -> tokenKeepRight anyToken (operatorFixityBeforeTerminator ())
      }
    })
    tokenPeek.

  identifierOperatorDeclarationCandidate :: TokenParser((CanonicalToken, CanonicalToken)).
  identifierOperatorDeclarationCandidate = tokenAndThen
    (\(declarationToken) -> tokenAndThen
      (\(symbolToken) -> tokenKeepRight
        (operatorFixityBeforeTerminator ())
        (tokenSucceed (declarationToken, symbolToken)))
      tokenIdentifier)
    operatorKeyword.

  identifierOperatorDeclarationStart :: TokenParser(Maybe((CanonicalToken, CanonicalToken))).
  identifierOperatorDeclarationStart = tokenLookAhead
    (tokenOptional (tokenAttempt identifierOperatorDeclarationCandidate)).

  abstractionBodyBeforeTerminator :: () -> TokenParser(()).
  abstractionBodyBeforeTerminator = \() -> tokenAndThen
    (\(current) -> case current {
      | Nothing -> tokenFailAt Nothing (ExpectedSyntax "abstraction body" EndOfInput)
      | Just token -> case canonicalTokenKind token {
        | PunctuationKind LeftBracePunctuation -> tokenSucceed ()
        | PunctuationKind DotPunctuation -> tokenFailAtSpan
          (canonicalTokenSpan token)
          (ExpectedSyntax "abstraction body" (canonicalTokenEncountered current))
        | other -> tokenKeepRight anyToken (abstractionBodyBeforeTerminator ())
      }
    })
    tokenPeek.

  unsupportedDeclarationCandidate :: TokenParser(CanonicalToken).
  unsupportedDeclarationCandidate = tokenAndThen
    (\(declarationToken) -> case canonicalTokenKind declarationToken {
      | IdentifierKind name -> if isAbstractionName name then
        tokenKeepRight
          abstractionHeaderStart
          (tokenKeepRight
            (abstractionBodyBeforeTerminator ())
            (tokenSucceed declarationToken))
        else tokenFailAtSpan
          (canonicalTokenSpan declarationToken)
          (ExpectedSyntax "abstraction declaration" (FoundToken (IdentifierKind name) name))
    })
    tokenIdentifier.

  # Top-level statements inspect unsupported declaration shapes and stop at
  # end of input; nested blocks skip that inspection and stop at a right brace.
  # The modes are complements, so one flag cannot represent an invalid pair.
  unsupportedDeclarationStart :: Bool -> TokenParser(Maybe(CanonicalToken)).
  unsupportedDeclarationStart = \(nestedBlock) -> if nestedBlock then
    tokenSucceed Nothing
    else tokenAndThen
      (\(current) -> case current {
        | Just token -> case canonicalTokenKind token {
          | IdentifierKind name -> if isAbstractionName name then
            tokenLookAhead (tokenOptional (tokenAttempt unsupportedDeclarationCandidate))
            else tokenSucceed Nothing
          | other -> tokenSucceed Nothing
        }
        | Nothing -> tokenSucceed Nothing
      })
      tokenPeek.

  identifierStartsUpper :: Text -> Bool.
  identifierStartsUpper = \(name) -> case textUncons name {
    | Just (first, rest) -> charIsUpper first
    | Nothing -> False
  }.

  isBareSignatureNamePair :: Text -> Text -> Bool.
  isBareSignatureNamePair = \(name, typeName) -> if identifierStartsUpper name then
    if identifierStartsUpper typeName then True else textLength typeName == 1
    else True.

  startsSignaturePayloadContinuation :: CanonicalToken -> Bool.
  startsSignaturePayloadContinuation = \(token) -> case canonicalTokenKind token {
    | PunctuationKind LeftParenPunctuation -> True
    | PunctuationKind LeftBracketPunctuation -> True
    | PunctuationKind LeftBracePunctuation -> True
    | other -> False
  }.

  signaturePayloadBoundary :: Text -> Text -> CanonicalToken -> CanonicalToken -> TokenParser((CanonicalToken, CanonicalToken)).
  signaturePayloadBoundary = \(name, typeName, nameToken, separatorToken) -> tokenAndThen
    (\(current) -> case current {
      | Just token -> case canonicalTokenKind token {
        | PunctuationKind DotPunctuation -> if isBareSignatureNamePair name typeName then
          tokenSucceed (nameToken, separatorToken)
          else tokenFailAtSpan
            (canonicalTokenSpan nameToken)
            (ExpectedSyntax "simple signature declaration" (canonicalTokenEncountered (Just nameToken)))
        | other -> if startsSignaturePayloadContinuation token then tokenSucceed (nameToken, separatorToken)
          else tokenFailAtSpan
            (canonicalTokenSpan token)
            (ExpectedSyntax "signature payload continuation" (canonicalTokenEncountered current))
      }
      | Nothing -> tokenFailAt Nothing (ExpectedSyntax "signature payload continuation" EndOfInput)
    })
    tokenPeek.

  compactSignatureCandidate :: TokenParser((CanonicalToken, CanonicalToken)).
  compactSignatureCandidate = tokenAndThen
    (\(nameToken) -> case canonicalTokenKind nameToken {
      | IdentifierKind name -> tokenAndThen
        (\(separatorToken) -> tokenAndThen
          (\(typeToken) -> case canonicalTokenKind typeToken {
            | IdentifierKind typeName -> if tokensAreAdjacent nameToken separatorToken then
              if tokensAreAdjacent separatorToken typeToken then
                signaturePayloadBoundary name typeName nameToken separatorToken
                else tokenFailAtSpan
                  (canonicalTokenSpan typeToken)
                  (ExpectedSyntax "adjacent signature type" (canonicalTokenEncountered (Just typeToken)))
              else tokenFailAtSpan
                (canonicalTokenSpan separatorToken)
                (ExpectedSyntax "adjacent signature separator" (canonicalTokenEncountered (Just separatorToken)))
          })
          tokenIdentifier)
        (tokenPunctuation DoubleColonPunctuation)
    })
    tokenIdentifier.

  compactSignatureStart :: TokenParser(Maybe((CanonicalToken, CanonicalToken))).
  compactSignatureStart = tokenLookAhead (tokenOptional (tokenAttempt compactSignatureCandidate)).

  isReservedLiteralName :: Text -> Bool.
  isReservedLiteralName = \(name) -> if name == "True" then True else name == "False".

  parseBinding :: (() -> TokenParser([SurfaceStatement])) -> TokenParser(SurfaceStatement).
  parseBinding = \(parseBlock) -> tokenAndThen
    (\(nameToken) -> case canonicalTokenKind nameToken {
      | IdentifierKind name -> if isReservedLiteralName name then
        tokenFailAtSpan
          (canonicalTokenSpan nameToken)
          (DeclarationFailure (ReservedLiteralName BindingName name))
        else tokenKeepRight
          (tokenPunctuation EqualsPunctuation)
          (tokenAndThen
            (\(valueExpression) -> tokenKeepRight
              (tokenPunctuation DotPunctuation)
              (tokenSucceed (LetStatement name (canonicalTokenSpan nameToken) valueExpression)))
            (parseFoundationalExpression (parseBlock ())))
    })
    tokenIdentifier.

  parseExpressionStatement :: (() -> TokenParser([SurfaceStatement])) -> TokenParser(SurfaceStatement).
  parseExpressionStatement = \(parseBlock) -> tokenAndThen
    (\(current) -> case current {
      | Just firstToken -> tokenAndThen
        (\(expression) -> tokenKeepRight
          (tokenPunctuation DotPunctuation)
          (tokenSucceed (ExpressionStatement (canonicalTokenSpan firstToken) expression)))
        (parseFoundationalExpression (parseBlock ()))
      | Nothing -> tokenFailAt Nothing (ExpectedSyntax "expression" EndOfInput)
    })
    tokenPeek.

  rejectUnsupportedDeclaration :: CanonicalToken -> TokenParser(SurfaceStatement).
  rejectUnsupportedDeclaration = \(declarationToken) -> case canonicalTokenKind declarationToken {
    | IdentifierKind name -> tokenFailAtSpan
      (canonicalTokenSpan declarationToken)
      (UnsupportedSyntax (AbstractionSyntax name))
    | other -> tokenFailAtSpan
      (canonicalTokenSpan declarationToken)
      (InternalParserFailure TokenStreamParseFailure)
  }.

  rejectUnsupportedSignature :: (CanonicalToken, CanonicalToken) -> TokenParser(SurfaceStatement).
  rejectUnsupportedSignature = \(candidate) -> case candidate {
    | (nameToken, separatorToken) -> case canonicalTokenKind nameToken {
      | IdentifierKind name -> if isReservedLiteralName name then
        tokenFailAtSpan
          (canonicalTokenSpan nameToken)
          (DeclarationFailure (ReservedLiteralName BindingName name))
        else tokenFailAtSpan
          (canonicalTokenSpan separatorToken)
          (UnexpectedSyntax (canonicalTokenEncountered (Just separatorToken)) "an expression-foundation statement")
      | other -> tokenFailAtSpan
        (canonicalTokenSpan nameToken)
        (InternalParserFailure TokenStreamParseFailure)
    }
  }.

  rejectIdentifierOperatorDeclaration :: Bool -> (CanonicalToken, CanonicalToken) -> TokenParser(SurfaceStatement).
  rejectIdentifierOperatorDeclaration = \(nestedBlock, candidate) -> case candidate {
    | (declarationToken, symbolToken) -> if nestedBlock then
      tokenFailAtSpan
        (canonicalTokenSpan declarationToken)
        (DeclarationFailure (DeclarationOutsideAllowedScope OperatorDeclaration))
      else tokenFailAtSpan
        (canonicalTokenSpan symbolToken)
        (ExpectedSyntax "operator symbol after 'operator'" (canonicalTokenEncountered (Just symbolToken)))
  }.

  parseNonBindingStatement :: Bool -> (() -> TokenParser([SurfaceStatement])) -> TokenParser(SurfaceStatement).
  parseNonBindingStatement = \(nestedBlock, parseBlock) -> tokenAndThen
    (\(operatorStart) -> case operatorStart {
      | Just candidate -> rejectIdentifierOperatorDeclaration nestedBlock candidate
      | Nothing -> tokenAndThen
        (\(declarationStart) -> case declarationStart {
          | Just declarationToken -> rejectUnsupportedDeclaration declarationToken
          | Nothing -> tokenAndThen
            (\(signatureStart) -> case signatureStart {
              | Just candidate -> rejectUnsupportedSignature candidate
              | Nothing -> parseExpressionStatement parseBlock
            })
            compactSignatureStart
        })
        (unsupportedDeclarationStart nestedBlock)
    })
    identifierOperatorDeclarationStart.

  parseStatement :: Bool -> (() -> TokenParser([SurfaceStatement])) -> TokenParser(SurfaceStatement).
  parseStatement = \(nestedBlock, parseBlock) -> tokenAndThen
    (\(start) -> case start {
      | Just token -> parseBinding parseBlock
      | Nothing -> parseNonBindingStatement nestedBlock parseBlock
    })
    bindingStart.

  parseStatements :: Bool -> (() -> TokenParser([SurfaceStatement])) -> [SurfaceStatement] -> TokenParser([SurfaceStatement]).
  parseStatements = \(nestedBlock, parseBlock, reversed) -> tokenAndThen
    (\(current) -> case current {
      | Nothing -> if nestedBlock then
        tokenFailAt Nothing (ExpectedSyntax "'}'" EndOfInput)
        else tokenSucceed (listReverse reversed)
      | Just token -> case canonicalTokenKind token {
        | PunctuationKind RightBracePunctuation -> if nestedBlock then
          tokenKeepRight
            (tokenPunctuation RightBracePunctuation)
            (tokenSucceed (listReverse reversed))
          else tokenAndThen
            (\(statement) -> parseStatements nestedBlock parseBlock (listPrepend statement reversed))
            (parseStatement nestedBlock parseBlock)
        | other -> tokenAndThen
          (\(statement) -> parseStatements nestedBlock parseBlock (listPrepend statement reversed))
          (parseStatement nestedBlock parseBlock)
      }
    })
    tokenPeek.

  parseBlock :: () -> TokenParser([SurfaceStatement]).
  parseBlock = \() -> parseStatements True parseBlock [].

  parseFoundationalProgram :: TokenParser(SurfaceExpr).
  parseFoundationalProgram = tokenTransform
    (\(statements) -> BlockExpression statements)
    (parseStatements False parseBlock []).
}
