module ParserProgram (value parseFoundationalProgram) {
  import LexerTypes (
    PunctuationKind,
    RightBracePunctuation
  ).
  import List (listFoldLeft, listPrepend, listReverse).
  import Maybe.
  import ParserContext.
  import ParserDeclaration (parseStatementWithContext).
  import ParserExpression (parseFoundationalExpressionWithContext).
  import ParserToken (
    TokenParser,
    canonicalTokenKind,
    tokenSucceed,
    tokenTransform,
    tokenAndThen,
    tokenKeepRight,
    tokenPeek,
    tokenFailAt,
    tokenPunctuation
  ).
  # Complete ParserTypes import keeps surface statement/expression types
  # available to recursive orchestration signatures.
  import ParserTypes.

  prependStatements :: [SurfaceStatement] -> [SurfaceStatement] -> [SurfaceStatement].
  prependStatements = \(statements, reversed) -> listFoldLeft
    (\(result, statement) -> listPrepend statement result)
    reversed
    statements.

  parseExpressionInContext :: ParserContext -> TokenParser(SurfaceExpr).
  parseExpressionInContext = \(context) -> parseFoundationalExpressionWithContext
    context
    (parseStatements (parserContextNestedBlock context) []).

  parseStatementList :: ParserContext -> TokenParser([SurfaceStatement]).
  parseStatementList = \(context) -> parseStatements context [].

  parseNextStatement :: ParserContext -> [SurfaceStatement] -> TokenParser([SurfaceStatement]).
  parseNextStatement = \(context, reversed) -> tokenAndThen
    (\(result) -> case result {
      | (statements, nextContext) -> parseStatements
        nextContext
        (prependStatements statements reversed)
    })
    (parseStatementWithContext parseExpressionInContext parseStatementList context).

  parseStatements :: ParserContext -> [SurfaceStatement] -> TokenParser([SurfaceStatement]).
  parseStatements = \(context, reversed) -> tokenAndThen
    (\(current) -> case current {
      | Nothing -> if parserContextStopsAtRightBrace context then
        tokenFailAt Nothing (ExpectedSyntax "'}'" EndOfInput)
        else tokenSucceed (listReverse reversed)
      | Just token -> case canonicalTokenKind token {
        | PunctuationKind RightBracePunctuation -> if parserContextStopsAtRightBrace context then
          tokenKeepRight
            (tokenPunctuation RightBracePunctuation)
            (tokenSucceed (listReverse reversed))
          else parseNextStatement context reversed
        | other -> parseNextStatement context reversed
      }
    })
    tokenPeek.

  parseFoundationalProgram :: TokenParser(SurfaceExpr).
  parseFoundationalProgram = tokenTransform
    (\(statements) -> BlockExpression statements)
    (parseStatements parserContextInitial []).
}
