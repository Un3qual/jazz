module ParserTypes (
  type SurfaceLiteral(..),
  type SurfacePattern(..),
  type SurfaceCaseArm(..),
  type SurfaceLambdaParameter(..),
  type SurfaceDataConstructor(..),
  type SurfaceExpr(..),
  type SurfaceNumericType(..),
  type SurfaceSignaturePayload(..),
  type SurfaceSignatureConstraint(..),
  type SurfaceSignatureType(..),
  type SurfaceSignatureToken(..),
  type SurfaceClassMethodSignature(..),
  type SurfaceImplMethod(..),
  type SurfaceStatement(..),
  type SurfaceNameNamespace(..),
  type SurfaceLocatedExportName(..),
  type SurfaceTypeConstructorSelector(..),
  type SurfaceModuleExportSelector(..),
  type ParserEncountered(..),
  type ParserOperatorUse(..),
  type ParserDeclarationKind(..),
  type ParserNameRole(..),
  type ParserDuplicateNameRole(..),
  type ParserListKind(..),
  type ParserUnsupportedFeature(..),
  type ParserPatternFailure(..),
  type ParserDeclarationFailure(..),
  type ParserInternalInvariant(..),
  type ParserFailureReason(..),
  type ParserFailure(..),
  type CanonicalParserResult(..),
  type CanonicalSourceResult(..)
) {
  import LexerTypes.
  import Maybe.
  import NonEmpty.

  data SurfaceLiteral
    = IntegerLiteral Text
    | FractionalLiteral Text Text Maybe(SurfaceNumericType)
    | BooleanLiteral Bool
    | CharacterLiteral Char
    | TextLiteral Text.

  data SurfacePattern
    = WildcardPattern
    | VariablePattern Text
    | LiteralPattern SurfaceLiteral
    | ConstructorPattern Text [SurfacePattern]
    | ListPattern [SurfacePattern]
    | ConsListPattern SurfacePattern SurfacePattern
    | TuplePattern [SurfacePattern]
    | AsPattern Text SurfacePattern
    | OrPattern [SurfacePattern].

  data SurfaceCaseArm = SurfaceCaseArm SurfacePattern Maybe(SurfaceExpr) SurfaceExpr.

  data SurfaceLambdaParameter = IdentifierParameter Text | PatternParameter SurfacePattern.

  data SurfaceDataConstructor = SurfaceDataConstructor Text [SurfaceSignatureType].

  data SurfaceExpr
    = LiteralExpression SurfaceLiteral
    | VariableExpression Text
    | QualifiedVariableExpression Text Text
    | LambdaExpression NonEmpty(SurfaceLambdaParameter) SurfaceExpr
    | OperatorValueExpression Text
    | ListExpression [SurfaceExpr]
    | TupleExpression [SurfaceExpr]
    | ApplyExpression SurfaceExpr SurfaceExpr
    | TypeApplicationExpression SurfaceExpr CanonicalSpan SurfaceSignatureType
    | IfExpression SurfaceExpr SurfaceExpr SurfaceExpr
    | CaseExpression SurfaceExpr [SurfaceCaseArm]
    | BinaryExpression Text SurfaceExpr SurfaceExpr
    | LeftSectionExpression SurfaceExpr Text
    | RightSectionExpression Text SurfaceExpr
    | BlockExpression [SurfaceStatement].

  data SurfaceNumericType
    = Int8Type
    | Int16Type
    | Int32Type
    | Int64Type
    | UInt8Type
    | UInt16Type
    | UInt32Type
    | UInt64Type
    | Float16Type
    | Float32Type
    | Float64Type.

  data SurfaceSignaturePayload
    = TypeSignature SurfaceSignatureType
    | ConstrainedSignature [SurfaceSignatureConstraint] SurfaceSignatureType
    | UnsupportedSignature [SurfaceSignatureToken].

  data SurfaceSignatureConstraint = SurfaceSignatureConstraint Text [SurfaceSignatureType].

  data SurfaceSignatureType
    = IntType
    | FloatType
    | NumericType SurfaceNumericType
    | BoolType
    | CharType
    | TextType
    | TypeVariable Text
    | NamedType Text
    | AppliedType Text [SurfaceSignatureType]
    | ListType SurfaceSignatureType
    | TupleType [SurfaceSignatureType]
    | FunctionType SurfaceSignatureType SurfaceSignatureType.

  data SurfaceSignatureToken
    = SignatureNameToken Text
    | SignatureIntegerToken Text
    | SignatureArrowToken
    | SignatureAtToken
    | SignatureColonToken
    | SignatureLeftParenToken
    | SignatureRightParenToken
    | SignatureLeftBraceToken
    | SignatureRightBraceToken
    | SignatureLeftBracketToken
    | SignatureRightBracketToken
    | SignatureCommaToken
    | SignatureOperatorToken Text
    | SignatureOtherToken Text.

  data SurfaceClassMethodSignature
    = SurfaceClassMethodSignature Text CanonicalSpan SurfaceSignaturePayload.

  data SurfaceImplMethod = SurfaceImplMethod Text CanonicalSpan SurfaceExpr.

  data SurfaceStatement
    = LetStatement Text CanonicalSpan SurfaceExpr
    | SignatureStatement Text CanonicalSpan SurfaceSignaturePayload
    | DataStatement CanonicalSpan Text [Text] [SurfaceDataConstructor]
    | ClassStatement CanonicalSpan Text [Text] [SurfaceClassMethodSignature]
    | ImplStatement CanonicalSpan Text [SurfaceSignatureType] [SurfaceImplMethod]
    | ModuleStatement CanonicalSpan [Text] Maybe([SurfaceModuleExportSelector])
    | ImportStatement CanonicalSpan [Text] Maybe(Text) Maybe([Text])
    | ExpressionStatement CanonicalSpan SurfaceExpr.

  data SurfaceNameNamespace = ValueName | ConstructorName | TypeName | CapabilityName.

  data SurfaceLocatedExportName = SurfaceLocatedExportName Text CanonicalSpan.

  data SurfaceTypeConstructorSelector
    = AbstractTypeSelector
    | AllConstructorsSelector CanonicalSpan
    | SelectedConstructorsSelector NonEmpty(SurfaceLocatedExportName).

  data SurfaceModuleExportSelector
    = NamedExportSelector Maybe(SurfaceNameNamespace) Text
    | TypeExportSelector Text CanonicalSpan SurfaceTypeConstructorSelector.

  data ParserEncountered
    = EndOfInput
    | EndOfInputAfter Text
    | EndOfInputIn Text
    | FoundToken CanonicalTokenKind Text
    | AtToken CanonicalTokenKind Text
    | BeforeToken CanonicalTokenKind Text Maybe(Text)
    | BeforeBoundary Text
    | ImplicitBoundary.

  data ParserOperatorUse = ExpressionOperatorUse | BindingOperatorUse | SignatureOperatorUse.

  data ParserDeclarationKind
    = ModuleDeclaration
    | ImportDeclaration
    | DataDeclaration
    | OperatorDeclaration
    | OperatorBinding
    | OperatorSignature
    | ClassDeclaration
    | ImplDeclaration.

  data ParserNameRole = BindingName | ImportAlias.

  data ParserDuplicateNameRole
    = DataTypeParameter
    | DataConstructorName
    | ClassMethodName
    | ImplMethodName.

  data ParserListKind = ImportSymbolList | ModuleExportList | ConstructorExportList.

  data ParserUnsupportedFeature
    = ExplicitTypeApplicationArgument
    | FractionalLiteralPattern
    | ClassMethodBody Text
    | DeclarationHeaderArguments ParserDeclarationKind
    | AbstractionSyntax Text.

  data ParserPatternFailure = ConsLikeListPatternHeadCount.

  data ParserDeclarationFailure
    = BuiltinOperatorCannotBeRedeclared Text
    | BuiltinOperatorCannotBeBound Text
    | BuiltinOperatorCannotBeSigned Text
    | ReservedOperatorSymbol Text
    | DuplicateOperatorDeclaration Text
    | InvalidOperatorSymbol Text
    | OperatorTierOutOfRange
    | OperatorPrecedenceOutOfRange
    | ReservedLiteralName ParserNameRole Text
    | DeclarationOutsideAllowedScope ParserDeclarationKind
    | ImportAliasCombinedWithSymbolList
    | ImplRequiresConcreteTarget
    | DuplicateName ParserDuplicateNameRole Text ParserDeclarationKind
    | DuplicateListItem ParserListKind Text
    | ExpectedOrdinaryImplMethodBinding Text
    | ClassRequiresExplicitParameterList
    | ClassRequiresLowercaseParameter
    | DuplicateClassParameter Text
    | ClassSupportsExactlyOneParameter
    | ClassParameterMustBeLowercase
    | UndeclaredConstructorTypeParameter Text Text
    | ConstructorArgumentDelimiterMismatch Text
    | ConstructorExportGroupRequiresAll
    | ModuleMustBeFirstTopLevelForm.

  data ParserInternalInvariant
    = TokenStreamParseFailure
    | ExpectedOperatorToken ParserOperatorUse
    | ExpectedSignatureSeparator
    | ExpectedBindingEquals.

  data ParserFailureReason
    = ExpectedSyntax Text ParserEncountered
    | UnexpectedSyntax ParserEncountered Text
    | UnexpectedSyntaxIn ParserEncountered Text
    | UnexpectedSyntaxAfter ParserEncountered Text
    | UnsupportedSyntax ParserUnsupportedFeature
    | InvalidFractionalLiteral Text
    | NonAssociativeOperatorChain Text
    | UndeclaredOperator Text ParserOperatorUse
    | DeclarationFailure ParserDeclarationFailure
    | PatternFailure ParserPatternFailure
    | InternalParserFailure ParserInternalInvariant.

  data ParserFailure = ParserFailure Text Maybe(CanonicalSpan) ParserFailureReason.

  data CanonicalParserResult
    = CanonicalParserSuccess CanonicalSourcePath SurfaceExpr
    | CanonicalParserFailure CanonicalSourcePath ParserFailure.

  data CanonicalSourceResult
    = CanonicalSourceSuccess CanonicalSourcePath SurfaceExpr
    | CanonicalSourceLexicalFailure CanonicalSourcePath CanonicalLexError
    | CanonicalSourceParserFailure CanonicalSourcePath ParserFailure.
}
