module TypedCoreValidate (
  value validateProgram
) {
  import List (listAll, listAppend, listConcat, listContains, listIndexed, listLength, listMap, listPrepend, listReverse, listZip).
  import Maybe.
  import Text (textContains, textIsEmpty, textJoin, textSplit, textStartsWith, textToChars).
  import TypedCoreTypes.

  data SchemeEntry = SchemeEntry TypedBinderId TypedScheme.

  data StatementIndexEntry = StatementIndexEntry [Int] Int.

  data NameEntry = NameEntry [Text] TypedNameNamespace Text.

  data DataEntry = DataEntry [Text] Text Int.

  data VisibleModule = VisibleModule (Maybe([Text])) TypedModule.

  data ModuleContext = ModuleContext [Text] [[Text]] [SchemeEntry] [StatementIndexEntry] [NameEntry] [TypedImplId] [DataEntry] [TypedTypeParameterId].

  data PatternBinderContract = PatternBinderContract TypedBinderId TypedType TypedRepresentationRecipe.

  failure :: TypedCoreValidationPath -> TypedCoreValidationKind -> TypedCoreValidationDetail -> TypedCoreValidationFailure.
  failure = TypedCoreValidationFailure.

  textListEqual :: [Text] -> [Text] -> Bool.
  textListEqual = \(left, right) -> case (left, right) {
    | ([], []) -> True
    | ([leftFirst | leftRest], [rightFirst | rightRest]) -> if leftFirst == rightFirst then textListEqual leftRest rightRest else False
    | other -> False
  }.

  intListEqual :: [Int] -> [Int] -> Bool.
  intListEqual = \(left, right) -> case (left, right) {
    | ([], []) -> True
    | ([leftFirst | leftRest], [rightFirst | rightRest]) -> if leftFirst == rightFirst then intListEqual leftRest rightRest else False
    | other -> False
  }.

  nestedStatementLocation :: [Int] -> [Int] -> Int -> [Int].
  nestedStatementLocation = \(statementLocation, expressionPath, blockIndex) ->
    listConcat [statementLocation, [(0 - 1)], expressionPath, [(0 - 2), blockIndex]].

  statementIndexFor :: [Int] -> [StatementIndexEntry] -> Int.
  statementIndexFor = \(statementLocation, entries) -> case entries {
    | [] -> 0
    | [StatementIndexEntry candidateLocation statementIndex | rest] ->
      if intListEqual statementLocation candidateLocation then statementIndex else statementIndexFor statementLocation rest
  }.

  statementLocationFor :: Int -> [StatementIndexEntry] -> [Int].
  statementLocationFor = \(statementIndex, entries) -> case entries {
    | [] -> []
    | [StatementIndexEntry statementLocation candidateIndex | rest] ->
      if statementIndex == candidateIndex then statementLocation else statementLocationFor statementIndex rest
  }.

  modulePathMember :: [Text] -> [[Text]] -> Bool.
  modulePathMember = \(candidate, paths) -> case paths {
    | [] -> False
    | [first | rest] -> if textListEqual candidate first then True else modulePathMember candidate rest
  }.

  nameOriginEqual :: TypedNameOrigin -> TypedNameOrigin -> Bool.
  nameOriginEqual = \(left, right) -> case (left, right) {
    | (TypedCurrentModule, TypedCurrentModule) -> True
    | (TypedImportedModule leftPath, TypedImportedModule rightPath) -> textListEqual leftPath rightPath
    | (TypedAmbientPrelude, TypedAmbientPrelude) -> True
    | other -> False
  }.

  nameNamespaceEqual :: TypedNameNamespace -> TypedNameNamespace -> Bool.
  nameNamespaceEqual = \(left, right) -> case (left, right) {
    | (TypedValueNamespace, TypedValueNamespace) -> True
    | (TypedConstructorNamespace, TypedConstructorNamespace) -> True
    | (TypedTypeNamespace, TypedTypeNamespace) -> True
    | (TypedCapabilityNamespace, TypedCapabilityNamespace) -> True
    | other -> False
  }.

  generatedNameKindEqual :: TypedGeneratedNameKind -> TypedGeneratedNameKind -> Bool.
  generatedNameKindEqual = \(left, right) -> case (left, right) {
    | (TypedLambdaPatternArgument leftIndex, TypedLambdaPatternArgument rightIndex) -> leftIndex == rightIndex
    | (TypedOperatorBinding leftSymbol, TypedOperatorBinding rightSymbol) -> leftSymbol == rightSymbol
    | (TypedOperatorSectionFunction, TypedOperatorSectionFunction) -> True
    | (TypedOperatorSectionLeft, TypedOperatorSectionLeft) -> True
    | (TypedOperatorSectionRight, TypedOperatorSectionRight) -> True
    | other -> False
  }.

  coreNameEqual :: TypedCoreName -> TypedCoreName -> Bool.
  coreNameEqual = \(left, right) -> case (left, right) {
    | (TypedUnresolvedSourceName leftName, TypedUnresolvedSourceName rightName) -> leftName == rightName
    | (TypedUnresolvedQualifiedName leftQualifier leftName, TypedUnresolvedQualifiedName rightQualifier rightName) -> if leftQualifier == rightQualifier then leftName == rightName else False
    | (TypedResolvedName leftOrigin leftNamespace leftName, TypedResolvedName rightOrigin rightNamespace rightName) -> if nameOriginEqual leftOrigin rightOrigin then if nameNamespaceEqual leftNamespace rightNamespace then leftName == rightName else False else False
    | (TypedBuiltinName leftName, TypedBuiltinName rightName) -> leftName == rightName
    | (TypedGeneratedName leftKind, TypedGeneratedName rightKind) -> generatedNameKindEqual leftKind rightKind
    | other -> False
  }.

  typeParameterIdValue :: TypedTypeParameterId -> Int.
  typeParameterIdValue = \(parameterId) -> case parameterId {
    | TypedTypeParameterId value -> value
  }.

  typeParameterIdEqual :: TypedTypeParameterId -> TypedTypeParameterId -> Bool.
  typeParameterIdEqual = \(left, right) -> typeParameterIdValue left == typeParameterIdValue right.

  evidenceParameterIdValue :: TypedEvidenceParameterId -> Int.
  evidenceParameterIdValue = \(parameterId) -> case parameterId {
    | TypedEvidenceParameterId value -> value
  }.

  evidenceParameterIdEqual :: TypedEvidenceParameterId -> TypedEvidenceParameterId -> Bool.
  evidenceParameterIdEqual = \(left, right) -> evidenceParameterIdValue left == evidenceParameterIdValue right.

  binderIdEqual :: TypedBinderId -> TypedBinderId -> Bool.
  binderIdEqual = \(left, right) -> case (left, right) {
    | (TypedBinderId leftModule leftLexical leftName, TypedBinderId rightModule rightLexical rightName) -> if textListEqual leftModule rightModule then if intListEqual leftLexical rightLexical then coreNameEqual leftName rightName else False else False
  }.

  numericTypeEqual :: TypedNumericType -> TypedNumericType -> Bool.
  numericTypeEqual = \(left, right) -> case (left, right) {
    | (TypedInt8Type, TypedInt8Type) -> True
    | (TypedInt16Type, TypedInt16Type) -> True
    | (TypedInt32Type, TypedInt32Type) -> True
    | (TypedInt64Type, TypedInt64Type) -> True
    | (TypedUInt8Type, TypedUInt8Type) -> True
    | (TypedUInt16Type, TypedUInt16Type) -> True
    | (TypedUInt32Type, TypedUInt32Type) -> True
    | (TypedUInt64Type, TypedUInt64Type) -> True
    | (TypedFloat16Type, TypedFloat16Type) -> True
    | (TypedFloat32Type, TypedFloat32Type) -> True
    | (TypedFloat64Type, TypedFloat64Type) -> True
    | other -> False
  }.

  typeListEqual :: [TypedType] -> [TypedType] -> Bool.
  typeListEqual = \(left, right) -> case (left, right) {
    | ([], []) -> True
    | ([leftFirst | leftRest], [rightFirst | rightRest]) -> if typeEqual leftFirst rightFirst then typeListEqual leftRest rightRest else False
    | other -> False
  }.

  typeEqual :: TypedType -> TypedType -> Bool.
  typeEqual = \(left, right) -> case (left, right) {
    | (TypedIntType, TypedIntType) -> True
    | (TypedFloatType, TypedFloatType) -> True
    | (TypedNumericType leftNumeric, TypedNumericType rightNumeric) -> numericTypeEqual leftNumeric rightNumeric
    | (TypedBoolType, TypedBoolType) -> True
    | (TypedCharType, TypedCharType) -> True
    | (TypedTextType, TypedTextType) -> True
    | (TypedListType leftElement, TypedListType rightElement) -> typeEqual leftElement rightElement
    | (TypedTupleType leftElements, TypedTupleType rightElements) -> typeListEqual leftElements rightElements
    | (TypedDataType leftName leftArguments, TypedDataType rightName rightArguments) -> if coreNameEqual leftName rightName then typeListEqual leftArguments rightArguments else False
    | (TypedFunctionType leftArgument leftResult, TypedFunctionType rightArgument rightResult) -> if typeEqual leftArgument rightArgument then typeEqual leftResult rightResult else False
    | (TypedTypeParameterType leftId, TypedTypeParameterType rightId) -> typeParameterIdEqual leftId rightId
    | other -> False
  }.

  recipeListEqual :: [TypedRepresentationRecipe] -> [TypedRepresentationRecipe] -> Bool.
  recipeListEqual = \(left, right) -> case (left, right) {
    | ([], []) -> True
    | ([leftFirst | leftRest], [rightFirst | rightRest]) -> if recipeEqual leftFirst rightFirst then recipeListEqual leftRest rightRest else False
    | other -> False
  }.

  recipeEqual :: TypedRepresentationRecipe -> TypedRepresentationRecipe -> Bool.
  recipeEqual = \(left, right) -> case (left, right) {
    | (TypedUnitRecipe, TypedUnitRecipe) -> True
    | (TypedBoolRecipe, TypedBoolRecipe) -> True
    | (TypedSignedIntegerRecipe leftWidth, TypedSignedIntegerRecipe rightWidth) -> leftWidth == rightWidth
    | (TypedUnsignedIntegerRecipe leftWidth, TypedUnsignedIntegerRecipe rightWidth) -> leftWidth == rightWidth
    | (TypedFloatRecipe leftWidth, TypedFloatRecipe rightWidth) -> leftWidth == rightWidth
    | (TypedCharRecipe, TypedCharRecipe) -> True
    | (TypedManagedTextRecipe, TypedManagedTextRecipe) -> True
    | (TypedManagedListRecipe leftElement, TypedManagedListRecipe rightElement) -> recipeEqual leftElement rightElement
    | (TypedManagedProductRecipe leftElements, TypedManagedProductRecipe rightElements) -> recipeListEqual leftElements rightElements
    | (TypedManagedVariantRecipe leftName leftArguments, TypedManagedVariantRecipe rightName rightArguments) -> if coreNameEqual leftName rightName then typeListEqual leftArguments rightArguments else False
    | (TypedClosureRecipe leftParameters leftResult, TypedClosureRecipe rightParameters rightResult) -> if recipeListEqual leftParameters rightParameters then recipeEqual leftResult rightResult else False
    | (TypedRepresentationParameterRecipe leftId, TypedRepresentationParameterRecipe rightId) -> typeParameterIdEqual leftId rightId
    | other -> False
  }.

  capabilityConstraintEqual :: TypedCapabilityConstraint -> TypedCapabilityConstraint -> Bool.
  capabilityConstraintEqual = \(left, right) -> case (left, right) {
    | (TypedCapabilityConstraint leftCapability leftMethod leftType, TypedCapabilityConstraint rightCapability rightMethod rightType) -> if leftCapability == rightCapability then if leftMethod == rightMethod then typeEqual leftType rightType else False else False
  }.

  implIdEqual :: TypedImplId -> TypedImplId -> Bool.
  implIdEqual = \(left, right) -> case (left, right) {
    | (TypedImplId leftModule leftCapability leftArguments, TypedImplId rightModule rightCapability rightArguments) -> if textListEqual leftModule rightModule then if coreNameEqual leftCapability rightCapability then typeListEqual leftArguments rightArguments else False else False
  }.

  methodIdEqual :: TypedMethodId -> TypedMethodId -> Bool.
  methodIdEqual = \(left, right) -> case (left, right) {
    | (TypedMethodId leftImpl leftName, TypedMethodId rightImpl rightName) -> if implIdEqual leftImpl rightImpl then leftName == rightName else False
  }.

  typeParameterIdMember :: TypedTypeParameterId -> [TypedTypeParameterId] -> Bool.
  typeParameterIdMember = \(candidate, identifiers) -> case identifiers {
    | [] -> False
    | [first | rest] -> if typeParameterIdEqual candidate first then True else typeParameterIdMember candidate rest
  }.

  evidenceParameterIdMember :: TypedEvidenceParameterId -> [TypedEvidenceParameterId] -> Bool.
  evidenceParameterIdMember = \(candidate, identifiers) -> case identifiers {
    | [] -> False
    | [first | rest] -> if evidenceParameterIdEqual candidate first then True else evidenceParameterIdMember candidate rest
  }.

  binderIdMember :: TypedBinderId -> [TypedBinderId] -> Bool.
  binderIdMember = \(candidate, identifiers) -> case identifiers {
    | [] -> False
    | [first | rest] -> if binderIdEqual candidate first then True else binderIdMember candidate rest
  }.

  modulePathText :: [Text] -> Text.
  modulePathText = \(path) -> textJoin "::" path.

  coreNameIdentifier :: TypedCoreName -> Maybe(Text).
  coreNameIdentifier = \(name) -> case name {
    | TypedResolvedName origin namespace identifier -> Just identifier
    | TypedBuiltinName identifier -> Just identifier
    | other -> Nothing
  }.

  coreNameIdentifierEqual :: Text -> TypedCoreName -> Bool.
  coreNameIdentifierEqual = \(expected, name) -> case coreNameIdentifier name {
    | Nothing -> False
    | Just actual -> expected == actual
  }.

  originModulePath :: [Text] -> TypedNameOrigin -> [Text].
  originModulePath = \(currentModulePath, origin) -> case origin {
    | TypedCurrentModule -> currentModulePath
    | TypedImportedModule modulePath -> modulePath
    | TypedAmbientPrelude -> ["Prelude"]
  }.

  resolvedNameEntry :: [Text] -> TypedCoreName -> Maybe(NameEntry).
  resolvedNameEntry = \(currentModulePath, name) -> case name {
    | TypedResolvedName origin namespace identifier -> Just (NameEntry (originModulePath currentModulePath origin) namespace identifier)
    | other -> Nothing
  }.

  definitionNameEntry :: [Text] -> TypedCoreName -> Maybe(NameEntry).
  definitionNameEntry = \(modulePath, name) -> case name {
    | TypedResolvedName origin namespace identifier -> Just (NameEntry modulePath namespace identifier)
    | other -> Nothing
  }.

  nameEntryEqual :: NameEntry -> NameEntry -> Bool.
  nameEntryEqual = \(left, right) -> case (left, right) {
    | (NameEntry leftPath leftNamespace leftName, NameEntry rightPath rightNamespace rightName) ->
      if textListEqual leftPath rightPath then if nameNamespaceEqual leftNamespace rightNamespace then leftName == rightName else False else False
  }.

  nameEntryMember :: NameEntry -> [NameEntry] -> Bool.
  nameEntryMember = \(candidate, entries) -> case entries {
    | [] -> False
    | [first | rest] -> if nameEntryEqual candidate first then True else nameEntryMember candidate rest
  }.

  appendResolvedNameEntry :: [Text] -> TypedCoreName -> [NameEntry] -> [NameEntry].
  appendResolvedNameEntry = \(modulePath, name, entries) -> case resolvedNameEntry modulePath name {
    | Nothing -> entries
    | Just entry -> if nameEntryMember entry entries then entries else listAppend entries [entry]
  }.

  appendDefinitionNameEntry :: [Text] -> TypedCoreName -> [NameEntry] -> [NameEntry].
  appendDefinitionNameEntry = \(modulePath, name, entries) -> case definitionNameEntry modulePath name {
    | Nothing -> entries
    | Just entry -> if nameEntryMember entry entries then entries else listAppend entries [entry]
  }.

  implIdMember :: TypedImplId -> [TypedImplId] -> Bool.
  implIdMember = \(candidate, identifiers) -> case identifiers {
    | [] -> False
    | [first | rest] -> if implIdEqual candidate first then True else implIdMember candidate rest
  }.

  dataEntryMatches :: [Text] -> Text -> DataEntry -> Bool.
  dataEntryMatches = \(modulePath, identifier, entry) -> case entry {
    | DataEntry candidatePath candidateIdentifier arity -> if textListEqual modulePath candidatePath then identifier == candidateIdentifier else False
  }.

  lookupDataArity :: [Text] -> Text -> [DataEntry] -> Maybe(Int).
  lookupDataArity = \(modulePath, identifier, entries) -> case entries {
    | [] -> Nothing
    | [first | rest] -> if dataEntryMatches modulePath identifier first then case first {
      | DataEntry path name arity -> Just arity
    } else lookupDataArity modulePath identifier rest
  }.

  withTypeScope :: [TypedTypeParameterId] -> ModuleContext -> ModuleContext.
  withTypeScope = \(scope, context) -> case context {
    | ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries oldScope -> ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries scope
  }.

  withVisibleName :: TypedCoreName -> ModuleContext -> ModuleContext.
  withVisibleName = \(name, context) -> case context {
    | ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope -> ModuleContext modulePath visibleModules schemes statementIndices (appendResolvedNameEntry modulePath name visibleNames) visibleImpls dataEntries typeScope
  }.

  withVisibleNames :: [TypedCoreName] -> ModuleContext -> ModuleContext.
  withVisibleNames = \(names, context) -> case names {
    | [] -> context
    | [first | rest] -> withVisibleNames rest (withVisibleName first context)
  }.

  validateCoreName :: TypedCoreValidationPath -> TypedCoreName -> [TypedCoreValidationFailure].
  validateCoreName = \(path, name) -> case name {
    | TypedUnresolvedSourceName source -> [failure path TypedUnresolvedName (TypedNameDetail name)]
    | TypedUnresolvedQualifiedName qualifier member -> [failure path TypedUnresolvedName (TypedNameDetail name)]
    | other -> []
  }.

  validateVisibleName :: ModuleContext -> TypedCoreValidationPath -> TypedCoreName -> [TypedCoreValidationFailure].
  validateVisibleName = \(context, path, name) -> case context {
    | ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope -> listAppend
      (validateCoreName path name)
      (case resolvedNameEntry modulePath name {
        | Nothing -> []
        | Just entry -> if nameEntryMember entry visibleNames then [] else [failure path TypedInvisibleName (TypedNameDetail name)]
      })
  }.

  validateOperatorRef :: TypedCoreValidationPath -> TypedOperatorRef -> [TypedCoreValidationFailure].
  validateOperatorRef = \(path, operator) -> case operator {
    | TypedBuiltinOperator symbol -> []
    | TypedResolvedOperator name symbol -> validateCoreName path name
  }.

  numericRecipe :: TypedNumericType -> TypedRepresentationRecipe.
  numericRecipe = \(numericType) -> case numericType {
    | TypedInt8Type -> TypedSignedIntegerRecipe 8
    | TypedInt16Type -> TypedSignedIntegerRecipe 16
    | TypedInt32Type -> TypedSignedIntegerRecipe 32
    | TypedInt64Type -> TypedSignedIntegerRecipe 64
    | TypedUInt8Type -> TypedUnsignedIntegerRecipe 8
    | TypedUInt16Type -> TypedUnsignedIntegerRecipe 16
    | TypedUInt32Type -> TypedUnsignedIntegerRecipe 32
    | TypedUInt64Type -> TypedUnsignedIntegerRecipe 64
    | TypedFloat16Type -> TypedFloatRecipe 16
    | TypedFloat32Type -> TypedFloatRecipe 32
    | TypedFloat64Type -> TypedFloatRecipe 64
  }.

  flattenFunctionParameters :: TypedType -> [TypedType].
  flattenFunctionParameters = \(typeValue) -> case typeValue {
    | TypedFunctionType argument result -> listPrepend argument (flattenFunctionParameters result)
    | other -> []
  }.

  flattenFunctionResult :: TypedType -> TypedType.
  flattenFunctionResult = \(typeValue) -> case typeValue {
    | TypedFunctionType argument result -> flattenFunctionResult result
    | other -> other
  }.

  expectedRecipes :: [TypedType] -> Maybe([TypedRepresentationRecipe]).
  expectedRecipes = \(types) -> case types {
    | [] -> Just []
    | [first | rest] -> case (expectedRecipe first, expectedRecipes rest) {
      | (Just firstRecipe, Just restRecipes) -> Just (listPrepend firstRecipe restRecipes)
      | other -> Nothing
    }
  }.

  expectedRecipe :: TypedType -> Maybe(TypedRepresentationRecipe).
  expectedRecipe = \(typeValue) -> case typeValue {
    | TypedIntType -> Just (TypedSignedIntegerRecipe 64)
    | TypedFloatType -> Just (TypedFloatRecipe 64)
    | TypedNumericType numericType -> Just (numericRecipe numericType)
    | TypedBoolType -> Just TypedBoolRecipe
    | TypedCharType -> Just TypedCharRecipe
    | TypedTextType -> Just TypedManagedTextRecipe
    | TypedListType elementType -> case expectedRecipe elementType {
      | Nothing -> Nothing
      | Just elementRecipe -> Just (TypedManagedListRecipe elementRecipe)
    }
    | TypedTupleType elementTypes -> case elementTypes {
      | [] -> Just TypedUnitRecipe
      | other -> case expectedRecipes elementTypes {
        | Nothing -> Nothing
        | Just elementRecipes -> Just (TypedManagedProductRecipe elementRecipes)
      }
    }
    | TypedDataType name arguments -> Just (TypedManagedVariantRecipe name arguments)
    | TypedFunctionType argument result -> case (expectedRecipes (flattenFunctionParameters typeValue), expectedRecipe (flattenFunctionResult typeValue)) {
      | (Just parameterRecipes, Just resultRecipe) -> Just (TypedClosureRecipe parameterRecipes resultRecipe)
      | other -> Nothing
    }
    | TypedTypeParameterType parameterId -> Just (TypedRepresentationParameterRecipe parameterId)
  }.

  isFunctionType :: TypedType -> Bool.
  isFunctionType = \(typeValue) -> case typeValue {
    | TypedFunctionType argument result -> True
    | other -> False
  }.

  validSignedWidth :: Int -> Bool.
  validSignedWidth = \(width) -> if width == 8 then True else if width == 16 then True else if width == 32 then True else width == 64.

  validFloatWidth :: Int -> Bool.
  validFloatWidth = \(width) -> if width == 16 then True else if width == 32 then True else width == 64.

  invalidRecipeWidth :: TypedRepresentationRecipe -> Maybe(Int).
  invalidRecipeWidth = \(recipe) -> case recipe {
    | TypedSignedIntegerRecipe width -> if validSignedWidth width then Nothing else Just width
    | TypedUnsignedIntegerRecipe width -> if validSignedWidth width then Nothing else Just width
    | TypedFloatRecipe width -> if validFloatWidth width then Nothing else Just width
    | TypedManagedListRecipe elementRecipe -> invalidRecipeWidth elementRecipe
    | TypedManagedProductRecipe elementRecipes -> invalidRecipeWidths elementRecipes
    | TypedClosureRecipe parameters result -> case invalidRecipeWidths parameters {
      | Just width -> Just width
      | Nothing -> invalidRecipeWidth result
    }
    | other -> Nothing
  }.

  invalidRecipeWidths :: [TypedRepresentationRecipe] -> Maybe(Int).
  invalidRecipeWidths = \(recipes) -> case recipes {
    | [] -> Nothing
    | [first | rest] -> case invalidRecipeWidth first {
      | Just width -> Just width
      | Nothing -> invalidRecipeWidths rest
    }
  }.

  recipeWidthValid :: TypedRepresentationRecipe -> Bool.
  recipeWidthValid = \(recipe) -> case invalidRecipeWidth recipe {
    | Nothing -> True
    | Just width -> False
  }.

  hasUnboundTypeParameter :: [TypedTypeParameterId] -> TypedType -> Bool.
  hasUnboundTypeParameter = \(scope, typeValue) -> case typeValue {
    | TypedListType elementType -> hasUnboundTypeParameter scope elementType
    | TypedTupleType elementTypes -> anyUnboundTypes scope elementTypes
    | TypedDataType name arguments -> anyUnboundTypes scope arguments
    | TypedFunctionType argument result -> if hasUnboundTypeParameter scope argument then True else hasUnboundTypeParameter scope result
    | TypedTypeParameterType parameterId -> if typeParameterIdMember parameterId scope then False else True
    | other -> False
  }.

  anyUnboundTypes :: [TypedTypeParameterId] -> [TypedType] -> Bool.
  anyUnboundTypes = \(scope, types) -> case types {
    | [] -> False
    | [first | rest] -> if hasUnboundTypeParameter scope first then True else anyUnboundTypes scope rest
  }.

  hasUnboundRepresentationParameter :: [TypedTypeParameterId] -> TypedRepresentationRecipe -> Bool.
  hasUnboundRepresentationParameter = \(scope, recipe) -> case recipe {
    | TypedManagedListRecipe elementRecipe -> hasUnboundRepresentationParameter scope elementRecipe
    | TypedManagedProductRecipe elementRecipes -> anyUnboundRecipes scope elementRecipes
    | TypedClosureRecipe parameters result -> if anyUnboundRecipes scope parameters then True else hasUnboundRepresentationParameter scope result
    | TypedRepresentationParameterRecipe parameterId -> if typeParameterIdMember parameterId scope then False else True
    | other -> False
  }.

  anyUnboundRecipes :: [TypedTypeParameterId] -> [TypedRepresentationRecipe] -> Bool.
  anyUnboundRecipes = \(scope, recipes) -> case recipes {
    | [] -> False
    | [first | rest] -> if hasUnboundRepresentationParameter scope first then True else anyUnboundRecipes scope rest
  }.

  validateType :: TypedCoreValidationPath -> [TypedTypeParameterId] -> TypedType -> [TypedCoreValidationFailure].
  validateType = \(path, scope, typeValue) -> case typeValue {
    | TypedListType elementType -> validateType path scope elementType
    | TypedTupleType elementTypes -> validateTypes path scope elementTypes
    | TypedDataType name arguments -> listAppend (validateCoreName path name) (validateTypes path scope arguments)
    | TypedFunctionType argument result -> listAppend (validateType path scope argument) (validateType path scope result)
    | TypedTypeParameterType parameterId -> if typeParameterIdMember parameterId scope then [] else [failure path TypedUnboundTypeParameter (TypedTypeParameterDetail parameterId)]
    | other -> []
  }.

  validateTypes :: TypedCoreValidationPath -> [TypedTypeParameterId] -> [TypedType] -> [TypedCoreValidationFailure].
  validateTypes = \(path, scope, types) -> case types {
    | [] -> []
    | [first | rest] -> listAppend (validateType path scope first) (validateTypes path scope rest)
  }.

  validateRecipe :: TypedCoreValidationPath -> [TypedTypeParameterId] -> TypedRepresentationRecipe -> [TypedCoreValidationFailure].
  validateRecipe = \(path, scope, recipe) -> listAppend
    (case invalidRecipeWidth recipe {
      | Nothing -> []
      | Just width -> [failure path TypedInvalidRepresentationWidth (TypedIndexDetail width)]
    })
    (case recipe {
      | TypedManagedListRecipe elementRecipe -> validateRecipe path scope elementRecipe
      | TypedManagedProductRecipe elementRecipes -> validateRecipes path scope elementRecipes
      | TypedManagedVariantRecipe name arguments -> listAppend (validateCoreName path name) (validateTypes path scope arguments)
      | TypedClosureRecipe parameters result -> listAppend (validateRecipes path scope parameters) (validateRecipe path scope result)
      | TypedRepresentationParameterRecipe parameterId -> if typeParameterIdMember parameterId scope then [] else [failure path TypedUnboundRepresentationParameter (TypedTypeParameterDetail parameterId)]
      | other -> []
    }).

  validateRecipes :: TypedCoreValidationPath -> [TypedTypeParameterId] -> [TypedRepresentationRecipe] -> [TypedCoreValidationFailure].
  validateRecipes = \(path, scope, recipes) -> case recipes {
    | [] -> []
    | [first | rest] -> listAppend (validateRecipe path scope first) (validateRecipes path scope rest)
  }.

  validateTypeRecipe :: TypedCoreValidationPath -> [TypedTypeParameterId] -> TypedType -> TypedRepresentationRecipe -> [TypedCoreValidationFailure].
  validateTypeRecipe = \(path, scope, typeValue, recipe) -> if recipeWidthValid recipe then
    if hasUnboundTypeParameter scope typeValue then [] else
    if hasUnboundRepresentationParameter scope recipe then [] else case expectedRecipe typeValue {
      | Nothing -> []
      | Just expected -> if recipeEqual expected recipe then [] else
        [failure path (if isFunctionType typeValue then TypedCallableRecipeMismatch else TypedTypeRepresentationMismatch) (TypedRecipeDetail expected recipe)]
    }
  else [].

  validateCapabilityConstraint :: TypedCoreValidationPath -> [TypedTypeParameterId] -> TypedCapabilityConstraint -> [TypedCoreValidationFailure].
  validateCapabilityConstraint = \(path, scope, constraint) -> case constraint {
    | TypedCapabilityConstraint capability method targetType -> validateType path scope targetType
  }.

  validatePrimitiveConstraint :: TypedCoreValidationPath -> [TypedTypeParameterId] -> TypedPrimitiveConstraint -> [TypedCoreValidationFailure].
  validatePrimitiveConstraint = \(path, scope, constraint) -> case constraint {
    | TypedNumericPrimitiveConstraint numericConstraint typeValue -> validateType path scope typeValue
    | TypedStrictEqualityPrimitiveConstraint typeValue -> validateType path scope typeValue
  }.

  validatePrimitiveConstraints :: TypedCoreValidationPath -> [TypedTypeParameterId] -> [TypedPrimitiveConstraint] -> [TypedCoreValidationFailure].
  validatePrimitiveConstraints = \(path, scope, constraints) -> case constraints {
    | [] -> []
    | [first | rest] -> listAppend (validatePrimitiveConstraint path scope first) (validatePrimitiveConstraints path scope rest)
  }.

  duplicateTypeParameterFailuresFrom :: TypedCoreValidationPath -> [TypedTypeParameterId] -> [TypedTypeParameterId] -> [TypedCoreValidationFailure] -> [TypedCoreValidationFailure].
  duplicateTypeParameterFailuresFrom = \(path, parameters, seen, reversed) -> case parameters {
    | [] -> listReverse reversed
    | [first | rest] -> if typeParameterIdMember first seen then
      duplicateTypeParameterFailuresFrom path rest seen (listPrepend (failure path TypedDuplicateTypeParameter (TypedTypeParameterDetail first)) reversed)
    else duplicateTypeParameterFailuresFrom path rest (listPrepend first seen) reversed
  }.

  typeParameterOrderFailuresFrom :: TypedCoreValidationPath -> [TypedTypeParameterId] -> Int -> [TypedCoreValidationFailure].
  typeParameterOrderFailuresFrom = \(path, parameters, index) -> case parameters {
    | [] -> []
    | [first | rest] -> listAppend
      (if typeParameterIdValue first == index then [] else [failure path TypedInvalidTypeParameterOrder (TypedIndexDetail index)])
      (typeParameterOrderFailuresFrom path rest (index + 1))
  }.

  validateOrderedTypeParameters :: TypedCoreValidationPath -> [TypedTypeParameterId] -> [TypedCoreValidationFailure].
  validateOrderedTypeParameters = \(path, parameters) -> listAppend
    (duplicateTypeParameterFailuresFrom path parameters [] [])
    (typeParameterOrderFailuresFrom path parameters 0).

  evidenceParameterIds :: [TypedEvidenceParameter] -> [TypedEvidenceParameterId].
  evidenceParameterIds = \(parameters) -> case parameters {
    | [] -> []
    | [TypedEvidenceParameter parameterId constraint | rest] -> listPrepend parameterId (evidenceParameterIds rest)
  }.

  duplicateEvidenceParameterFailuresFrom :: TypedCoreValidationPath -> [TypedEvidenceParameterId] -> [TypedEvidenceParameterId] -> [TypedCoreValidationFailure] -> [TypedCoreValidationFailure].
  duplicateEvidenceParameterFailuresFrom = \(path, parameters, seen, reversed) -> case parameters {
    | [] -> listReverse reversed
    | [first | rest] -> if evidenceParameterIdMember first seen then
      duplicateEvidenceParameterFailuresFrom path rest seen (listPrepend (failure path TypedDuplicateEvidenceParameter (TypedEvidenceParameterDetail first)) reversed)
    else duplicateEvidenceParameterFailuresFrom path rest (listPrepend first seen) reversed
  }.

  evidenceParameterOrderFailuresFrom :: TypedCoreValidationPath -> [TypedEvidenceParameter] -> Int -> [TypedCoreValidationFailure].
  evidenceParameterOrderFailuresFrom = \(path, parameters, index) -> case parameters {
    | [] -> []
    | [TypedEvidenceParameter parameterId constraint | rest] -> listAppend
      (if evidenceParameterIdValue parameterId == index then [] else [failure path TypedInvalidEvidenceParameterOrder (TypedIndexDetail index)])
      (evidenceParameterOrderFailuresFrom path rest (index + 1))
  }.

  validateEvidenceParameters :: TypedCoreValidationPath -> [TypedTypeParameterId] -> [TypedEvidenceParameter] -> [TypedCoreValidationFailure].
  validateEvidenceParameters = \(path, scope, parameters) -> case parameters {
    | [] -> []
    | [TypedEvidenceParameter parameterId constraint | rest] -> listAppend (validateCapabilityConstraint path scope constraint) (validateEvidenceParameters path scope rest)
  }.

  validateOrderedEvidenceParameters :: TypedCoreValidationPath -> [TypedEvidenceParameter] -> [TypedCoreValidationFailure].
  validateOrderedEvidenceParameters = \(path, parameters) -> listAppend
    (duplicateEvidenceParameterFailuresFrom path (evidenceParameterIds parameters) [] [])
    (evidenceParameterOrderFailuresFrom path parameters 0).

  validateScheme :: TypedCoreValidationPath -> TypedBinderId -> TypedScheme -> [TypedCoreValidationFailure].
  validateScheme = \(path, owner, scheme) -> case scheme {
    | TypedScheme schemeOwner typeParameters evidenceParameters primitiveConstraints resultType resultRecipe -> listConcat
      [ if binderIdEqual owner schemeOwner then [] else [failure path TypedUnknownBinder (TypedBinderDetail schemeOwner)],
        validateOrderedTypeParameters path typeParameters,
        validateOrderedEvidenceParameters path evidenceParameters,
        validateEvidenceParameters path typeParameters evidenceParameters,
        validatePrimitiveConstraints path typeParameters primitiveConstraints,
        validateType path typeParameters resultType,
        validateRecipe path typeParameters resultRecipe,
        validateTypeRecipe path typeParameters resultType resultRecipe
      ]
  }.

  implModulePath :: TypedImplId -> [Text].
  implModulePath = \(implId) -> case implId {
    | TypedImplId modulePath capability arguments -> modulePath
  }.

  implTargetTypes :: TypedImplId -> [TypedType].
  implTargetTypes = \(implId) -> case implId {
    | TypedImplId modulePath capability arguments -> arguments
  }.

  validateImplId :: TypedCoreValidationPath -> [TypedTypeParameterId] -> TypedImplId -> [TypedCoreValidationFailure].
  validateImplId = \(path, scope, implId) -> case implId {
    | TypedImplId modulePath capability arguments -> listAppend (validateCoreName path capability) (validateTypes path scope arguments)
  }.

  validateMethodId :: TypedCoreValidationPath -> [TypedTypeParameterId] -> TypedMethodId -> [TypedCoreValidationFailure].
  validateMethodId = \(path, scope, methodId) -> case methodId {
    | TypedMethodId implId methodName -> validateImplId path scope implId
  }.

  lookupScheme :: TypedBinderId -> [SchemeEntry] -> Maybe(TypedScheme).
  lookupScheme = \(candidate, entries) -> case entries {
    | [] -> Nothing
    | [SchemeEntry binderId scheme | rest] -> if binderIdEqual candidate binderId then Just scheme else lookupScheme candidate rest
  }.

  typeArgumentIds :: [TypedTypeArgument] -> [TypedTypeParameterId].
  typeArgumentIds = \(arguments) -> case arguments {
    | [] -> []
    | [TypedTypeArgument parameterId typeValue | rest] -> listPrepend parameterId (typeArgumentIds rest)
  }.

  typeParameterIdListEqual :: [TypedTypeParameterId] -> [TypedTypeParameterId] -> Bool.
  typeParameterIdListEqual = \(left, right) -> case (left, right) {
    | ([], []) -> True
    | ([leftFirst | leftRest], [rightFirst | rightRest]) -> if typeParameterIdEqual leftFirst rightFirst then typeParameterIdListEqual leftRest rightRest else False
    | other -> False
  }.

  validateTypeArguments :: TypedCoreValidationPath -> [TypedTypeArgument] -> [TypedCoreValidationFailure].
  validateTypeArguments = \(path, arguments) -> case arguments {
    | [] -> []
    | [TypedTypeArgument parameterId typeValue | rest] -> listAppend (validateType path [] typeValue) (validateTypeArguments path rest)
  }.

  schemeTypeParameters :: TypedScheme -> [TypedTypeParameterId].
  schemeTypeParameters = \(scheme) -> case scheme {
    | TypedScheme owner typeParameters evidence primitive resultType resultRecipe -> typeParameters
  }.

  validateInstantiation :: ModuleContext -> TypedCoreValidationPath -> TypedInstantiation -> [TypedCoreValidationFailure].
  validateInstantiation = \(context, path, instantiation) -> case (context, instantiation) {
    | (ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope, TypedInstantiation owner arguments explicitSpan) -> case lookupScheme owner schemes {
      | Nothing -> [failure path TypedInstantiationMismatch (TypedBinderDetail owner)]
      | Just scheme -> if typeParameterIdListEqual (typeArgumentIds arguments) (schemeTypeParameters scheme) then validateTypeArguments path arguments else [failure path TypedInstantiationMismatch (TypedBinderDetail owner)]
    }
  }.

  validateInstantiations :: ModuleContext -> TypedCoreValidationPath -> [TypedInstantiation] -> [TypedCoreValidationFailure].
  validateInstantiations = \(context, path, instantiations) -> case instantiations {
    | [] -> []
    | [first | rest] -> listAppend (validateInstantiation context path first) (validateInstantiations context path rest)
  }.

  validateEvidenceCandidate :: TypedCoreValidationPath -> TypedType -> TypedEvidenceCandidate -> [TypedCoreValidationFailure].
  validateEvidenceCandidate = \(path, targetType, candidate) -> case candidate {
    | TypedEvidenceCandidate implId maybeMethod -> listConcat
      [ validateImplId path [] implId,
        case implTargetTypes implId {
          | [first | rest] -> if typeEqual first targetType then [] else [failure path TypedMethodSelectionMismatch (TypedTypeDetail targetType first)]
          | [] -> []
        },
        case maybeMethod {
          | Nothing -> []
          | Just methodId -> validateMethodId path [] methodId
        }
      ]
  }.

  validateEvidenceCandidates :: TypedCoreValidationPath -> TypedType -> [TypedEvidenceCandidate] -> [TypedCoreValidationFailure].
  validateEvidenceCandidates = \(path, targetType, candidates) -> case candidates {
    | [] -> []
    | [first | rest] -> listAppend (validateEvidenceCandidate path targetType first) (validateEvidenceCandidates path targetType rest)
  }.

  lastText :: [Text] -> Text.
  lastText = \(values) -> case values {
    | [] -> ""
    | [first] -> first
    | [first | rest] -> lastText rest
  }.

  methodKeyMatches :: Text -> Text -> Bool.
  methodKeyMatches = \(expected, actual) -> if expected == actual then True else lastText (textSplit "." expected) == actual.

  evidenceMethodFailures :: TypedCoreValidationPath -> Maybe(Text) -> TypedImplId -> Maybe(TypedMethodId) -> [TypedCoreValidationFailure].
  evidenceMethodFailures = \(path, constraintMethod, implId, maybeMethod) -> case (constraintMethod, maybeMethod) {
    | (Nothing, Nothing) -> []
    | (Nothing, Just methodId) -> case methodId {
      | TypedMethodId methodImpl methodName -> listConcat
        [ validateMethodId path [] methodId,
          if implIdEqual methodImpl implId then [] else [failure path TypedMethodSelectionMismatch (TypedImplDetail methodImpl)],
          [failure path TypedMethodSelectionMismatch (TypedTextDetail methodName)]
        ]
    }
    | (Just expectedMethod, Nothing) -> [failure path TypedMethodSelectionMismatch (TypedTextDetail expectedMethod)]
    | (Just expectedMethod, Just methodId) -> case methodId {
      | TypedMethodId methodImpl methodName -> listConcat
        [ validateMethodId path [] methodId,
          if implIdEqual methodImpl implId then [] else [failure path TypedMethodSelectionMismatch (TypedImplDetail methodImpl)],
          if methodKeyMatches expectedMethod methodName then [] else [failure path TypedMethodSelectionMismatch (TypedTextDetail expectedMethod)]
        ]
    }
  }.

  validateEvidenceUse :: ModuleContext -> TypedCoreValidationPath -> TypedEvidenceUse -> [TypedCoreValidationFailure].
  validateEvidenceUse = \(context, path, evidenceUse) -> case (context, evidenceUse) {
    | (ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope, TypedEvidenceUse parameterId constraint implId maybeMethod) -> case (constraint, implId) {
      | (TypedCapabilityConstraint capability constraintMethod targetType, TypedImplId implPath capabilityName targetTypes) -> listConcat
        [ validateCapabilityConstraint path [] constraint,
          validateImplId path [] implId,
          if coreNameIdentifierEqual capability capabilityName then [] else [failure path TypedMethodSelectionMismatch (TypedTextDetail capability)],
          case targetTypes {
            | [] -> [failure path TypedMethodSelectionMismatch (TypedArityDetail 1 0)]
            | [first | rest] -> if typeEqual first targetType then [] else [failure path TypedMethodSelectionMismatch (TypedTypeDetail targetType first)]
          },
          if textListEqual implPath ["Prelude"] then [] else if implIdMember implId visibleImpls then [] else [failure path TypedInvisibleImpl (TypedImplDetail implId)],
          evidenceMethodFailures path constraintMethod implId maybeMethod
        ]
      }
  }.

  selectedEvidenceParameterIds :: [TypedEvidenceSelection] -> [TypedEvidenceParameterId].
  selectedEvidenceParameterIds = \(selections) -> case selections {
    | [] -> []
    | [first | rest] -> case first {
      | TypedSelectedEvidence evidenceUse -> case evidenceUse {
        | TypedEvidenceUse maybeParameter constraint implId maybeMethod -> case maybeParameter {
          | Nothing -> selectedEvidenceParameterIds rest
          | Just parameterId -> listPrepend parameterId (selectedEvidenceParameterIds rest)
        }
      }
      | other -> selectedEvidenceParameterIds rest
    }
  }.

  duplicateEvidenceUseFailuresFrom :: TypedCoreValidationPath -> [TypedEvidenceParameterId] -> [TypedEvidenceParameterId] -> [TypedCoreValidationFailure] -> [TypedCoreValidationFailure].
  duplicateEvidenceUseFailuresFrom = \(path, parameterIds, seen, reversed) -> case parameterIds {
    | [] -> listReverse reversed
    | [first | rest] -> if evidenceParameterIdMember first seen then
      duplicateEvidenceUseFailuresFrom path rest seen (listPrepend (failure path TypedDuplicateEvidence (TypedEvidenceParameterDetail first)) reversed)
    else duplicateEvidenceUseFailuresFrom path rest (listPrepend first seen) reversed
  }.

  validateEvidenceSelection :: ModuleContext -> TypedCoreValidationPath -> TypedType -> TypedEvidenceSelection -> [TypedCoreValidationFailure].
  validateEvidenceSelection = \(context, path, expressionType, selection) -> case selection {
    | TypedSelectedEvidence evidenceUse -> validateEvidenceUse context path evidenceUse
    | TypedEvidenceCandidates constraint candidates -> case constraint {
      | TypedCapabilityConstraint capability method targetType -> if listLength candidates == 0 then [failure path TypedMissingEvidence (TypedTextDetail capability)] else
        if listLength candidates > 1 then if isFunctionType expressionType then validateEvidenceCandidates path targetType candidates else
          [failure path TypedAmbiguousEvidence (TypedArityDetail 1 (listLength candidates))]
        else validateEvidenceCandidates path targetType candidates
    }
  }.

  validateEvidenceSelectionsOnly :: ModuleContext -> TypedCoreValidationPath -> TypedType -> [TypedEvidenceSelection] -> [TypedCoreValidationFailure].
  validateEvidenceSelectionsOnly = \(context, path, expressionType, selections) -> case selections {
    | [] -> []
    | [first | rest] -> listAppend (validateEvidenceSelection context path expressionType first) (validateEvidenceSelectionsOnly context path expressionType rest)
  }.

  validateEvidenceSelections :: ModuleContext -> TypedCoreValidationPath -> TypedType -> [TypedEvidenceSelection] -> [TypedCoreValidationFailure].
  validateEvidenceSelections = \(context, path, expressionType, selections) -> listAppend
    (validateEvidenceSelectionsOnly context path expressionType selections)
    (duplicateEvidenceUseFailuresFrom path (selectedEvidenceParameterIds selections) [] []).

  validateDataTypeApplications :: ModuleContext -> TypedCoreValidationPath -> TypedType -> [TypedCoreValidationFailure].
  validateDataTypeApplications = \(context, path, typeValue) -> case context {
    | ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope -> case typeValue {
      | TypedListType elementType -> validateDataTypeApplications context path elementType
      | TypedTupleType elementTypes -> listConcat (listMap (\(elementType) -> validateDataTypeApplications context path elementType) elementTypes)
      | TypedDataType name arguments -> listAppend
        (listConcat (listMap (\(argument) -> validateDataTypeApplications context path argument) arguments))
        (case name {
          | TypedResolvedName origin namespace identifier -> case lookupDataArity (originModulePath modulePath origin) identifier dataEntries {
            | Nothing -> [failure path TypedDataTypeMismatch (TypedNameDetail name)]
            | Just expectedArity -> if expectedArity == listLength arguments then [] else [failure path TypedDataTypeMismatch (TypedArityDetail expectedArity (listLength arguments))]
          }
          | other -> [failure path TypedDataTypeMismatch (TypedNameDetail name)]
        })
      | TypedFunctionType argument result -> listAppend (validateDataTypeApplications context path argument) (validateDataTypeApplications context path result)
      | other -> []
    }
  }.

  validateImplDataTypes :: ModuleContext -> TypedCoreValidationPath -> TypedImplId -> [TypedCoreValidationFailure].
  validateImplDataTypes = \(context, path, implId) -> case implId {
    | TypedImplId modulePath capability arguments -> listConcat (listMap (\(argument) -> validateDataTypeApplications context path argument) arguments)
  }.

  validateMaybeMethodDataTypes :: ModuleContext -> TypedCoreValidationPath -> Maybe(TypedMethodId) -> [TypedCoreValidationFailure].
  validateMaybeMethodDataTypes = \(context, path, maybeMethod) -> case maybeMethod {
    | Nothing -> []
    | Just methodId -> case methodId {
      | TypedMethodId implId methodName -> validateImplDataTypes context path implId
    }
  }.

  validateEvidenceCandidateDataTypes :: ModuleContext -> TypedCoreValidationPath -> [TypedEvidenceCandidate] -> [TypedCoreValidationFailure].
  validateEvidenceCandidateDataTypes = \(context, path, candidates) -> case candidates {
    | [] -> []
    | [TypedEvidenceCandidate implId maybeMethod | rest] -> listConcat
      [ validateImplDataTypes context path implId,
        validateMaybeMethodDataTypes context path maybeMethod,
        validateEvidenceCandidateDataTypes context path rest
      ]
  }.

  validateEvidenceSelectionDataTypes :: ModuleContext -> TypedCoreValidationPath -> TypedEvidenceSelection -> [TypedCoreValidationFailure].
  validateEvidenceSelectionDataTypes = \(context, path, selection) -> case selection {
    | TypedSelectedEvidence evidenceUse -> case evidenceUse {
      | TypedEvidenceUse parameterId constraint implId maybeMethod -> case constraint {
        | TypedCapabilityConstraint capability method targetType -> listConcat
          [ validateDataTypeApplications context path targetType,
            validateImplDataTypes context path implId,
            validateMaybeMethodDataTypes context path maybeMethod
          ]
      }
    }
    | TypedEvidenceCandidates constraint candidates -> case constraint {
      | TypedCapabilityConstraint capability method targetType -> listAppend
        (validateDataTypeApplications context path targetType)
        (validateEvidenceCandidateDataTypes context path candidates)
    }
  }.

  validateNodeInfo :: ModuleContext -> TypedCoreValidationPath -> [TypedTypeParameterId] -> TypedNodeInfo -> [TypedCoreValidationFailure].
  validateNodeInfo = \(context, path, scope, info) -> case info {
    | TypedNodeInfo typeValue recipe instantiations evidence -> listConcat
      [ validateType path scope typeValue,
        validateDataTypeApplications context path typeValue,
        validateRecipe path scope recipe,
        validateTypeRecipe path scope typeValue recipe,
        validateInstantiations context path instantiations,
        validateEvidenceSelections context path typeValue evidence,
        listConcat (listMap (\(selection) -> validateEvidenceSelectionDataTypes context path selection) evidence)
      ]
  }.

  nodeType :: TypedNodeInfo -> TypedType.
  nodeType = \(info) -> case info {
    | TypedNodeInfo typeValue recipe instantiations evidence -> typeValue
  }.

  nodeRecipe :: TypedNodeInfo -> TypedRepresentationRecipe.
  nodeRecipe = \(info) -> case info {
    | TypedNodeInfo typeValue recipe instantiations evidence -> recipe
  }.

  expressionInfo :: TypedExpr -> TypedNodeInfo.
  expressionInfo = \(expression) -> case expression {
    | TypedLiteralExpr info literal -> info
    | TypedVariableExpr info name -> info
    | TypedLambdaExpr info binder name body -> info
    | TypedOperatorValueExpr info operator -> info
    | TypedListExpr info expressions -> info
    | TypedTupleExpr info expressions -> info
    | TypedApplyExpr info function argument -> info
    | TypedTypeApplicationExpr info function span typeArgument -> info
    | TypedIfExpr info condition thenExpression elseExpression -> info
    | TypedPatternCaseExpr info scrutinee arms -> info
    | TypedBinaryExpr info operator left right -> info
    | TypedLeftSectionExpr info left operator -> info
    | TypedRightSectionExpr info operator right -> info
    | TypedBlockExpr info statements -> info
  }.

  nestedExpressionListLocations :: [Int] -> [Int] -> [TypedExpr] -> Int -> [[Int]].
  nestedExpressionListLocations = \(statementLocation, parentPath, expressions, childIndex) -> case expressions {
    | [] -> []
    | [first | rest] -> listAppend
      (nestedExpressionLocations statementLocation (listAppend parentPath [childIndex]) first)
      (nestedExpressionListLocations statementLocation parentPath rest (childIndex + 1))
  }.

  nestedCaseArmExpressionLocations :: [Int] -> [Int] -> [TypedCaseArm] -> Int -> [[Int]].
  nestedCaseArmExpressionLocations = \(statementLocation, parentPath, arms, childIndex) -> case arms {
    | [] -> []
    | [TypedCaseArm pattern maybeGuard result | rest] -> case maybeGuard {
      | Nothing -> listAppend
        (nestedExpressionLocations statementLocation (listAppend parentPath [childIndex]) result)
        (nestedCaseArmExpressionLocations statementLocation parentPath rest (childIndex + 1))
      | Just guard -> listConcat
        [ nestedExpressionLocations statementLocation (listAppend parentPath [childIndex]) guard,
          nestedExpressionLocations statementLocation (listAppend parentPath [childIndex + 1]) result,
          nestedCaseArmExpressionLocations statementLocation parentPath rest (childIndex + 2)
        ]
    }
  }.

  nestedBlockStatementLocations :: [Int] -> [Int] -> [TypedStatement] -> Int -> [[Int]].
  nestedBlockStatementLocations = \(statementLocation, expressionPath, statements, blockIndex) -> case statements {
    | [] -> []
    | [first | rest] -> {
      location = nestedStatementLocation statementLocation expressionPath blockIndex.
      listConcat
        [ [location],
          nestedStatementLocations location first,
          nestedBlockStatementLocations statementLocation expressionPath rest (blockIndex + 1)
        ].
    }
  }.

  nestedExpressionLocations :: [Int] -> [Int] -> TypedExpr -> [[Int]].
  nestedExpressionLocations = \(statementLocation, expressionPath, expression) -> case expression {
    | TypedLambdaExpr info binder name body -> nestedExpressionLocations statementLocation (listAppend expressionPath [0]) body
    | TypedListExpr info expressions -> nestedExpressionListLocations statementLocation expressionPath expressions 0
    | TypedTupleExpr info expressions -> nestedExpressionListLocations statementLocation expressionPath expressions 0
    | TypedApplyExpr info function argument -> listAppend
      (nestedExpressionLocations statementLocation (listAppend expressionPath [0]) function)
      (nestedExpressionLocations statementLocation (listAppend expressionPath [1]) argument)
    | TypedTypeApplicationExpr info function span typeArgument -> nestedExpressionLocations statementLocation (listAppend expressionPath [0]) function
    | TypedIfExpr info condition thenExpression elseExpression -> listConcat
      [ nestedExpressionLocations statementLocation (listAppend expressionPath [0]) condition,
        nestedExpressionLocations statementLocation (listAppend expressionPath [1]) thenExpression,
        nestedExpressionLocations statementLocation (listAppend expressionPath [2]) elseExpression
      ]
    | TypedPatternCaseExpr info scrutinee arms -> listAppend
      (nestedExpressionLocations statementLocation (listAppend expressionPath [0]) scrutinee)
      (nestedCaseArmExpressionLocations statementLocation expressionPath arms 1)
    | TypedBinaryExpr info operator left right -> listAppend
      (nestedExpressionLocations statementLocation (listAppend expressionPath [0]) left)
      (nestedExpressionLocations statementLocation (listAppend expressionPath [1]) right)
    | TypedLeftSectionExpr info left operator -> nestedExpressionLocations statementLocation (listAppend expressionPath [0]) left
    | TypedRightSectionExpr info operator right -> nestedExpressionLocations statementLocation (listAppend expressionPath [0]) right
    | TypedBlockExpr info statements -> nestedBlockStatementLocations statementLocation expressionPath statements 0
    | other -> []
  }.

  nestedMethodStatementLocations :: [Int] -> [TypedMethodDefinition] -> Int -> [[Int]].
  nestedMethodStatementLocations = \(statementLocation, methods, methodIndex) -> case methods {
    | [] -> []
    | [TypedMethodDefinition methodId binder name span expression | rest] -> listAppend
      (nestedExpressionLocations statementLocation [methodIndex] expression)
      (nestedMethodStatementLocations statementLocation rest (methodIndex + 1))
  }.

  nestedStatementLocations :: [Int] -> TypedStatement -> [[Int]].
  nestedStatementLocations = \(statementLocation, statement) -> case statement {
    | TypedLetStatement binder name span scheme expression -> nestedExpressionLocations statementLocation [0] expression
    | TypedImplStatement declaration -> case declaration {
      | TypedImplDeclaration span implId methods -> nestedMethodStatementLocations statementLocation methods 0
    }
    | TypedExpressionStatement span expression -> nestedExpressionLocations statementLocation [0] expression
    | other -> []
  }.

  topLevelStatementLocations :: [TypedStatement] -> Int -> [[Int]].
  topLevelStatementLocations = \(statements, statementIndex) -> case statements {
    | [] -> []
    | [first | rest] -> listPrepend [statementIndex] (topLevelStatementLocations rest (statementIndex + 1))
  }.

  allNestedStatementLocations :: [TypedStatement] -> Int -> [[Int]].
  allNestedStatementLocations = \(statements, statementIndex) -> case statements {
    | [] -> []
    | [first | rest] -> listAppend
      (nestedStatementLocations [statementIndex] first)
      (allNestedStatementLocations rest (statementIndex + 1))
  }.

  assignStatementIndices :: [[Int]] -> Int -> [StatementIndexEntry].
  assignStatementIndices = \(locations, statementIndex) -> case locations {
    | [] -> []
    | [first | rest] -> listPrepend (StatementIndexEntry first statementIndex) (assignStatementIndices rest (statementIndex + 1))
  }.

  statementIndexEntries :: [TypedStatement] -> [StatementIndexEntry].
  statementIndexEntries = \(statements) ->
    assignStatementIndices (listAppend (topLevelStatementLocations statements 0) (allNestedStatementLocations statements 0)) 0.

  patternInfo :: TypedPattern -> TypedNodeInfo.
  patternInfo = \(pattern) -> case pattern {
    | TypedWildcardPattern info -> info
    | TypedVariablePattern info binder name -> info
    | TypedLiteralPattern info literal -> info
    | TypedConstructorPattern info name patterns -> info
    | TypedListPattern info patterns -> info
    | TypedConsListPattern info headPattern tailPattern -> info
    | TypedTuplePattern info patterns -> info
    | TypedAsPattern info binder name nested -> info
    | TypedOrPattern info alternatives -> info
  }.

  patternBinderContract :: TypedPattern -> [PatternBinderContract].
  patternBinderContract = \(pattern) -> case pattern {
    | TypedVariablePattern info binder name -> [PatternBinderContract binder (nodeType info) (nodeRecipe info)]
    | TypedConstructorPattern info name patterns -> patternBinderContracts patterns
    | TypedListPattern info patterns -> patternBinderContracts patterns
    | TypedConsListPattern info headPattern tailPattern -> listAppend (patternBinderContract headPattern) (patternBinderContract tailPattern)
    | TypedTuplePattern info patterns -> patternBinderContracts patterns
    | TypedAsPattern info binder name nested -> listPrepend (PatternBinderContract binder (nodeType info) (nodeRecipe info)) (patternBinderContract nested)
    | TypedOrPattern info alternatives -> case alternatives {
      | [] -> []
      | [first | rest] -> patternBinderContract first
    }
    | other -> []
  }.

  patternBinderContracts :: [TypedPattern] -> [PatternBinderContract].
  patternBinderContracts = \(patterns) -> case patterns {
    | [] -> []
    | [first | rest] -> listAppend (patternBinderContract first) (patternBinderContracts rest)
  }.

  patternBinderContractEqual :: PatternBinderContract -> PatternBinderContract -> Bool.
  patternBinderContractEqual = \(left, right) -> case (left, right) {
    | (PatternBinderContract leftBinder leftType leftRecipe, PatternBinderContract rightBinder rightType rightRecipe) -> if binderIdEqual leftBinder rightBinder then if typeEqual leftType rightType then recipeEqual leftRecipe rightRecipe else False else False
  }.

  patternBinderContractListEqual :: [PatternBinderContract] -> [PatternBinderContract] -> Bool.
  patternBinderContractListEqual = \(left, right) -> case (left, right) {
    | ([], []) -> True
    | ([leftFirst | leftRest], [rightFirst | rightRest]) -> if patternBinderContractEqual leftFirst rightFirst then patternBinderContractListEqual leftRest rightRest else False
    | other -> False
  }.

  mismatchedPatternBinder :: [PatternBinderContract] -> [PatternBinderContract] -> Maybe(TypedBinderId).
  mismatchedPatternBinder = \(expected, actual) -> case (expected, actual) {
    | ([], []) -> Nothing
    | ([], [PatternBinderContract binder typeValue recipe | rest]) -> Just binder
    | ([first | rest], []) -> Nothing
    | ([expectedFirst | expectedRest], [actualFirst | actualRest]) -> if patternBinderContractEqual expectedFirst actualFirst then mismatchedPatternBinder expectedRest actualRest else case actualFirst {
      | PatternBinderContract binder typeValue recipe -> Just binder
    }
  }.

  validateOrAlternatives :: TypedCoreValidationPath -> [PatternBinderContract] -> [TypedPattern] -> [TypedCoreValidationFailure].
  validateOrAlternatives = \(path, expected, alternatives) -> case alternatives {
    | [] -> []
    | [first | rest] -> listAppend
      (if patternBinderContractListEqual expected (patternBinderContract first) then [] else case mismatchedPatternBinder expected (patternBinderContract first) {
        | Nothing -> [failure path TypedOrPatternBinderMismatch TypedNoValidationDetail]
        | Just binder -> [failure path TypedOrPatternBinderMismatch (TypedBinderDetail binder)]
      })
      (validateOrAlternatives path expected rest)
  }.

  validateOrPattern :: TypedCoreValidationPath -> [TypedPattern] -> [TypedCoreValidationFailure].
  validateOrPattern = \(path, alternatives) -> case alternatives {
    | [] -> []
    | [first | rest] -> validateOrAlternatives path (patternBinderContract first) rest
  }.

  validatePatternChildren :: ModuleContext -> Int -> [Int] -> TypedPattern -> [TypedCoreValidationFailure].
  validatePatternChildren = \(context, statementIndex, patternPath, pattern) -> case pattern {
    | TypedConstructorPattern info name patterns -> validatePatternChildrenUsingOwnTypes context statementIndex patternPath patterns 0
    | TypedListPattern info patterns -> case nodeType info {
      | TypedListType elementType -> validatePatterns context statementIndex patternPath elementType patterns 0
      | other -> validatePatternChildrenUsingOwnTypes context statementIndex patternPath patterns 0
    }
    | TypedConsListPattern info headPattern tailPattern -> case nodeType info {
      | TypedListType elementType -> listAppend
        (validatePattern context statementIndex (listAppend patternPath [0]) elementType headPattern)
        (validatePattern context statementIndex (listAppend patternPath [1]) (nodeType info) tailPattern)
      | other -> listAppend
        (validatePattern context statementIndex (listAppend patternPath [0]) other headPattern)
        (validatePattern context statementIndex (listAppend patternPath [1]) other tailPattern)
    }
    | TypedTuplePattern info patterns -> case nodeType info {
      | TypedTupleType types -> validatePatternTypePairs context statementIndex patternPath (listZip types patterns) 0
      | other -> validatePatternChildrenUsingOwnTypes context statementIndex patternPath patterns 0
    }
    | TypedAsPattern info binder name nested -> validatePattern context statementIndex (listAppend patternPath [0]) (nodeType info) nested
    | TypedOrPattern info alternatives -> validatePatterns context statementIndex patternPath (nodeType info) alternatives 0
    | other -> []
  }.

  validatePatterns :: ModuleContext -> Int -> [Int] -> TypedType -> [TypedPattern] -> Int -> [TypedCoreValidationFailure].
  validatePatterns = \(context, statementIndex, parentPath, expectedType, patterns, index) -> case patterns {
    | [] -> []
    | [first | rest] -> listAppend
      (validatePattern context statementIndex (listAppend parentPath [index]) expectedType first)
      (validatePatterns context statementIndex parentPath expectedType rest (index + 1))
  }.

  validatePatternChildrenUsingOwnTypes :: ModuleContext -> Int -> [Int] -> [TypedPattern] -> Int -> [TypedCoreValidationFailure].
  validatePatternChildrenUsingOwnTypes = \(context, statementIndex, parentPath, patterns, index) -> case patterns {
    | [] -> []
    | [first | rest] -> listAppend
      (validatePattern context statementIndex (listAppend parentPath [index]) (nodeType (patternInfo first)) first)
      (validatePatternChildrenUsingOwnTypes context statementIndex parentPath rest (index + 1))
  }.

  validatePatternTypePairs :: ModuleContext -> Int -> [Int] -> [(TypedType, TypedPattern)] -> Int -> [TypedCoreValidationFailure].
  validatePatternTypePairs = \(context, statementIndex, parentPath, pairs, index) -> case pairs {
    | [] -> []
    | [(typeValue, pattern) | rest] -> listAppend
      (validatePattern context statementIndex (listAppend parentPath [index]) typeValue pattern)
      (validatePatternTypePairs context statementIndex parentPath rest (index + 1))
  }.

  tuplePatternShapeFailures :: TypedCoreValidationPath -> TypedPattern -> [TypedCoreValidationFailure].
  tuplePatternShapeFailures = \(path, pattern) -> case pattern {
    | TypedTuplePattern info patterns -> case nodeType info {
      | TypedTupleType types -> if listLength types == listLength patterns then [] else [failure path TypedPatternShapeMismatch (TypedArityDetail (listLength types) (listLength patterns))]
      | other -> []
    }
    | other -> []
  }.

  validatePattern :: ModuleContext -> Int -> [Int] -> TypedType -> TypedPattern -> [TypedCoreValidationFailure].
  validatePattern = \(context, statementIndex, patternPath, expectedType, pattern) -> case context {
    | ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope -> {
      path = TypedPatternPath modulePath statementIndex patternPath.
      info = patternInfo pattern.
      listConcat
        [ validateNodeInfo context path [] info,
          if typeEqual (nodeType info) expectedType then [] else [failure path TypedPatternScrutineeMismatch (TypedTypeDetail expectedType (nodeType info))],
          case pattern {
            | TypedVariablePattern valueInfo binder name -> validateCoreName path name
            | TypedConstructorPattern valueInfo name patterns -> validateVisibleName context path name
            | TypedAsPattern valueInfo binder name nested -> validateCoreName path name
            | TypedOrPattern valueInfo alternatives -> validateOrPattern path alternatives
            | other -> []
          },
          tuplePatternShapeFailures path pattern,
          validatePatternChildren context statementIndex patternPath pattern
        ].
    }
  }.

  validateCaseArms :: ModuleContext -> Int -> TypedType -> TypedType -> [TypedCaseArm] -> Int -> [TypedCoreValidationFailure].
  validateCaseArms = \(context, statementIndex, scrutineeType, resultType, arms, armIndex) -> case (context, arms) {
    | (ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope, []) -> []
    | (ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope, [TypedCaseArm pattern maybeGuard result | rest]) -> listConcat
      [ validatePattern context statementIndex [armIndex] scrutineeType pattern,
        case maybeGuard {
          | Nothing -> []
          | Just guard -> if typeEqual (nodeType (expressionInfo guard)) TypedBoolType then [] else [failure (TypedPatternPath modulePath statementIndex [armIndex]) TypedPatternGuardMismatch (TypedTypeDetail TypedBoolType (nodeType (expressionInfo guard)))]
        },
        if typeEqual (nodeType (expressionInfo result)) resultType then [] else [failure (TypedPatternPath modulePath statementIndex [armIndex]) TypedPatternArmResultMismatch (TypedTypeDetail resultType (nodeType (expressionInfo result)))],
        validateCaseArms context statementIndex scrutineeType resultType rest (armIndex + 1)
      ]
  }.

  validateApplication :: TypedCoreValidationPath -> TypedNodeInfo -> TypedExpr -> TypedExpr -> [TypedCoreValidationFailure].
  validateApplication = \(path, resultInfo, function, argument) -> case nodeType (expressionInfo function) {
    | TypedFunctionType expectedArgument expectedResult -> listAppend
      (if typeEqual expectedArgument (nodeType (expressionInfo argument)) then [] else [failure path TypedApplicationArgumentMismatch (TypedTypeDetail expectedArgument (nodeType (expressionInfo argument)))])
      (if typeEqual expectedResult (nodeType resultInfo) then [] else [failure path TypedApplicationResultMismatch (TypedTypeDetail expectedResult (nodeType resultInfo))])
    | actualFunctionType -> [failure path TypedApplicationFunctionMismatch (TypedTypeDetail (TypedFunctionType (nodeType (expressionInfo argument)) (nodeType resultInfo)) actualFunctionType)]
  }.

  validateConditional :: TypedCoreValidationPath -> TypedNodeInfo -> TypedExpr -> TypedExpr -> TypedExpr -> [TypedCoreValidationFailure].
  validateConditional = \(path, resultInfo, condition, thenExpression, elseExpression) -> {
    conditionType = nodeType (expressionInfo condition).
    thenType = nodeType (expressionInfo thenExpression).
    elseType = nodeType (expressionInfo elseExpression).
    listConcat
      [ if typeEqual conditionType TypedBoolType then [] else [failure path TypedConditionalConditionMismatch (TypedTypeDetail TypedBoolType conditionType)],
        if typeEqual thenType elseType then [] else [failure path TypedConditionalBranchMismatch (TypedTypeDetail thenType elseType)],
        if typeEqual thenType elseType then if typeEqual (nodeType resultInfo) thenType then [] else [failure path TypedConditionalBranchMismatch (TypedTypeDetail thenType (nodeType resultInfo))] else []
      ].
  }.

  numericTypeIsFloat :: TypedNumericType -> Bool.
  numericTypeIsFloat = \(numericType) -> case numericType {
    | TypedFloat16Type -> True
    | TypedFloat32Type -> True
    | TypedFloat64Type -> True
    | other -> False
  }.

  literalType :: TypedLiteral -> TypedType.
  literalType = \(literal) -> case literal {
    | TypedIntegerLiteral value -> TypedIntType
    | TypedFractionalLiteral whole fractional suffix -> TypedFloatType
    | TypedBooleanLiteral value -> TypedBoolType
    | TypedCharacterLiteral value -> TypedCharType
    | TypedTextLiteral value -> TypedTextType
  }.

  literalMatchesType :: TypedLiteral -> TypedType -> Bool.
  literalMatchesType = \(literal, typeValue) -> case (literal, typeValue) {
    | (TypedIntegerLiteral value, TypedIntType) -> True
    | (TypedIntegerLiteral value, TypedNumericType numericType) -> if numericTypeIsFloat numericType then False else True
    | (TypedFractionalLiteral whole fractional suffix, TypedFloatType) -> True
    | (TypedFractionalLiteral whole fractional suffix, TypedNumericType numericType) -> numericTypeIsFloat numericType
    | (TypedBooleanLiteral value, TypedBoolType) -> True
    | (TypedCharacterLiteral value, TypedCharType) -> True
    | (TypedTextLiteral value, TypedTextType) -> True
    | other -> False
  }.

  validateLiteral :: TypedCoreValidationPath -> TypedNodeInfo -> TypedLiteral -> [TypedCoreValidationFailure].
  validateLiteral = \(path, info, literal) ->
    if literalMatchesType literal (nodeType info) then [] else [failure path TypedLiteralTypeMismatch (TypedTypeDetail (literalType literal) (nodeType info))].

  validateLambdaResult :: TypedCoreValidationPath -> TypedNodeInfo -> TypedExpr -> [TypedCoreValidationFailure].
  validateLambdaResult = \(path, info, body) -> case nodeType info {
    | TypedFunctionType argument expectedResult -> if typeEqual expectedResult (nodeType (expressionInfo body)) then [] else [failure path TypedLambdaResultMismatch (TypedTypeDetail expectedResult (nodeType (expressionInfo body)))]
    | actual -> [failure path TypedLambdaResultMismatch (TypedTypeDetail (TypedFunctionType (nodeType (expressionInfo body)) (nodeType (expressionInfo body))) actual)]
  }.

  validateListElements :: TypedCoreValidationPath -> TypedType -> [TypedExpr] -> [TypedCoreValidationFailure].
  validateListElements = \(path, expectedType, expressions) -> case expressions {
    | [] -> []
    | [first | rest] -> listAppend
      (if typeEqual expectedType (nodeType (expressionInfo first)) then [] else [failure path TypedCollectionShapeMismatch (TypedTypeDetail expectedType (nodeType (expressionInfo first)))])
      (validateListElements path expectedType rest)
  }.

  validateListShape :: TypedCoreValidationPath -> TypedNodeInfo -> [TypedExpr] -> [TypedCoreValidationFailure].
  validateListShape = \(path, info, expressions) -> case nodeType info {
    | TypedListType elementType -> validateListElements path elementType expressions
    | actual -> [failure path TypedCollectionShapeMismatch (TypedTypeDetail (TypedListType actual) actual)]
  }.

  validateTupleElements :: TypedCoreValidationPath -> [TypedType] -> [TypedExpr] -> [TypedCoreValidationFailure].
  validateTupleElements = \(path, expectedTypes, expressions) -> case (expectedTypes, expressions) {
    | ([], []) -> []
    | ([expected | expectedRest], [expression | expressionRest]) -> listAppend
      (if typeEqual expected (nodeType (expressionInfo expression)) then [] else [failure path TypedCollectionShapeMismatch (TypedTypeDetail expected (nodeType (expressionInfo expression)))])
      (validateTupleElements path expectedRest expressionRest)
    | other -> []
  }.

  validateTupleShape :: TypedCoreValidationPath -> TypedNodeInfo -> [TypedExpr] -> [TypedCoreValidationFailure].
  validateTupleShape = \(path, info, expressions) -> case nodeType info {
    | TypedTupleType expectedTypes -> if listLength expectedTypes == listLength expressions then validateTupleElements path expectedTypes expressions else [failure path TypedCollectionShapeMismatch (TypedArityDetail (listLength expectedTypes) (listLength expressions))]
    | actual -> [failure path TypedCollectionShapeMismatch (TypedTypeDetail (TypedTupleType []) actual)]
  }.

  validateExpressionOwned :: ModuleContext -> Int -> [Int] -> TypedCoreValidationPath -> TypedExpr -> [TypedCoreValidationFailure].
  validateExpressionOwned = \(context, statementIndex, expressionPath, path, expression) -> case expression {
    | TypedLiteralExpr info literal -> validateLiteral path info literal
    | TypedVariableExpr info name -> validateVisibleName context path name
    | TypedLambdaExpr info binder name body -> listAppend (validateCoreName path name) (validateLambdaResult path info body)
    | TypedOperatorValueExpr info operator -> validateOperatorRef path operator
    | TypedListExpr info expressions -> validateListShape path info expressions
    | TypedTupleExpr info expressions -> validateTupleShape path info expressions
    | TypedApplyExpr info function argument -> validateApplication path info function argument
    | TypedTypeApplicationExpr info function span typeArgument -> case context {
      | ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope -> listAppend (validateType path typeScope typeArgument) (validateDataTypeApplications context path typeArgument)
    }
    | TypedIfExpr info condition thenExpression elseExpression -> validateConditional path info condition thenExpression elseExpression
    | TypedPatternCaseExpr info scrutinee arms -> validateCaseArms context statementIndex (nodeType (expressionInfo scrutinee)) (nodeType info) arms 0
    | TypedBinaryExpr info operator left right -> validateOperatorRef path operator
    | TypedLeftSectionExpr info left operator -> validateOperatorRef path operator
    | TypedRightSectionExpr info operator right -> validateOperatorRef path operator
    | TypedBlockExpr info statements -> []
  }.

  patternBoundNames :: TypedPattern -> [TypedCoreName].
  patternBoundNames = \(pattern) -> case pattern {
    | TypedVariablePattern info binder name -> [name]
    | TypedConstructorPattern info name patterns -> listConcat (listMap patternBoundNames patterns)
    | TypedListPattern info patterns -> listConcat (listMap patternBoundNames patterns)
    | TypedConsListPattern info head tail -> listAppend (patternBoundNames head) (patternBoundNames tail)
    | TypedTuplePattern info patterns -> listConcat (listMap patternBoundNames patterns)
    | TypedAsPattern info binder name nested -> listPrepend name (patternBoundNames nested)
    | TypedOrPattern info alternatives -> case alternatives {
      | [] -> []
      | [first | rest] -> patternBoundNames first
    }
    | other -> []
  }.

  constructorNames :: [TypedConstructorDeclaration] -> [TypedCoreName].
  constructorNames = \(constructors) -> case constructors {
    | [] -> []
    | [TypedConstructorDeclaration binder name fields recipes | rest] -> listPrepend name (constructorNames rest)
  }.

  signatureNames :: [TypedMethodSignature] -> [TypedCoreName].
  signatureNames = \(methods) -> case methods {
    | [] -> []
    | [TypedMethodSignature name span scheme | rest] -> listPrepend name (signatureNames rest)
  }.

  definitionNames :: [TypedMethodDefinition] -> [TypedCoreName].
  definitionNames = \(methods) -> case methods {
    | [] -> []
    | [TypedMethodDefinition methodId binder name span expression | rest] -> listPrepend name (definitionNames rest)
  }.

  statementDefinedNames :: TypedStatement -> [TypedCoreName].
  statementDefinedNames = \(statement) -> case statement {
    | TypedLetStatement binder name span scheme expression -> [name]
    | TypedSignatureStatement binder name span scheme -> [name]
    | TypedDataStatement declaration -> case declaration {
      | TypedDataDeclaration span name parameters constructors -> listPrepend name (constructorNames constructors)
    }
    | TypedClassStatement declaration -> case declaration {
      | TypedClassDeclaration span name parameters methods -> listPrepend name (signatureNames methods)
    }
    | TypedImplStatement declaration -> case declaration {
      | TypedImplDeclaration span implId methods -> definitionNames methods
    }
    | TypedExpressionStatement span expression -> []
  }.

  statementsDefinedNames :: [TypedStatement] -> [TypedCoreName].
  statementsDefinedNames = \(statements) -> listConcat (listMap statementDefinedNames statements).

  validateCaseChildExpressions :: ModuleContext -> Int -> [Int] -> [TypedCaseArm] -> Int -> [TypedCoreValidationFailure].
  validateCaseChildExpressions = \(context, statementIndex, expressionPath, arms, childIndex) -> case arms {
    | [] -> []
    | [TypedCaseArm pattern maybeGuard result | rest] -> {
      armContext = withVisibleNames (patternBoundNames pattern) context.
      case maybeGuard {
      | Nothing -> listAppend
        (validateExpression armContext statementIndex (listAppend expressionPath [childIndex]) result)
        (validateCaseChildExpressions context statementIndex expressionPath rest (childIndex + 1))
      | Just guard -> listConcat
        [ validateExpression armContext statementIndex (listAppend expressionPath [childIndex]) guard,
          validateExpression armContext statementIndex (listAppend expressionPath [childIndex + 1]) result,
          validateCaseChildExpressions context statementIndex expressionPath rest (childIndex + 2)
        ]
      }.
    }
  }.

  validateBlockStatements :: ModuleContext -> Int -> [Int] -> [TypedStatement] -> [TypedCoreValidationFailure].
  validateBlockStatements = \(context, statementIndex, expressionPath, statements) -> case context {
    | ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope -> {
      statementLocation = statementLocationFor statementIndex statementIndices.
      listConcat (listMap (\(indexed) -> case indexed {
        | (blockIndex, statement) -> validateStatement
          context
          (statementIndexFor (nestedStatementLocation statementLocation expressionPath blockIndex) statementIndices)
          statement
      }) (listIndexed statements)).
    }
  }.

  blockConstructorBinders :: [TypedConstructorDeclaration] -> [TypedBinderId].
  blockConstructorBinders = \(constructors) -> case constructors {
    | [] -> []
    | [TypedConstructorDeclaration binder name fields recipes | rest] -> listPrepend binder (blockConstructorBinders rest)
  }.

  blockMethodSignatureBinders :: [TypedMethodSignature] -> [TypedBinderId].
  blockMethodSignatureBinders = \(methods) -> case methods {
    | [] -> []
    | [TypedMethodSignature name span scheme | rest] -> case scheme {
      | TypedScheme binder parameters evidence primitive resultType resultRecipe -> listPrepend binder (blockMethodSignatureBinders rest)
    }
  }.

  blockMethodDefinitionBinders :: [TypedMethodDefinition] -> [TypedBinderId].
  blockMethodDefinitionBinders = \(methods) -> case methods {
    | [] -> []
    | [TypedMethodDefinition methodId binder name span expression | rest] -> listPrepend binder (blockMethodDefinitionBinders rest)
  }.

  blockStatementBinderDefinitions :: TypedStatement -> [TypedBinderId].
  blockStatementBinderDefinitions = \(statement) -> case statement {
    | TypedLetStatement binder name span scheme expression -> [binder]
    | TypedSignatureStatement binder name span scheme -> [binder]
    | TypedDataStatement declaration -> case declaration {
      | TypedDataDeclaration span name parameters constructors -> blockConstructorBinders constructors
    }
    | TypedClassStatement declaration -> case declaration {
      | TypedClassDeclaration span name parameters methods -> blockMethodSignatureBinders methods
    }
    | TypedImplStatement declaration -> case declaration {
      | TypedImplDeclaration span implId methods -> blockMethodDefinitionBinders methods
    }
    | TypedExpressionStatement span expression -> []
  }.

  duplicateBlockBindersAt :: [Text] -> Int -> [TypedBinderId] -> [TypedBinderId] -> ([TypedBinderId], [TypedCoreValidationFailure]).
  duplicateBlockBindersAt = \(modulePath, statementIndex, binders, seen) -> case binders {
    | [] -> (seen, [])
    | [first | rest] -> case duplicateBlockBindersAt modulePath statementIndex rest (if binderIdMember first seen then seen else listPrepend first seen) {
      | (laterSeen, laterFailures) -> (laterSeen, listAppend (if binderIdMember first seen then [failure (TypedStatementPath modulePath statementIndex) TypedDuplicateBinder (TypedBinderDetail first)] else []) laterFailures)
    }
  }.

  duplicateBlockBinderFailuresFrom :: ModuleContext -> [Int] -> [Int] -> [TypedStatement] -> Int -> [TypedBinderId] -> [TypedCoreValidationFailure].
  duplicateBlockBinderFailuresFrom = \(context, statementLocation, expressionPath, statements, blockIndex, seen) -> case (context, statements) {
    | (ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope, []) -> []
    | (ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope, [first | rest]) -> {
      nestedIndex = statementIndexFor (nestedStatementLocation statementLocation expressionPath blockIndex) statementIndices.
      case duplicateBlockBindersAt modulePath nestedIndex (blockStatementBinderDefinitions first) seen {
        | (laterSeen, currentFailures) -> listAppend
          currentFailures
          (duplicateBlockBinderFailuresFrom context statementLocation expressionPath rest (blockIndex + 1) laterSeen)
      }.
    }
  }.

  duplicateBlockBinderFailures :: ModuleContext -> Int -> [Int] -> [TypedStatement] -> [TypedCoreValidationFailure].
  duplicateBlockBinderFailures = \(context, statementIndex, expressionPath, statements) -> case context {
    | ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope ->
      duplicateBlockBinderFailuresFrom context (statementLocationFor statementIndex statementIndices) expressionPath statements 0 []
  }.

  validateExpression :: ModuleContext -> Int -> [Int] -> TypedExpr -> [TypedCoreValidationFailure].
  validateExpression = \(context, statementIndex, expressionPath, expression) -> case context {
    | ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope -> {
      path = TypedExpressionPath modulePath statementIndex expressionPath.
      childFailures = case expression {
        | TypedLambdaExpr info binder name body -> validateExpression (withVisibleName name context) statementIndex (listAppend expressionPath [0]) body
        | TypedListExpr info expressions -> listConcat (listMap (\(indexed) -> case indexed {
          | (index, child) -> validateExpression context statementIndex (listAppend expressionPath [index]) child
        }) (listIndexed expressions))
        | TypedTupleExpr info expressions -> listConcat (listMap (\(indexed) -> case indexed {
          | (index, child) -> validateExpression context statementIndex (listAppend expressionPath [index]) child
        }) (listIndexed expressions))
        | TypedApplyExpr info function argument -> listAppend
          (validateExpression context statementIndex (listAppend expressionPath [0]) function)
          (validateExpression context statementIndex (listAppend expressionPath [1]) argument)
        | TypedTypeApplicationExpr info function span typeArgument -> validateExpression context statementIndex (listAppend expressionPath [0]) function
        | TypedIfExpr info condition thenExpression elseExpression -> listConcat
          [ validateExpression context statementIndex (listAppend expressionPath [0]) condition,
            validateExpression context statementIndex (listAppend expressionPath [1]) thenExpression,
            validateExpression context statementIndex (listAppend expressionPath [2]) elseExpression
          ]
        | TypedPatternCaseExpr info scrutinee arms -> listAppend
          (validateExpression context statementIndex (listAppend expressionPath [0]) scrutinee)
          (validateCaseChildExpressions context statementIndex expressionPath arms 1)
        | TypedBinaryExpr info operator left right -> listAppend
          (validateExpression context statementIndex (listAppend expressionPath [0]) left)
          (validateExpression context statementIndex (listAppend expressionPath [1]) right)
        | TypedLeftSectionExpr info left operator -> validateExpression context statementIndex (listAppend expressionPath [0]) left
        | TypedRightSectionExpr info operator right -> validateExpression context statementIndex (listAppend expressionPath [0]) right
        | TypedBlockExpr info statements -> listAppend
          (duplicateBlockBinderFailures context statementIndex expressionPath statements)
          (validateBlockStatements (withVisibleNames (statementsDefinedNames statements) context) statementIndex expressionPath statements)
        | other -> []
      }.
      listConcat
        [ validateNodeInfo context path typeScope (expressionInfo expression),
          validateExpressionOwned context statementIndex expressionPath path expression,
          childFailures
        ].
    }
  }.

  typeParameterIdListEqualForScheme :: [TypedTypeParameterId] -> [TypedTypeParameterId] -> Bool.
  typeParameterIdListEqualForScheme = typeParameterIdListEqual.

  numericConstraintEqual :: TypedNumericConstraint -> TypedNumericConstraint -> Bool.
  numericConstraintEqual = \(left, right) -> case (left, right) {
    | (TypedAnyNumericConstraint, TypedAnyNumericConstraint) -> True
    | (TypedRuntimeArithmeticNumericConstraint, TypedRuntimeArithmeticNumericConstraint) -> True
    | (TypedRuntimeComparisonNumericConstraint, TypedRuntimeComparisonNumericConstraint) -> True
    | (TypedIntegralNumericConstraint, TypedIntegralNumericConstraint) -> True
    | (TypedIntegralLiteralNumericConstraint leftLower leftUpper, TypedIntegralLiteralNumericConstraint rightLower rightUpper) -> if leftLower == rightLower then leftUpper == rightUpper else False
    | other -> False
  }.

  primitiveConstraintEqual :: TypedPrimitiveConstraint -> TypedPrimitiveConstraint -> Bool.
  primitiveConstraintEqual = \(left, right) -> case (left, right) {
    | (TypedNumericPrimitiveConstraint leftConstraint leftType, TypedNumericPrimitiveConstraint rightConstraint rightType) -> if numericConstraintEqual leftConstraint rightConstraint then typeEqual leftType rightType else False
    | (TypedStrictEqualityPrimitiveConstraint leftType, TypedStrictEqualityPrimitiveConstraint rightType) -> typeEqual leftType rightType
    | other -> False
  }.

  primitiveConstraintListEqual :: [TypedPrimitiveConstraint] -> [TypedPrimitiveConstraint] -> Bool.
  primitiveConstraintListEqual = \(left, right) -> case (left, right) {
    | ([], []) -> True
    | ([leftFirst | leftRest], [rightFirst | rightRest]) -> if primitiveConstraintEqual leftFirst rightFirst then primitiveConstraintListEqual leftRest rightRest else False
    | other -> False
  }.

  evidenceParameterEqual :: TypedEvidenceParameter -> TypedEvidenceParameter -> Bool.
  evidenceParameterEqual = \(left, right) -> case (left, right) {
    | (TypedEvidenceParameter leftId leftConstraint, TypedEvidenceParameter rightId rightConstraint) -> if evidenceParameterIdEqual leftId rightId then capabilityConstraintEqual leftConstraint rightConstraint else False
  }.

  evidenceParameterListEqual :: [TypedEvidenceParameter] -> [TypedEvidenceParameter] -> Bool.
  evidenceParameterListEqual = \(left, right) -> case (left, right) {
    | ([], []) -> True
    | ([leftFirst | leftRest], [rightFirst | rightRest]) -> if evidenceParameterEqual leftFirst rightFirst then evidenceParameterListEqual leftRest rightRest else False
    | other -> False
  }.

  schemeEqual :: TypedScheme -> TypedScheme -> Bool.
  schemeEqual = \(left, right) -> case (left, right) {
    | (TypedScheme leftOwner leftTypes leftEvidence leftPrimitive leftResult leftRecipe, TypedScheme rightOwner rightTypes rightEvidence rightPrimitive rightResult rightRecipe) ->
      if binderIdEqual leftOwner rightOwner then
        if typeParameterIdListEqualForScheme leftTypes rightTypes then
          if evidenceParameterListEqual leftEvidence rightEvidence then
            if primitiveConstraintListEqual leftPrimitive rightPrimitive then
              if typeEqual leftResult rightResult then recipeEqual leftRecipe rightRecipe else False
            else False
          else False
        else False
      else False
  }.

  constructorDeclarationEqual :: TypedConstructorDeclaration -> TypedConstructorDeclaration -> Bool.
  constructorDeclarationEqual = \(left, right) -> case (left, right) {
    | (TypedConstructorDeclaration leftBinder leftName leftFields leftRecipes, TypedConstructorDeclaration rightBinder rightName rightFields rightRecipes) -> if binderIdEqual leftBinder rightBinder then if coreNameEqual leftName rightName then if typeListEqual leftFields rightFields then recipeListEqual leftRecipes rightRecipes else False else False else False
  }.

  constructorDeclarationListEqual :: [TypedConstructorDeclaration] -> [TypedConstructorDeclaration] -> Bool.
  constructorDeclarationListEqual = \(left, right) -> case (left, right) {
    | ([], []) -> True
    | ([leftFirst | leftRest], [rightFirst | rightRest]) -> if constructorDeclarationEqual leftFirst rightFirst then constructorDeclarationListEqual leftRest rightRest else False
    | other -> False
  }.

  spanEqual :: TypedSpan -> TypedSpan -> Bool.
  spanEqual = \(left, right) -> case (left, right) {
    | (TypedSpan leftLine leftColumn, TypedSpan rightLine rightColumn) -> if leftLine == rightLine then leftColumn == rightColumn else False
  }.

  dataDeclarationEqual :: TypedDataDeclaration -> TypedDataDeclaration -> Bool.
  dataDeclarationEqual = \(left, right) -> case (left, right) {
    | (TypedDataDeclaration leftSpan leftName leftParameters leftConstructors, TypedDataDeclaration rightSpan rightName rightParameters rightConstructors) -> if spanEqual leftSpan rightSpan then if coreNameEqual leftName rightName then if typeParameterIdListEqual leftParameters rightParameters then constructorDeclarationListEqual leftConstructors rightConstructors else False else False else False
  }.

  methodSignatureEqual :: TypedMethodSignature -> TypedMethodSignature -> Bool.
  methodSignatureEqual = \(left, right) -> case (left, right) {
    | (TypedMethodSignature leftName leftSpan leftScheme, TypedMethodSignature rightName rightSpan rightScheme) -> if coreNameEqual leftName rightName then if spanEqual leftSpan rightSpan then schemeEqual leftScheme rightScheme else False else False
  }.

  methodSignatureListEqual :: [TypedMethodSignature] -> [TypedMethodSignature] -> Bool.
  methodSignatureListEqual = \(left, right) -> case (left, right) {
    | ([], []) -> True
    | ([leftFirst | leftRest], [rightFirst | rightRest]) -> if methodSignatureEqual leftFirst rightFirst then methodSignatureListEqual leftRest rightRest else False
    | other -> False
  }.

  classDeclarationEqual :: TypedClassDeclaration -> TypedClassDeclaration -> Bool.
  classDeclarationEqual = \(left, right) -> case (left, right) {
    | (TypedClassDeclaration leftSpan leftName leftParameters leftMethods, TypedClassDeclaration rightSpan rightName rightParameters rightMethods) -> if spanEqual leftSpan rightSpan then if coreNameEqual leftName rightName then if typeParameterIdListEqual leftParameters rightParameters then methodSignatureListEqual leftMethods rightMethods else False else False else False
  }.

  constructorBinders :: [TypedConstructorDeclaration] -> [TypedBinderId].
  constructorBinders = \(constructors) -> case constructors {
    | [] -> []
    | [TypedConstructorDeclaration binder name fields recipes | rest] -> listPrepend binder (constructorBinders rest)
  }.

  methodSignatureBinders :: [TypedMethodSignature] -> [TypedBinderId].
  methodSignatureBinders = \(methods) -> case methods {
    | [] -> []
    | [TypedMethodSignature name span scheme | rest] -> case scheme {
      | TypedScheme binder parameters evidence primitive resultType resultRecipe -> listPrepend binder (methodSignatureBinders rest)
    }
  }.

  methodDefinitionBinders :: [TypedMethodDefinition] -> [TypedBinderId].
  methodDefinitionBinders = \(methods) -> case methods {
    | [] -> []
    | [TypedMethodDefinition methodId binder name span expression | rest] -> listPrepend binder (methodDefinitionBinders rest)
  }.

  statementBinderDefinitions :: TypedStatement -> [TypedBinderId].
  statementBinderDefinitions = \(statement) -> case statement {
    | TypedLetStatement binder name span scheme expression -> [binder]
    | TypedSignatureStatement binder name span scheme -> [binder]
    | TypedDataStatement declaration -> case declaration {
      | TypedDataDeclaration span name parameters constructors -> constructorBinders constructors
    }
    | TypedClassStatement declaration -> case declaration {
      | TypedClassDeclaration span name parameters methods -> methodSignatureBinders methods
    }
    | TypedImplStatement declaration -> case declaration {
      | TypedImplDeclaration span implId methods -> methodDefinitionBinders methods
    }
    | TypedExpressionStatement span expression -> []
  }.

  duplicateBindersAt :: [Text] -> Int -> [TypedBinderId] -> [TypedBinderId] -> ([TypedBinderId], [TypedCoreValidationFailure]).
  duplicateBindersAt = \(modulePath, statementIndex, binders, seen) -> case binders {
    | [] -> (seen, [])
    | [first | rest] -> case duplicateBindersAt modulePath statementIndex rest (if binderIdMember first seen then seen else listPrepend first seen) {
      | (laterSeen, laterFailures) -> (laterSeen, listAppend (if binderIdMember first seen then [failure (TypedStatementPath modulePath statementIndex) TypedDuplicateBinder (TypedBinderDetail first)] else []) laterFailures)
    }
  }.

  duplicateBinderFailuresFrom :: [Text] -> [TypedStatement] -> Int -> [TypedBinderId] -> [TypedCoreValidationFailure].
  duplicateBinderFailuresFrom = \(modulePath, statements, statementIndex, seen) -> case statements {
    | [] -> []
    | [first | rest] -> case duplicateBindersAt modulePath statementIndex (statementBinderDefinitions first) seen {
      | (laterSeen, currentFailures) -> listAppend currentFailures (duplicateBinderFailuresFrom modulePath rest (statementIndex + 1) laterSeen)
    }
  }.

  methodSchemeEntries :: [TypedMethodSignature] -> [SchemeEntry].
  methodSchemeEntries = \(methods) -> case methods {
    | [] -> []
    | [TypedMethodSignature name span scheme | rest] -> case scheme {
      | TypedScheme binder parameters evidence primitive resultType resultRecipe -> listPrepend (SchemeEntry binder scheme) (methodSchemeEntries rest)
    }
  }.

  statementSchemeEntries :: TypedStatement -> [SchemeEntry].
  statementSchemeEntries = \(statement) -> case statement {
    | TypedLetStatement binder name span scheme expression -> [SchemeEntry binder scheme]
    | TypedSignatureStatement binder name span scheme -> [SchemeEntry binder scheme]
    | TypedClassStatement declaration -> case declaration {
      | TypedClassDeclaration span name parameters methods -> methodSchemeEntries methods
    }
    | other -> []
  }.

  moduleSchemeEntries :: [TypedStatement] -> [SchemeEntry].
  moduleSchemeEntries = \(statements) -> case statements {
    | [] -> []
    | [first | rest] -> listAppend (statementSchemeEntries first) (moduleSchemeEntries rest)
  }.

  dataRecipePairFailures :: TypedCoreValidationPath -> [(TypedType, TypedRepresentationRecipe)] -> [TypedCoreValidationFailure].
  dataRecipePairFailures = \(path, pairs) -> case pairs {
    | [] -> []
    | [(typeValue, recipe) | rest] -> listAppend
      (case expectedRecipe typeValue {
        | Nothing -> []
        | Just expected -> if recipeWidthValid recipe then if recipeEqual expected recipe then [] else [failure path TypedDataRecipeMismatch (TypedRecipeDetail expected recipe)] else []
      })
      (dataRecipePairFailures path rest)
  }.

  validateConstructorDeclaration :: ModuleContext -> TypedCoreValidationPath -> [TypedTypeParameterId] -> TypedConstructorDeclaration -> [TypedCoreValidationFailure].
  validateConstructorDeclaration = \(context, path, scope, declaration) -> case declaration {
    | TypedConstructorDeclaration binder name fields recipes -> listConcat
      [ validateCoreName path name,
        validateTypes path scope fields,
        listConcat (listMap (\(field) -> validateDataTypeApplications context path field) fields),
        validateRecipes path scope recipes,
        if listLength fields == listLength recipes then dataRecipePairFailures path (listZip fields recipes) else [failure path TypedDataRecipeMismatch (TypedArityDetail (listLength fields) (listLength recipes))]
      ]
  }.

  validateConstructorDeclarations :: ModuleContext -> TypedCoreValidationPath -> [TypedTypeParameterId] -> [TypedConstructorDeclaration] -> [TypedCoreValidationFailure].
  validateConstructorDeclarations = \(context, path, scope, declarations) -> case declarations {
    | [] -> []
    | [first | rest] -> listAppend (validateConstructorDeclaration context path scope first) (validateConstructorDeclarations context path scope rest)
  }.

  validateDataDeclaration :: ModuleContext -> TypedCoreValidationPath -> TypedDataDeclaration -> [TypedCoreValidationFailure].
  validateDataDeclaration = \(context, path, declaration) -> case declaration {
    | TypedDataDeclaration span name parameters constructors -> listConcat
      [ validateCoreName path name,
        validateOrderedTypeParameters path parameters,
        validateConstructorDeclarations context path parameters constructors
      ]
  }.

  validateEvidenceParameterDataTypes :: ModuleContext -> TypedCoreValidationPath -> [TypedEvidenceParameter] -> [TypedCoreValidationFailure].
  validateEvidenceParameterDataTypes = \(context, path, parameters) -> case parameters {
    | [] -> []
    | [TypedEvidenceParameter parameterId constraint | rest] -> case constraint {
      | TypedCapabilityConstraint capability method targetType -> listAppend (validateDataTypeApplications context path targetType) (validateEvidenceParameterDataTypes context path rest)
    }
  }.

  validatePrimitiveDataTypes :: ModuleContext -> TypedCoreValidationPath -> [TypedPrimitiveConstraint] -> [TypedCoreValidationFailure].
  validatePrimitiveDataTypes = \(context, path, constraints) -> case constraints {
    | [] -> []
    | [first | rest] -> listAppend
      (case first {
        | TypedNumericPrimitiveConstraint numericConstraint typeValue -> validateDataTypeApplications context path typeValue
        | TypedStrictEqualityPrimitiveConstraint typeValue -> validateDataTypeApplications context path typeValue
      })
      (validatePrimitiveDataTypes context path rest)
  }.

  validateSchemeDataTypes :: ModuleContext -> TypedCoreValidationPath -> TypedScheme -> [TypedCoreValidationFailure].
  validateSchemeDataTypes = \(context, path, scheme) -> case scheme {
    | TypedScheme owner parameters evidence primitive resultType resultRecipe -> listConcat
      [ validateDataTypeApplications context path resultType,
        validateEvidenceParameterDataTypes context path evidence,
        validatePrimitiveDataTypes context path primitive
      ]
  }.

  validateMethodSignatures :: ModuleContext -> TypedCoreValidationPath -> [TypedMethodSignature] -> [TypedCoreValidationFailure].
  validateMethodSignatures = \(context, path, methods) -> case methods {
    | [] -> []
    | [TypedMethodSignature name span scheme | rest] -> case scheme {
      | TypedScheme binder parameters evidence primitive resultType resultRecipe -> listConcat
        [ validateCoreName path name,
          validateScheme path binder scheme,
          validateSchemeDataTypes context path scheme,
          validateMethodSignatures context path rest
        ]
    }
  }.

  validateClassDeclaration :: ModuleContext -> TypedCoreValidationPath -> TypedClassDeclaration -> [TypedCoreValidationFailure].
  validateClassDeclaration = \(context, path, declaration) -> case declaration {
    | TypedClassDeclaration span name parameters methods -> listConcat
      [ validateCoreName path name,
        validateOrderedTypeParameters path parameters,
        validateMethodSignatures context path methods
      ]
  }.

  validateMethodDefinitions :: ModuleContext -> Int -> TypedCoreValidationPath -> TypedImplId -> [TypedMethodDefinition] -> Int -> [TypedCoreValidationFailure].
  validateMethodDefinitions = \(context, statementIndex, path, enclosingImpl, methods, methodIndex) -> case methods {
    | [] -> []
    | [TypedMethodDefinition methodId binder name span expression | rest] -> listConcat
      [ validateMethodId path [] methodId,
        case methodId {
          | TypedMethodId methodImpl methodName -> if implIdEqual methodImpl enclosingImpl then [] else [failure path TypedMethodSelectionMismatch (TypedImplDetail methodImpl)]
        },
        validateCoreName path name,
        validateExpression context statementIndex [methodIndex] expression,
        validateMethodDefinitions context statementIndex path enclosingImpl rest (methodIndex + 1)
      ]
  }.

  validateImplDeclaration :: ModuleContext -> Int -> TypedCoreValidationPath -> TypedImplDeclaration -> [TypedCoreValidationFailure].
  validateImplDeclaration = \(context, statementIndex, path, declaration) -> case declaration {
    | TypedImplDeclaration span implId methods -> listConcat
      [ validateImplId path [] implId,
        validateImplDataTypes context path implId,
        validateMethodDefinitions context statementIndex path implId methods 0
      ]
  }.

  validateBindingValue :: TypedCoreValidationPath -> TypedScheme -> TypedNodeInfo -> [TypedCoreValidationFailure].
  validateBindingValue = \(path, scheme, info) -> case scheme {
    | TypedScheme owner parameters evidence primitive resultType resultRecipe ->
      if typeEqual resultType (nodeType info) then
        if recipeEqual resultRecipe (nodeRecipe info) then [] else [failure path TypedBindingValueMismatch (TypedRecipeDetail resultRecipe (nodeRecipe info))]
      else [failure path TypedBindingValueMismatch (TypedTypeDetail resultType (nodeType info))]
  }.

  validateStatement :: ModuleContext -> Int -> TypedStatement -> [TypedCoreValidationFailure].
  validateStatement = \(context, statementIndex, statement) -> case context {
    | ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope -> {
      path = TypedStatementPath modulePath statementIndex.
      case statement {
        | TypedLetStatement binder name span scheme expression -> listConcat
          [ validateCoreName path name,
            validateScheme path binder scheme,
            validateSchemeDataTypes context path scheme,
            validateBindingValue path scheme (expressionInfo expression),
            validateExpression (withTypeScope (schemeTypeParameters scheme) context) statementIndex [0] expression
          ]
        | TypedSignatureStatement binder name span scheme -> listConcat [validateCoreName path name, validateScheme path binder scheme, validateSchemeDataTypes context path scheme]
        | TypedDataStatement declaration -> validateDataDeclaration context path declaration
        | TypedClassStatement declaration -> validateClassDeclaration context path declaration
        | TypedImplStatement declaration -> validateImplDeclaration context statementIndex path declaration
        | TypedExpressionStatement span expression -> validateExpression context statementIndex [0] expression
      }.
    }
  }.

  validateStatements :: ModuleContext -> [TypedStatement] -> Int -> [TypedCoreValidationFailure].
  validateStatements = \(context, statements, statementIndex) -> case statements {
    | [] -> []
    | [first | rest] -> listAppend (validateStatement context statementIndex first) (validateStatements context rest (statementIndex + 1))
  }.

  declaredValueMatches :: TypedCoreName -> TypedScheme -> [TypedStatement] -> Bool.
  declaredValueMatches = \(name, scheme, statements) -> case statements {
    | [] -> False
    | [first | rest] -> case first {
      | TypedLetStatement binder candidateName span candidateScheme expression -> if coreNameEqual name candidateName then schemeEqual scheme candidateScheme else declaredValueMatches name scheme rest
      | TypedSignatureStatement binder candidateName span candidateScheme -> if coreNameEqual name candidateName then schemeEqual scheme candidateScheme else declaredValueMatches name scheme rest
      | other -> declaredValueMatches name scheme rest
    }
  }.

  declaredDataMatches :: TypedDataDeclaration -> [TypedStatement] -> Bool.
  declaredDataMatches = \(declaration, statements) -> case statements {
    | [] -> False
    | [first | rest] -> case first {
      | TypedDataStatement candidate -> if dataDeclarationEqual declaration candidate then True else declaredDataMatches declaration rest
      | other -> declaredDataMatches declaration rest
    }
  }.

  declaredClassMatches :: TypedClassDeclaration -> [TypedStatement] -> Bool.
  declaredClassMatches = \(declaration, statements) -> case statements {
    | [] -> False
    | [first | rest] -> case first {
      | TypedClassStatement candidate -> if classDeclarationEqual declaration candidate then True else declaredClassMatches declaration rest
      | other -> declaredClassMatches declaration rest
    }
  }.

  declaredImplMatches :: TypedImplId -> [TypedStatement] -> Bool.
  declaredImplMatches = \(implId, statements) -> case statements {
    | [] -> False
    | [first | rest] -> case first {
      | TypedImplStatement declaration -> case declaration {
        | TypedImplDeclaration span candidate methods -> if implIdEqual implId candidate then True else declaredImplMatches implId rest
      }
      | other -> declaredImplMatches implId rest
    }
  }.

  validateValueInterfaces :: TypedCoreValidationPath -> [TypedStatement] -> [TypedValueInterface] -> [TypedCoreValidationFailure].
  validateValueInterfaces = \(path, statements, interfaces) -> case interfaces {
    | [] -> []
    | [TypedValueInterface name scheme | rest] -> listAppend
      (if declaredValueMatches name scheme statements then [] else [failure path TypedModuleInterfaceMismatch (TypedNameDetail name)])
      (validateValueInterfaces path statements rest)
  }.

  validateDataInterfaces :: TypedCoreValidationPath -> [TypedStatement] -> [TypedDataInterface] -> [TypedCoreValidationFailure].
  validateDataInterfaces = \(path, statements, interfaces) -> case interfaces {
    | [] -> []
    | [TypedDataInterface declaration | rest] -> case declaration {
      | TypedDataDeclaration span name parameters constructors -> listAppend
        (if declaredDataMatches declaration statements then [] else [failure path TypedModuleInterfaceMismatch (TypedNameDetail name)])
        (validateDataInterfaces path statements rest)
    }
  }.

  validateClassInterfaces :: TypedCoreValidationPath -> [TypedStatement] -> [TypedClassInterface] -> [TypedCoreValidationFailure].
  validateClassInterfaces = \(path, statements, interfaces) -> case interfaces {
    | [] -> []
    | [TypedClassInterface declaration | rest] -> case declaration {
      | TypedClassDeclaration span name parameters methods -> listAppend
        (if declaredClassMatches declaration statements then [] else [failure path TypedModuleInterfaceMismatch (TypedNameDetail name)])
        (validateClassInterfaces path statements rest)
    }
  }.

  validateImplInterfaces :: TypedCoreValidationPath -> [TypedStatement] -> [TypedImplInterface] -> [TypedCoreValidationFailure].
  validateImplInterfaces = \(path, statements, interfaces) -> case interfaces {
    | [] -> []
    | [TypedImplInterface implId | rest] -> listAppend
      (if declaredImplMatches implId statements then [] else [failure path TypedModuleInterfaceMismatch (TypedImplDetail implId)])
      (validateImplInterfaces path statements rest)
  }.

  valueExportPresent :: Text -> [TypedValueInterface] -> Bool.
  valueExportPresent = \(expected, interfaces) -> case interfaces {
    | [] -> False
    | [TypedValueInterface name scheme | rest] -> if coreNameIdentifierEqual expected name then True else valueExportPresent expected rest
  }.

  dataExportPresent :: Text -> [TypedDataInterface] -> Bool.
  dataExportPresent = \(expected, interfaces) -> case interfaces {
    | [] -> False
    | [TypedDataInterface declaration | rest] -> case declaration {
      | TypedDataDeclaration span name parameters constructors -> if coreNameIdentifierEqual expected name then True else dataExportPresent expected rest
    }
  }.

  classExportPresent :: Text -> [TypedClassInterface] -> Bool.
  classExportPresent = \(expected, interfaces) -> case interfaces {
    | [] -> False
    | [TypedClassInterface declaration | rest] -> case declaration {
      | TypedClassDeclaration span name parameters methods -> if coreNameIdentifierEqual expected name then True else classExportPresent expected rest
    }
  }.

  constructorExportPresentIn :: Text -> [TypedConstructorDeclaration] -> Bool.
  constructorExportPresentIn = \(expected, constructors) -> case constructors {
    | [] -> False
    | [TypedConstructorDeclaration binder name fields recipes | rest] -> if coreNameIdentifierEqual expected name then True else constructorExportPresentIn expected rest
  }.

  constructorExportPresent :: Text -> [TypedDataInterface] -> Bool.
  constructorExportPresent = \(expected, interfaces) -> case interfaces {
    | [] -> False
    | [TypedDataInterface declaration | rest] -> case declaration {
      | TypedDataDeclaration span name parameters constructors -> if constructorExportPresentIn expected constructors then True else constructorExportPresent expected rest
    }
  }.

  exportPresent :: TypedModuleExport -> TypedModuleInterface -> Bool.
  exportPresent = \(export, interface) -> case (export, interface) {
    | (TypedModuleExport namespace name, TypedModuleInterface values datas classes impls) -> case namespace {
      | TypedValueNamespace -> valueExportPresent name values
      | TypedTypeNamespace -> if dataExportPresent name datas then True else classExportPresent name classes
      | TypedConstructorNamespace -> constructorExportPresent name datas
      | TypedCapabilityNamespace -> classExportPresent name classes
    }
  }.

  validateExports :: TypedCoreValidationPath -> TypedModuleInterface -> [TypedModuleExport] -> [TypedCoreValidationFailure].
  validateExports = \(path, interface, exports) -> case exports {
    | [] -> []
    | [export | rest] -> case export {
      | TypedModuleExport namespace name -> listAppend
        (if exportPresent export interface then [] else [failure path TypedModuleInterfaceMismatch (TypedNameDetail (TypedResolvedName TypedCurrentModule namespace name))])
        (validateExports path interface rest)
    }
  }.

  validateModuleInterface :: [Text] -> TypedModuleInterface -> [TypedStatement] -> [TypedModuleExport] -> [TypedCoreValidationFailure].
  validateModuleInterface = \(modulePath, interface, statements, exports) -> case interface {
    | TypedModuleInterface values datas classes impls -> {
      path = TypedInterfacePath modulePath.
      listConcat
        [ validateValueInterfaces path statements values,
          validateDataInterfaces path statements datas,
          validateClassInterfaces path statements classes,
          validateImplInterfaces path statements impls,
          validateExports path interface exports
        ].
    }
  }.

  sourceSegmentsValid :: [Text] -> Bool.
  sourceSegmentsValid = \(segments) -> case segments {
    | [] -> True
    | [first | rest] -> if textIsEmpty first then False else if first == "." then False else if first == ".." then False else sourceSegmentsValid rest
  }.

  driveAbsolute :: Text -> Bool.
  driveAbsolute = \(sourcePath) -> case textToChars sourcePath {
    | [first | [':' | rest]] -> True
    | other -> False
  }.

  validRelativeSourcePath :: Text -> Bool.
  validRelativeSourcePath = \(sourcePath) -> if textIsEmpty sourcePath then False else
    if textStartsWith "/" sourcePath then False else
      if textContains "\\" sourcePath then False else if driveAbsolute sourcePath then False else sourceSegmentsValid (textSplit "/" sourcePath).

  validateSourcePath :: [Text] -> TypedSourcePath -> [TypedCoreValidationFailure].
  validateSourcePath = \(modulePath, sourcePathValue) -> case sourcePathValue {
    | TypedSourcePath sourcePath -> if validRelativeSourcePath sourcePath then [] else [failure (TypedModulePath modulePath) TypedInvalidSourcePath (TypedTextDetail sourcePath)]
  }.

  resolvedImportPaths :: [TypedResolvedImport] -> [[Text]].
  resolvedImportPaths = \(imports) -> case imports {
    | [] -> []
    | [TypedResolvedImport span modulePath alias names | rest] -> listPrepend modulePath (resolvedImportPaths rest)
  }.

  typedModulePath :: TypedModule -> [Text].
  typedModulePath = \(moduleValue) -> case moduleValue {
    | TypedModule modulePath sourcePath imports exports interface statements info -> modulePath
  }.

  modulePaths :: [TypedModule] -> [[Text]].
  modulePaths = \(modules) -> case modules {
    | [] -> []
    | [first | rest] -> listPrepend (typedModulePath first) (modulePaths rest)
  }.

  allModules :: Maybe(TypedModule) -> [TypedModule] -> [TypedModule].
  allModules = \(prelude, modules) -> case prelude {
    | Nothing -> modules
    | Just preludeModule -> listPrepend preludeModule modules
  }.

  findModule :: [Text] -> [TypedModule] -> Maybe(TypedModule).
  findModule = \(modulePath, modules) -> case modules {
    | [] -> Nothing
    | [first | rest] -> if textListEqual modulePath (typedModulePath first) then Just first else findModule modulePath rest
  }.

  selectedNameAllowed :: Maybe([Text]) -> TypedCoreName -> Bool.
  selectedNameAllowed = \(selectedNames, name) -> case selectedNames {
    | Nothing -> True
    | Just names -> case coreNameIdentifier name {
      | Nothing -> False
      | Just identifier -> listContains identifier names
    }
  }.

  importedVisibleModules :: [TypedResolvedImport] -> [TypedModule] -> [VisibleModule].
  importedVisibleModules = \(imports, completeModules) -> case imports {
    | [] -> []
    | [TypedResolvedImport span modulePath alias names | rest] -> case findModule modulePath completeModules {
      | Nothing -> importedVisibleModules rest completeModules
      | Just moduleValue -> listPrepend (VisibleModule names moduleValue) (importedVisibleModules rest completeModules)
    }
  }.

  visibleModulesFor :: Bool -> Maybe(TypedModule) -> [TypedResolvedImport] -> [TypedModule] -> [VisibleModule].
  visibleModulesFor = \(isPrelude, prelude, imports, completeModules) -> {
    imported = importedVisibleModules imports completeModules.
    if isPrelude then imported else case prelude {
      | Nothing -> imported
      | Just preludeModule -> listPrepend (VisibleModule Nothing preludeModule) imported
    }.
  }.

  valueInterfaceSchemeEntries :: Maybe([Text]) -> [TypedValueInterface] -> [SchemeEntry].
  valueInterfaceSchemeEntries = \(selectedNames, values) -> case values {
    | [] -> []
    | [TypedValueInterface name scheme | rest] -> case scheme {
      | TypedScheme binder parameters evidence primitive resultType resultRecipe ->
        if selectedNameAllowed selectedNames name then listPrepend (SchemeEntry binder scheme) (valueInterfaceSchemeEntries selectedNames rest) else valueInterfaceSchemeEntries selectedNames rest
    }
  }.

  selectedMethodSchemeEntries :: Maybe([Text]) -> [TypedMethodSignature] -> [SchemeEntry].
  selectedMethodSchemeEntries = \(selectedNames, methods) -> case methods {
    | [] -> []
    | [TypedMethodSignature name span scheme | rest] -> case scheme {
      | TypedScheme binder parameters evidence primitive resultType resultRecipe ->
        if selectedNameAllowed selectedNames name then listPrepend (SchemeEntry binder scheme) (selectedMethodSchemeEntries selectedNames rest) else selectedMethodSchemeEntries selectedNames rest
    }
  }.

  classInterfaceSchemeEntries :: Maybe([Text]) -> [TypedClassInterface] -> [SchemeEntry].
  classInterfaceSchemeEntries = \(selectedNames, classes) -> case classes {
    | [] -> []
    | [TypedClassInterface declaration | rest] -> case declaration {
      | TypedClassDeclaration span name parameters methods -> listAppend (selectedMethodSchemeEntries selectedNames methods) (classInterfaceSchemeEntries selectedNames rest)
    }
  }.

  interfaceSchemeEntries :: VisibleModule -> [SchemeEntry].
  interfaceSchemeEntries = \(visibleModule) -> case visibleModule {
    | VisibleModule selectedNames moduleValue -> case moduleValue {
      | TypedModule modulePath sourcePath imports exports interface statements info -> case interface {
        | TypedModuleInterface values datas classes impls -> listAppend (valueInterfaceSchemeEntries selectedNames values) (classInterfaceSchemeEntries selectedNames classes)
      }
    }
  }.

  visibleModuleSchemeEntries :: [VisibleModule] -> [SchemeEntry].
  visibleModuleSchemeEntries = \(modules) -> listConcat (listMap interfaceSchemeEntries modules).

  appendDefinitionNames :: [Text] -> [TypedCoreName] -> [NameEntry] -> [NameEntry].
  appendDefinitionNames = \(modulePath, names, entries) -> case names {
    | [] -> entries
    | [first | rest] -> appendDefinitionNames modulePath rest (appendDefinitionNameEntry modulePath first entries)
  }.

  localNameEntries :: [Text] -> [TypedStatement] -> [NameEntry].
  localNameEntries = \(modulePath, statements) -> appendDefinitionNames modulePath (statementsDefinedNames statements) [].

  constructorInterfaceNameEntries :: [Text] -> Maybe([Text]) -> [TypedConstructorDeclaration] -> [NameEntry] -> [NameEntry].
  constructorInterfaceNameEntries = \(modulePath, selectedNames, constructors, entries) -> case constructors {
    | [] -> entries
    | [TypedConstructorDeclaration binder name fields recipes | rest] -> constructorInterfaceNameEntries modulePath selectedNames rest (if selectedNameAllowed selectedNames name then appendDefinitionNameEntry modulePath name entries else entries)
  }.

  dataInterfaceNameEntries :: [Text] -> Maybe([Text]) -> [TypedDataInterface] -> [NameEntry] -> [NameEntry].
  dataInterfaceNameEntries = \(modulePath, selectedNames, datas, entries) -> case datas {
    | [] -> entries
    | [TypedDataInterface declaration | rest] -> case declaration {
      | TypedDataDeclaration span name parameters constructors -> dataInterfaceNameEntries modulePath selectedNames rest
        (constructorInterfaceNameEntries modulePath selectedNames constructors (if selectedNameAllowed selectedNames name then appendDefinitionNameEntry modulePath name entries else entries))
    }
  }.

  methodInterfaceNameEntries :: [Text] -> Maybe([Text]) -> [TypedMethodSignature] -> [NameEntry] -> [NameEntry].
  methodInterfaceNameEntries = \(modulePath, selectedNames, methods, entries) -> case methods {
    | [] -> entries
    | [TypedMethodSignature name span scheme | rest] -> methodInterfaceNameEntries modulePath selectedNames rest (if selectedNameAllowed selectedNames name then appendDefinitionNameEntry modulePath name entries else entries)
  }.

  classInterfaceNameEntries :: [Text] -> Maybe([Text]) -> [TypedClassInterface] -> [NameEntry] -> [NameEntry].
  classInterfaceNameEntries = \(modulePath, selectedNames, classes, entries) -> case classes {
    | [] -> entries
    | [TypedClassInterface declaration | rest] -> case declaration {
      | TypedClassDeclaration span name parameters methods -> classInterfaceNameEntries modulePath selectedNames rest
        (methodInterfaceNameEntries modulePath selectedNames methods (if selectedNameAllowed selectedNames name then appendDefinitionNameEntry modulePath name entries else entries))
    }
  }.

  valueInterfaceNameEntries :: [Text] -> Maybe([Text]) -> [TypedValueInterface] -> [NameEntry] -> [NameEntry].
  valueInterfaceNameEntries = \(modulePath, selectedNames, values, entries) -> case values {
    | [] -> entries
    | [TypedValueInterface name scheme | rest] -> valueInterfaceNameEntries modulePath selectedNames rest (if selectedNameAllowed selectedNames name then appendDefinitionNameEntry modulePath name entries else entries)
  }.

  interfaceNameEntries :: VisibleModule -> [NameEntry].
  interfaceNameEntries = \(visibleModule) -> case visibleModule {
    | VisibleModule selectedNames moduleValue -> case moduleValue {
      | TypedModule modulePath sourcePath imports exports interface statements info -> case interface {
        | TypedModuleInterface values datas classes impls -> classInterfaceNameEntries modulePath selectedNames classes
          (dataInterfaceNameEntries modulePath selectedNames datas (valueInterfaceNameEntries modulePath selectedNames values []))
      }
    }
  }.

  visibleModuleNameEntries :: [VisibleModule] -> [NameEntry].
  visibleModuleNameEntries = \(modules) -> listConcat (listMap interfaceNameEntries modules).

  localImplIds :: [TypedStatement] -> [TypedImplId].
  localImplIds = \(statements) -> case statements {
    | [] -> []
    | [first | rest] -> case first {
      | TypedImplStatement declaration -> case declaration {
        | TypedImplDeclaration span implId methods -> listPrepend implId (localImplIds rest)
      }
      | other -> localImplIds rest
    }
  }.

  interfaceImplIds :: VisibleModule -> [TypedImplId].
  interfaceImplIds = \(visibleModule) -> case visibleModule {
    | VisibleModule selectedNames moduleValue -> case moduleValue {
      | TypedModule modulePath sourcePath imports exports interface statements info -> case interface {
        | TypedModuleInterface values datas classes impls -> listMap (\(implInterface) -> case implInterface { | TypedImplInterface implId -> implId }) impls
      }
    }
  }.

  visibleModuleImplIds :: [VisibleModule] -> [TypedImplId].
  visibleModuleImplIds = \(modules) -> listConcat (listMap interfaceImplIds modules).

  appendDataEntry :: [Text] -> TypedCoreName -> [TypedTypeParameterId] -> [DataEntry] -> [DataEntry].
  appendDataEntry = \(modulePath, name, parameters, entries) -> case coreNameIdentifier name {
    | Nothing -> entries
    | Just identifier -> listAppend entries [DataEntry modulePath identifier (listLength parameters)]
  }.

  localDataEntries :: [Text] -> [TypedStatement] -> [DataEntry].
  localDataEntries = \(modulePath, statements) -> case statements {
    | [] -> []
    | [first | rest] -> case first {
      | TypedDataStatement declaration -> case declaration {
        | TypedDataDeclaration span name parameters constructors -> listPrepend (DataEntry modulePath (case coreNameIdentifier name { | Just identifier -> identifier | Nothing -> "" }) (listLength parameters)) (localDataEntries modulePath rest)
      }
      | other -> localDataEntries modulePath rest
    }
  }.

  selectedConstructorAllowed :: Maybe([Text]) -> [TypedConstructorDeclaration] -> Bool.
  selectedConstructorAllowed = \(selectedNames, constructors) -> case constructors {
    | [] -> False
    | [TypedConstructorDeclaration binder name fields recipes | rest] -> if selectedNameAllowed selectedNames name then True else selectedConstructorAllowed selectedNames rest
  }.

  interfaceDataEntriesFrom :: [Text] -> Maybe([Text]) -> [TypedDataInterface] -> [DataEntry].
  interfaceDataEntriesFrom = \(modulePath, selectedNames, datas) -> case datas {
    | [] -> []
    | [TypedDataInterface declaration | rest] -> case declaration {
      | TypedDataDeclaration span name parameters constructors ->
        if selectedNameAllowed selectedNames name then listPrepend (DataEntry modulePath (case coreNameIdentifier name { | Just identifier -> identifier | Nothing -> "" }) (listLength parameters)) (interfaceDataEntriesFrom modulePath selectedNames rest) else
          if selectedConstructorAllowed selectedNames constructors then listPrepend (DataEntry modulePath (case coreNameIdentifier name { | Just identifier -> identifier | Nothing -> "" }) (listLength parameters)) (interfaceDataEntriesFrom modulePath selectedNames rest) else interfaceDataEntriesFrom modulePath selectedNames rest
    }
  }.

  interfaceDataEntries :: VisibleModule -> [DataEntry].
  interfaceDataEntries = \(visibleModule) -> case visibleModule {
    | VisibleModule selectedNames moduleValue -> case moduleValue {
      | TypedModule modulePath sourcePath imports exports interface statements info -> case interface {
        | TypedModuleInterface values datas classes impls -> interfaceDataEntriesFrom modulePath selectedNames datas
      }
    }
  }.

  visibleModuleDataEntries :: [VisibleModule] -> [DataEntry].
  visibleModuleDataEntries = \(modules) -> listConcat (listMap interfaceDataEntries modules).

  duplicateModuleFailuresFrom :: [TypedModule] -> [[Text]] -> [TypedCoreValidationFailure] -> [TypedCoreValidationFailure].
  duplicateModuleFailuresFrom = \(modules, seen, reversed) -> case modules {
    | [] -> listReverse reversed
    | [first | rest] -> {
      modulePath = typedModulePath first.
      if modulePathMember modulePath seen then
        duplicateModuleFailuresFrom rest seen (listPrepend (failure (TypedModulePath modulePath) TypedDuplicateModule (TypedTextDetail (modulePathText modulePath))) reversed)
      else duplicateModuleFailuresFrom rest (listPrepend modulePath seen) reversed.
    }
  }.

  nodeInfoContractEqual :: TypedNodeInfo -> TypedNodeInfo -> Bool.
  nodeInfoContractEqual = \(left, right) -> if typeEqual (nodeType left) (nodeType right) then recipeEqual (nodeRecipe left) (nodeRecipe right) else False.

  nodeInfoIntrinsicValid :: TypedNodeInfo -> Bool.
  nodeInfoIntrinsicValid = \(info) -> case expectedRecipe (nodeType info) {
    | Nothing -> False
    | Just expected -> if recipeWidthValid (nodeRecipe info) then recipeEqual expected (nodeRecipe info) else False
  }.

  terminalExpressionInfo :: [TypedStatement] -> Maybe(TypedNodeInfo).
  terminalExpressionInfo = \(statements) -> case listReverse statements {
    | [TypedExpressionStatement span expression | rest] -> Just (expressionInfo expression)
    | other -> Nothing
  }.

  validateModuleInfo :: ModuleContext -> TypedCoreValidationPath -> [TypedStatement] -> TypedNodeInfo -> [TypedCoreValidationFailure].
  validateModuleInfo = \(context, path, statements, moduleInfo) -> case terminalExpressionInfo statements {
    | Just terminalInfo -> if nodeInfoContractEqual moduleInfo terminalInfo then [] else validateNodeInfo context path [] moduleInfo
    | Nothing -> validateNodeInfo context path [] moduleInfo
  }.

  validateModuleResult :: [Text] -> [TypedStatement] -> TypedNodeInfo -> [TypedCoreValidationFailure].
  validateModuleResult = \(modulePath, statements, moduleInfo) -> case terminalExpressionInfo statements {
    | Nothing -> []
    | Just terminalInfo -> if nodeInfoIntrinsicValid moduleInfo then if nodeInfoIntrinsicValid terminalInfo then
      if typeEqual (nodeType moduleInfo) (nodeType terminalInfo) then
        if recipeEqual (nodeRecipe moduleInfo) (nodeRecipe terminalInfo) then [] else [failure (TypedModulePath modulePath) TypedModuleResultMismatch (TypedRecipeDetail (nodeRecipe moduleInfo) (nodeRecipe terminalInfo))]
      else [failure (TypedModulePath modulePath) TypedModuleResultMismatch (TypedTypeDetail (nodeType moduleInfo) (nodeType terminalInfo))]
    else [] else []
  }.

  validateModule :: [TypedModule] -> Maybe(TypedModule) -> Bool -> TypedModule -> [TypedCoreValidationFailure].
  validateModule = \(completeModules, prelude, isPrelude, moduleValue) -> case moduleValue {
    | TypedModule modulePath sourcePath imports exports interface statements moduleInfo -> {
      externalModules = visibleModulesFor isPrelude prelude imports completeModules.
      visibleModules = listAppend [modulePath, ["Prelude"]] (resolvedImportPaths imports).
      schemes = listAppend (moduleSchemeEntries statements) (visibleModuleSchemeEntries externalModules).
      visibleNames = listAppend (localNameEntries modulePath statements) (visibleModuleNameEntries externalModules).
      visibleImpls = listAppend (localImplIds statements) (visibleModuleImplIds externalModules).
      dataEntries = listAppend (localDataEntries modulePath statements) (visibleModuleDataEntries externalModules).
      context = ModuleContext modulePath visibleModules schemes (statementIndexEntries statements) visibleNames visibleImpls dataEntries [].
      moduleValidationPath = if isPrelude then TypedPreludePath else TypedModulePath modulePath.
      listConcat
        [ validateSourcePath modulePath sourcePath,
          validateModuleInterface modulePath interface statements exports,
          duplicateBinderFailuresFrom modulePath statements 0 [],
          validateStatements context statements 0,
          validateModuleInfo context moduleValidationPath statements moduleInfo,
          validateModuleResult modulePath statements moduleInfo
        ].
    }
  }.

  validateModules :: [TypedModule] -> Maybe(TypedModule) -> [TypedModule] -> [TypedCoreValidationFailure].
  validateModules = \(completeModules, prelude, modules) -> case modules {
    | [] -> []
    | [first | rest] -> listAppend (validateModule completeModules prelude False first) (validateModules completeModules prelude rest)
  }.

  validatePrelude :: [TypedModule] -> Maybe(TypedModule) -> [TypedCoreValidationFailure].
  validatePrelude = \(completeModules, prelude) -> case prelude {
    | Nothing -> []
    | Just preludeModule -> validateModule completeModules prelude True preludeModule
  }.

  validateProgram :: TypedProgram -> [TypedCoreValidationFailure].
  validateProgram = \(program) -> case program {
    | TypedProgram prelude modules entryModule -> {
      completeModules = allModules prelude modules.
      paths = modulePaths completeModules.
      listConcat
        [ duplicateModuleFailuresFrom completeModules [] [],
          if modulePathMember entryModule paths then [] else [failure TypedProgramPath TypedUnknownEntryModule (TypedTextDetail (modulePathText entryModule))],
          validatePrelude completeModules prelude,
          validateModules completeModules prelude modules
        ].
    }
  }.
}
