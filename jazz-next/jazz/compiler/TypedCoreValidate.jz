module TypedCoreValidate (
  value validateProgram
) {
  import Char (charToUInt32).
  import List (listAll, listAppend, listConcat, listContains, listFilter, listIndexed, listLength, listMap, listPrepend, listReverse, listSort, listZip).
  import Maybe.
  import Text (textAppend, textContains, textIsEmpty, textJoin, textSplit, textStartsWith, textToChars, textUncons).
  import TypedCoreTypes.

  data SchemeEntry = SchemeEntry TypedBinderId TypedScheme.

  data StatementIndexEntry = StatementIndexEntry [Int] Int.

  data NameEntry = NameEntry [Text] TypedNameNamespace Text | GeneratedNameEntry TypedGeneratedNameKind.

  data MethodContract = MethodContract Text TypedScheme.

  data DataEntry = DataEntry [Text] Text Int | DataContractEntry [Text] Text [TypedTypeParameterId] [[TypedType]] | ConstructorEntry [Text] Text TypedBinderId Text [TypedTypeParameterId] [TypedType] | CapabilityEntry [Text] Text [TypedTypeParameterId] [MethodContract] | EvidenceCapabilityEntry TypedEvidenceParameterRef [Text] Text | ImplMethodEntry TypedImplId [Text] | LexicalContractEntry [Text] TypedNameNamespace Text TypedType TypedRepresentationRecipe | GeneratedLexicalContractEntry TypedGeneratedNameKind TypedType TypedRepresentationRecipe | PrimitiveConstraintEntry TypedPrimitiveConstraint.

  data DataMetadataDeclaration = DataMetadataDeclaration [Text] TypedDataDeclaration.

  data ConstructorContract = ConstructorContract TypedBinderId [Text] Text [TypedTypeParameterId] [TypedType].

  data DataContract = DataContract [TypedTypeParameterId] [[TypedType]].

  data CapabilityContract = CapabilityContract [TypedTypeParameterId] [MethodContract].

  data InstantiationContract = InstantiationContract TypedBinderId [TypedTypeParameterId] [TypedPrimitiveConstraint].

  data ValueContract = ValueContract TypedType TypedRepresentationRecipe.

  data DeclarationEntry = DeclarationEntry NameEntry TypedCoreName (Maybe(TypedBinderId)) | ImplDeclarationEntry TypedImplId.

  data VisibleModule = VisibleModule (Maybe([Text])) TypedModule.

  data ImportNameOrigin = ImportNameOrigin Text [Text].

  data ModuleContext = ModuleContext [Text] [[Text]] [SchemeEntry] [StatementIndexEntry] [NameEntry] [TypedImplId] [DataEntry] [TypedTypeParameterId].

  data PatternBinderContract = PatternBinderContract TypedBinderId TypedCoreName TypedType TypedRepresentationRecipe.

  data BinderOccurrence = BinderOccurrence TypedCoreValidationPath TypedBinderId.

  data AliasSummary = AliasSummary Bool Bool.

  data AliasBinding = AliasBinding NameEntry TypedExpr.

  data EvidenceBinding = EvidenceBinding TypedEvidenceParameterRef TypedCapabilityConstraint.

  data EqualityDataKey = EqualityDataKey [Text] Text.

  failure :: TypedCoreValidationPath -> TypedCoreValidationKind -> TypedCoreValidationDetail -> TypedCoreValidationFailure.
  failure = TypedCoreValidationFailure.

  textListEqual :: [Text] -> [Text] -> Bool.
  textListEqual = \(left, right) -> case (left, right) {
    | ([], []) -> True
    | ([leftFirst | leftRest], [rightFirst | rightRest]) -> if leftFirst == rightFirst then textListEqual leftRest rightRest else False
    | other -> False
  }.

  intListEqual :: [Int] -> [Int] -> Bool.
  intListEqual = \(left, right) -> case (left, right) {
    | ([], []) -> True
    | ([leftFirst | leftRest], [rightFirst | rightRest]) -> if leftFirst == rightFirst then intListEqual leftRest rightRest else False
    | other -> False
  }.

  nestedStatementLocation :: [Int] -> [Int] -> Int -> [Int].
  nestedStatementLocation = \(statementLocation, expressionPath, blockIndex) ->
    listConcat [statementLocation, [(0 - 1)], expressionPath, [(0 - 2), blockIndex]].

  statementIndexFor :: [Int] -> [StatementIndexEntry] -> Int.
  statementIndexFor = \(statementLocation, entries) -> case entries {
    | [] -> 0
    | [StatementIndexEntry candidateLocation statementIndex | rest] ->
      if intListEqual statementLocation candidateLocation then statementIndex else statementIndexFor statementLocation rest
  }.

  statementLocationFor :: Int -> [StatementIndexEntry] -> [Int].
  statementLocationFor = \(statementIndex, entries) -> case entries {
    | [] -> []
    | [StatementIndexEntry statementLocation candidateIndex | rest] ->
      if statementIndex == candidateIndex then statementLocation else statementLocationFor statementIndex rest
  }.

  modulePathMember :: [Text] -> [[Text]] -> Bool.
  modulePathMember = \(candidate, paths) -> case paths {
    | [] -> False
    | [first | rest] -> if textListEqual candidate first then True else modulePathMember candidate rest
  }.

  nameOriginEqual :: TypedNameOrigin -> TypedNameOrigin -> Bool.
  nameOriginEqual = \(left, right) -> case (left, right) {
    | (TypedCurrentModule, TypedCurrentModule) -> True
    | (TypedImportedModule leftPath, TypedImportedModule rightPath) -> textListEqual leftPath rightPath
    | (TypedAmbientPrelude, TypedAmbientPrelude) -> True
    | other -> False
  }.

  nameNamespaceEqual :: TypedNameNamespace -> TypedNameNamespace -> Bool.
  nameNamespaceEqual = \(left, right) -> case (left, right) {
    | (TypedValueNamespace, TypedValueNamespace) -> True
    | (TypedConstructorNamespace, TypedConstructorNamespace) -> True
    | (TypedTypeNamespace, TypedTypeNamespace) -> True
    | (TypedCapabilityNamespace, TypedCapabilityNamespace) -> True
    | other -> False
  }.

  nameNamespaceMember :: TypedNameNamespace -> [TypedNameNamespace] -> Bool.
  nameNamespaceMember = \(candidate, namespaces) -> case namespaces {
    | [] -> False
    | [first | rest] -> if nameNamespaceEqual candidate first then True else nameNamespaceMember candidate rest
  }.

  generatedNameKindEqual :: TypedGeneratedNameKind -> TypedGeneratedNameKind -> Bool.
  generatedNameKindEqual = \(left, right) -> case (left, right) {
    | (TypedLambdaPatternArgument leftIndex, TypedLambdaPatternArgument rightIndex) -> leftIndex == rightIndex
    | (TypedOperatorBinding leftSymbol, TypedOperatorBinding rightSymbol) -> leftSymbol == rightSymbol
    | (TypedOperatorSectionFunction, TypedOperatorSectionFunction) -> True
    | (TypedOperatorSectionLeft, TypedOperatorSectionLeft) -> True
    | (TypedOperatorSectionRight, TypedOperatorSectionRight) -> True
    | other -> False
  }.

  coreNameEqual :: TypedCoreName -> TypedCoreName -> Bool.
  coreNameEqual = \(left, right) -> case (left, right) {
    | (TypedUnresolvedSourceName leftName, TypedUnresolvedSourceName rightName) -> leftName == rightName
    | (TypedUnresolvedQualifiedName leftQualifier leftName, TypedUnresolvedQualifiedName rightQualifier rightName) -> if leftQualifier == rightQualifier then leftName == rightName else False
    | (TypedResolvedName leftOrigin leftNamespace leftName, TypedResolvedName rightOrigin rightNamespace rightName) -> if nameOriginEqual leftOrigin rightOrigin then if nameNamespaceEqual leftNamespace rightNamespace then leftName == rightName else False else False
    | (TypedBuiltinName leftName, TypedBuiltinName rightName) -> leftName == rightName
    | (TypedGeneratedName leftKind, TypedGeneratedName rightKind) -> generatedNameKindEqual leftKind rightKind
    | other -> False
  }.

  typeParameterIdValue :: TypedTypeParameterId -> Int.
  typeParameterIdValue = \(parameterId) -> case parameterId {
    | TypedTypeParameterId value -> value
  }.

  typeParameterIdEqual :: TypedTypeParameterId -> TypedTypeParameterId -> Bool.
  typeParameterIdEqual = \(left, right) -> typeParameterIdValue left == typeParameterIdValue right.

  evidenceParameterIdValue :: TypedEvidenceParameterId -> Int.
  evidenceParameterIdValue = \(parameterId) -> case parameterId {
    | TypedEvidenceParameterId value -> value
  }.

  evidenceParameterIdEqual :: TypedEvidenceParameterId -> TypedEvidenceParameterId -> Bool.
  evidenceParameterIdEqual = \(left, right) -> evidenceParameterIdValue left == evidenceParameterIdValue right.

  evidenceParameterRefId :: TypedEvidenceParameterRef -> TypedEvidenceParameterId.
  evidenceParameterRefId = \(parameterRef) -> case parameterRef {
    | TypedEvidenceParameterRef owner parameterId -> parameterId
  }.

  binderIdEqual :: TypedBinderId -> TypedBinderId -> Bool.
  binderIdEqual = \(left, right) -> case (left, right) {
    | (TypedBinderId leftModule leftLexical leftName, TypedBinderId rightModule rightLexical rightName) -> if textListEqual leftModule rightModule then if intListEqual leftLexical rightLexical then coreNameEqual leftName rightName else False else False
  }.

  evidenceParameterRefEqual :: TypedEvidenceParameterRef -> TypedEvidenceParameterRef -> Bool.
  evidenceParameterRefEqual = \(left, right) -> case (left, right) {
    | (TypedEvidenceParameterRef leftOwner leftId, TypedEvidenceParameterRef rightOwner rightId) ->
      if binderIdEqual leftOwner rightOwner then evidenceParameterIdEqual leftId rightId else False
  }.

  numericTypeEqual :: TypedNumericType -> TypedNumericType -> Bool.
  numericTypeEqual = \(left, right) -> case (left, right) {
    | (TypedInt8Type, TypedInt8Type) -> True
    | (TypedInt16Type, TypedInt16Type) -> True
    | (TypedInt32Type, TypedInt32Type) -> True
    | (TypedInt64Type, TypedInt64Type) -> True
    | (TypedUInt8Type, TypedUInt8Type) -> True
    | (TypedUInt16Type, TypedUInt16Type) -> True
    | (TypedUInt32Type, TypedUInt32Type) -> True
    | (TypedUInt64Type, TypedUInt64Type) -> True
    | (TypedFloat16Type, TypedFloat16Type) -> True
    | (TypedFloat32Type, TypedFloat32Type) -> True
    | (TypedFloat64Type, TypedFloat64Type) -> True
    | other -> False
  }.

  typeListEqual :: [TypedType] -> [TypedType] -> Bool.
  typeListEqual = \(left, right) -> case (left, right) {
    | ([], []) -> True
    | ([leftFirst | leftRest], [rightFirst | rightRest]) -> if typeEqual leftFirst rightFirst then typeListEqual leftRest rightRest else False
    | other -> False
  }.

  typeEqual :: TypedType -> TypedType -> Bool.
  typeEqual = \(left, right) -> case (left, right) {
    | (TypedIntType, TypedIntType) -> True
    | (TypedFloatType, TypedFloatType) -> True
    | (TypedNumericType leftNumeric, TypedNumericType rightNumeric) -> numericTypeEqual leftNumeric rightNumeric
    | (TypedBoolType, TypedBoolType) -> True
    | (TypedCharType, TypedCharType) -> True
    | (TypedTextType, TypedTextType) -> True
    | (TypedListType leftElement, TypedListType rightElement) -> typeEqual leftElement rightElement
    | (TypedTupleType leftElements, TypedTupleType rightElements) -> typeListEqual leftElements rightElements
    | (TypedDataType leftName leftArguments, TypedDataType rightName rightArguments) -> if coreNameEqual leftName rightName then typeListEqual leftArguments rightArguments else False
    | (TypedFunctionType leftArgument leftResult, TypedFunctionType rightArgument rightResult) -> if typeEqual leftArgument rightArgument then typeEqual leftResult rightResult else False
    | (TypedTypeParameterType leftId, TypedTypeParameterType rightId) -> typeParameterIdEqual leftId rightId
    | other -> False
  }.

  equalityDataKeyMember :: EqualityDataKey -> [EqualityDataKey] -> Bool.
  equalityDataKeyMember = \(candidate, keys) -> case (candidate, keys) {
    | (other, []) -> False
    | (EqualityDataKey candidatePath candidateName, [EqualityDataKey firstPath firstName | rest]) ->
      if textListEqual candidatePath firstPath then
        if candidateName == firstName then True else equalityDataKeyMember candidate rest
      else equalityDataKeyMember candidate rest
  }.

  recipeListEqual :: [TypedRepresentationRecipe] -> [TypedRepresentationRecipe] -> Bool.
  recipeListEqual = \(left, right) -> case (left, right) {
    | ([], []) -> True
    | ([leftFirst | leftRest], [rightFirst | rightRest]) -> if recipeEqual leftFirst rightFirst then recipeListEqual leftRest rightRest else False
    | other -> False
  }.

  recipeEqual :: TypedRepresentationRecipe -> TypedRepresentationRecipe -> Bool.
  recipeEqual = \(left, right) -> case (left, right) {
    | (TypedUnitRecipe, TypedUnitRecipe) -> True
    | (TypedBoolRecipe, TypedBoolRecipe) -> True
    | (TypedSignedIntegerRecipe leftWidth, TypedSignedIntegerRecipe rightWidth) -> leftWidth == rightWidth
    | (TypedUnsignedIntegerRecipe leftWidth, TypedUnsignedIntegerRecipe rightWidth) -> leftWidth == rightWidth
    | (TypedFloatRecipe leftWidth, TypedFloatRecipe rightWidth) -> leftWidth == rightWidth
    | (TypedCharRecipe, TypedCharRecipe) -> True
    | (TypedManagedTextRecipe, TypedManagedTextRecipe) -> True
    | (TypedManagedListRecipe leftElement, TypedManagedListRecipe rightElement) -> recipeEqual leftElement rightElement
    | (TypedManagedProductRecipe leftElements, TypedManagedProductRecipe rightElements) -> recipeListEqual leftElements rightElements
    | (TypedManagedVariantRecipe leftName leftArguments, TypedManagedVariantRecipe rightName rightArguments) -> if coreNameEqual leftName rightName then typeListEqual leftArguments rightArguments else False
    | (TypedClosureRecipe leftParameters leftResult, TypedClosureRecipe rightParameters rightResult) -> if recipeListEqual leftParameters rightParameters then recipeEqual leftResult rightResult else False
    | (TypedRepresentationParameterRecipe leftId, TypedRepresentationParameterRecipe rightId) -> typeParameterIdEqual leftId rightId
    | other -> False
  }.

  capabilityConstraintEqual :: TypedCapabilityConstraint -> TypedCapabilityConstraint -> Bool.
  capabilityConstraintEqual = \(left, right) -> case (left, right) {
    | (TypedCapabilityConstraint leftCapability leftMethod leftType, TypedCapabilityConstraint rightCapability rightMethod rightType) -> if leftCapability == rightCapability then if leftMethod == rightMethod then typeEqual leftType rightType else False else False
  }.

  implIdEqual :: TypedImplId -> TypedImplId -> Bool.
  implIdEqual = \(left, right) -> case (left, right) {
    | (TypedImplId leftModule leftCapability leftArguments, TypedImplId rightModule rightCapability rightArguments) -> if textListEqual leftModule rightModule then if coreNameEqual leftCapability rightCapability then typeListEqual leftArguments rightArguments else False else False
  }.

  methodIdEqual :: TypedMethodId -> TypedMethodId -> Bool.
  methodIdEqual = \(left, right) -> case (left, right) {
    | (TypedMethodId leftImpl leftName, TypedMethodId rightImpl rightName) -> if implIdEqual leftImpl rightImpl then leftName == rightName else False
  }.

  typeParameterIdMember :: TypedTypeParameterId -> [TypedTypeParameterId] -> Bool.
  typeParameterIdMember = \(candidate, identifiers) -> case identifiers {
    | [] -> False
    | [first | rest] -> if typeParameterIdEqual candidate first then True else typeParameterIdMember candidate rest
  }.

  evidenceParameterIdMember :: TypedEvidenceParameterId -> [TypedEvidenceParameterId] -> Bool.
  evidenceParameterIdMember = \(candidate, identifiers) -> case identifiers {
    | [] -> False
    | [first | rest] -> if evidenceParameterIdEqual candidate first then True else evidenceParameterIdMember candidate rest
  }.

  evidenceParameterRefMember :: TypedEvidenceParameterRef -> [TypedEvidenceParameterRef] -> Bool.
  evidenceParameterRefMember = \(candidate, identifiers) -> case identifiers {
    | [] -> False
    | [first | rest] -> if evidenceParameterRefEqual candidate first then True else evidenceParameterRefMember candidate rest
  }.

  binderIdMember :: TypedBinderId -> [TypedBinderId] -> Bool.
  binderIdMember = \(candidate, identifiers) -> case identifiers {
    | [] -> False
    | [first | rest] -> if binderIdEqual candidate first then True else binderIdMember candidate rest
  }.

  modulePathText :: [Text] -> Text.
  modulePathText = \(path) -> textJoin "::" path.

  coreNameIdentifier :: TypedCoreName -> Maybe(Text).
  coreNameIdentifier = \(name) -> case name {
    | TypedResolvedName origin namespace identifier -> Just identifier
    | TypedBuiltinName identifier -> Just identifier
    | other -> Nothing
  }.

  coreNameIdentifierEqual :: Text -> TypedCoreName -> Bool.
  coreNameIdentifierEqual = \(expected, name) -> case coreNameIdentifier name {
    | Nothing -> False
    | Just actual -> expected == actual
  }.

  originModulePath :: [Text] -> TypedNameOrigin -> [Text].
  originModulePath = \(currentModulePath, origin) -> case origin {
    | TypedCurrentModule -> currentModulePath
    | TypedImportedModule modulePath -> modulePath
    | TypedAmbientPrelude -> ["Prelude"]
  }.

  resolvedNameEntry :: [Text] -> TypedCoreName -> Maybe(NameEntry).
  resolvedNameEntry = \(currentModulePath, name) -> case name {
    | TypedResolvedName origin namespace identifier -> Just (NameEntry (originModulePath currentModulePath origin) namespace identifier)
    | TypedGeneratedName kind -> Just (GeneratedNameEntry kind)
    | other -> Nothing
  }.

  definitionNameEntry :: [Text] -> TypedCoreName -> Maybe(NameEntry).
  definitionNameEntry = \(modulePath, name) -> case name {
    | TypedResolvedName origin namespace identifier -> Just (NameEntry modulePath namespace identifier)
    | TypedGeneratedName kind -> Just (GeneratedNameEntry kind)
    | other -> Nothing
  }.

  nameEntryEqual :: NameEntry -> NameEntry -> Bool.
  nameEntryEqual = \(left, right) -> case (left, right) {
    | (NameEntry leftPath leftNamespace leftName, NameEntry rightPath rightNamespace rightName) ->
      if textListEqual leftPath rightPath then if nameNamespaceEqual leftNamespace rightNamespace then leftName == rightName else False else False
    | (GeneratedNameEntry leftKind, GeneratedNameEntry rightKind) -> generatedNameKindEqual leftKind rightKind
    | other -> False
  }.

  nameEntryMember :: NameEntry -> [NameEntry] -> Bool.
  nameEntryMember = \(candidate, entries) -> case entries {
    | [] -> False
    | [first | rest] -> if nameEntryEqual candidate first then True else nameEntryMember candidate rest
  }.

  appendResolvedNameEntry :: [Text] -> TypedCoreName -> [NameEntry] -> [NameEntry].
  appendResolvedNameEntry = \(modulePath, name, entries) -> case resolvedNameEntry modulePath name {
    | Nothing -> entries
    | Just entry -> if nameEntryMember entry entries then entries else listAppend entries [entry]
  }.

  appendDefinitionNameEntry :: [Text] -> TypedCoreName -> [NameEntry] -> [NameEntry].
  appendDefinitionNameEntry = \(modulePath, name, entries) -> case definitionNameEntry modulePath name {
    | Nothing -> entries
    | Just entry -> if nameEntryMember entry entries then entries else listAppend entries [entry]
  }.

  implIdMember :: TypedImplId -> [TypedImplId] -> Bool.
  implIdMember = \(candidate, identifiers) -> case identifiers {
    | [] -> False
    | [first | rest] -> if implIdEqual candidate first then True else implIdMember candidate rest
  }.

  dataEntryMatches :: [Text] -> Text -> DataEntry -> Bool.
  dataEntryMatches = \(modulePath, identifier, entry) -> case entry {
    | DataEntry candidatePath candidateIdentifier arity -> if textListEqual modulePath candidatePath then identifier == candidateIdentifier else False
    | other -> False
  }.

  lookupDataArity :: [Text] -> Text -> [DataEntry] -> Maybe(Int).
  lookupDataArity = \(modulePath, identifier, entries) -> case entries {
    | [] -> Nothing
    | [first | rest] -> if dataEntryMatches modulePath identifier first then case first {
      | DataEntry path name arity -> Just arity
      | other -> lookupDataArity modulePath identifier rest
    } else lookupDataArity modulePath identifier rest
  }.

  lookupDataContract :: [Text] -> Text -> [DataEntry] -> Maybe(DataContract).
  lookupDataContract = \(modulePath, identifier, entries) -> case entries {
    | [] -> Nothing
    | [first | rest] -> case first {
      | DataContractEntry candidatePath candidateIdentifier parameters constructors ->
        if textListEqual modulePath candidatePath then if identifier == candidateIdentifier then Just (DataContract parameters constructors) else lookupDataContract modulePath identifier rest else lookupDataContract modulePath identifier rest
      | other -> lookupDataContract modulePath identifier rest
    }
  }.

  lookupConstructorContract :: [Text] -> Text -> [DataEntry] -> Maybe(ConstructorContract).
  lookupConstructorContract = \(modulePath, identifier, entries) -> case entries {
    | [] -> Nothing
    | [first | rest] -> case first {
      | ConstructorEntry candidatePath candidateIdentifier binder dataIdentifier parameters fields ->
        if textListEqual modulePath candidatePath then if identifier == candidateIdentifier then Just (ConstructorContract binder candidatePath dataIdentifier parameters fields) else lookupConstructorContract modulePath identifier rest else lookupConstructorContract modulePath identifier rest
      | other -> lookupConstructorContract modulePath identifier rest
    }
  }.

  lookupConstructorContractByOwner :: TypedBinderId -> [DataEntry] -> Maybe(ConstructorContract).
  lookupConstructorContractByOwner = \(owner, entries) -> case entries {
    | [] -> Nothing
    | [first | rest] -> case first {
      | ConstructorEntry candidatePath candidateIdentifier binder dataIdentifier parameters fields ->
        if binderIdEqual owner binder then
          Just (ConstructorContract binder candidatePath dataIdentifier parameters fields)
        else
          lookupConstructorContractByOwner owner rest
      | other -> lookupConstructorContractByOwner owner rest
    }
  }.

  lookupCapabilityContract :: [Text] -> Text -> [DataEntry] -> Maybe(CapabilityContract).
  lookupCapabilityContract = \(modulePath, identifier, entries) -> case entries {
    | [] -> Nothing
    | [first | rest] -> case first {
      | CapabilityEntry candidatePath candidateIdentifier parameters methods ->
        if textListEqual modulePath candidatePath then if identifier == candidateIdentifier then Just (CapabilityContract parameters methods) else lookupCapabilityContract modulePath identifier rest else lookupCapabilityContract modulePath identifier rest
      | other -> lookupCapabilityContract modulePath identifier rest
    }
  }.

  lookupEvidenceCapability :: TypedEvidenceParameterRef -> [DataEntry] -> Maybe(NameEntry).
  lookupEvidenceCapability = \(parameterRef, entries) -> case entries {
    | [] -> Nothing
    | [first | rest] -> case first {
      | EvidenceCapabilityEntry candidateRef modulePath identifier ->
        if evidenceParameterRefEqual parameterRef candidateRef then
          Just (NameEntry modulePath TypedCapabilityNamespace identifier)
        else lookupEvidenceCapability parameterRef rest
      | other -> lookupEvidenceCapability parameterRef rest
    }
  }.

  lookupLexicalContract :: [Text] -> TypedCoreName -> [DataEntry] -> Maybe(ValueContract).
  lookupLexicalContract = \(modulePath, name, entries) -> case (resolvedNameEntry modulePath name, entries) {
    | (Nothing, other) -> Nothing
    | (Just expected, []) -> Nothing
    | (Just expected, [first | rest]) -> case first {
      | LexicalContractEntry candidatePath candidateNamespace candidateIdentifier typeValue recipe ->
        if nameEntryEqual expected (NameEntry candidatePath candidateNamespace candidateIdentifier) then Just (ValueContract typeValue recipe) else lookupLexicalContract modulePath name rest
      | GeneratedLexicalContractEntry candidateKind typeValue recipe ->
        if nameEntryEqual expected (GeneratedNameEntry candidateKind) then Just (ValueContract typeValue recipe) else lookupLexicalContract modulePath name rest
      | other -> lookupLexicalContract modulePath name rest
    }
  }.

  lookupImplMethods :: TypedImplId -> [DataEntry] -> Maybe([Text]).
  lookupImplMethods = \(implId, entries) -> case entries {
    | [] -> Nothing
    | [first | rest] -> case first {
      | ImplMethodEntry candidate methods -> if implIdEqual implId candidate then Just methods else lookupImplMethods implId rest
      | other -> lookupImplMethods implId rest
    }
  }.

  primitiveConstraintEntries :: [TypedPrimitiveConstraint] -> [DataEntry].
  primitiveConstraintEntries = \(constraints) -> case constraints {
    | [] -> []
    | [first | rest] -> listPrepend (PrimitiveConstraintEntry first) (primitiveConstraintEntries rest)
  }.

  activePrimitiveConstraintsFrom :: [DataEntry] -> [TypedPrimitiveConstraint].
  activePrimitiveConstraintsFrom = \(entries) -> case entries {
    | [] -> []
    | [first | rest] -> case first {
      | PrimitiveConstraintEntry constraint -> listPrepend constraint (activePrimitiveConstraintsFrom rest)
      | other -> activePrimitiveConstraintsFrom rest
    }
  }.

  activePrimitiveConstraints :: ModuleContext -> [TypedPrimitiveConstraint].
  activePrimitiveConstraints = \(context) -> case context {
    | ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope ->
      activePrimitiveConstraintsFrom dataEntries
  }.

  withSchemeScope :: TypedScheme -> ModuleContext -> ModuleContext.
  withSchemeScope = \(scheme, context) -> case (scheme, context) {
    | (TypedScheme owner typeParameters evidence primitiveConstraints resultType resultRecipe, ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries oldScope) ->
      ModuleContext
        modulePath
        visibleModules
        schemes
        statementIndices
        visibleNames
        visibleImpls
        (listAppend (primitiveConstraintEntries primitiveConstraints) dataEntries)
        (listAppend typeParameters oldScope)
  }.

  withVisibleName :: TypedCoreName -> ModuleContext -> ModuleContext.
  withVisibleName = \(name, context) -> case context {
    | ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope -> ModuleContext modulePath visibleModules schemes statementIndices (appendResolvedNameEntry modulePath name visibleNames) visibleImpls dataEntries typeScope
  }.

  withVisibleNames :: [TypedCoreName] -> ModuleContext -> ModuleContext.
  withVisibleNames = \(names, context) -> case names {
    | [] -> context
    | [first | rest] -> withVisibleNames rest (withVisibleName first context)
  }.

  withLexicalContract :: TypedCoreName -> TypedType -> TypedRepresentationRecipe -> ModuleContext -> ModuleContext.
  withLexicalContract = \(name, typeValue, recipe, context) -> case context {
    | ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope -> case resolvedNameEntry modulePath name {
      | Nothing -> withVisibleName name context
      | Just entry -> case entry {
        | NameEntry namePath namespace identifier -> ModuleContext
          modulePath
          visibleModules
          schemes
          statementIndices
          (appendResolvedNameEntry modulePath name visibleNames)
          visibleImpls
          (listPrepend (LexicalContractEntry namePath namespace identifier typeValue recipe) dataEntries)
          typeScope
        | GeneratedNameEntry kind -> ModuleContext
          modulePath
          visibleModules
          schemes
          statementIndices
          (appendResolvedNameEntry modulePath name visibleNames)
          visibleImpls
          (listPrepend (GeneratedLexicalContractEntry kind typeValue recipe) dataEntries)
          typeScope
      }
    }
  }.

  validateBinderDefinition :: ModuleContext -> TypedCoreValidationPath -> TypedBinderId -> TypedCoreName -> [TypedCoreValidationFailure].
  validateBinderDefinition = \(context, path, binder, publishedName) -> case (context, binder) {
    | (ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope, TypedBinderId binderModule lexicalPath embeddedName) ->
      if textListEqual modulePath binderModule then if coreNameEqual embeddedName publishedName then [] else [failure path TypedUnknownBinder (TypedBinderDetail binder)] else [failure path TypedUnknownBinder (TypedBinderDetail binder)]
  }.

  validateCoreName :: TypedCoreValidationPath -> TypedCoreName -> [TypedCoreValidationFailure].
  validateCoreName = \(path, name) -> case name {
    | TypedUnresolvedSourceName source -> [failure path TypedUnresolvedName (TypedNameDetail name)]
    | TypedUnresolvedQualifiedName qualifier member -> [failure path TypedUnresolvedName (TypedNameDetail name)]
    | TypedResolvedName origin namespace identifier ->
      if textIsEmpty identifier then [failure path TypedUnresolvedName (TypedNameDetail name)] else []
    | TypedGeneratedName generated -> case generated {
      | TypedLambdaPatternArgument index ->
        if index < 0 then [failure path TypedUnresolvedName (TypedNameDetail name)] else []
      | TypedOperatorBinding bindingName ->
        if textStartsWith "$operator:" bindingName then
          if bindingName == "$operator:" then [failure path TypedUnresolvedName (TypedNameDetail name)] else []
        else [failure path TypedUnresolvedName (TypedNameDetail name)]
      | other -> []
    }
    | other -> []
  }.

  validateLocalDefinitionName :: ModuleContext -> [TypedNameNamespace] -> TypedCoreValidationPath -> TypedCoreName -> [TypedCoreValidationFailure].
  validateLocalDefinitionName = \(context, allowedNamespaces, path, name) -> case context {
    | ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope -> listAppend
      (validateCoreName path name)
      (case name {
        | TypedResolvedName TypedCurrentModule namespace identifier -> if nameNamespaceMember namespace allowedNamespaces then [] else [failure path TypedInvisibleName (TypedNameDetail name)]
        | TypedResolvedName TypedAmbientPrelude namespace identifier -> if textListEqual modulePath ["Prelude"] then if nameNamespaceMember namespace allowedNamespaces then [] else [failure path TypedInvisibleName (TypedNameDetail name)] else [failure path TypedInvisibleName (TypedNameDetail name)]
        | TypedGeneratedName kind -> if nameNamespaceMember TypedValueNamespace allowedNamespaces then [] else [failure path TypedInvisibleName (TypedNameDetail name)]
        | TypedUnresolvedSourceName source -> []
        | TypedUnresolvedQualifiedName qualifier member -> []
        | other -> [failure path TypedInvisibleName (TypedNameDetail name)]
      })
  }.

  knownBuiltinName :: Text -> Bool.
  knownBuiltinName = \(identifier) ->
    listContains identifier
      [ "map", "filter", "hd", "tl", "print!", "toInt8", "toInt16", "toInt32", "toInt64", "toUInt8", "toUInt16", "toUInt32", "toUInt64", "toFloat16", "toFloat32", "toFloat64",
        "__kernel_map", "__kernel_filter", "__kernel_hd", "__kernel_tl", "__kernel_print!", "__kernel_toInt8", "__kernel_toInt16", "__kernel_toInt32", "__kernel_toInt64", "__kernel_toUInt8", "__kernel_toUInt16", "__kernel_toUInt32", "__kernel_toUInt64", "__kernel_toFloat16", "__kernel_toFloat32", "__kernel_toFloat64", "__kernel_listPrependRaw", "__kernel_listReverseRaw", "__kernel_charToUInt32", "__kernel_charFromUInt32Raw", "__kernel_charIsAlpha", "__kernel_charIsAlphaNum", "__kernel_charIsDigit", "__kernel_charIsSpace", "__kernel_charIsHexDigit", "__kernel_charIsLower", "__kernel_charIsUpper", "__kernel_charToLower", "__kernel_charToUpper", "__kernel_textLength", "__kernel_textUnconsRaw", "__kernel_textAppend", "__kernel_textAppendChar", "__kernel_textFromChars", "__kernel_textConcat", "__kernel_renderValue", "__kernel_readTextRaw!", "__kernel_writeTextRaw!", "__kernel_readStdinRaw!", "__kernel_writeStdoutRaw!", "__kernel_writeStderrRaw!", "__kernel_arguments!", "__kernel_exit!"
      ].

  validateVisibleNameInNamespaces :: [TypedNameNamespace] -> ModuleContext -> TypedCoreValidationPath -> TypedCoreName -> [TypedCoreValidationFailure].
  validateVisibleNameInNamespaces = \(allowedNamespaces, context, path, name) -> case context {
    | ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope -> listAppend
      (validateCoreName path name)
      (case (name, resolvedNameEntry modulePath name) {
        | (TypedBuiltinName identifier, other) ->
          if nameNamespaceMember TypedValueNamespace allowedNamespaces then if knownBuiltinName identifier then [] else [failure path TypedInvisibleName (TypedNameDetail name)] else [failure path TypedInvisibleName (TypedNameDetail name)]
        | (TypedResolvedName origin namespace identifier, Just entry) ->
          case origin {
            | TypedImportedModule importedPath ->
              if textListEqual importedPath modulePath then [failure path TypedInvisibleName (TypedNameDetail name)] else
                if textListEqual importedPath ["Prelude"] then [failure path TypedInvisibleName (TypedNameDetail name)] else
                  if modulePathMember importedPath visibleModules then
                    if nameNamespaceMember namespace allowedNamespaces then
                      if nameEntryMember entry visibleNames then [] else [failure path TypedInvisibleName (TypedNameDetail name)]
                    else [failure path TypedInvisibleName (TypedNameDetail name)]
                  else [failure path TypedInvisibleName (TypedNameDetail name)]
            | other ->
              if nameNamespaceMember namespace allowedNamespaces then
                if nameEntryMember entry visibleNames then [] else [failure path TypedInvisibleName (TypedNameDetail name)]
              else [failure path TypedInvisibleName (TypedNameDetail name)]
          }
        | (TypedGeneratedName kind, Just entry) ->
          if nameNamespaceMember TypedValueNamespace allowedNamespaces then
            if nameEntryMember entry visibleNames then [] else [failure path TypedInvisibleName (TypedNameDetail name)]
          else [failure path TypedInvisibleName (TypedNameDetail name)]
        | other -> []
      })
  }.

  builtinOperatorHasTypedRule :: Text -> Bool.
  builtinOperatorHasTypedRule = \(symbol) -> listContains symbol ["+", "-", "*", "/", "<", "<=", ">", ">=", "==", "!=", "$"].

  operatorBindingCharacter :: Char -> Text.
  operatorBindingCharacter = \(character) -> if character == '!' then "%21" else
    if character == '%' then "%25" else
    if character == '&' then "%26" else
    if character == '*' then "%2A" else
    if character == '+' then "%2B" else
    if character == '-' then "%2D" else
    if character == '/' then "%2F" else
    if character == '<' then "%3C" else
    if character == '>' then "%3E" else
    if character == '?' then "%3F" else
    if character == '^' then "%5E" else
    if character == '|' then "%7C" else "%7E".

  operatorBindingSuffix :: Text -> Text.
  operatorBindingSuffix = \(symbol) -> case textUncons symbol {
    | Nothing -> ""
    | Just (first, rest) -> textAppend (operatorBindingCharacter first) (operatorBindingSuffix rest)
  }.

  resolvedOperatorMatchesSymbol :: TypedCoreName -> Text -> Bool.
  resolvedOperatorMatchesSymbol = \(name, symbol) -> case name {
    | TypedGeneratedName generated -> case generated {
      | TypedOperatorBinding bindingName -> bindingName == textAppend "$operator:" (operatorBindingSuffix symbol)
      | other -> False
    }
    | other -> False
  }.

  validateOperatorRef :: ModuleContext -> TypedCoreValidationPath -> TypedOperatorRef -> [TypedCoreValidationFailure].
  validateOperatorRef = \(context, path, operator) -> case operator {
    | TypedBuiltinOperator symbol -> if builtinOperatorHasTypedRule symbol then [] else [failure path TypedBindingValueMismatch (TypedTextDetail symbol)]
    | TypedResolvedOperator name symbol -> listAppend
      (validateVisibleNameInNamespaces [TypedValueNamespace] context path name)
      (if resolvedOperatorMatchesSymbol name symbol then [] else [failure path TypedBindingValueMismatch (TypedTextDetail symbol)])
  }.

  numericRecipe :: TypedNumericType -> TypedRepresentationRecipe.
  numericRecipe = \(numericType) -> case numericType {
    | TypedInt8Type -> TypedSignedIntegerRecipe 8
    | TypedInt16Type -> TypedSignedIntegerRecipe 16
    | TypedInt32Type -> TypedSignedIntegerRecipe 32
    | TypedInt64Type -> TypedSignedIntegerRecipe 64
    | TypedUInt8Type -> TypedUnsignedIntegerRecipe 8
    | TypedUInt16Type -> TypedUnsignedIntegerRecipe 16
    | TypedUInt32Type -> TypedUnsignedIntegerRecipe 32
    | TypedUInt64Type -> TypedUnsignedIntegerRecipe 64
    | TypedFloat16Type -> TypedFloatRecipe 16
    | TypedFloat32Type -> TypedFloatRecipe 32
    | TypedFloat64Type -> TypedFloatRecipe 64
  }.

  flattenFunctionParameters :: TypedType -> [TypedType].
  flattenFunctionParameters = \(typeValue) -> case typeValue {
    | TypedFunctionType argument result -> listPrepend argument (flattenFunctionParameters result)
    | other -> []
  }.

  flattenFunctionResult :: TypedType -> TypedType.
  flattenFunctionResult = \(typeValue) -> case typeValue {
    | TypedFunctionType argument result -> flattenFunctionResult result
    | other -> other
  }.

  expectedRecipes :: [TypedType] -> Maybe([TypedRepresentationRecipe]).
  expectedRecipes = \(types) -> case types {
    | [] -> Just []
    | [first | rest] -> case (expectedRecipe first, expectedRecipes rest) {
      | (Just firstRecipe, Just restRecipes) -> Just (listPrepend firstRecipe restRecipes)
      | other -> Nothing
    }
  }.

  expectedRecipe :: TypedType -> Maybe(TypedRepresentationRecipe).
  expectedRecipe = \(typeValue) -> case typeValue {
    | TypedIntType -> Just (TypedSignedIntegerRecipe 64)
    | TypedFloatType -> Just (TypedFloatRecipe 64)
    | TypedNumericType numericType -> Just (numericRecipe numericType)
    | TypedBoolType -> Just TypedBoolRecipe
    | TypedCharType -> Just TypedCharRecipe
    | TypedTextType -> Just TypedManagedTextRecipe
    | TypedListType elementType -> case expectedRecipe elementType {
      | Nothing -> Nothing
      | Just elementRecipe -> Just (TypedManagedListRecipe elementRecipe)
    }
    | TypedTupleType elementTypes -> case elementTypes {
      | [] -> Just TypedUnitRecipe
      | other -> case expectedRecipes elementTypes {
        | Nothing -> Nothing
        | Just elementRecipes -> Just (TypedManagedProductRecipe elementRecipes)
      }
    }
    | TypedDataType name arguments -> Just (TypedManagedVariantRecipe name arguments)
    | TypedFunctionType argument result -> case (expectedRecipes (flattenFunctionParameters typeValue), expectedRecipe (flattenFunctionResult typeValue)) {
      | (Just parameterRecipes, Just resultRecipe) -> Just (TypedClosureRecipe parameterRecipes resultRecipe)
      | other -> Nothing
    }
    | TypedTypeParameterType parameterId -> Just (TypedRepresentationParameterRecipe parameterId)
  }.

  isFunctionType :: TypedType -> Bool.
  isFunctionType = \(typeValue) -> case typeValue {
    | TypedFunctionType argument result -> True
    | other -> False
  }.

  validSignedWidth :: Int -> Bool.
  validSignedWidth = \(width) -> if width == 8 then True else if width == 16 then True else if width == 32 then True else width == 64.

  validFloatWidth :: Int -> Bool.
  validFloatWidth = \(width) -> if width == 16 then True else if width == 32 then True else width == 64.

  invalidRecipeWidth :: TypedRepresentationRecipe -> Maybe(Int).
  invalidRecipeWidth = \(recipe) -> case recipe {
    | TypedSignedIntegerRecipe width -> if validSignedWidth width then Nothing else Just width
    | TypedUnsignedIntegerRecipe width -> if validSignedWidth width then Nothing else Just width
    | TypedFloatRecipe width -> if validFloatWidth width then Nothing else Just width
    | TypedManagedListRecipe elementRecipe -> invalidRecipeWidth elementRecipe
    | TypedManagedProductRecipe elementRecipes -> invalidRecipeWidths elementRecipes
    | TypedClosureRecipe parameters result -> case invalidRecipeWidths parameters {
      | Just width -> Just width
      | Nothing -> invalidRecipeWidth result
    }
    | other -> Nothing
  }.

  invalidRecipeWidths :: [TypedRepresentationRecipe] -> Maybe(Int).
  invalidRecipeWidths = \(recipes) -> case recipes {
    | [] -> Nothing
    | [first | rest] -> case invalidRecipeWidth first {
      | Just width -> Just width
      | Nothing -> invalidRecipeWidths rest
    }
  }.

  recipeWidthValid :: TypedRepresentationRecipe -> Bool.
  recipeWidthValid = \(recipe) -> case invalidRecipeWidth recipe {
    | Nothing -> True
    | Just width -> False
  }.

  hasUnboundTypeParameter :: [TypedTypeParameterId] -> TypedType -> Bool.
  hasUnboundTypeParameter = \(scope, typeValue) -> case typeValue {
    | TypedListType elementType -> hasUnboundTypeParameter scope elementType
    | TypedTupleType elementTypes -> anyUnboundTypes scope elementTypes
    | TypedDataType name arguments -> anyUnboundTypes scope arguments
    | TypedFunctionType argument result -> if hasUnboundTypeParameter scope argument then True else hasUnboundTypeParameter scope result
    | TypedTypeParameterType parameterId -> if typeParameterIdMember parameterId scope then False else True
    | other -> False
  }.

  anyUnboundTypes :: [TypedTypeParameterId] -> [TypedType] -> Bool.
  anyUnboundTypes = \(scope, types) -> case types {
    | [] -> False
    | [first | rest] -> if hasUnboundTypeParameter scope first then True else anyUnboundTypes scope rest
  }.

  hasUnboundRepresentationParameter :: [TypedTypeParameterId] -> TypedRepresentationRecipe -> Bool.
  hasUnboundRepresentationParameter = \(scope, recipe) -> case recipe {
    | TypedManagedListRecipe elementRecipe -> hasUnboundRepresentationParameter scope elementRecipe
    | TypedManagedProductRecipe elementRecipes -> anyUnboundRecipes scope elementRecipes
    | TypedClosureRecipe parameters result -> if anyUnboundRecipes scope parameters then True else hasUnboundRepresentationParameter scope result
    | TypedRepresentationParameterRecipe parameterId -> if typeParameterIdMember parameterId scope then False else True
    | other -> False
  }.

  anyUnboundRecipes :: [TypedTypeParameterId] -> [TypedRepresentationRecipe] -> Bool.
  anyUnboundRecipes = \(scope, recipes) -> case recipes {
    | [] -> False
    | [first | rest] -> if hasUnboundRepresentationParameter scope first then True else anyUnboundRecipes scope rest
  }.

  validateType :: TypedCoreValidationPath -> [TypedTypeParameterId] -> TypedType -> [TypedCoreValidationFailure].
  validateType = \(path, scope, typeValue) -> case typeValue {
    | TypedListType elementType -> validateType path scope elementType
    | TypedTupleType elementTypes -> validateTypes path scope elementTypes
    | TypedDataType name arguments -> listAppend (validateCoreName path name) (validateTypes path scope arguments)
    | TypedFunctionType argument result -> listAppend (validateType path scope argument) (validateType path scope result)
    | TypedTypeParameterType parameterId -> if typeParameterIdMember parameterId scope then [] else [failure path TypedUnboundTypeParameter (TypedTypeParameterDetail parameterId)]
    | other -> []
  }.

  validateTypes :: TypedCoreValidationPath -> [TypedTypeParameterId] -> [TypedType] -> [TypedCoreValidationFailure].
  validateTypes = \(path, scope, types) -> case types {
    | [] -> []
    | [first | rest] -> listAppend (validateType path scope first) (validateTypes path scope rest)
  }.

  validateRecipe :: TypedCoreValidationPath -> [TypedTypeParameterId] -> TypedRepresentationRecipe -> [TypedCoreValidationFailure].
  validateRecipe = \(path, scope, recipe) -> listAppend
    (case invalidRecipeWidth recipe {
      | Nothing -> []
      | Just width -> [failure path TypedInvalidRepresentationWidth (TypedIndexDetail width)]
    })
    (case recipe {
      | TypedManagedListRecipe elementRecipe -> validateRecipe path scope elementRecipe
      | TypedManagedProductRecipe elementRecipes -> validateRecipes path scope elementRecipes
      | TypedManagedVariantRecipe name arguments -> listAppend (validateCoreName path name) (validateTypes path scope arguments)
      | TypedClosureRecipe parameters result -> listAppend (validateRecipes path scope parameters) (validateRecipe path scope result)
      | TypedRepresentationParameterRecipe parameterId -> if typeParameterIdMember parameterId scope then [] else [failure path TypedUnboundRepresentationParameter (TypedTypeParameterDetail parameterId)]
      | other -> []
    }).

  validateRecipes :: TypedCoreValidationPath -> [TypedTypeParameterId] -> [TypedRepresentationRecipe] -> [TypedCoreValidationFailure].
  validateRecipes = \(path, scope, recipes) -> case recipes {
    | [] -> []
    | [first | rest] -> listAppend (validateRecipe path scope first) (validateRecipes path scope rest)
  }.

  validateTypeRecipe :: TypedCoreValidationPath -> [TypedTypeParameterId] -> TypedType -> TypedRepresentationRecipe -> [TypedCoreValidationFailure].
  validateTypeRecipe = \(path, scope, typeValue, recipe) -> if recipeWidthValid recipe then
    if hasUnboundTypeParameter scope typeValue then [] else
    if hasUnboundRepresentationParameter scope recipe then [] else case expectedRecipe typeValue {
      | Nothing -> []
      | Just expected -> if recipeEqual expected recipe then [] else
        [failure path (if isFunctionType typeValue then TypedCallableRecipeMismatch else TypedTypeRepresentationMismatch) (TypedRecipeDetail expected recipe)]
    }
  else [].

  validateCapabilityConstraint :: TypedCoreValidationPath -> [TypedTypeParameterId] -> TypedCapabilityConstraint -> [TypedCoreValidationFailure].
  validateCapabilityConstraint = \(path, scope, constraint) -> case constraint {
    | TypedCapabilityConstraint capability method targetType -> validateType path scope targetType
  }.

  qualifiedMethodKeyParts :: [Text] -> [Text] -> Maybe((Maybe(Text), Text)).
  qualifiedMethodKeyParts = \(parts, reversedQualifier) -> case parts {
    | [] -> Nothing
    | [methodName] -> {
      qualifier = textJoin "::" (listReverse reversedQualifier).
      if textIsEmpty qualifier then Nothing else if textIsEmpty methodName then Nothing else Just (Just qualifier, methodName).
    }
    | [first | rest] -> if textIsEmpty first then Nothing else qualifiedMethodKeyParts rest (listPrepend first reversedQualifier)
  }.

  methodKeyParts :: Text -> Maybe((Maybe(Text), Text)).
  methodKeyParts = \(methodKey) -> if textIsEmpty methodKey then Nothing else case textSplit "::" methodKey {
    | [unqualified] -> case textSplit "." unqualified {
      | [qualifier, methodName] -> if textIsEmpty qualifier then Nothing else if textIsEmpty methodName then Nothing else Just (Just qualifier, methodName)
      | [methodName] -> if textIsEmpty methodName then Nothing else Just (Nothing, methodName)
      | other -> Nothing
    }
    | qualifiedParts -> qualifiedMethodKeyParts qualifiedParts []
  }.

  methodKeyMatches :: Text -> Text -> Text -> Bool.
  methodKeyMatches = \(capability, expected, actual) -> case (methodKeyParts expected, methodKeyParts actual) {
    | (Just (expectedQualifier, expectedMethod), Just (actualQualifier, actualMethod)) ->
      if expectedMethod == actualMethod then
        if case expectedQualifier { | Nothing -> True | Just qualifier -> qualifier == capability } then
          case actualQualifier { | Nothing -> True | Just qualifier -> qualifier == capability }
        else False
      else False
    | other -> False
  }.

  visibleCapabilityIdentifierCount :: Text -> [NameEntry] -> Int.
  visibleCapabilityIdentifierCount = \(capability, entries) -> case entries {
    | [] -> 0
    | [first | rest] -> case first {
      | NameEntry modulePath TypedCapabilityNamespace identifier ->
        if identifier == capability then 1 + visibleCapabilityIdentifierCount capability rest else visibleCapabilityIdentifierCount capability rest
      | other -> visibleCapabilityIdentifierCount capability rest
    }
  }.

  methodContractMatches :: Text -> Text -> [MethodContract] -> Bool.
  methodContractMatches = \(capability, method, methods) -> case methods {
    | [] -> False
    | [MethodContract methodName scheme | rest] ->
      if methodKeyMatches capability method methodName then True else methodContractMatches capability method rest
  }.

  visibleCapabilityMethodPresent :: Text -> Text -> [NameEntry] -> [DataEntry] -> Bool.
  visibleCapabilityMethodPresent = \(capability, method, names, entries) -> case names {
    | [] -> False
    | [first | rest] -> case first {
      | NameEntry modulePath TypedCapabilityNamespace identifier ->
        if identifier == capability then case lookupCapabilityContract modulePath identifier entries {
          | Just contract -> case contract {
            | CapabilityContract parameters methods -> if methodContractMatches capability method methods then True else visibleCapabilityMethodPresent capability method rest entries
          }
          | Nothing -> visibleCapabilityMethodPresent capability method rest entries
        } else visibleCapabilityMethodPresent capability method rest entries
      | other -> visibleCapabilityMethodPresent capability method rest entries
    }
  }.

  validateDeclaredCapabilityConstraint :: ModuleContext -> TypedCoreValidationPath -> [TypedTypeParameterId] -> TypedCapabilityConstraint -> [TypedCoreValidationFailure].
  validateDeclaredCapabilityConstraint = \(context, path, scope, constraint) -> case (context, constraint) {
    | (ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope, TypedCapabilityConstraint capability maybeMethod targetType) ->
      listAppend
        (validateType path scope targetType)
        (if visibleCapabilityIdentifierCount capability visibleNames == 0 then [failure path TypedInvisibleName (TypedTextDetail capability)] else
          if visibleCapabilityIdentifierCount capability visibleNames > 1 then [failure path TypedDuplicateDeclaration (TypedTextDetail capability)] else case maybeMethod {
            | Nothing -> []
            | Just method -> if visibleCapabilityMethodPresent capability method visibleNames dataEntries then [] else [failure path TypedMethodSelectionMismatch (TypedTextDetail method)]
          })
  }.

  numericTypeIntegral :: TypedNumericType -> Bool.
  numericTypeIntegral = \(numericType) -> case numericType {
    | TypedInt8Type -> True
    | TypedInt16Type -> True
    | TypedInt32Type -> True
    | TypedInt64Type -> True
    | TypedUInt8Type -> True
    | TypedUInt16Type -> True
    | TypedUInt32Type -> True
    | TypedUInt64Type -> True
    | TypedFloat16Type -> False
    | TypedFloat32Type -> False
    | TypedFloat64Type -> False
  }.

  numericConstraintIntegral :: TypedNumericConstraint -> Bool.
  numericConstraintIntegral = \(constraint) -> case constraint {
    | TypedIntegralNumericConstraint -> True
    | TypedIntegralLiteralNumericConstraint lower upper -> True
    | other -> False
  }.

  decimalDigitValue :: Char -> Maybe(Int).
  decimalDigitValue = \(digit) ->
    if digit == '0' then Just 0 else
    if digit == '1' then Just 1 else
    if digit == '2' then Just 2 else
    if digit == '3' then Just 3 else
    if digit == '4' then Just 4 else
    if digit == '5' then Just 5 else
    if digit == '6' then Just 6 else
    if digit == '7' then Just 7 else
    if digit == '8' then Just 8 else
    if digit == '9' then Just 9 else Nothing.

  decimalDigitsValid :: [Char] -> Bool.
  decimalDigitsValid = \(digits) -> case digits {
    | [] -> False
    | [first | rest] -> case decimalDigitValue first {
      | Nothing -> False
      | Just digit -> case rest {
        | [] -> True
        | remaining -> decimalDigitsValid remaining
      }
    }
  }.

  dropLeadingDecimalZeros :: [Char] -> [Char].
  dropLeadingDecimalZeros = \(digits) -> case digits {
    | ['0' | rest] -> case rest {
      | [] -> ['0']
      | remaining -> dropLeadingDecimalZeros remaining
    }
    | other -> other
  }.

  decimalDigitsZero :: [Char] -> Bool.
  decimalDigitsZero = \(digits) -> case digits {
    | [] -> True
    | [first | rest] -> if first == '0' then decimalDigitsZero rest else False
  }.

  decimalDigitsAtMost :: [Char] -> [Char] -> Bool.
  decimalDigitsAtMost = \(left, right) -> case (left, right) {
    | ([], []) -> True
    | ([leftFirst | leftRest], [rightFirst | rightRest]) -> case (decimalDigitValue leftFirst, decimalDigitValue rightFirst) {
      | (Just leftDigit, Just rightDigit) ->
        if leftDigit < rightDigit then True else if leftDigit > rightDigit then False else decimalDigitsAtMost leftRest rightRest
      | other -> False
    }
    | other -> False
  }.

  decimalMagnitudeAtMost :: [Char] -> [Char] -> Bool.
  decimalMagnitudeAtMost = \(left, right) ->
    if decimalDigitsValid left then if decimalDigitsValid right then {
      normalizedLeft = dropLeadingDecimalZeros left.
      normalizedRight = dropLeadingDecimalZeros right.
      leftLength = listLength normalizedLeft.
      rightLength = listLength normalizedRight.
      if leftLength < rightLength then True else if leftLength > rightLength then False else decimalDigitsAtMost normalizedLeft normalizedRight.
    } else False else False.

  decimalValueParts :: Text -> Maybe((Bool, [Char])).
  decimalValueParts = \(value) -> case textToChars value {
    | [] -> Nothing
    | ['-' | digits] -> if decimalDigitsValid digits then {
      negative = if decimalDigitsZero digits then False else True.
      Just (negative, dropLeadingDecimalZeros digits).
    } else Nothing
    | digits -> if decimalDigitsValid digits then Just (False, dropLeadingDecimalZeros digits) else Nothing
  }.

  decimalValueAtMost :: Text -> Text -> Bool.
  decimalValueAtMost = \(left, right) -> case (decimalValueParts left, decimalValueParts right) {
    | (Just (leftNegative, leftMagnitude), Just (rightNegative, rightMagnitude)) ->
      if leftNegative then
        if rightNegative then decimalMagnitudeAtMost rightMagnitude leftMagnitude else True
      else if rightNegative then False else decimalMagnitudeAtMost leftMagnitude rightMagnitude
    | other -> False
  }.

  decimalValueWithin :: Text -> Text -> Text -> Bool.
  decimalValueWithin = \(minimumValue, value, maximumValue) ->
    if decimalValueAtMost minimumValue value then decimalValueAtMost value maximumValue else False.

  floatingNumericMaximumWholeDigits :: TypedNumericType -> Maybe([Char]).
  floatingNumericMaximumWholeDigits = \(numericType) -> case numericType {
    | TypedFloat16Type -> Just (textToChars "65504")
    | TypedFloat32Type -> Just (textToChars "340282346638528859811704183484516925440")
    | TypedFloat64Type -> Just (textToChars "")
    | other -> Nothing
  }.

  fractionalLiteralFitsNumericType :: Text -> Text -> TypedNumericType -> Bool.
  fractionalLiteralFitsNumericType = \(whole, fractional, numericType) -> case (decimalValueParts whole, floatingNumericMaximumWholeDigits numericType) {
    | (Just (_, wholeMagnitude), Just maximumMagnitude) -> {
      fractionalDigits = textToChars fractional.
      if decimalDigitsValid fractionalDigits then
        if decimalMagnitudeAtMost wholeMagnitude maximumMagnitude then
          if decimalMagnitudeAtMost maximumMagnitude wholeMagnitude then decimalDigitsZero fractionalDigits else True
        else False
      else False.
    }
    | other -> False
  }.

  integralLiteralTextFitsType :: Text -> TypedType -> Bool.
  integralLiteralTextFitsType = \(value, typeValue) -> case typeValue {
    | TypedIntType -> decimalValueWithin "-9223372036854775808" value "9223372036854775807"
    | TypedNumericType numericType -> case numericType {
      | TypedInt8Type -> decimalValueWithin "-128" value "127"
      | TypedInt16Type -> decimalValueWithin "-32768" value "32767"
      | TypedInt32Type -> decimalValueWithin "-2147483648" value "2147483647"
      | TypedInt64Type -> decimalValueWithin "-9223372036854775808" value "9223372036854775807"
      | TypedUInt8Type -> decimalValueWithin "0" value "255"
      | TypedUInt16Type -> decimalValueWithin "0" value "65535"
      | TypedUInt32Type -> decimalValueWithin "0" value "4294967295"
      | TypedUInt64Type -> decimalValueWithin "0" value "18446744073709551615"
      | TypedFloat16Type -> False
      | TypedFloat32Type -> False
      | TypedFloat64Type -> False
    }
    | other -> False
  }.

  numericConstraintAcceptsType :: TypedNumericConstraint -> TypedType -> Bool.
  numericConstraintAcceptsType = \(constraint, typeValue) -> case constraint {
    | TypedIntegralLiteralNumericConstraint lowerText upperText -> if decimalValueAtMost lowerText upperText then case typeValue {
      | TypedTypeParameterType parameter -> True
      | other -> if integralLiteralTextFitsType lowerText typeValue then integralLiteralTextFitsType upperText typeValue else False
    } else False
    | otherConstraint -> case typeValue {
      | TypedTypeParameterType parameter -> True
      | TypedIntType -> True
      | TypedFloatType -> if numericConstraintIntegral constraint then False else True
      | TypedNumericType numericType -> if numericConstraintIntegral constraint then numericTypeIntegral numericType else True
      | other -> False
    }
  }.

  validateNumericConstraintTarget :: TypedCoreValidationPath -> TypedNumericConstraint -> TypedType -> [TypedCoreValidationFailure].
  validateNumericConstraintTarget = \(path, constraint, typeValue) ->
    if numericConstraintAcceptsType constraint typeValue then [] else [failure path TypedBindingValueMismatch (TypedTypeDetail TypedIntType typeValue)].

  dataContractForName :: ModuleContext -> TypedCoreName -> Maybe(DataContract).
  dataContractForName = \(context, name) -> case (context, name) {
    | (ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope, TypedResolvedName origin TypedTypeNamespace identifier) ->
      lookupDataContract (originModulePath modulePath origin) identifier dataEntries
    | other -> Nothing
  }.

  lookupEqualityTypeSubstitution :: TypedTypeParameterId -> [(TypedTypeParameterId, TypedType)] -> Maybe(TypedType).
  lookupEqualityTypeSubstitution = \(parameterId, substitutions) -> case substitutions {
    | [] -> Nothing
    | [(candidateId, typeValue) | rest] -> if typeParameterIdEqual parameterId candidateId then Just typeValue else lookupEqualityTypeSubstitution parameterId rest
  }.

  substituteEqualityTypeParameters :: [(TypedTypeParameterId, TypedType)] -> TypedType -> TypedType.
  substituteEqualityTypeParameters = \(substitutions, typeValue) -> case typeValue {
    | TypedListType elementType -> TypedListType (substituteEqualityTypeParameters substitutions elementType)
    | TypedTupleType elementTypes -> TypedTupleType (listMap (\(elementType) -> substituteEqualityTypeParameters substitutions elementType) elementTypes)
    | TypedDataType name arguments -> TypedDataType name (listMap (\(argument) -> substituteEqualityTypeParameters substitutions argument) arguments)
    | TypedFunctionType argument result -> TypedFunctionType (substituteEqualityTypeParameters substitutions argument) (substituteEqualityTypeParameters substitutions result)
    | TypedTypeParameterType parameterId -> case lookupEqualityTypeSubstitution parameterId substitutions {
      | Nothing -> typeValue
      | Just replacement -> replacement
    }
    | other -> other
  }.

  strictEqualityTypeSupportedWithSeen :: ModuleContext -> [EqualityDataKey] -> TypedType -> Bool.
  strictEqualityTypeSupportedWithSeen = \(context, seen, typeValue) -> case typeValue {
    | TypedIntType -> True
    | TypedFloatType -> True
    | TypedNumericType numericType -> True
    | TypedBoolType -> True
    | TypedCharType -> True
    | TypedTextType -> True
    | TypedListType elementType -> strictEqualityTypeSupportedWithSeen context seen elementType
    | TypedTupleType elementTypes -> listAll (\(elementType) -> strictEqualityTypeSupportedWithSeen context seen elementType) elementTypes
    | TypedTypeParameterType parameterId -> True
    | TypedFunctionType argument result -> False
    | TypedDataType name arguments -> {
      result = case (context, name, dataContractForName context name) {
        | (ModuleContext currentPath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope, TypedResolvedName origin TypedTypeNamespace identifier, Just contract) -> case contract {
          | DataContract parameters constructors -> {
            dataKey = EqualityDataKey (originModulePath currentPath origin) identifier.
            if listLength parameters == listLength arguments then if equalityDataKeyMember dataKey seen then
              listAll (\(argument) -> strictEqualityTypeSupportedWithSeen context seen argument) arguments
            else {
              substitutions = listZip parameters arguments.
              nextSeen = listPrepend dataKey seen.
              listAll
                (\(fields) -> listAll (\(field) -> strictEqualityTypeSupportedWithSeen context nextSeen (substituteEqualityTypeParameters substitutions field)) fields)
                constructors.
            } else False.
          }
        }
        | other -> False
      }.
      result.
    }
  }.

  strictEqualityTypeSupported :: ModuleContext -> TypedType -> Bool.
  strictEqualityTypeSupported = \(context, typeValue) -> strictEqualityTypeSupportedWithSeen context [] typeValue.

  activeStrictEqualityConstraint :: ModuleContext -> TypedType -> Bool.
  activeStrictEqualityConstraint = \(context, typeValue) ->
    listAll
      (\(constraint) -> case constraint {
        | TypedStrictEqualityPrimitiveConstraint constrainedType -> if typeEqual constrainedType typeValue then False else True
        | other -> True
      })
      (activePrimitiveConstraints context)
      == False.

  strictEqualityOperandSupportedWithSeen :: ModuleContext -> [EqualityDataKey] -> TypedType -> Bool.
  strictEqualityOperandSupportedWithSeen = \(context, seen, typeValue) -> case typeValue {
      | TypedIntType -> True
      | TypedFloatType -> True
      | TypedNumericType numericType -> True
      | TypedBoolType -> True
      | TypedCharType -> True
      | TypedTextType -> True
      | TypedListType elementType -> strictEqualityOperandSupportedWithSeen context seen elementType
      | TypedTupleType elementTypes -> listAll (\(elementType) -> strictEqualityOperandSupportedWithSeen context seen elementType) elementTypes
      | TypedTypeParameterType parameterId -> activeStrictEqualityConstraint context typeValue
      | TypedFunctionType argument result -> False
      | TypedDataType name arguments -> {
        result = case (context, name, dataContractForName context name) {
          | (ModuleContext currentPath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope, TypedResolvedName origin TypedTypeNamespace identifier, Just contract) -> case contract {
            | DataContract parameters constructors -> {
              dataKey = EqualityDataKey (originModulePath currentPath origin) identifier.
              if listLength parameters == listLength arguments then if equalityDataKeyMember dataKey seen then True else {
                substitutions = listZip parameters arguments.
                nextSeen = listPrepend dataKey seen.
                listAll
                  (\(fields) -> listAll (\(field) -> strictEqualityOperandSupportedWithSeen context nextSeen (substituteEqualityTypeParameters substitutions field)) fields)
                  constructors.
              } else False.
            }
          }
          | other -> False
        }.
        result.
      }
    }.

  strictEqualityOperandSupported :: ModuleContext -> TypedType -> Bool.
  strictEqualityOperandSupported = \(context, typeValue) ->
    if activeStrictEqualityConstraint context typeValue then True else strictEqualityOperandSupportedWithSeen context [] typeValue.

  validateStrictEqualityTarget :: ModuleContext -> TypedCoreValidationPath -> TypedType -> [TypedCoreValidationFailure].
  validateStrictEqualityTarget = \(context, path, typeValue) ->
    if strictEqualityTypeSupported context typeValue then [] else [failure path TypedBindingValueMismatch (TypedTypeDetail TypedBoolType typeValue)].

  validatePrimitiveConstraint :: ModuleContext -> TypedCoreValidationPath -> [TypedTypeParameterId] -> TypedPrimitiveConstraint -> [TypedCoreValidationFailure].
  validatePrimitiveConstraint = \(context, path, scope, constraint) -> case constraint {
    | TypedNumericPrimitiveConstraint numericConstraint typeValue -> listAppend
      (validateType path scope typeValue)
      (validateNumericConstraintTarget path numericConstraint typeValue)
    | TypedStrictEqualityPrimitiveConstraint typeValue -> listAppend
      (validateType path scope typeValue)
      (validateStrictEqualityTarget context path typeValue)
  }.

  validatePrimitiveConstraints :: ModuleContext -> TypedCoreValidationPath -> [TypedTypeParameterId] -> [TypedPrimitiveConstraint] -> [TypedCoreValidationFailure].
  validatePrimitiveConstraints = \(context, path, scope, constraints) -> case constraints {
    | [] -> []
    | [first | rest] -> listAppend (validatePrimitiveConstraint context path scope first) (validatePrimitiveConstraints context path scope rest)
  }.

  duplicateTypeParameterFailuresFrom :: TypedCoreValidationPath -> [TypedTypeParameterId] -> [TypedTypeParameterId] -> [TypedCoreValidationFailure] -> [TypedCoreValidationFailure].
  duplicateTypeParameterFailuresFrom = \(path, parameters, seen, reversed) -> case parameters {
    | [] -> listReverse reversed
    | [first | rest] -> if typeParameterIdMember first seen then
      duplicateTypeParameterFailuresFrom path rest seen (listPrepend (failure path TypedDuplicateTypeParameter (TypedTypeParameterDetail first)) reversed)
    else duplicateTypeParameterFailuresFrom path rest (listPrepend first seen) reversed
  }.

  typeParameterOrderFailuresFrom :: TypedCoreValidationPath -> [TypedTypeParameterId] -> Int -> [TypedCoreValidationFailure].
  typeParameterOrderFailuresFrom = \(path, parameters, index) -> case parameters {
    | [] -> []
    | [first | rest] -> listAppend
      (if typeParameterIdValue first == index then [] else [failure path TypedInvalidTypeParameterOrder (TypedIndexDetail index)])
      (typeParameterOrderFailuresFrom path rest (index + 1))
  }.

  validateOrderedTypeParametersFrom :: TypedCoreValidationPath -> Int -> [TypedTypeParameterId] -> [TypedCoreValidationFailure].
  validateOrderedTypeParametersFrom = \(path, firstOrdinal, parameters) -> listAppend
    (duplicateTypeParameterFailuresFrom path parameters [] [])
    (typeParameterOrderFailuresFrom path parameters firstOrdinal).

  validateOrderedTypeParameters :: TypedCoreValidationPath -> [TypedTypeParameterId] -> [TypedCoreValidationFailure].
  validateOrderedTypeParameters = \(path, parameters) -> validateOrderedTypeParametersFrom path 0 parameters.

  nextTypeParameterOrdinalFrom :: [TypedTypeParameterId] -> Int -> Int.
  nextTypeParameterOrdinalFrom = \(parameters, nextOrdinal) -> case parameters {
    | [] -> nextOrdinal
    | [first | rest] -> {
      candidate = typeParameterIdValue first + 1.
      nextTypeParameterOrdinalFrom rest (if candidate > nextOrdinal then candidate else nextOrdinal).
    }
  }.

  nextTypeParameterOrdinal :: [TypedTypeParameterId] -> Int.
  nextTypeParameterOrdinal = \(parameters) -> nextTypeParameterOrdinalFrom parameters 0.

  evidenceParameterIds :: [TypedEvidenceParameter] -> [TypedEvidenceParameterId].
  evidenceParameterIds = \(parameters) -> case parameters {
    | [] -> []
    | [TypedEvidenceParameter parameterId constraint | rest] -> listPrepend parameterId (evidenceParameterIds rest)
  }.

  duplicateEvidenceParameterFailuresFrom :: TypedCoreValidationPath -> [TypedEvidenceParameterId] -> [TypedEvidenceParameterId] -> [TypedCoreValidationFailure] -> [TypedCoreValidationFailure].
  duplicateEvidenceParameterFailuresFrom = \(path, parameters, seen, reversed) -> case parameters {
    | [] -> listReverse reversed
    | [first | rest] -> if evidenceParameterIdMember first seen then
      duplicateEvidenceParameterFailuresFrom path rest seen (listPrepend (failure path TypedDuplicateEvidenceParameter (TypedEvidenceParameterDetail first)) reversed)
    else duplicateEvidenceParameterFailuresFrom path rest (listPrepend first seen) reversed
  }.

  evidenceParameterOrderFailuresFrom :: TypedCoreValidationPath -> [TypedEvidenceParameter] -> Int -> [TypedCoreValidationFailure].
  evidenceParameterOrderFailuresFrom = \(path, parameters, index) -> case parameters {
    | [] -> []
    | [TypedEvidenceParameter parameterId constraint | rest] -> listAppend
      (if evidenceParameterIdValue parameterId == index then [] else [failure path TypedInvalidEvidenceParameterOrder (TypedIndexDetail index)])
      (evidenceParameterOrderFailuresFrom path rest (index + 1))
  }.

  validateEvidenceParameters :: ModuleContext -> TypedCoreValidationPath -> [TypedTypeParameterId] -> [TypedEvidenceParameter] -> [TypedCoreValidationFailure].
  validateEvidenceParameters = \(context, path, scope, parameters) -> case parameters {
    | [] -> []
    | [TypedEvidenceParameter parameterId constraint | rest] -> listAppend
      (validateDeclaredCapabilityConstraint context path scope constraint)
      (validateEvidenceParameters context path scope rest)
  }.

  validateOrderedEvidenceParameters :: TypedCoreValidationPath -> [TypedEvidenceParameter] -> [TypedCoreValidationFailure].
  validateOrderedEvidenceParameters = \(path, parameters) -> listAppend
    (duplicateEvidenceParameterFailuresFrom path (evidenceParameterIds parameters) [] [])
    (evidenceParameterOrderFailuresFrom path parameters 0).

  shadowedTypeParameterFailures :: TypedCoreValidationPath -> [TypedTypeParameterId] -> [TypedTypeParameterId] -> [TypedCoreValidationFailure].
  shadowedTypeParameterFailures = \(path, parameters, outerScope) -> case parameters {
    | [] -> []
    | [first | rest] -> listAppend
      (if typeParameterIdMember first outerScope then [failure path TypedDuplicateTypeParameter (TypedTypeParameterDetail first)] else [])
      (shadowedTypeParameterFailures path rest outerScope)
  }.

  validateSchemeWithOuterScope :: ModuleContext -> TypedCoreValidationPath -> TypedBinderId -> [TypedTypeParameterId] -> TypedScheme -> [TypedCoreValidationFailure].
  validateSchemeWithOuterScope = \(context, path, owner, outerScope, scheme) -> case scheme {
    | TypedScheme schemeOwner typeParameters evidenceParameters primitiveConstraints resultType resultRecipe -> {
      shadowingFailures = shadowedTypeParameterFailures path typeParameters outerScope.
      parameterOrderFailures = if listLength shadowingFailures == 0 then validateOrderedTypeParametersFrom path (nextTypeParameterOrdinal outerScope) typeParameters else [].
      listConcat
        [ if binderIdEqual owner schemeOwner then [] else [failure path TypedUnknownBinder (TypedBinderDetail schemeOwner)],
          shadowingFailures,
          parameterOrderFailures,
          validateOrderedEvidenceParameters path evidenceParameters,
          validateEvidenceParameters context path (listAppend outerScope typeParameters) evidenceParameters,
          validatePrimitiveConstraints context path (listAppend outerScope typeParameters) primitiveConstraints,
          validateType path (listAppend outerScope typeParameters) resultType,
          validateRecipe path (listAppend outerScope typeParameters) resultRecipe,
          validateTypeRecipe path (listAppend outerScope typeParameters) resultType resultRecipe
        ].
    }
  }.

  validateScheme :: ModuleContext -> TypedCoreValidationPath -> TypedBinderId -> TypedScheme -> [TypedCoreValidationFailure].
  validateScheme = \(context, path, owner, scheme) -> validateSchemeWithOuterScope context path owner [] scheme.

  implModulePath :: TypedImplId -> [Text].
  implModulePath = \(implId) -> case implId {
    | TypedImplId modulePath capability arguments -> modulePath
  }.

  implTargetTypes :: TypedImplId -> [TypedType].
  implTargetTypes = \(implId) -> case implId {
    | TypedImplId modulePath capability arguments -> arguments
  }.

  concreteImplTargetType :: TypedType -> Bool.
  concreteImplTargetType = \(typeValue) -> case typeValue {
    | TypedListType elementType -> concreteImplTargetType elementType
    | TypedTupleType elementTypes -> listAll (\(elementType) -> concreteImplTargetType elementType) elementTypes
    | TypedDataType name arguments -> listAll (\(argument) -> concreteImplTargetType argument) arguments
    | TypedFunctionType argument result -> False
    | TypedTypeParameterType parameter -> False
    | other -> True
  }.

  validateCapabilityName :: ModuleContext -> TypedCoreValidationPath -> TypedCoreName -> [TypedCoreValidationFailure].
  validateCapabilityName = \(context, path, name) -> validateVisibleNameInNamespaces [TypedCapabilityNamespace] context path name.

  capabilityContractForName :: ModuleContext -> TypedCoreName -> Maybe(CapabilityContract).
  capabilityContractForName = \(context, name) -> case (context, name) {
    | (ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope, TypedResolvedName origin TypedCapabilityNamespace identifier) ->
      lookupCapabilityContract (originModulePath modulePath origin) identifier dataEntries
    | other -> Nothing
  }.

  retainedCapabilityOriginValid :: [Text] -> TypedCoreName -> Bool.
  retainedCapabilityOriginValid = \(modulePath, name) -> case name {
    | TypedResolvedName origin namespace identifier -> case origin {
      | TypedImportedModule importedPath ->
        if textListEqual importedPath modulePath then False else textListEqual importedPath ["Prelude"] == False
      | other -> True
    }
    | other -> True
  }.

  validateRetainedCapabilityName :: ModuleContext -> TypedCoreValidationPath -> TypedCoreName -> [TypedCoreValidationFailure].
  validateRetainedCapabilityName = \(context, path, name) -> case context {
    | ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope -> listAppend
      (validateCoreName path name)
      (if retainedCapabilityOriginValid modulePath name then case capabilityContractForName context name {
        | Nothing -> [failure path TypedInvisibleName (TypedNameDetail name)]
        | Just contract -> []
      } else [failure path TypedInvisibleName (TypedNameDetail name)])
  }.

  capabilityArity :: ModuleContext -> TypedCoreName -> Maybe(Int).
  capabilityArity = \(context, capability) -> case capabilityContractForName context capability {
    | Just contract -> case contract {
      | CapabilityContract parameters methods -> Just (listLength parameters)
    }
    | Nothing -> Nothing
  }.

  validateImplIdShape :: ModuleContext -> TypedCoreValidationPath -> [TypedTypeParameterId] -> TypedImplId -> [TypedCoreValidationFailure].
  validateImplIdShape = \(context, path, scope, implId) -> case implId {
    | TypedImplId modulePath capability arguments -> listConcat
      [ case capabilityArity context capability {
          | Nothing -> []
          | Just expectedArity -> if expectedArity == listLength arguments then [] else [failure path TypedMethodSelectionMismatch (TypedArityDetail expectedArity (listLength arguments))]
        },
        if listAll (\(targetType) -> concreteImplTargetType targetType) arguments then [] else [failure path TypedMethodSelectionMismatch (TypedImplDetail implId)],
        validateTypes path scope arguments
      ]
  }.

  validateImplId :: ModuleContext -> TypedCoreValidationPath -> [TypedTypeParameterId] -> TypedImplId -> [TypedCoreValidationFailure].
  validateImplId = \(context, path, scope, implId) -> case implId {
    | TypedImplId modulePath capability arguments ->
      listAppend (validateCapabilityName context path capability) (validateImplIdShape context path scope implId)
  }.

  validateEvidenceImplId :: ModuleContext -> TypedCoreValidationPath -> [TypedTypeParameterId] -> TypedImplId -> [TypedCoreValidationFailure].
  validateEvidenceImplId = \(context, path, scope, implId) -> case implId {
    | TypedImplId modulePath capability arguments ->
      listAppend (validateRetainedCapabilityName context path capability) (validateImplIdShape context path scope implId)
  }.

  validateMethodId :: ModuleContext -> TypedCoreValidationPath -> [TypedTypeParameterId] -> TypedMethodId -> [TypedCoreValidationFailure].
  validateMethodId = \(context, path, scope, methodId) -> case methodId {
    | TypedMethodId implId methodName -> validateImplId context path scope implId
  }.

  validateEvidenceMethodId :: ModuleContext -> TypedCoreValidationPath -> [TypedTypeParameterId] -> TypedMethodId -> [TypedCoreValidationFailure].
  validateEvidenceMethodId = \(context, path, scope, methodId) -> case methodId {
    | TypedMethodId implId methodName -> validateEvidenceImplId context path scope implId
  }.

  lookupScheme :: TypedBinderId -> [SchemeEntry] -> Maybe(TypedScheme).
  lookupScheme = \(candidate, entries) -> case entries {
    | [] -> Nothing
    | [SchemeEntry binderId scheme | rest] -> if binderIdEqual candidate binderId then Just scheme else lookupScheme candidate rest
  }.

  methodContractPresent :: Text -> [MethodContract] -> Bool.
  methodContractPresent = \(methodName, methods) -> case methods {
    | [] -> False
    | [MethodContract candidateName scheme | rest] -> if methodName == candidateName then True else methodContractPresent methodName rest
  }.

  capabilityMethodExistenceFailures :: ModuleContext -> TypedCoreValidationPath -> TypedImplId -> Text -> [TypedCoreValidationFailure].
  capabilityMethodExistenceFailures = \(context, path, implId, methodName) -> case implId {
    | TypedImplId implPath capability targets -> case capabilityContractForName context capability {
      | Nothing -> []
      | Just contract -> case contract {
        | CapabilityContract parameters methods -> if methodContractPresent methodName methods then [] else [failure path TypedMethodSelectionMismatch (TypedTextDetail methodName)]
      }
    }
  }.

  implMethodExistenceFailures :: ModuleContext -> TypedCoreValidationPath -> TypedImplId -> Text -> [TypedCoreValidationFailure].
  implMethodExistenceFailures = \(context, path, implId, methodName) -> case context {
    | ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope -> case lookupImplMethods implId dataEntries {
      | Nothing -> []
      | Just methods -> if listContains methodName methods then [] else [failure path TypedMethodSelectionMismatch (TypedTextDetail methodName)]
    }
  }.

  evidenceMethodFailures :: ModuleContext -> TypedCoreValidationPath -> Bool -> Text -> Maybe(Text) -> TypedImplId -> Maybe(TypedMethodId) -> [TypedCoreValidationFailure].
  evidenceMethodFailures = \(context, path, retainedCapability, capability, constraintMethod, implId, maybeMethod) -> case context {
    | ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope -> case (constraintMethod, maybeMethod) {
      | (Nothing, Nothing) -> []
      | (Nothing, Just methodId) -> case methodId {
        | TypedMethodId methodImpl methodName -> listConcat
          [ if retainedCapability then validateEvidenceMethodId context path typeScope methodId else validateMethodId context path typeScope methodId,
            if implIdEqual methodImpl implId then [] else [failure path TypedMethodSelectionMismatch (TypedImplDetail methodImpl)],
            [failure path TypedMethodSelectionMismatch (TypedTextDetail methodName)]
          ]
      }
      | (Just expectedMethod, Nothing) -> [failure path TypedMethodSelectionMismatch (TypedTextDetail expectedMethod)]
      | (Just expectedMethod, Just methodId) -> case methodId {
        | TypedMethodId methodImpl methodName -> listConcat
          [ if retainedCapability then validateEvidenceMethodId context path typeScope methodId else validateMethodId context path typeScope methodId,
            if implIdEqual methodImpl implId then [] else [failure path TypedMethodSelectionMismatch (TypedImplDetail methodImpl)],
            if methodKeyMatches capability expectedMethod methodName then [] else [failure path TypedMethodSelectionMismatch (TypedTextDetail expectedMethod)],
            capabilityMethodExistenceFailures context path implId methodName,
            implMethodExistenceFailures context path implId methodName
          ]
      }
    }
  }.

  validateEvidenceUse :: ModuleContext -> TypedCoreValidationPath -> TypedEvidenceUse -> [TypedCoreValidationFailure].
  validateEvidenceUse = \(context, path, evidenceUse) -> case (context, evidenceUse) {
    | (ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope, TypedEvidenceUse parameterId constraint implId maybeMethod) -> case (constraint, implId) {
      | (TypedCapabilityConstraint capability constraintMethod targetType, TypedImplId implPath capabilityName targetTypes) -> {
        retainedCapability = case parameterId { | Nothing -> False | Just parameterRef -> True }.
        listConcat
        [ validateCapabilityConstraint path typeScope constraint,
          if retainedCapability then validateEvidenceImplId context path typeScope implId else validateImplId context path typeScope implId,
          case parameterId {
            | Nothing -> []
            | Just parameterRef -> case lookupEvidenceCapability parameterRef dataEntries {
              | Nothing -> []
              | Just expectedCapability -> case resolvedNameEntry modulePath capabilityName {
                | Just actualCapability ->
                  if nameEntryEqual expectedCapability actualCapability then [] else [failure path TypedMethodSelectionMismatch (TypedNameDetail capabilityName)]
                | Nothing -> [failure path TypedMethodSelectionMismatch (TypedNameDetail capabilityName)]
              }
            }
          },
          if coreNameIdentifierEqual capability capabilityName then [] else [failure path TypedMethodSelectionMismatch (TypedTextDetail capability)],
          case targetTypes {
            | [first] -> if typeEqual first targetType then [] else [failure path TypedMethodSelectionMismatch (TypedTypeDetail targetType first)]
            | other -> []
          },
          if implIdMember implId visibleImpls then [] else [failure path TypedInvisibleImpl (TypedImplDetail implId)],
          evidenceMethodFailures context path retainedCapability capability constraintMethod implId maybeMethod
        ].
      }
    }
  }.

  validateEvidenceCandidate :: ModuleContext -> TypedCoreValidationPath -> TypedCapabilityConstraint -> TypedEvidenceCandidate -> [TypedCoreValidationFailure].
  validateEvidenceCandidate = \(context, path, constraint, candidate) -> case candidate {
    | TypedEvidenceCandidate implId maybeMethod -> validateEvidenceUse context path (TypedEvidenceUse Nothing constraint implId maybeMethod)
  }.

  validateEvidenceCandidates :: ModuleContext -> TypedCoreValidationPath -> TypedCapabilityConstraint -> [TypedEvidenceCandidate] -> [TypedCoreValidationFailure].
  validateEvidenceCandidates = \(context, path, constraint, candidates) -> case candidates {
    | [] -> []
    | [first | rest] -> listAppend
      (validateEvidenceCandidate context path constraint first)
      (validateEvidenceCandidates context path constraint rest)
  }.

  selectedEvidenceParameterRefs :: [TypedEvidenceSelection] -> [TypedEvidenceParameterRef].
  selectedEvidenceParameterRefs = \(selections) -> case selections {
    | [] -> []
    | [first | rest] -> case first {
      | TypedSelectedEvidence evidenceUse -> case evidenceUse {
        | TypedEvidenceUse maybeParameter constraint implId maybeMethod -> case maybeParameter {
          | Nothing -> selectedEvidenceParameterRefs rest
          | Just parameterRef -> listPrepend parameterRef (selectedEvidenceParameterRefs rest)
        }
      }
      | other -> selectedEvidenceParameterRefs rest
    }
  }.

  duplicateEvidenceUseFailuresFrom :: TypedCoreValidationPath -> [TypedEvidenceParameterRef] -> [TypedEvidenceParameterRef] -> [TypedCoreValidationFailure] -> [TypedCoreValidationFailure].
  duplicateEvidenceUseFailuresFrom = \(path, parameterRefs, seen, reversed) -> case parameterRefs {
    | [] -> listReverse reversed
    | [first | rest] -> if evidenceParameterRefMember first seen then
      duplicateEvidenceUseFailuresFrom path rest seen (listPrepend (failure path TypedDuplicateEvidence (TypedEvidenceParameterDetail (evidenceParameterRefId first))) reversed)
    else duplicateEvidenceUseFailuresFrom path rest (listPrepend first seen) reversed
  }.

  selectedUnboundEvidenceConstraints :: [TypedEvidenceSelection] -> [TypedCapabilityConstraint].
  selectedUnboundEvidenceConstraints = \(selections) -> case selections {
    | [] -> []
    | [first | rest] -> case first {
      | TypedSelectedEvidence evidenceUse -> case evidenceUse {
        | TypedEvidenceUse maybeParameter constraint implId maybeMethod -> case maybeParameter {
          | Nothing -> listPrepend constraint (selectedUnboundEvidenceConstraints rest)
          | Just parameterRef -> selectedUnboundEvidenceConstraints rest
        }
      }
      | other -> selectedUnboundEvidenceConstraints rest
    }
  }.

  capabilityConstraintMember :: TypedCapabilityConstraint -> [TypedCapabilityConstraint] -> Bool.
  capabilityConstraintMember = \(candidate, constraints) -> case constraints {
    | [] -> False
    | [first | rest] -> if capabilityConstraintEqual candidate first then True else capabilityConstraintMember candidate rest
  }.

  capabilityConstraintLabel :: TypedCapabilityConstraint -> Text.
  capabilityConstraintLabel = \(constraint) -> case constraint {
    | TypedCapabilityConstraint capability maybeMethod targetType -> case maybeMethod {
      | Nothing -> capability
      | Just method -> method
    }
  }.

  duplicateUnboundEvidenceFailuresFrom :: TypedCoreValidationPath -> [TypedCapabilityConstraint] -> [TypedCapabilityConstraint] -> [TypedCoreValidationFailure] -> [TypedCoreValidationFailure].
  duplicateUnboundEvidenceFailuresFrom = \(path, constraints, seen, reversed) -> case constraints {
    | [] -> listReverse reversed
    | [first | rest] -> if capabilityConstraintMember first seen then
      duplicateUnboundEvidenceFailuresFrom path rest seen (listPrepend (failure path TypedDuplicateEvidence (TypedTextDetail (capabilityConstraintLabel first))) reversed)
    else duplicateUnboundEvidenceFailuresFrom path rest (listPrepend first seen) reversed
  }.

  qualifiedMethodCandidates :: Text -> Maybe(Text) -> Maybe(Text) -> Bool.
  qualifiedMethodCandidates = \(capability, constraintMethod, expressionMethod) -> case (constraintMethod, expressionMethod) {
    | (Just expectedMethod, Just actualMethod) -> methodKeyMatches capability expectedMethod actualMethod
    | other -> False
  }.

  evidenceCandidateIdentityEqual :: TypedEvidenceCandidate -> TypedEvidenceCandidate -> Bool.
  evidenceCandidateIdentityEqual = \(left, right) -> case (left, right) {
    | (TypedEvidenceCandidate leftImpl leftMethod, TypedEvidenceCandidate rightImpl rightMethod) ->
      if implIdEqual leftImpl rightImpl then case (leftMethod, rightMethod) {
        | (Nothing, Nothing) -> True
        | (Just leftMethodId, Just rightMethodId) -> methodIdEqual leftMethodId rightMethodId
        | other -> False
      } else False
  }.

  evidenceCandidateMember :: TypedEvidenceCandidate -> [TypedEvidenceCandidate] -> Bool.
  evidenceCandidateMember = \(candidate, candidates) -> case candidates {
    | [] -> False
    | [first | rest] -> if evidenceCandidateIdentityEqual candidate first then True else evidenceCandidateMember candidate rest
  }.

  duplicateEvidenceCandidateFailuresFrom :: TypedCoreValidationPath -> [TypedEvidenceCandidate] -> [TypedEvidenceCandidate] -> [TypedCoreValidationFailure].
  duplicateEvidenceCandidateFailuresFrom = \(path, candidates, seen) -> case candidates {
    | [] -> []
    | [candidate | rest] -> case candidate {
      | TypedEvidenceCandidate implId methodId -> listAppend
        (if evidenceCandidateMember candidate seen then [failure path TypedDuplicateEvidence (TypedImplDetail implId)] else [])
        (duplicateEvidenceCandidateFailuresFrom path rest (if evidenceCandidateMember candidate seen then seen else listPrepend candidate seen))
    }
  }.

  validateEvidenceSelection :: ModuleContext -> TypedCoreValidationPath -> Bool -> Maybe(Text) -> Maybe(Text) -> TypedEvidenceSelection -> [TypedCoreValidationFailure].
  validateEvidenceSelection = \(context, path, requireSelectedConsumer, selectedMethodKey, candidateMethodKey, selection) -> case selection {
    | TypedSelectedEvidence evidenceUse -> case evidenceUse {
      | TypedEvidenceUse maybeParameter constraint implId maybeMethod -> {
        evidenceUseFailures = validateEvidenceUse context path evidenceUse.
        case maybeParameter {
          | Just parameterRef -> evidenceUseFailures
          | Nothing -> if listLength evidenceUseFailures > 0 then evidenceUseFailures else
            if requireSelectedConsumer then case constraint {
              | TypedCapabilityConstraint capability method targetType ->
                if qualifiedMethodCandidates capability method selectedMethodKey then [] else
                  [failure path TypedMethodSelectionMismatch (TypedTextDetail (capabilityConstraintLabel constraint))]
            } else []
        }.
      }
    }
    | TypedEvidenceCandidates constraint candidates -> case constraint {
      | TypedCapabilityConstraint capability method targetType -> if listLength candidates == 0 then [failure path TypedMissingEvidence (TypedTextDetail capability)] else
        if qualifiedMethodCandidates capability method candidateMethodKey then listAppend (duplicateEvidenceCandidateFailuresFrom path candidates []) (validateEvidenceCandidates context path constraint candidates) else
          [failure path TypedAmbiguousEvidence (TypedArityDetail 1 (listLength candidates))]
    }
  }.

  validateEvidenceSelectionsOnly :: ModuleContext -> TypedCoreValidationPath -> Bool -> Maybe(Text) -> Maybe(Text) -> [TypedEvidenceSelection] -> [TypedCoreValidationFailure].
  validateEvidenceSelectionsOnly = \(context, path, requireSelectedConsumer, selectedMethodKey, candidateMethodKey, selections) -> case selections {
    | [] -> []
    | [first | rest] -> listAppend (validateEvidenceSelection context path requireSelectedConsumer selectedMethodKey candidateMethodKey first) (validateEvidenceSelectionsOnly context path requireSelectedConsumer selectedMethodKey candidateMethodKey rest)
  }.

  validateEvidenceSelections :: ModuleContext -> TypedCoreValidationPath -> Bool -> Maybe(Text) -> Maybe(Text) -> [TypedEvidenceSelection] -> [TypedCoreValidationFailure].
  validateEvidenceSelections = \(context, path, requireSelectedConsumer, selectedMethodKey, candidateMethodKey, selections) -> listConcat
    [ validateEvidenceSelectionsOnly context path requireSelectedConsumer selectedMethodKey candidateMethodKey selections,
      duplicateEvidenceUseFailuresFrom path (selectedEvidenceParameterRefs selections) [] [],
      duplicateUnboundEvidenceFailuresFrom path (selectedUnboundEvidenceConstraints selections) [] []
    ].

  validateDataTypeApplications :: ModuleContext -> TypedCoreValidationPath -> TypedType -> [TypedCoreValidationFailure].
  validateDataTypeApplications = \(context, path, typeValue) -> case context {
    | ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope -> case typeValue {
      | TypedListType elementType -> validateDataTypeApplications context path elementType
      | TypedTupleType elementTypes -> listConcat (listMap (\(elementType) -> validateDataTypeApplications context path elementType) elementTypes)
      | TypedDataType name arguments -> listAppend
        (listConcat (listMap (\(argument) -> validateDataTypeApplications context path argument) arguments))
        (case name {
          | TypedResolvedName origin namespace identifier -> case lookupDataArity (originModulePath modulePath origin) identifier dataEntries {
            | Nothing -> [failure path TypedDataTypeMismatch (TypedNameDetail name)]
            | Just expectedArity -> if expectedArity == listLength arguments then [] else [failure path TypedDataTypeMismatch (TypedArityDetail expectedArity (listLength arguments))]
          }
          | other -> [failure path TypedDataTypeMismatch (TypedNameDetail name)]
        })
      | TypedFunctionType argument result -> listAppend (validateDataTypeApplications context path argument) (validateDataTypeApplications context path result)
      | other -> []
    }
  }.

  validateSourceDataTypeApplications :: ModuleContext -> TypedCoreValidationPath -> TypedType -> [TypedCoreValidationFailure].
  validateSourceDataTypeApplications = \(context, path, typeValue) -> case context {
    | ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope -> case typeValue {
      | TypedListType elementType -> validateSourceDataTypeApplications context path elementType
      | TypedTupleType elementTypes -> listConcat (listMap (\(elementType) -> validateSourceDataTypeApplications context path elementType) elementTypes)
      | TypedDataType name arguments -> listAppend
        (listConcat (listMap (\(argument) -> validateSourceDataTypeApplications context path argument) arguments))
        (case name {
          | TypedResolvedName origin namespace identifier -> case lookupDataArity (originModulePath modulePath origin) identifier dataEntries {
            | Nothing -> []
            | Just expectedArity -> case resolvedNameEntry modulePath name {
              | Nothing -> []
              | Just entry -> if nameEntryMember entry visibleNames then [] else [failure path TypedInvisibleName (TypedNameDetail name)]
            }
          }
          | other -> []
        })
      | TypedFunctionType argument result -> listAppend (validateSourceDataTypeApplications context path argument) (validateSourceDataTypeApplications context path result)
      | other -> []
    }
  }.

  typeArgumentIds :: [TypedTypeArgument] -> [TypedTypeParameterId].
  typeArgumentIds = \(arguments) -> case arguments {
    | [] -> []
    | [TypedTypeArgument parameterId typeValue | rest] -> listPrepend parameterId (typeArgumentIds rest)
  }.

  typeParameterIdListEqual :: [TypedTypeParameterId] -> [TypedTypeParameterId] -> Bool.
  typeParameterIdListEqual = \(left, right) -> case (left, right) {
    | ([], []) -> True
    | ([leftFirst | leftRest], [rightFirst | rightRest]) -> if typeParameterIdEqual leftFirst rightFirst then typeParameterIdListEqual leftRest rightRest else False
    | other -> False
  }.

  binderModulePathValue :: TypedBinderId -> [Text].
  binderModulePathValue = \(binder) -> case binder {
    | TypedBinderId modulePath lexicalPath name -> modulePath
  }.

  typeArgumentSubstitutions :: [TypedTypeArgument] -> [(TypedTypeParameterId, TypedType)].
  typeArgumentSubstitutions = \(arguments) -> case arguments {
    | [] -> []
    | [TypedTypeArgument parameterId typeValue | rest] -> listPrepend (parameterId, typeValue) (typeArgumentSubstitutions rest)
  }.

  lookupTypeSubstitution :: TypedTypeParameterId -> [(TypedTypeParameterId, TypedType)] -> Maybe(TypedType).
  lookupTypeSubstitution = \(parameterId, substitutions) -> case substitutions {
    | [] -> Nothing
    | [(candidateId, typeValue) | rest] -> if typeParameterIdEqual parameterId candidateId then Just typeValue else lookupTypeSubstitution parameterId rest
  }.

  substituteTypeParameters :: [(TypedTypeParameterId, TypedType)] -> TypedType -> TypedType.
  substituteTypeParameters = \(substitutions, typeValue) -> case typeValue {
    | TypedListType elementType -> TypedListType (substituteTypeParameters substitutions elementType)
    | TypedTupleType elementTypes -> TypedTupleType (listMap (\(elementType) -> substituteTypeParameters substitutions elementType) elementTypes)
    | TypedDataType name arguments -> TypedDataType name (listMap (\(argument) -> substituteTypeParameters substitutions argument) arguments)
    | TypedFunctionType argument result -> TypedFunctionType (substituteTypeParameters substitutions argument) (substituteTypeParameters substitutions result)
    | TypedTypeParameterType parameterId -> case lookupTypeSubstitution parameterId substitutions {
      | Nothing -> typeValue
      | Just replacement -> replacement
    }
    | other -> typeValue
  }.

  substituteRepresentationParameters :: [(TypedTypeParameterId, TypedType)] -> TypedRepresentationRecipe -> TypedRepresentationRecipe.
  substituteRepresentationParameters = \(substitutions, recipe) -> case recipe {
    | TypedManagedListRecipe elementRecipe -> TypedManagedListRecipe (substituteRepresentationParameters substitutions elementRecipe)
    | TypedManagedProductRecipe elementRecipes -> TypedManagedProductRecipe (listMap (\(elementRecipe) -> substituteRepresentationParameters substitutions elementRecipe) elementRecipes)
    | TypedManagedVariantRecipe name arguments -> TypedManagedVariantRecipe name (listMap (\(argument) -> substituteTypeParameters substitutions argument) arguments)
    | TypedClosureRecipe parameters result -> TypedClosureRecipe
      (listMap (\(parameter) -> substituteRepresentationParameters substitutions parameter) parameters)
      (substituteRepresentationParameters substitutions result)
    | TypedRepresentationParameterRecipe parameterId -> case lookupTypeSubstitution parameterId substitutions {
      | Nothing -> recipe
      | Just replacement -> case expectedRecipe replacement {
        | Nothing -> recipe
        | Just replacementRecipe -> replacementRecipe
      }
    }
    | other -> recipe
  }.

  qualifyExternalName :: [Text] -> TypedCoreName -> TypedCoreName.
  qualifyExternalName = \(modulePath, name) -> case name {
    | TypedResolvedName TypedCurrentModule namespace identifier ->
      TypedResolvedName (if textListEqual modulePath ["Prelude"] then TypedAmbientPrelude else TypedImportedModule modulePath) namespace identifier
    | other -> other
  }.

  qualifyExternalType :: [Text] -> TypedType -> TypedType.
  qualifyExternalType = \(modulePath, typeValue) -> case typeValue {
    | TypedListType elementType -> TypedListType (qualifyExternalType modulePath elementType)
    | TypedTupleType elementTypes -> TypedTupleType (listMap (\(elementType) -> qualifyExternalType modulePath elementType) elementTypes)
    | TypedDataType name arguments -> TypedDataType (qualifyExternalName modulePath name) (listMap (\(argument) -> qualifyExternalType modulePath argument) arguments)
    | TypedFunctionType argument result -> TypedFunctionType (qualifyExternalType modulePath argument) (qualifyExternalType modulePath result)
    | other -> other
  }.

  qualifyExternalImplId :: [Text] -> TypedImplId -> TypedImplId.
  qualifyExternalImplId = \(modulePath, implId) -> case implId {
    | TypedImplId implPath capability arguments -> TypedImplId
      implPath
      (qualifyExternalName modulePath capability)
      (listMap (\(argument) -> qualifyExternalType modulePath argument) arguments)
  }.

  instantiatedConstraint :: [Text] -> TypedBinderId -> [(TypedTypeParameterId, TypedType)] -> TypedCapabilityConstraint -> TypedCapabilityConstraint.
  instantiatedConstraint = \(currentModulePath, owner, substitutions, constraint) -> case constraint {
    | TypedCapabilityConstraint capability method targetType -> {
      ownerPath = binderModulePathValue owner.
      qualifiedTarget = if textListEqual ownerPath currentModulePath then targetType else qualifyExternalType ownerPath targetType.
      TypedCapabilityConstraint capability method (substituteTypeParameters substitutions qualifiedTarget).
    }
  }.

  instantiatedPrimitiveConstraint :: [Text] -> TypedBinderId -> [(TypedTypeParameterId, TypedType)] -> TypedPrimitiveConstraint -> TypedPrimitiveConstraint.
  instantiatedPrimitiveConstraint = \(currentModulePath, owner, substitutions, constraint) -> {
    ownerPath = binderModulePathValue owner.
    case constraint {
      | TypedNumericPrimitiveConstraint numericConstraint targetType -> {
        qualifiedTarget = if textListEqual ownerPath currentModulePath then targetType else qualifyExternalType ownerPath targetType.
        TypedNumericPrimitiveConstraint numericConstraint (substituteTypeParameters substitutions qualifiedTarget).
      }
      | TypedStrictEqualityPrimitiveConstraint targetType -> {
        qualifiedTarget = if textListEqual ownerPath currentModulePath then targetType else qualifyExternalType ownerPath targetType.
        TypedStrictEqualityPrimitiveConstraint (substituteTypeParameters substitutions qualifiedTarget).
      }
    }.
  }.

  validateInstantiatedPrimitiveConstraints :: ModuleContext -> TypedCoreValidationPath -> [TypedTypeParameterId] -> [Text] -> TypedBinderId -> [(TypedTypeParameterId, TypedType)] -> [TypedPrimitiveConstraint] -> [TypedCoreValidationFailure].
  validateInstantiatedPrimitiveConstraints = \(context, path, scope, modulePath, owner, substitutions, constraints) -> case constraints {
    | [] -> []
    | [first | rest] -> listAppend
      (validatePrimitiveConstraint context path scope (instantiatedPrimitiveConstraint modulePath owner substitutions first))
      (validateInstantiatedPrimitiveConstraints context path scope modulePath owner substitutions rest)
  }.

  evidenceBindingsFromParameters :: [Text] -> TypedBinderId -> [(TypedTypeParameterId, TypedType)] -> [TypedEvidenceParameter] -> [EvidenceBinding].
  evidenceBindingsFromParameters = \(modulePath, owner, substitutions, parameters) -> case parameters {
    | [] -> []
    | [TypedEvidenceParameter parameterId constraint | rest] -> listPrepend
      (EvidenceBinding (TypedEvidenceParameterRef owner parameterId) (instantiatedConstraint modulePath owner substitutions constraint))
      (evidenceBindingsFromParameters modulePath owner substitutions rest)
  }.

  expectedEvidenceBindingsFor :: [Text] -> [SchemeEntry] -> TypedInstantiation -> [EvidenceBinding].
  expectedEvidenceBindingsFor = \(modulePath, schemes, instantiation) -> case instantiation {
    | TypedInstantiation owner arguments explicitSpan -> case lookupScheme owner schemes {
      | Nothing -> []
      | Just scheme -> case scheme {
        | TypedScheme schemeOwner parameters evidence primitive resultType resultRecipe -> if typeParameterIdListEqual (typeArgumentIds arguments) parameters then
          evidenceBindingsFromParameters modulePath owner (typeArgumentSubstitutions arguments) evidence
        else []
      }
    }
  }.

  expectedEvidenceBindings :: [Text] -> [SchemeEntry] -> [TypedInstantiation] -> [EvidenceBinding].
  expectedEvidenceBindings = \(modulePath, schemes, instantiations) -> case instantiations {
    | [] -> []
    | [first | rest] -> listAppend (expectedEvidenceBindingsFor modulePath schemes first) (expectedEvidenceBindings modulePath schemes rest)
  }.

  evidenceBindingMember :: TypedEvidenceParameterRef -> TypedCapabilityConstraint -> [EvidenceBinding] -> Bool.
  evidenceBindingMember = \(parameterRef, constraint, bindings) -> case bindings {
    | [] -> False
    | [EvidenceBinding candidateRef candidateConstraint | rest] -> if evidenceParameterRefEqual parameterRef candidateRef then if capabilityConstraintEqual constraint candidateConstraint then True else evidenceBindingMember parameterRef constraint rest else evidenceBindingMember parameterRef constraint rest
  }.

  evidenceBindingEqual :: EvidenceBinding -> EvidenceBinding -> Bool.
  evidenceBindingEqual = \(left, right) -> case (left, right) {
    | (EvidenceBinding leftRef leftConstraint, EvidenceBinding rightRef rightConstraint) -> if evidenceParameterRefEqual leftRef rightRef then capabilityConstraintEqual leftConstraint rightConstraint else False
  }.

  evidenceBindingEntryMember :: EvidenceBinding -> [EvidenceBinding] -> Bool.
  evidenceBindingEntryMember = \(candidate, bindings) -> case bindings {
    | [] -> False
    | [first | rest] -> if evidenceBindingEqual candidate first then True else evidenceBindingEntryMember candidate rest
  }.

  uniqueEvidenceBindings :: [EvidenceBinding] -> [EvidenceBinding] -> [EvidenceBinding].
  uniqueEvidenceBindings = \(bindings, seen) -> case bindings {
    | [] -> listReverse seen
    | [first | rest] -> if evidenceBindingEntryMember first seen then uniqueEvidenceBindings rest seen else uniqueEvidenceBindings rest (listPrepend first seen)
  }.

  selectionSuppliesEvidenceBinding :: EvidenceBinding -> [TypedEvidenceSelection] -> Bool.
  selectionSuppliesEvidenceBinding = \(binding, selections) -> case (binding, selections) {
    | (candidate, []) -> False
    | (EvidenceBinding parameterRef constraint, [first | rest]) -> case first {
      | TypedSelectedEvidence evidenceUse -> case evidenceUse {
        | TypedEvidenceUse maybeSelectedRef selectedConstraint implId maybeMethod -> case maybeSelectedRef {
          | Just selectedRef -> if evidenceParameterRefEqual parameterRef selectedRef then if capabilityConstraintEqual constraint selectedConstraint then True else selectionSuppliesEvidenceBinding binding rest else selectionSuppliesEvidenceBinding binding rest
          | Nothing -> selectionSuppliesEvidenceBinding binding rest
        }
      }
      | other -> selectionSuppliesEvidenceBinding binding rest
    }
  }.

  selectedEvidenceBindings :: [TypedEvidenceSelection] -> [EvidenceBinding].
  selectedEvidenceBindings = \(selections) -> case selections {
    | [] -> []
    | [first | rest] -> case first {
      | TypedSelectedEvidence evidenceUse -> case evidenceUse {
        | TypedEvidenceUse maybeSelectedRef constraint implId maybeMethod -> case maybeSelectedRef {
          | Just selectedRef -> listPrepend (EvidenceBinding selectedRef constraint) (selectedEvidenceBindings rest)
          | Nothing -> selectedEvidenceBindings rest
        }
      }
      | other -> selectedEvidenceBindings rest
    }
  }.

  evidenceBindingsIncluded :: [EvidenceBinding] -> [EvidenceBinding] -> Bool.
  evidenceBindingsIncluded = \(candidates, bindings) -> case candidates {
    | [] -> True
    | [first | rest] -> if evidenceBindingEntryMember first bindings then evidenceBindingsIncluded rest bindings else False
  }.

  sameEvidenceBindings :: [EvidenceBinding] -> [EvidenceBinding] -> Bool.
  sameEvidenceBindings = \(expected, actual) ->
    if listLength expected == listLength actual then
      if evidenceBindingsIncluded expected actual then evidenceBindingsIncluded actual expected else False
    else False.

  evidenceBindingOrderFailures :: TypedCoreValidationPath -> [EvidenceBinding] -> [EvidenceBinding] -> [TypedCoreValidationFailure].
  evidenceBindingOrderFailures = \(path, expected, actual) -> case (expected, actual) {
    | ([], []) -> []
    | ([expectedFirst | expectedRest], [actualFirst | actualRest]) -> case actualFirst {
      | EvidenceBinding actualRef actualConstraint -> listAppend
        (if evidenceBindingEqual expectedFirst actualFirst then [] else [failure path TypedInstantiationMismatch (TypedEvidenceParameterDetail (evidenceParameterRefId actualRef))])
        (evidenceBindingOrderFailures path expectedRest actualRest)
    }
    | other -> []
  }.

  missingEvidenceBindingFailures :: TypedCoreValidationPath -> [EvidenceBinding] -> [TypedEvidenceSelection] -> [TypedCoreValidationFailure].
  missingEvidenceBindingFailures = \(path, bindings, selections) -> case bindings {
    | [] -> []
    | [first | rest] -> case first {
      | EvidenceBinding parameterRef constraint -> listAppend
        (if selectionSuppliesEvidenceBinding first selections then [] else [failure path TypedMissingEvidence (TypedEvidenceParameterDetail (evidenceParameterRefId parameterRef))])
        (missingEvidenceBindingFailures path rest selections)
    }
  }.

  validateEvidenceParameterBindingsFrom :: TypedCoreValidationPath -> [EvidenceBinding] -> [TypedEvidenceSelection] -> [TypedCoreValidationFailure].
  validateEvidenceParameterBindingsFrom = \(path, bindings, selections) -> case selections {
    | [] -> []
    | [first | rest] -> listAppend
      (case first {
        | TypedSelectedEvidence evidenceUse -> case evidenceUse {
          | TypedEvidenceUse maybeParameter constraint implId maybeMethod -> case maybeParameter {
            | Nothing -> []
            | Just parameterRef -> if evidenceBindingMember parameterRef constraint bindings then [] else [failure path TypedInstantiationMismatch (TypedEvidenceParameterDetail (evidenceParameterRefId parameterRef))]
          }
        }
        | other -> []
      })
      (validateEvidenceParameterBindingsFrom path bindings rest)
  }.

  validateEvidenceParameterBindings :: ModuleContext -> TypedCoreValidationPath -> [TypedInstantiation] -> [TypedEvidenceSelection] -> [TypedCoreValidationFailure].
  validateEvidenceParameterBindings = \(context, path, instantiations, selections) -> case context {
    | ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope ->
      {
        bindings = uniqueEvidenceBindings (expectedEvidenceBindings modulePath schemes instantiations) [].
        suppliedBindings = selectedEvidenceBindings selections.
        listConcat
          [ missingEvidenceBindingFailures path bindings selections,
            if sameEvidenceBindings bindings suppliedBindings then evidenceBindingOrderFailures path bindings suppliedBindings else [],
            validateEvidenceParameterBindingsFrom path bindings selections
          ].
      }
  }.

  validateTypeArguments :: ModuleContext -> TypedCoreValidationPath -> [TypedTypeParameterId] -> [TypedTypeArgument] -> [TypedCoreValidationFailure].
  validateTypeArguments = \(context, path, scope, arguments) -> case arguments {
    | [] -> []
    | [TypedTypeArgument parameterId typeValue | rest] -> listConcat
      [ validateType path scope typeValue,
        validateDataTypeApplications context path typeValue,
        validateTypeArguments context path scope rest
      ]
  }.

  schemeTypeParameters :: TypedScheme -> [TypedTypeParameterId].
  schemeTypeParameters = \(scheme) -> case scheme {
    | TypedScheme owner typeParameters evidence primitive resultType resultRecipe -> typeParameters
  }.

  lookupInstantiationContract :: TypedBinderId -> [SchemeEntry] -> [DataEntry] -> Maybe(InstantiationContract).
  lookupInstantiationContract = \(owner, schemes, dataEntries) -> case lookupScheme owner schemes {
    | Just scheme -> case scheme {
      | TypedScheme schemeOwner parameters evidence primitive resultType resultRecipe ->
        Just (InstantiationContract schemeOwner parameters primitive)
    }
    | Nothing -> case lookupConstructorContractByOwner owner dataEntries {
      | Just constructorContract -> case constructorContract {
        | ConstructorContract constructorOwner dataPath dataIdentifier parameters fields ->
          Just (InstantiationContract constructorOwner parameters [])
      }
      | Nothing -> Nothing
    }
  }.

  validateInstantiation :: ModuleContext -> TypedCoreValidationPath -> [TypedTypeParameterId] -> TypedInstantiation -> [TypedCoreValidationFailure].
  validateInstantiation = \(context, path, scope, instantiation) -> case (context, instantiation) {
    | (ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope, TypedInstantiation owner arguments explicitSpan) -> case lookupInstantiationContract owner schemes dataEntries {
      | Nothing -> [failure path TypedInstantiationMismatch (TypedBinderDetail owner)]
      | Just contract -> case contract {
        | InstantiationContract contractOwner parameters primitive -> if typeParameterIdListEqual (typeArgumentIds arguments) parameters then listAppend
          (validateTypeArguments context path scope arguments)
          (validateInstantiatedPrimitiveConstraints context path scope modulePath contractOwner (typeArgumentSubstitutions arguments) primitive)
        else [failure path TypedInstantiationMismatch (TypedBinderDetail owner)]
      }
    }
  }.

  validateInstantiations :: ModuleContext -> TypedCoreValidationPath -> [TypedTypeParameterId] -> [TypedInstantiation] -> [TypedCoreValidationFailure].
  validateInstantiations = \(context, path, scope, instantiations) -> case instantiations {
    | [] -> []
    | [first | rest] -> listAppend (validateInstantiation context path scope first) (validateInstantiations context path scope rest)
  }.

  duplicateInstantiationFailuresWith :: TypedCoreValidationPath -> [TypedBinderId] -> [TypedInstantiation] -> [TypedCoreValidationFailure].
  duplicateInstantiationFailuresWith = \(path, seen, instantiations) -> case instantiations {
    | [] -> []
    | [TypedInstantiation owner arguments explicitSpan | rest] ->
      if binderIdMember owner seen then
        listAppend
          [failure path TypedInstantiationMismatch (TypedBinderDetail owner)]
          (duplicateInstantiationFailuresWith path seen rest)
      else
        duplicateInstantiationFailuresWith path (listAppend [owner] seen) rest
  }.

  duplicateInstantiationFailures :: TypedCoreValidationPath -> [TypedInstantiation] -> [TypedCoreValidationFailure].
  duplicateInstantiationFailures = \(path, instantiations) -> duplicateInstantiationFailuresWith path [] instantiations.

  validateImplDataTypes :: ModuleContext -> TypedCoreValidationPath -> TypedImplId -> [TypedCoreValidationFailure].
  validateImplDataTypes = \(context, path, implId) -> case implId {
    | TypedImplId modulePath capability arguments -> listConcat (listMap (\(argument) -> validateDataTypeApplications context path argument) arguments)
  }.

  validateMaybeMethodDataTypes :: ModuleContext -> TypedCoreValidationPath -> Maybe(TypedMethodId) -> [TypedCoreValidationFailure].
  validateMaybeMethodDataTypes = \(context, path, maybeMethod) -> case maybeMethod {
    | Nothing -> []
    | Just methodId -> case methodId {
      | TypedMethodId implId methodName -> validateImplDataTypes context path implId
    }
  }.

  validateEvidenceCandidateDataTypes :: ModuleContext -> TypedCoreValidationPath -> [TypedEvidenceCandidate] -> [TypedCoreValidationFailure].
  validateEvidenceCandidateDataTypes = \(context, path, candidates) -> case candidates {
    | [] -> []
    | [TypedEvidenceCandidate implId maybeMethod | rest] -> listConcat
      [ validateImplDataTypes context path implId,
        validateMaybeMethodDataTypes context path maybeMethod,
        validateEvidenceCandidateDataTypes context path rest
      ]
  }.

  validateEvidenceSelectionDataTypes :: ModuleContext -> TypedCoreValidationPath -> TypedEvidenceSelection -> [TypedCoreValidationFailure].
  validateEvidenceSelectionDataTypes = \(context, path, selection) -> case selection {
    | TypedSelectedEvidence evidenceUse -> case evidenceUse {
      | TypedEvidenceUse parameterId constraint implId maybeMethod -> case constraint {
        | TypedCapabilityConstraint capability method targetType -> listConcat
          [ validateDataTypeApplications context path targetType,
            validateImplDataTypes context path implId,
            validateMaybeMethodDataTypes context path maybeMethod
          ]
      }
    }
    | TypedEvidenceCandidates constraint candidates -> case constraint {
      | TypedCapabilityConstraint capability method targetType -> listAppend
        (validateDataTypeApplications context path targetType)
        (validateEvidenceCandidateDataTypes context path candidates)
    }
  }.

  qualifiedMethodExpressionKey :: TypedExpr -> Maybe(Text).
  qualifiedMethodExpressionKey = \(expression) -> case expression {
    | TypedVariableExpr info name -> case name {
      | TypedBuiltinName identifier -> Just identifier
      | other -> Nothing
    }
    | TypedApplyExpr info function argument -> qualifiedMethodExpressionKey function
    | TypedTypeApplicationExpr info function span typeArgument -> qualifiedMethodExpressionKey function
    | other -> Nothing
  }.

  validateNodeInfo :: ModuleContext -> TypedCoreValidationPath -> [TypedTypeParameterId] -> Bool -> Maybe(Text) -> Maybe(Text) -> TypedNodeInfo -> [TypedCoreValidationFailure].
  validateNodeInfo = \(context, path, scope, requireSelectedConsumer, selectedMethodKey, candidateMethodKey, info) -> case info {
    | TypedNodeInfo typeValue recipe instantiations evidence -> listConcat
      [ validateType path scope typeValue,
        validateDataTypeApplications context path typeValue,
        validateRecipe path scope recipe,
        validateTypeRecipe path scope typeValue recipe,
        validateInstantiations context path scope instantiations,
        duplicateInstantiationFailures path instantiations,
        validateEvidenceSelections context path requireSelectedConsumer selectedMethodKey candidateMethodKey evidence,
        validateEvidenceParameterBindings context path instantiations evidence,
        listConcat (listMap (\(selection) -> validateEvidenceSelectionDataTypes context path selection) evidence)
      ]
  }.

  nodeType :: TypedNodeInfo -> TypedType.
  nodeType = \(info) -> case info {
    | TypedNodeInfo typeValue recipe instantiations evidence -> typeValue
  }.

  nodeRecipe :: TypedNodeInfo -> TypedRepresentationRecipe.
  nodeRecipe = \(info) -> case info {
    | TypedNodeInfo typeValue recipe instantiations evidence -> recipe
  }.

  nodeEvidenceSelections :: TypedNodeInfo -> [TypedEvidenceSelection].
  nodeEvidenceSelections = \(info) -> case info {
    | TypedNodeInfo typeValue recipe instantiations evidence -> evidence
  }.

  expressionInfo :: TypedExpr -> TypedNodeInfo.
  expressionInfo = \(expression) -> case expression {
    | TypedLiteralExpr info literal -> info
    | TypedVariableExpr info name -> info
    | TypedLambdaExpr info binder name body -> info
    | TypedOperatorValueExpr info operator -> info
    | TypedListExpr info expressions -> info
    | TypedTupleExpr info expressions -> info
    | TypedApplyExpr info function argument -> info
    | TypedTypeApplicationExpr info function span typeArgument -> info
    | TypedIfExpr info condition thenExpression elseExpression -> info
    | TypedPatternCaseExpr info scrutinee arms -> info
    | TypedBinaryExpr info operator left right -> info
    | TypedLeftSectionExpr info left operator -> info
    | TypedRightSectionExpr info operator right -> info
    | TypedBlockExpr info statements -> info
  }.

  qualifiedMethodCandidateKey :: TypedExpr -> Maybe(Text).
  qualifiedMethodCandidateKey = \(expression) -> case nodeType (expressionInfo expression) {
    | TypedFunctionType argument result -> qualifiedMethodExpressionKey expression
    | other -> Nothing
  }.

  nestedExpressionListLocations :: [Int] -> [Int] -> [TypedExpr] -> Int -> [[Int]].
  nestedExpressionListLocations = \(statementLocation, parentPath, expressions, childIndex) -> case expressions {
    | [] -> []
    | [first | rest] -> listAppend
      (nestedExpressionLocations statementLocation (listAppend parentPath [childIndex]) first)
      (nestedExpressionListLocations statementLocation parentPath rest (childIndex + 1))
  }.

  nestedCaseArmExpressionLocations :: [Int] -> [Int] -> [TypedCaseArm] -> Int -> [[Int]].
  nestedCaseArmExpressionLocations = \(statementLocation, parentPath, arms, childIndex) -> case arms {
    | [] -> []
    | [TypedCaseArm pattern maybeGuard result | rest] -> case maybeGuard {
      | Nothing -> listAppend
        (nestedExpressionLocations statementLocation (listAppend parentPath [childIndex]) result)
        (nestedCaseArmExpressionLocations statementLocation parentPath rest (childIndex + 1))
      | Just guard -> listConcat
        [ nestedExpressionLocations statementLocation (listAppend parentPath [childIndex]) guard,
          nestedExpressionLocations statementLocation (listAppend parentPath [childIndex + 1]) result,
          nestedCaseArmExpressionLocations statementLocation parentPath rest (childIndex + 2)
        ]
    }
  }.

  nestedBlockStatementLocations :: [Int] -> [Int] -> [TypedStatement] -> Int -> [[Int]].
  nestedBlockStatementLocations = \(statementLocation, expressionPath, statements, blockIndex) -> case statements {
    | [] -> []
    | [first | rest] -> {
      location = nestedStatementLocation statementLocation expressionPath blockIndex.
      listConcat
        [ [location],
          nestedStatementLocations location first,
          nestedBlockStatementLocations statementLocation expressionPath rest (blockIndex + 1)
        ].
    }
  }.

  nestedExpressionLocations :: [Int] -> [Int] -> TypedExpr -> [[Int]].
  nestedExpressionLocations = \(statementLocation, expressionPath, expression) -> case expression {
    | TypedLambdaExpr info binder name body -> nestedExpressionLocations statementLocation (listAppend expressionPath [0]) body
    | TypedListExpr info expressions -> nestedExpressionListLocations statementLocation expressionPath expressions 0
    | TypedTupleExpr info expressions -> nestedExpressionListLocations statementLocation expressionPath expressions 0
    | TypedApplyExpr info function argument -> listAppend
      (nestedExpressionLocations statementLocation (listAppend expressionPath [0]) function)
      (nestedExpressionLocations statementLocation (listAppend expressionPath [1]) argument)
    | TypedTypeApplicationExpr info function span typeArgument -> nestedExpressionLocations statementLocation (listAppend expressionPath [0]) function
    | TypedIfExpr info condition thenExpression elseExpression -> listConcat
      [ nestedExpressionLocations statementLocation (listAppend expressionPath [0]) condition,
        nestedExpressionLocations statementLocation (listAppend expressionPath [1]) thenExpression,
        nestedExpressionLocations statementLocation (listAppend expressionPath [2]) elseExpression
      ]
    | TypedPatternCaseExpr info scrutinee arms -> listAppend
      (nestedExpressionLocations statementLocation (listAppend expressionPath [0]) scrutinee)
      (nestedCaseArmExpressionLocations statementLocation expressionPath arms 1)
    | TypedBinaryExpr info operator left right -> listAppend
      (nestedExpressionLocations statementLocation (listAppend expressionPath [0]) left)
      (nestedExpressionLocations statementLocation (listAppend expressionPath [1]) right)
    | TypedLeftSectionExpr info left operator -> nestedExpressionLocations statementLocation (listAppend expressionPath [0]) left
    | TypedRightSectionExpr info operator right -> nestedExpressionLocations statementLocation (listAppend expressionPath [0]) right
    | TypedBlockExpr info statements -> nestedBlockStatementLocations statementLocation expressionPath statements 0
    | other -> []
  }.

  nestedMethodStatementLocations :: [Int] -> [TypedMethodDefinition] -> Int -> [[Int]].
  nestedMethodStatementLocations = \(statementLocation, methods, methodIndex) -> case methods {
    | [] -> []
    | [TypedMethodDefinition methodId binder name span expression | rest] -> listAppend
      (nestedExpressionLocations statementLocation [methodIndex] expression)
      (nestedMethodStatementLocations statementLocation rest (methodIndex + 1))
  }.

  nestedStatementLocations :: [Int] -> TypedStatement -> [[Int]].
  nestedStatementLocations = \(statementLocation, statement) -> case statement {
    | TypedLetStatement binder name span scheme expression -> nestedExpressionLocations statementLocation [0] expression
    | TypedImplStatement declaration -> case declaration {
      | TypedImplDeclaration span implId methods -> nestedMethodStatementLocations statementLocation methods 0
    }
    | TypedExpressionStatement span expression -> nestedExpressionLocations statementLocation [0] expression
    | other -> []
  }.

  topLevelStatementLocations :: [TypedStatement] -> Int -> [[Int]].
  topLevelStatementLocations = \(statements, statementIndex) -> case statements {
    | [] -> []
    | [first | rest] -> listPrepend [statementIndex] (topLevelStatementLocations rest (statementIndex + 1))
  }.

  allNestedStatementLocations :: [TypedStatement] -> Int -> [[Int]].
  allNestedStatementLocations = \(statements, statementIndex) -> case statements {
    | [] -> []
    | [first | rest] -> listAppend
      (nestedStatementLocations [statementIndex] first)
      (allNestedStatementLocations rest (statementIndex + 1))
  }.

  assignStatementIndices :: [[Int]] -> Int -> [StatementIndexEntry].
  assignStatementIndices = \(locations, statementIndex) -> case locations {
    | [] -> []
    | [first | rest] -> listPrepend (StatementIndexEntry first statementIndex) (assignStatementIndices rest (statementIndex + 1))
  }.

  statementIndexEntries :: [TypedStatement] -> [StatementIndexEntry].
  statementIndexEntries = \(statements) ->
    assignStatementIndices (listAppend (topLevelStatementLocations statements 0) (allNestedStatementLocations statements 0)) 0.

  patternInfo :: TypedPattern -> TypedNodeInfo.
  patternInfo = \(pattern) -> case pattern {
    | TypedWildcardPattern info -> info
    | TypedVariablePattern info binder name -> info
    | TypedLiteralPattern info literal -> info
    | TypedConstructorPattern info name patterns -> info
    | TypedListPattern info patterns -> info
    | TypedConsListPattern info headPattern tailPattern -> info
    | TypedTuplePattern info patterns -> info
    | TypedAsPattern info binder name nested -> info
    | TypedOrPattern info alternatives -> info
  }.

  numericTypeIsFloat :: TypedNumericType -> Bool.
  numericTypeIsFloat = \(numericType) -> case numericType {
    | TypedFloat16Type -> True
    | TypedFloat32Type -> True
    | TypedFloat64Type -> True
    | other -> False
  }.

  literalType :: TypedLiteral -> TypedType.
  literalType = \(literal) -> case literal {
    | TypedIntegerLiteral value -> TypedIntType
    | TypedFractionalLiteral whole fractional suffix -> case suffix {
      | Nothing -> TypedFloatType
      | Just numericType -> TypedNumericType numericType
    }
    | TypedBooleanLiteral value -> TypedBoolType
    | TypedCharacterLiteral value -> TypedCharType
    | TypedTextLiteral value -> TypedTextType
  }.

  integerLiteralFitsType :: Text -> TypedType -> Bool.
  integerLiteralFitsType = \(value, typeValue) -> integralLiteralTextFitsType value typeValue.

  literalMatchesType :: TypedLiteral -> TypedType -> Bool.
  literalMatchesType = \(literal, typeValue) -> case (literal, typeValue) {
    | (TypedIntegerLiteral value, TypedIntType) -> integerLiteralFitsType value typeValue
    | (TypedIntegerLiteral value, TypedNumericType numericType) -> if numericTypeIsFloat numericType then False else integerLiteralFitsType value typeValue
    | (TypedFractionalLiteral whole fractional suffix, TypedFloatType) -> case suffix {
      | Nothing -> fractionalLiteralFitsNumericType whole fractional TypedFloat64Type
      | Just expectedType -> False
    }
    | (TypedFractionalLiteral whole fractional suffix, TypedNumericType actualType) -> case suffix {
      | Nothing -> if numericTypeIsFloat actualType then fractionalLiteralFitsNumericType whole fractional actualType else False
      | Just expectedType -> if numericTypeEqual expectedType actualType then if numericTypeIsFloat actualType then fractionalLiteralFitsNumericType whole fractional actualType else False else False
    }
    | (TypedBooleanLiteral value, TypedBoolType) -> True
    | (TypedCharacterLiteral value, TypedCharType) -> True
    | (TypedTextLiteral value, TypedTextType) -> True
    | other -> False
  }.

  characterIsUnicodeScalar :: Char -> Bool.
  characterIsUnicodeScalar = \(value) ->
    if charToUInt32 value < 55296 then True else charToUInt32 value > 57343.

  validateLiteral :: TypedCoreValidationPath -> TypedNodeInfo -> TypedLiteral -> [TypedCoreValidationFailure].
  validateLiteral = \(path, info, literal) -> case literal {
    | TypedCharacterLiteral value ->
      if characterIsUnicodeScalar value then
        if literalMatchesType literal (nodeType info) then [] else [failure path TypedLiteralTypeMismatch (TypedTypeDetail (literalType literal) (nodeType info))]
      else [failure path TypedLiteralTypeMismatch (TypedTextDetail "non-scalar character")]
    | other -> if literalMatchesType literal (nodeType info) then [] else [failure path TypedLiteralTypeMismatch (TypedTypeDetail (literalType literal) (nodeType info))]
  }.

  patternBinderContract :: TypedPattern -> [PatternBinderContract].
  patternBinderContract = \(pattern) -> case pattern {
    | TypedVariablePattern info binder name -> [PatternBinderContract binder name (nodeType info) (nodeRecipe info)]
    | TypedConstructorPattern info name patterns -> patternBinderContracts patterns
    | TypedListPattern info patterns -> patternBinderContracts patterns
    | TypedConsListPattern info headPattern tailPattern -> listAppend (patternBinderContract headPattern) (patternBinderContract tailPattern)
    | TypedTuplePattern info patterns -> patternBinderContracts patterns
    | TypedAsPattern info binder name nested -> listPrepend (PatternBinderContract binder name (nodeType info) (nodeRecipe info)) (patternBinderContract nested)
    | TypedOrPattern info alternatives -> case alternatives {
      | [] -> []
      | [first | rest] -> patternBinderContract first
    }
    | other -> []
  }.

  patternBinderContracts :: [TypedPattern] -> [PatternBinderContract].
  patternBinderContracts = \(patterns) -> case patterns {
    | [] -> []
    | [first | rest] -> listAppend (patternBinderContract first) (patternBinderContracts rest)
  }.

  patternBinderContractEqual :: PatternBinderContract -> PatternBinderContract -> Bool.
  patternBinderContractEqual = \(left, right) -> case (left, right) {
    | (PatternBinderContract leftBinder leftName leftType leftRecipe, PatternBinderContract rightBinder rightName rightType rightRecipe) -> if coreNameEqual leftName rightName then if typeEqual leftType rightType then recipeEqual leftRecipe rightRecipe else False else False
  }.

  patternBinderContractMember :: PatternBinderContract -> [PatternBinderContract] -> Bool.
  patternBinderContractMember = \(candidate, contracts) -> case contracts {
    | [] -> False
    | [first | rest] -> if patternBinderContractEqual candidate first then True else patternBinderContractMember candidate rest
  }.

  patternBinderContractCount :: PatternBinderContract -> [PatternBinderContract] -> Int.
  patternBinderContractCount = \(candidate, contracts) -> case contracts {
    | [] -> 0
    | [first | rest] ->
      (if patternBinderContractEqual candidate first then 1 else 0) + patternBinderContractCount candidate rest
  }.

  patternBinderContractListEqual :: [PatternBinderContract] -> [PatternBinderContract] -> Bool.
  patternBinderContractListEqual = \(left, right) ->
    if listLength left == listLength right then
      listAll (\(contract) -> patternBinderContractCount contract left == patternBinderContractCount contract right) left
    else False.

  mismatchedPatternBinder :: [PatternBinderContract] -> [PatternBinderContract] -> Maybe(TypedBinderId).
  mismatchedPatternBinder = \(expected, actual) -> case actual {
    | [] -> Nothing
    | [first | rest] -> if patternBinderContractMember first expected then mismatchedPatternBinder expected rest else case first {
      | PatternBinderContract binder name typeValue recipe -> Just binder
    }
  }.

  patternContractNameMember :: TypedCoreName -> [PatternBinderContract] -> Bool.
  patternContractNameMember = \(candidate, contracts) -> case contracts {
    | [] -> False
    | [PatternBinderContract binder name typeValue recipe | rest] -> if coreNameEqual candidate name then True else patternContractNameMember candidate rest
  }.

  duplicatePatternNameFailuresFrom :: TypedCoreValidationPath -> [PatternBinderContract] -> [PatternBinderContract] -> [TypedCoreValidationFailure].
  duplicatePatternNameFailuresFrom = \(path, contracts, seen) -> case contracts {
    | [] -> []
    | [first | rest] -> case first {
      | PatternBinderContract binder name typeValue recipe -> listAppend
        (if patternContractNameMember name seen then [failure path TypedDuplicateBinder (TypedBinderDetail binder)] else [])
        (duplicatePatternNameFailuresFrom path rest (listPrepend first seen))
    }
  }.

  validateOrAlternatives :: TypedCoreValidationPath -> [PatternBinderContract] -> [TypedPattern] -> [TypedCoreValidationFailure].
  validateOrAlternatives = \(path, expected, alternatives) -> case alternatives {
    | [] -> []
    | [first | rest] -> listAppend
      (if patternBinderContractListEqual expected (patternBinderContract first) then [] else case mismatchedPatternBinder expected (patternBinderContract first) {
        | Nothing -> [failure path TypedOrPatternBinderMismatch TypedNoValidationDetail]
        | Just binder -> [failure path TypedOrPatternBinderMismatch (TypedBinderDetail binder)]
      })
      (validateOrAlternatives path expected rest)
  }.

  validateOrPattern :: TypedCoreValidationPath -> [TypedPattern] -> [TypedCoreValidationFailure].
  validateOrPattern = \(path, alternatives) -> case alternatives {
    | [] -> [failure path TypedPatternShapeMismatch (TypedArityDetail 1 0)]
    | [first | rest] -> validateOrAlternatives path (patternBinderContract first) rest
  }.

  constructorPatternFieldTypes :: ModuleContext -> TypedNodeInfo -> TypedCoreName -> Maybe([TypedType]).
  constructorPatternFieldTypes = \(context, info, constructorName) -> case (context, constructorName, nodeType info) {
    | (ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope, TypedResolvedName constructorOrigin constructorNamespace constructorIdentifier, TypedDataType dataName arguments) -> case (lookupConstructorContract (originModulePath modulePath constructorOrigin) constructorIdentifier dataEntries, dataName) {
      | (Just contract, TypedResolvedName dataOrigin dataNamespace actualDataIdentifier) -> case contract {
        | ConstructorContract binder dataModulePath dataIdentifier parameters fields ->
          if textListEqual dataModulePath (originModulePath modulePath dataOrigin) then if dataIdentifier == actualDataIdentifier then if listLength parameters == listLength arguments then
            Just (listMap (\(fieldType) -> substituteTypeParameters (listZip parameters arguments) fieldType) fields)
          else Nothing else Nothing else Nothing
      }
      | other -> Nothing
    }
    | other -> Nothing
  }.

  constructorPatternExpectedType :: ModuleContext -> TypedCoreName -> Maybe(TypedType).
  constructorPatternExpectedType = \(context, constructorName) -> case (context, constructorName) {
    | (ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope, TypedResolvedName constructorOrigin constructorNamespace constructorIdentifier) ->
      case lookupConstructorContract (originModulePath modulePath constructorOrigin) constructorIdentifier dataEntries {
        | Nothing -> Nothing
        | Just contract -> case contract {
          | ConstructorContract binder dataModulePath dataIdentifier parameters fields -> {
            dataOrigin = if textListEqual dataModulePath modulePath then TypedCurrentModule else if textListEqual dataModulePath ["Prelude"] then TypedAmbientPrelude else TypedImportedModule dataModulePath.
            Just (TypedDataType (TypedResolvedName dataOrigin TypedTypeNamespace dataIdentifier) (listMap TypedTypeParameterType parameters)).
          }
        }
      }
    | other -> Nothing
  }.

  constructorPatternShapeFailures :: ModuleContext -> TypedCoreValidationPath -> TypedPattern -> [TypedCoreValidationFailure].
  constructorPatternShapeFailures = \(context, path, pattern) -> case pattern {
    | TypedConstructorPattern info name patterns -> case constructorPatternFieldTypes context info name {
      | Nothing -> case constructorPatternExpectedType context name {
        | Nothing -> []
        | Just expectedType -> [failure path TypedPatternShapeMismatch (TypedTypeDetail expectedType (nodeType info))]
      }
      | Just fieldTypes -> if listLength fieldTypes == listLength patterns then [] else [failure path TypedPatternShapeMismatch (TypedArityDetail (listLength fieldTypes) (listLength patterns))]
    }
    | other -> []
  }.

  listPatternShapeFailures :: TypedCoreValidationPath -> TypedPattern -> [TypedCoreValidationFailure].
  listPatternShapeFailures = \(path, pattern) -> case pattern {
    | TypedListPattern info patterns -> case nodeType info {
      | TypedListType elementType -> []
      | actualType -> [failure path TypedPatternShapeMismatch (TypedTypeDetail (TypedListType actualType) actualType)]
    }
    | TypedConsListPattern info headPattern tailPattern -> case nodeType info {
      | TypedListType elementType -> []
      | actualType -> [failure path TypedPatternShapeMismatch (TypedTypeDetail (TypedListType actualType) actualType)]
    }
    | other -> []
  }.

  validatePatternChildren :: ModuleContext -> Int -> [Int] -> TypedPattern -> [TypedCoreValidationFailure].
  validatePatternChildren = \(context, statementIndex, patternPath, pattern) -> case pattern {
    | TypedConstructorPattern info name patterns -> case constructorPatternFieldTypes context info name {
      | Nothing -> validatePatternChildrenUsingOwnTypes context statementIndex patternPath patterns 0
      | Just fieldTypes -> validatePatternTypePairs context statementIndex patternPath (listZip fieldTypes patterns) 0
    }
    | TypedListPattern info patterns -> case nodeType info {
      | TypedListType elementType -> validatePatterns context statementIndex patternPath elementType patterns 0
      | other -> validatePatternChildrenUsingOwnTypes context statementIndex patternPath patterns 0
    }
    | TypedConsListPattern info headPattern tailPattern -> case nodeType info {
      | TypedListType elementType -> listAppend
        (validatePattern context statementIndex (listAppend patternPath [0]) elementType headPattern)
        (validatePattern context statementIndex (listAppend patternPath [1]) (nodeType info) tailPattern)
      | other -> listAppend
        (validatePattern context statementIndex (listAppend patternPath [0]) other headPattern)
        (validatePattern context statementIndex (listAppend patternPath [1]) other tailPattern)
    }
    | TypedTuplePattern info patterns -> case nodeType info {
      | TypedTupleType types -> validatePatternTypePairs context statementIndex patternPath (listZip types patterns) 0
      | other -> validatePatternChildrenUsingOwnTypes context statementIndex patternPath patterns 0
    }
    | TypedAsPattern info binder name nested -> validatePattern context statementIndex (listAppend patternPath [0]) (nodeType info) nested
    | TypedOrPattern info alternatives -> validatePatterns context statementIndex patternPath (nodeType info) alternatives 0
    | other -> []
  }.

  validatePatterns :: ModuleContext -> Int -> [Int] -> TypedType -> [TypedPattern] -> Int -> [TypedCoreValidationFailure].
  validatePatterns = \(context, statementIndex, parentPath, expectedType, patterns, index) -> case patterns {
    | [] -> []
    | [first | rest] -> listAppend
      (validatePattern context statementIndex (listAppend parentPath [index]) expectedType first)
      (validatePatterns context statementIndex parentPath expectedType rest (index + 1))
  }.

  validatePatternChildrenUsingOwnTypes :: ModuleContext -> Int -> [Int] -> [TypedPattern] -> Int -> [TypedCoreValidationFailure].
  validatePatternChildrenUsingOwnTypes = \(context, statementIndex, parentPath, patterns, index) -> case patterns {
    | [] -> []
    | [first | rest] -> listAppend
      (validatePattern context statementIndex (listAppend parentPath [index]) (nodeType (patternInfo first)) first)
      (validatePatternChildrenUsingOwnTypes context statementIndex parentPath rest (index + 1))
  }.

  validatePatternTypePairs :: ModuleContext -> Int -> [Int] -> [(TypedType, TypedPattern)] -> Int -> [TypedCoreValidationFailure].
  validatePatternTypePairs = \(context, statementIndex, parentPath, pairs, index) -> case pairs {
    | [] -> []
    | [(typeValue, pattern) | rest] -> listAppend
      (validatePattern context statementIndex (listAppend parentPath [index]) typeValue pattern)
      (validatePatternTypePairs context statementIndex parentPath rest (index + 1))
  }.

  tuplePatternShapeFailures :: TypedCoreValidationPath -> TypedPattern -> [TypedCoreValidationFailure].
  tuplePatternShapeFailures = \(path, pattern) -> case pattern {
    | TypedTuplePattern info patterns -> case nodeType info {
      | TypedTupleType types -> if listLength types == listLength patterns then [] else [failure path TypedPatternShapeMismatch (TypedArityDetail (listLength types) (listLength patterns))]
      | other -> [failure path TypedPatternShapeMismatch (TypedTypeDetail (TypedTupleType []) other)]
    }
    | other -> []
  }.

  patternMetadataFailures :: TypedCoreValidationPath -> TypedNodeInfo -> [TypedCoreValidationFailure].
  patternMetadataFailures = \(path, info) -> case info {
    | TypedNodeInfo typeValue recipe instantiations evidence ->
      if listLength instantiations == 0 then
        if listLength evidence == 0 then [] else [failure path TypedPatternShapeMismatch TypedNoValidationDetail]
      else [failure path TypedPatternShapeMismatch TypedNoValidationDetail]
  }.

  validatePattern :: ModuleContext -> Int -> [Int] -> TypedType -> TypedPattern -> [TypedCoreValidationFailure].
  validatePattern = \(context, statementIndex, patternPath, expectedType, pattern) -> case context {
    | ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope -> {
      path = TypedPatternPath modulePath statementIndex patternPath.
      info = patternInfo pattern.
      listConcat
        [ validateNodeInfo context path [] False Nothing Nothing info,
          patternMetadataFailures path info,
          if typeEqual (nodeType info) expectedType then [] else [failure path TypedPatternScrutineeMismatch (TypedTypeDetail expectedType (nodeType info))],
          case pattern {
            | TypedVariablePattern valueInfo binder name -> listAppend (validateLocalDefinitionName context [TypedValueNamespace] path name) (validateBinderDefinition context path binder name)
            | TypedLiteralPattern valueInfo literal -> validateLiteral path valueInfo literal
            | TypedConstructorPattern valueInfo name patterns -> validateVisibleNameInNamespaces [TypedConstructorNamespace] context path name
            | TypedAsPattern valueInfo binder name nested -> listAppend (validateLocalDefinitionName context [TypedValueNamespace] path name) (validateBinderDefinition context path binder name)
            | TypedOrPattern valueInfo alternatives -> validateOrPattern path alternatives
            | other -> []
          },
          constructorPatternShapeFailures context path pattern,
          listPatternShapeFailures path pattern,
          tuplePatternShapeFailures path pattern,
          validatePatternChildren context statementIndex patternPath pattern
        ].
    }
  }.

  validateCaseArms :: ModuleContext -> Int -> [Int] -> TypedType -> TypedType -> [TypedCaseArm] -> Int -> [TypedCoreValidationFailure].
  validateCaseArms = \(context, statementIndex, expressionPath, scrutineeType, resultType, arms, armIndex) -> case (context, arms) {
    | (ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope, []) -> []
    | (ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope, [TypedCaseArm pattern maybeGuard result | rest]) -> listConcat
      [ duplicatePatternNameFailuresFrom (TypedPatternPath modulePath statementIndex (listAppend expressionPath [armIndex])) (patternBinderContract pattern) [],
        validatePattern context statementIndex (listAppend expressionPath [armIndex]) scrutineeType pattern,
        case maybeGuard {
          | Nothing -> []
          | Just guard -> if typeEqual (nodeType (expressionInfo guard)) TypedBoolType then [] else [failure (TypedPatternPath modulePath statementIndex (listAppend expressionPath [armIndex])) TypedPatternGuardMismatch (TypedTypeDetail TypedBoolType (nodeType (expressionInfo guard)))]
        },
        if typeEqual (nodeType (expressionInfo result)) resultType then [] else [failure (TypedPatternPath modulePath statementIndex (listAppend expressionPath [armIndex])) TypedPatternArmResultMismatch (TypedTypeDetail resultType (nodeType (expressionInfo result)))],
        validateCaseArms context statementIndex expressionPath scrutineeType resultType rest (armIndex + 1)
      ]
  }.

  validateApplication :: TypedCoreValidationPath -> TypedNodeInfo -> TypedExpr -> TypedExpr -> [TypedCoreValidationFailure].
  validateApplication = \(path, resultInfo, function, argument) -> case nodeType (expressionInfo function) {
    | TypedFunctionType expectedArgument expectedResult -> listAppend
      (if typeEqual expectedArgument (nodeType (expressionInfo argument)) then [] else [failure path TypedApplicationArgumentMismatch (TypedTypeDetail expectedArgument (nodeType (expressionInfo argument)))])
      (if typeEqual expectedResult (nodeType resultInfo) then [] else [failure path TypedApplicationResultMismatch (TypedTypeDetail expectedResult (nodeType resultInfo))])
    | actualFunctionType -> [failure path TypedApplicationFunctionMismatch (TypedTypeDetail (TypedFunctionType (nodeType (expressionInfo argument)) (nodeType resultInfo)) actualFunctionType)]
  }.

  validateConditional :: TypedCoreValidationPath -> TypedNodeInfo -> TypedExpr -> TypedExpr -> TypedExpr -> [TypedCoreValidationFailure].
  validateConditional = \(path, resultInfo, condition, thenExpression, elseExpression) -> {
    conditionType = nodeType (expressionInfo condition).
    thenType = nodeType (expressionInfo thenExpression).
    elseType = nodeType (expressionInfo elseExpression).
    listConcat
      [ if typeEqual conditionType TypedBoolType then [] else [failure path TypedConditionalConditionMismatch (TypedTypeDetail TypedBoolType conditionType)],
        if typeEqual thenType elseType then [] else [failure path TypedConditionalBranchMismatch (TypedTypeDetail thenType elseType)],
        if typeEqual thenType elseType then if typeEqual (nodeType resultInfo) thenType then [] else [failure path TypedConditionalBranchMismatch (TypedTypeDetail thenType (nodeType resultInfo))] else []
      ].
  }.

  validateLambdaResult :: TypedCoreValidationPath -> TypedNodeInfo -> TypedExpr -> [TypedCoreValidationFailure].
  validateLambdaResult = \(path, info, body) -> case nodeType info {
    | TypedFunctionType argument expectedResult -> if typeEqual expectedResult (nodeType (expressionInfo body)) then [] else [failure path TypedLambdaResultMismatch (TypedTypeDetail expectedResult (nodeType (expressionInfo body)))]
    | actual -> [failure path TypedLambdaResultMismatch (TypedTypeDetail (TypedFunctionType (nodeType (expressionInfo body)) (nodeType (expressionInfo body))) actual)]
  }.

  validateListElements :: TypedCoreValidationPath -> TypedType -> [TypedExpr] -> [TypedCoreValidationFailure].
  validateListElements = \(path, expectedType, expressions) -> case expressions {
    | [] -> []
    | [first | rest] -> listAppend
      (if typeEqual expectedType (nodeType (expressionInfo first)) then [] else [failure path TypedCollectionShapeMismatch (TypedTypeDetail expectedType (nodeType (expressionInfo first)))])
      (validateListElements path expectedType rest)
  }.

  validateListShape :: TypedCoreValidationPath -> TypedNodeInfo -> [TypedExpr] -> [TypedCoreValidationFailure].
  validateListShape = \(path, info, expressions) -> case nodeType info {
    | TypedListType elementType -> validateListElements path elementType expressions
    | actual -> [failure path TypedCollectionShapeMismatch (TypedTypeDetail (TypedListType actual) actual)]
  }.

  validateTupleElements :: TypedCoreValidationPath -> [TypedType] -> [TypedExpr] -> [TypedCoreValidationFailure].
  validateTupleElements = \(path, expectedTypes, expressions) -> case (expectedTypes, expressions) {
    | ([], []) -> []
    | ([expected | expectedRest], [expression | expressionRest]) -> listAppend
      (if typeEqual expected (nodeType (expressionInfo expression)) then [] else [failure path TypedCollectionShapeMismatch (TypedTypeDetail expected (nodeType (expressionInfo expression)))])
      (validateTupleElements path expectedRest expressionRest)
    | other -> []
  }.

  validateTupleShape :: TypedCoreValidationPath -> TypedNodeInfo -> [TypedExpr] -> [TypedCoreValidationFailure].
  validateTupleShape = \(path, info, expressions) -> case nodeType info {
    | TypedTupleType expectedTypes -> if listLength expectedTypes == listLength expressions then validateTupleElements path expectedTypes expressions else [failure path TypedCollectionShapeMismatch (TypedArityDetail (listLength expectedTypes) (listLength expressions))]
    | actual -> [failure path TypedCollectionShapeMismatch (TypedTypeDetail (TypedTupleType []) actual)]
  }.

  spanEqual :: TypedSpan -> TypedSpan -> Bool.
  spanEqual = \(left, right) -> case (left, right) {
    | (TypedSpan leftLine leftColumn, TypedSpan rightLine rightColumn) -> if leftLine == rightLine then leftColumn == rightColumn else False
  }.

  binderDefinitionEntry :: TypedBinderId -> Maybe(NameEntry).
  binderDefinitionEntry = \(binder) -> case binder {
    | TypedBinderId modulePath lexicalPath name -> definitionNameEntry modulePath name
  }.

  lookupSchemeByName :: [Text] -> TypedCoreName -> [SchemeEntry] -> Maybe(TypedScheme).
  lookupSchemeByName = \(modulePath, name, entries) -> case (resolvedNameEntry modulePath name, entries) {
    | (Nothing, other) -> Nothing
    | (Just expectedEntry, []) -> Nothing
    | (Just expectedEntry, [SchemeEntry binder scheme | rest]) -> case binderDefinitionEntry binder {
      | Just actualEntry -> if nameEntryEqual expectedEntry actualEntry then Just scheme else lookupSchemeByName modulePath name rest
      | Nothing -> lookupSchemeByName modulePath name rest
    }
  }.

  nodeInstantiations :: TypedNodeInfo -> [TypedInstantiation].
  nodeInstantiations = \(info) -> case info {
    | TypedNodeInfo typeValue recipe instantiations evidence -> instantiations
  }.

  qualifyExternalRecipe :: [Text] -> TypedRepresentationRecipe -> TypedRepresentationRecipe.
  qualifyExternalRecipe = \(modulePath, recipe) -> case recipe {
    | TypedManagedListRecipe elementRecipe -> TypedManagedListRecipe (qualifyExternalRecipe modulePath elementRecipe)
    | TypedManagedProductRecipe elementRecipes -> TypedManagedProductRecipe (listMap (\(elementRecipe) -> qualifyExternalRecipe modulePath elementRecipe) elementRecipes)
    | TypedManagedVariantRecipe name arguments -> TypedManagedVariantRecipe (qualifyExternalName modulePath name) (listMap (\(argument) -> qualifyExternalType modulePath argument) arguments)
    | TypedClosureRecipe parameters result -> TypedClosureRecipe (listMap (\(parameter) -> qualifyExternalRecipe modulePath parameter) parameters) (qualifyExternalRecipe modulePath result)
    | other -> other
  }.

  findOwnerInstantiation :: TypedBinderId -> [TypedInstantiation] -> Maybe(TypedInstantiation).
  findOwnerInstantiation = \(owner, instantiations) -> case instantiations {
    | [] -> Nothing
    | [first | rest] -> case first {
      | TypedInstantiation candidateOwner arguments explicitSpan -> if binderIdEqual owner candidateOwner then Just first else findOwnerInstantiation owner rest
    }
  }.

  findMatchingInstantiation :: TypedBinderId -> [TypedTypeParameterId] -> [TypedInstantiation] -> Maybe(TypedInstantiation).
  findMatchingInstantiation = \(owner, parameters, instantiations) -> case instantiations {
    | [] -> Nothing
    | [first | rest] -> case first {
      | TypedInstantiation candidateOwner arguments explicitSpan ->
        if binderIdEqual owner candidateOwner then if typeParameterIdListEqual parameters (typeArgumentIds arguments) then Just first else findMatchingInstantiation owner parameters rest else findMatchingInstantiation owner parameters rest
    }
  }.

  numericConstraintSupportsOperator :: Text -> TypedNumericConstraint -> Bool.
  numericConstraintSupportsOperator = \(symbol, constraint) ->
    if listContains symbol ["+", "-", "*", "/"] then case constraint {
      | TypedRuntimeArithmeticNumericConstraint -> True
      | TypedIntegralNumericConstraint -> True
      | TypedIntegralLiteralNumericConstraint lower upper -> True
      | other -> False
    } else if listContains symbol ["<", "<=", ">", ">="] then case constraint {
      | TypedRuntimeArithmeticNumericConstraint -> True
      | TypedRuntimeComparisonNumericConstraint -> True
      | TypedIntegralNumericConstraint -> True
      | TypedIntegralLiteralNumericConstraint lower upper -> True
      | other -> False
    } else False.

  activeNumericConstraint :: ModuleContext -> Text -> TypedType -> Bool.
  activeNumericConstraint = \(context, symbol, typeValue) ->
    listAll
      (\(constraint) -> case constraint {
        | TypedNumericPrimitiveConstraint numericConstraint targetType ->
          if typeEqual targetType typeValue then if numericConstraintSupportsOperator symbol numericConstraint then False else True else True
        | other -> True
      })
      (activePrimitiveConstraints context)
      == False.

  numericOperatorType :: ModuleContext -> Text -> TypedType -> Bool.
  numericOperatorType = \(context, symbol, typeValue) -> case typeValue {
    | TypedIntType -> True
    | TypedFloatType -> True
    | TypedNumericType numericType -> True
    | TypedTypeParameterType parameter -> activeNumericConstraint context symbol typeValue
    | other -> False
  }.

  builtinTypeMismatchFailure :: TypedCoreValidationPath -> TypedCoreValidationKind -> TypedType -> TypedType -> [TypedCoreValidationFailure].
  builtinTypeMismatchFailure = \(path, kind, expected, actual) -> if typeEqual expected actual then [] else [failure path kind (TypedTypeDetail expected actual)].

  validateBuiltinOperatorApplication :: ModuleContext -> TypedCoreValidationPath -> Text -> TypedType -> TypedType -> TypedType -> [TypedCoreValidationFailure].
  validateBuiltinOperatorApplication = \(context, path, symbol, leftType, rightType, resultType) ->
    if builtinOperatorHasTypedRule symbol then
      if symbol == "$" then builtinTypeMismatchFailure path TypedApplicationFunctionMismatch (TypedFunctionType rightType resultType) leftType else {
        sameOperandFailure = builtinTypeMismatchFailure path TypedApplicationArgumentMismatch leftType rightType.
        numericOperandFailure = if numericOperatorType context symbol leftType then [] else [failure path TypedBindingValueMismatch (TypedTextDetail symbol)].
        if listContains symbol ["+", "-", "*", "/"] then listConcat
          [ sameOperandFailure,
            numericOperandFailure,
            builtinTypeMismatchFailure path TypedApplicationResultMismatch leftType resultType
          ]
        else if listContains symbol ["<", "<=", ">", ">="] then listConcat
          [ sameOperandFailure,
            numericOperandFailure,
            builtinTypeMismatchFailure path TypedApplicationResultMismatch TypedBoolType resultType
          ]
        else {
          equalityOperandFailure = if listContains symbol ["==", "!="] then if strictEqualityOperandSupported context leftType then [] else [failure path TypedBindingValueMismatch (TypedTypeDetail TypedBoolType leftType)] else [].
          listConcat [sameOperandFailure, equalityOperandFailure, builtinTypeMismatchFailure path TypedApplicationResultMismatch TypedBoolType resultType].
        }.
      }
    else [].

  validateBuiltinOperatorValue :: ModuleContext -> TypedCoreValidationPath -> Text -> TypedType -> [TypedCoreValidationFailure].
  validateBuiltinOperatorValue = \(context, path, symbol, operatorType) -> if builtinOperatorHasTypedRule symbol then case operatorType {
    | TypedFunctionType leftType remainder -> case remainder {
      | TypedFunctionType rightType resultType -> validateBuiltinOperatorApplication context path symbol leftType rightType resultType
      | other -> [failure path TypedApplicationFunctionMismatch (TypedTextDetail symbol)]
    }
    | other -> [failure path TypedApplicationFunctionMismatch (TypedTextDetail symbol)]
  } else [].

  operatorContractType :: ModuleContext -> TypedCoreValidationPath -> TypedNodeInfo -> TypedOperatorRef -> ([TypedCoreValidationFailure], Maybe(TypedType)).
  operatorContractType = \(context, path, info, operator) -> case (context, operator) {
    | (ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope, TypedBuiltinOperator symbol) -> ([], Nothing)
    | (ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope, TypedResolvedOperator name symbol) -> case lookupSchemeByName modulePath name schemes {
      | Nothing -> ([], Nothing)
      | Just scheme -> case scheme {
        | TypedScheme owner parameters evidence primitive resultType resultRecipe -> {
          ownerPath = binderModulePathValue owner.
          qualifiedType = if textListEqual ownerPath modulePath then resultType else qualifyExternalType ownerPath resultType.
          matching = findMatchingInstantiation owner parameters (nodeInstantiations info).
          instantiationFailures =
            if listLength parameters + listLength evidence > 0 then case matching {
              | Nothing -> [failure path TypedInstantiationMismatch (TypedBinderDetail owner)]
              | Just instantiation -> []
            } else [].
          missingEvidenceFailures =
            if listLength parameters == 0 then if listLength evidence > 0 then case matching {
              | Nothing -> listMap
                (\(evidenceParameter) -> case evidenceParameter {
                  | TypedEvidenceParameter parameterId constraint -> failure path TypedMissingEvidence (TypedEvidenceParameterDetail parameterId)
                })
                evidence
              | Just instantiation -> []
            } else [] else [].
          requirementFailures = listAppend instantiationFailures missingEvidenceFailures.
          if listLength parameters == 0 then (requirementFailures, Just qualifiedType) else case matching {
            | Nothing -> (requirementFailures, Nothing)
            | Just instantiation -> case instantiation {
              | TypedInstantiation candidateOwner arguments explicitSpan -> if typeParameterIdListEqual (typeArgumentIds arguments) parameters then
                (requirementFailures, Just (substituteTypeParameters (typeArgumentSubstitutions arguments) qualifiedType))
              else (requirementFailures, Nothing)
            }
          }.
        }
      }
    }
  }.

  typeMismatchFailure :: TypedCoreValidationPath -> TypedCoreValidationKind -> TypedType -> TypedType -> [TypedCoreValidationFailure].
  typeMismatchFailure = \(path, kind, expected, actual) -> if typeEqual expected actual then [] else [failure path kind (TypedTypeDetail expected actual)].

  validateOperatorValue :: ModuleContext -> TypedCoreValidationPath -> TypedNodeInfo -> TypedOperatorRef -> [TypedCoreValidationFailure].
  validateOperatorValue = \(context, path, info, operator) -> case operator {
    | TypedBuiltinOperator symbol -> listAppend (validateOperatorRef context path operator) (validateBuiltinOperatorValue context path symbol (nodeType info))
    | TypedResolvedOperator name symbol -> case operatorContractType context path info operator {
      | (contractFailures, Nothing) -> listAppend (validateOperatorRef context path operator) contractFailures
      | (contractFailures, Just expectedType) -> listConcat
        [ validateOperatorRef context path operator,
          contractFailures,
          typeMismatchFailure path TypedBindingValueMismatch expectedType (nodeType info)
        ]
    }
  }.

  validateBinaryOperator :: ModuleContext -> TypedCoreValidationPath -> TypedNodeInfo -> TypedOperatorRef -> TypedExpr -> TypedExpr -> [TypedCoreValidationFailure].
  validateBinaryOperator = \(context, path, info, operator, left, right) -> case operator {
    | TypedBuiltinOperator symbol -> listAppend
      (validateOperatorRef context path operator)
      (validateBuiltinOperatorApplication context path symbol (nodeType (expressionInfo left)) (nodeType (expressionInfo right)) (nodeType info))
    | TypedResolvedOperator name symbol -> case operatorContractType context path info operator {
      | (contractFailures, Nothing) -> listAppend (validateOperatorRef context path operator) contractFailures
      | (contractFailures, Just operatorType) -> case operatorType {
        | TypedFunctionType expectedLeft remainder -> case remainder {
          | TypedFunctionType expectedRight expectedResult -> listConcat
            [ validateOperatorRef context path operator,
              contractFailures,
              typeMismatchFailure path TypedApplicationArgumentMismatch expectedLeft (nodeType (expressionInfo left)),
              typeMismatchFailure path TypedApplicationArgumentMismatch expectedRight (nodeType (expressionInfo right)),
              typeMismatchFailure path TypedApplicationResultMismatch expectedResult (nodeType info)
            ]
          | other -> listConcat [validateOperatorRef context path operator, contractFailures, [failure path TypedApplicationFunctionMismatch (TypedTypeDetail (TypedFunctionType (nodeType (expressionInfo left)) (TypedFunctionType (nodeType (expressionInfo right)) (nodeType info))) operatorType)]]
        }
        | other -> listConcat [validateOperatorRef context path operator, contractFailures, [failure path TypedApplicationFunctionMismatch (TypedTypeDetail (TypedFunctionType (nodeType (expressionInfo left)) (TypedFunctionType (nodeType (expressionInfo right)) (nodeType info))) operatorType)]]
      }
    }
  }.

  validateLeftSectionOperator :: ModuleContext -> TypedCoreValidationPath -> TypedNodeInfo -> TypedExpr -> TypedOperatorRef -> [TypedCoreValidationFailure].
  validateLeftSectionOperator = \(context, path, info, left, operator) -> case operator {
    | TypedBuiltinOperator symbol -> listAppend (validateOperatorRef context path operator) (case nodeType info {
      | TypedFunctionType rightType resultType -> validateBuiltinOperatorApplication context path symbol (nodeType (expressionInfo left)) rightType resultType
      | actualType -> [failure path TypedApplicationFunctionMismatch (TypedTypeDetail (TypedFunctionType (nodeType (expressionInfo left)) actualType) actualType)]
    })
    | TypedResolvedOperator name symbol -> case operatorContractType context path info operator {
      | (contractFailures, Nothing) -> listAppend (validateOperatorRef context path operator) contractFailures
      | (contractFailures, Just operatorType) -> case operatorType {
        | TypedFunctionType expectedLeft remainder -> case remainder {
          | TypedFunctionType expectedRight expectedResult -> listConcat [validateOperatorRef context path operator, contractFailures, typeMismatchFailure path TypedApplicationArgumentMismatch expectedLeft (nodeType (expressionInfo left)), typeMismatchFailure path TypedApplicationResultMismatch remainder (nodeType info)]
          | other -> listConcat [validateOperatorRef context path operator, contractFailures, [failure path TypedApplicationFunctionMismatch (TypedTypeDetail (TypedFunctionType (nodeType (expressionInfo left)) (nodeType info)) operatorType)]]
        }
        | other -> listConcat [validateOperatorRef context path operator, contractFailures, [failure path TypedApplicationFunctionMismatch (TypedTypeDetail (TypedFunctionType (nodeType (expressionInfo left)) (nodeType info)) operatorType)]]
      }
    }
  }.

  validateRightSectionOperator :: ModuleContext -> TypedCoreValidationPath -> TypedNodeInfo -> TypedOperatorRef -> TypedExpr -> [TypedCoreValidationFailure].
  validateRightSectionOperator = \(context, path, info, operator, right) -> case operator {
    | TypedBuiltinOperator symbol -> listAppend (validateOperatorRef context path operator) (case nodeType info {
      | TypedFunctionType leftType resultType -> validateBuiltinOperatorApplication context path symbol leftType (nodeType (expressionInfo right)) resultType
      | actualType -> [failure path TypedApplicationFunctionMismatch (TypedTypeDetail (TypedFunctionType actualType (nodeType (expressionInfo right))) actualType)]
    })
    | TypedResolvedOperator name symbol -> case operatorContractType context path info operator {
      | (contractFailures, Nothing) -> listAppend (validateOperatorRef context path operator) contractFailures
      | (contractFailures, Just operatorType) -> case operatorType {
        | TypedFunctionType expectedLeft remainder -> case remainder {
          | TypedFunctionType expectedRight expectedResult -> listConcat [validateOperatorRef context path operator, contractFailures, typeMismatchFailure path TypedApplicationArgumentMismatch expectedRight (nodeType (expressionInfo right)), typeMismatchFailure path TypedApplicationResultMismatch (TypedFunctionType expectedLeft expectedResult) (nodeType info)]
          | other -> listConcat [validateOperatorRef context path operator, contractFailures, [failure path TypedApplicationFunctionMismatch (TypedTypeDetail (TypedFunctionType (nodeType info) (nodeType (expressionInfo right))) operatorType)]]
        }
        | other -> listConcat [validateOperatorRef context path operator, contractFailures, [failure path TypedApplicationFunctionMismatch (TypedTypeDetail (TypedFunctionType (nodeType info) (nodeType (expressionInfo right))) operatorType)]]
      }
    }
  }.

  nodeInfoIntrinsicValid :: TypedNodeInfo -> Bool.
  nodeInfoIntrinsicValid = \(info) -> case expectedRecipe (nodeType info) {
    | Nothing -> False
    | Just expected -> if recipeWidthValid (nodeRecipe info) then recipeEqual expected (nodeRecipe info) else False
  }.

  terminalExpressionInfo :: [TypedStatement] -> Maybe(TypedNodeInfo).
  terminalExpressionInfo = \(statements) -> case listReverse statements {
    | [] -> Nothing
    | [TypedExpressionStatement span expression | rest] -> Just (expressionInfo expression)
    | other -> Nothing
  }.

  validateBlockResult :: TypedCoreValidationPath -> TypedNodeInfo -> [TypedStatement] -> [TypedCoreValidationFailure].
  validateBlockResult = \(path, blockInfo, statements) -> case terminalExpressionInfo statements {
    | Nothing -> [failure path TypedBlockResultMismatch TypedNoValidationDetail]
    | Just terminalInfo -> if nodeInfoIntrinsicValid blockInfo then if nodeInfoIntrinsicValid terminalInfo then
      if typeEqual (nodeType blockInfo) (nodeType terminalInfo) then
        if recipeEqual (nodeRecipe blockInfo) (nodeRecipe terminalInfo) then [] else [failure path TypedBlockResultMismatch (TypedRecipeDetail (nodeRecipe blockInfo) (nodeRecipe terminalInfo))]
      else [failure path TypedBlockResultMismatch (TypedTypeDetail (nodeType blockInfo) (nodeType terminalInfo))]
    else [] else []
  }.

  validateValueContract :: TypedCoreValidationPath -> TypedNodeInfo -> ValueContract -> [TypedCoreValidationFailure].
  validateValueContract = \(path, info, contract) -> case contract {
    | ValueContract expectedType expectedRecipe -> if typeEqual expectedType (nodeType info) then
      if recipeEqual expectedRecipe (nodeRecipe info) then [] else [failure path TypedBindingValueMismatch (TypedRecipeDetail expectedRecipe (nodeRecipe info))]
    else [failure path TypedBindingValueMismatch (TypedTypeDetail expectedType (nodeType info))]
  }.

  schemeValueContract :: [Text] -> TypedNodeInfo -> TypedScheme -> Maybe(ValueContract).
  schemeValueContract = \(modulePath, info, scheme) -> case scheme {
    | TypedScheme owner parameters evidence primitive resultType resultRecipe -> case owner {
      | TypedBinderId ownerModule lexicalPath ownerName -> {
        qualifiedType = if textListEqual ownerModule modulePath then resultType else qualifyExternalType ownerModule resultType.
        qualifiedRecipe = if textListEqual ownerModule modulePath then resultRecipe else qualifyExternalRecipe ownerModule resultRecipe.
        if listLength parameters == 0 then Just (ValueContract qualifiedType qualifiedRecipe) else case findMatchingInstantiation owner parameters (nodeInstantiations info) {
          | Nothing -> Nothing
          | Just instantiation -> case instantiation {
            | TypedInstantiation candidateOwner arguments explicitSpan -> {
              substitutions = typeArgumentSubstitutions arguments.
              Just (ValueContract (substituteTypeParameters substitutions qualifiedType) (substituteRepresentationParameters substitutions qualifiedRecipe)).
            }
          }
        }.
      }
    }
  }.

  validateVariableSchemeContract :: [Text] -> TypedCoreValidationPath -> TypedNodeInfo -> TypedScheme -> [TypedCoreValidationFailure].
  validateVariableSchemeContract = \(modulePath, path, info, scheme) -> case scheme {
    | TypedScheme owner parameters evidence primitive resultType resultRecipe -> case schemeValueContract modulePath info scheme {
      | Nothing -> {
        matching = findMatchingInstantiation owner parameters (nodeInstantiations info).
        instantiationFailures =
          if listLength parameters > 0 then case matching {
            | Nothing -> [failure path TypedInstantiationMismatch (TypedBinderDetail owner)]
            | Just instantiation -> []
          } else if listLength evidence > 0 then case matching {
            | Nothing -> [failure path TypedInstantiationMismatch (TypedBinderDetail owner)]
            | Just instantiation -> []
          } else [].
        missingEvidenceFailures =
          if listLength parameters == 0 then case matching {
            | Nothing -> listMap
              (\(evidenceParameter) -> case evidenceParameter {
                | TypedEvidenceParameter parameterId constraint -> failure path TypedMissingEvidence (TypedEvidenceParameterDetail parameterId)
              })
              evidence
            | Just instantiation -> []
          } else [].
        listAppend instantiationFailures missingEvidenceFailures.
      }
      | Just contract -> {
        matching = findMatchingInstantiation owner parameters (nodeInstantiations info).
        instantiationFailures =
          if listLength parameters > 0 then case matching {
            | Nothing -> [failure path TypedInstantiationMismatch (TypedBinderDetail owner)]
            | Just instantiation -> []
          } else if listLength evidence > 0 then case matching {
            | Nothing -> [failure path TypedInstantiationMismatch (TypedBinderDetail owner)]
            | Just instantiation -> []
          } else [].
        missingEvidenceFailures =
          if listLength parameters == 0 then if listLength evidence > 0 then case matching {
            | Nothing -> listMap
              (\(evidenceParameter) -> case evidenceParameter {
                | TypedEvidenceParameter parameterId constraint -> failure path TypedMissingEvidence (TypedEvidenceParameterDetail parameterId)
              })
              evidence
            | Just instantiation -> []
          } else [] else [].
        listConcat [instantiationFailures, missingEvidenceFailures, validateValueContract path info contract].
      }
    }
  }.

  binaryFunctionType :: TypedType -> TypedType -> TypedType -> TypedType.
  binaryFunctionType = \(first, second, result) -> TypedFunctionType first (TypedFunctionType second result).

  typedUnitType :: TypedType.
  typedUnitType = TypedTupleType [].

  hostIOOutcomeType :: TypedType.
  hostIOOutcomeType = TypedTupleType [TypedBoolType, TypedTextType, TypedTextType, TypedTextType].

  builtinConcreteValueType :: Text -> Maybe(TypedType).
  builtinConcreteValueType = \(identifier) ->
    if identifier == "__kernel_charToUInt32" then Just (TypedFunctionType TypedCharType (TypedNumericType TypedUInt32Type)) else
    if identifier == "__kernel_charFromUInt32Raw" then Just (TypedFunctionType (TypedNumericType TypedUInt32Type) (TypedListType TypedCharType)) else
    if listContains identifier ["__kernel_charIsAlpha", "__kernel_charIsAlphaNum", "__kernel_charIsDigit", "__kernel_charIsSpace", "__kernel_charIsHexDigit", "__kernel_charIsLower", "__kernel_charIsUpper"] then
      Just (TypedFunctionType TypedCharType TypedBoolType)
    else if listContains identifier ["__kernel_charToLower", "__kernel_charToUpper"] then Just (TypedFunctionType TypedCharType TypedCharType) else
    if identifier == "__kernel_textLength" then Just (TypedFunctionType TypedTextType TypedIntType) else
    if identifier == "__kernel_textUnconsRaw" then Just (TypedFunctionType TypedTextType (TypedListType (TypedTupleType [TypedCharType, TypedTextType]))) else
    if identifier == "__kernel_textAppend" then Just (binaryFunctionType TypedTextType TypedTextType TypedTextType) else
    if identifier == "__kernel_textAppendChar" then Just (binaryFunctionType TypedTextType TypedCharType TypedTextType) else
    if identifier == "__kernel_textFromChars" then Just (TypedFunctionType (TypedListType TypedCharType) TypedTextType) else
    if identifier == "__kernel_textConcat" then Just (TypedFunctionType (TypedListType TypedTextType) TypedTextType) else
    if identifier == "__kernel_readTextRaw!" then Just (TypedFunctionType TypedTextType hostIOOutcomeType) else
    if identifier == "__kernel_writeTextRaw!" then Just (binaryFunctionType TypedTextType TypedTextType hostIOOutcomeType) else
    if identifier == "__kernel_readStdinRaw!" then Just (TypedFunctionType typedUnitType hostIOOutcomeType) else
    if listContains identifier ["__kernel_writeStdoutRaw!", "__kernel_writeStderrRaw!"] then Just (TypedFunctionType TypedTextType hostIOOutcomeType) else
    if identifier == "__kernel_arguments!" then Just (TypedFunctionType typedUnitType (TypedListType TypedTextType)) else
    if identifier == "__kernel_exit!" then Just (TypedFunctionType TypedIntType typedUnitType) else Nothing.

  builtinNumericTarget :: Text -> Maybe(TypedNumericType).
  builtinNumericTarget = \(identifier) ->
    if listContains identifier ["toInt8", "__kernel_toInt8"] then Just TypedInt8Type else
    if listContains identifier ["toInt16", "__kernel_toInt16"] then Just TypedInt16Type else
    if listContains identifier ["toInt32", "__kernel_toInt32"] then Just TypedInt32Type else
    if listContains identifier ["toInt64", "__kernel_toInt64"] then Just TypedInt64Type else
    if listContains identifier ["toUInt8", "__kernel_toUInt8"] then Just TypedUInt8Type else
    if listContains identifier ["toUInt16", "__kernel_toUInt16"] then Just TypedUInt16Type else
    if listContains identifier ["toUInt32", "__kernel_toUInt32"] then Just TypedUInt32Type else
    if listContains identifier ["toUInt64", "__kernel_toUInt64"] then Just TypedUInt64Type else
    if listContains identifier ["toFloat16", "__kernel_toFloat16"] then Just TypedFloat16Type else
    if listContains identifier ["toFloat32", "__kernel_toFloat32"] then Just TypedFloat32Type else
    if listContains identifier ["toFloat64", "__kernel_toFloat64"] then Just TypedFloat64Type else Nothing.

  numericValueTypeSupported :: ModuleContext -> TypedType -> Bool.
  numericValueTypeSupported = \(context, typeValue) -> case typeValue {
    | TypedIntType -> True
    | TypedFloatType -> True
    | TypedNumericType numericType -> True
    | TypedTypeParameterType parameterId ->
      listAll
        (\(constraint) -> case constraint {
          | TypedNumericPrimitiveConstraint numericConstraint targetType -> if typeEqual targetType typeValue then False else True
          | other -> True
        })
        (activePrimitiveConstraints context)
        == False
    | other -> False
  }.

  builtinPolymorphicValueTypeMatches :: ModuleContext -> Text -> TypedType -> Bool.
  builtinPolymorphicValueTypeMatches = \(context, identifier, typeValue) ->
    if listContains identifier ["map", "__kernel_map"] then case typeValue {
      | TypedFunctionType mapper remainder -> case (mapper, remainder) {
        | (TypedFunctionType source target, TypedFunctionType inputList outputList) -> case (inputList, outputList) {
          | (TypedListType input, TypedListType output) -> if typeEqual source input then typeEqual target output else False
          | other -> False
        }
        | other -> False
      }
      | other -> False
    } else if listContains identifier ["filter", "__kernel_filter"] then case typeValue {
      | TypedFunctionType predicate remainder -> case (predicate, remainder) {
        | (TypedFunctionType predicateInput predicateResult, TypedFunctionType inputList outputList) -> case (predicateResult, inputList, outputList) {
          | (TypedBoolType, TypedListType input, TypedListType output) ->
            if typeEqual predicateInput input then typeEqual input output else False
          | other -> False
        }
        | other -> False
      }
      | other -> False
    } else if listContains identifier ["hd", "__kernel_hd"] then case typeValue {
      | TypedFunctionType inputList output -> case inputList {
        | TypedListType input -> typeEqual input output
        | other -> False
      }
      | other -> False
    } else if listContains identifier ["tl", "__kernel_tl"] then case typeValue {
      | TypedFunctionType inputList outputList -> case (inputList, outputList) {
        | (TypedListType input, TypedListType output) -> typeEqual input output
        | other -> False
      }
      | other -> False
    } else if listContains identifier ["print!", "__kernel_print!"] then case typeValue {
      | TypedFunctionType input output -> typeEqual input output
      | other -> False
    } else if identifier == "__kernel_listPrependRaw" then case typeValue {
      | TypedFunctionType element remainder -> case remainder {
        | TypedFunctionType inputList outputList -> case (inputList, outputList) {
          | (TypedListType input, TypedListType output) -> if typeEqual element input then typeEqual input output else False
          | other -> False
        }
        | other -> False
      }
      | other -> False
    } else if identifier == "__kernel_listReverseRaw" then case typeValue {
      | TypedFunctionType inputList outputList -> case (inputList, outputList) {
        | (TypedListType input, TypedListType output) -> typeEqual input output
        | other -> False
      }
      | other -> False
    } else if identifier == "__kernel_renderValue" then case typeValue {
      | TypedFunctionType input TypedTextType -> True
      | other -> False
    } else case (builtinNumericTarget identifier, typeValue) {
      | (Just numericTarget, TypedFunctionType source target) -> case target {
        | TypedNumericType actualTarget ->
          if numericValueTypeSupported context source then numericTypeEqual numericTarget actualTarget else False
        | other -> False
      }
      | other -> False
    }.

  validateBuiltinValueContract :: ModuleContext -> TypedCoreValidationPath -> TypedNodeInfo -> Text -> [TypedCoreValidationFailure].
  validateBuiltinValueContract = \(context, path, info, identifier) ->
    if knownBuiltinName identifier then case builtinConcreteValueType identifier {
      | Just expectedType -> case expectedRecipe expectedType {
        | Just expectedRecipeValue -> validateValueContract path info (ValueContract expectedType expectedRecipeValue)
        | Nothing -> [failure path TypedBindingValueMismatch (TypedTextDetail identifier)]
      }
      | Nothing ->
        if builtinPolymorphicValueTypeMatches context identifier (nodeType info) then [] else [failure path TypedBindingValueMismatch (TypedTextDetail identifier)]
    } else [].

  resolvedNameForEntry :: [Text] -> [Text] -> TypedNameNamespace -> Text -> TypedCoreName.
  resolvedNameForEntry = \(currentModulePath, modulePath, namespace, identifier) ->
    TypedResolvedName
      (if textListEqual modulePath currentModulePath then TypedCurrentModule else if textListEqual modulePath ["Prelude"] then TypedAmbientPrelude else TypedImportedModule modulePath)
      namespace
      identifier.

  dropFunctionArguments :: Int -> TypedType -> TypedType.
  dropFunctionArguments = \(count, typeValue) -> if count <= 0 then typeValue else case typeValue {
    | TypedFunctionType argument result -> dropFunctionArguments (count - 1) result
    | other -> typeValue
  }.

  foldFunctionType :: [TypedType] -> TypedType -> TypedType.
  foldFunctionType = \(arguments, result) -> case arguments {
    | [] -> result
    | [first | rest] -> TypedFunctionType first (foldFunctionType rest result)
  }.

  inferConstructorSubstitutions :: [Text] -> [Text] -> Text -> [TypedTypeParameterId] -> Int -> TypedType -> [(TypedTypeParameterId, TypedType)].
  inferConstructorSubstitutions = \(currentModulePath, dataPath, dataIdentifier, parameters, fieldCount, actualType) -> case dropFunctionArguments fieldCount actualType {
    | TypedDataType dataName arguments -> case resolvedNameEntry currentModulePath dataName {
      | Nothing -> []
      | Just actualEntry -> if nameEntryEqual actualEntry (NameEntry dataPath TypedTypeNamespace dataIdentifier) then if listLength parameters == listLength arguments then listZip parameters arguments else [] else []
    }
    | other -> []
  }.

  validateConstructorExpressionContract :: [Text] -> TypedCoreValidationPath -> TypedNodeInfo -> ConstructorContract -> [TypedCoreValidationFailure].
  validateConstructorExpressionContract = \(modulePath, path, info, contract) -> case contract {
    | ConstructorContract owner dataPath dataIdentifier parameters fields -> {
      genericResult = TypedDataType (resolvedNameForEntry modulePath dataPath TypedTypeNamespace dataIdentifier) (listMap TypedTypeParameterType parameters).
      genericType = foldFunctionType fields genericResult.
      ownerInstantiation = findMatchingInstantiation owner parameters (nodeInstantiations info).
      missingInstantiationFailures = case ownerInstantiation {
        | Nothing -> if listLength parameters == 0 then [] else [failure path TypedInstantiationMismatch (TypedBinderDetail owner)]
        | Just instantiation -> []
      }.
      substitutions = case ownerInstantiation {
        | Just instantiation -> case instantiation {
          | TypedInstantiation candidateOwner arguments explicitSpan -> typeArgumentSubstitutions arguments
        }
        | Nothing -> inferConstructorSubstitutions modulePath dataPath dataIdentifier parameters (listLength fields) (nodeType info)
      }.
      expectedType = substituteTypeParameters substitutions genericType.
      expectedRecipeValue = case expectedRecipe expectedType { | Nothing -> nodeRecipe info | Just recipe -> recipe }.
      listAppend missingInstantiationFailures (validateValueContract path info (ValueContract expectedType expectedRecipeValue)).
    }
  }.

  lookupConstructorContractForName :: [Text] -> TypedCoreName -> [DataEntry] -> Maybe(ConstructorContract).
  lookupConstructorContractForName = \(modulePath, name, entries) -> case name {
    | TypedResolvedName origin TypedConstructorNamespace identifier -> lookupConstructorContract (originModulePath modulePath origin) identifier entries
    | other -> Nothing
  }.

  qualifiedMethodConstraintMatches :: Text -> [NameEntry] -> [DataEntry] -> TypedCapabilityConstraint -> Bool.
  qualifiedMethodConstraintMatches = \(methodKey, visibleNames, dataEntries, constraint) -> case constraint {
    | TypedCapabilityConstraint capability maybeMethod targetType -> case maybeMethod {
      | Nothing -> False
      | Just constraintMethod ->
        if methodKeyMatches capability constraintMethod methodKey then visibleCapabilityMethodPresent capability constraintMethod visibleNames dataEntries else False
    }
  }.

  qualifiedMethodSelectionsMatch :: Text -> [NameEntry] -> [DataEntry] -> [TypedEvidenceSelection] -> Bool.
  qualifiedMethodSelectionsMatch = \(methodKey, visibleNames, dataEntries, selections) -> case selections {
    | [] -> False
    | [selection | rest] -> case selection {
      | TypedSelectedEvidence evidenceUse -> case evidenceUse {
        | TypedEvidenceUse parameterRef constraint implId maybeMethod ->
          if qualifiedMethodConstraintMatches methodKey visibleNames dataEntries constraint then True else qualifiedMethodSelectionsMatch methodKey visibleNames dataEntries rest
      }
      | TypedEvidenceCandidates constraint candidates ->
        if qualifiedMethodConstraintMatches methodKey visibleNames dataEntries constraint then True else qualifiedMethodSelectionsMatch methodKey visibleNames dataEntries rest
    }
  }.

  qualifiedMethodEvidenceTarget :: ModuleContext -> Text -> TypedNodeInfo -> Bool.
  qualifiedMethodEvidenceTarget = \(context, methodKey, info) -> case (context, info) {
    | (ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope, TypedNodeInfo typeValue recipe instantiations evidenceSelections) ->
      qualifiedMethodSelectionsMatch methodKey visibleNames dataEntries evidenceSelections
  }.

  qualifiedMethodContractForKey :: Text -> Text -> [MethodContract] -> Maybe(TypedScheme).
  qualifiedMethodContractForKey = \(capability, methodKey, methods) -> case methods {
    | [] -> Nothing
    | [MethodContract candidateMethod scheme | rest] ->
      if methodKeyMatches capability candidateMethod methodKey then Just scheme else qualifiedMethodContractForKey capability methodKey rest
  }.

  visibleCapabilityContract :: Text -> [NameEntry] -> [DataEntry] -> Maybe(CapabilityContract).
  visibleCapabilityContract = \(capability, names, entries) -> case names {
    | [] -> Nothing
    | [first | rest] -> case first {
      | NameEntry modulePath TypedCapabilityNamespace identifier ->
        if identifier == capability then lookupCapabilityContract modulePath identifier entries else visibleCapabilityContract capability rest entries
      | other -> visibleCapabilityContract capability rest entries
    }
  }.

  qualifiedMethodConstraintValueContract :: ModuleContext -> Text -> TypedCapabilityConstraint -> Maybe(ValueContract).
  qualifiedMethodConstraintValueContract = \(context, methodKey, constraint) -> case (context, constraint) {
    | (ModuleContext currentModulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope, TypedCapabilityConstraint capability maybeMethod targetType) -> case maybeMethod {
      | Nothing -> Nothing
      | Just constraintMethod ->
        if methodKeyMatches capability constraintMethod methodKey then
          if visibleCapabilityIdentifierCount capability visibleNames == 1 then case visibleCapabilityContract capability visibleNames dataEntries {
            | Just contract -> case contract {
              | CapabilityContract [classParameter] methods -> case qualifiedMethodContractForKey capability methodKey methods {
                | Just scheme -> case scheme {
                  | TypedScheme owner parameters evidence primitive resultType resultRecipe -> {
                    ownerPath = binderModulePathValue owner.
                    qualifiedType = if textListEqual ownerPath currentModulePath then resultType else qualifyExternalType ownerPath resultType.
                    qualifiedRecipe = if textListEqual ownerPath currentModulePath then resultRecipe else qualifyExternalRecipe ownerPath resultRecipe.
                    substitutions = [(classParameter, targetType)].
                    Just (ValueContract (substituteTypeParameters substitutions qualifiedType) (substituteRepresentationParameters substitutions qualifiedRecipe)).
                  }
                }
                | Nothing -> Nothing
              }
              | other -> Nothing
            }
            | Nothing -> Nothing
          } else Nothing
        else Nothing
    }
  }.

  qualifiedMethodValueContractFrom :: ModuleContext -> Text -> [TypedEvidenceSelection] -> Maybe(ValueContract).
  qualifiedMethodValueContractFrom = \(context, methodKey, selections) -> case selections {
    | [] -> Nothing
    | [selection | rest] -> {
      constraint = case selection {
        | TypedSelectedEvidence evidenceUse -> case evidenceUse {
          | TypedEvidenceUse parameterRef selectedConstraint implId maybeMethod -> selectedConstraint
        }
        | TypedEvidenceCandidates candidateConstraint candidates -> candidateConstraint
      }.
      case qualifiedMethodConstraintValueContract context methodKey constraint {
        | Just contract -> Just contract
        | Nothing -> qualifiedMethodValueContractFrom context methodKey rest
      }.
    }
  }.

  validateVariableExpression :: ModuleContext -> TypedCoreValidationPath -> TypedNodeInfo -> TypedCoreName -> [TypedCoreValidationFailure].
  validateVariableExpression = \(context, path, info, name) -> case context {
    | ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope -> {
      qualifiedMethodTarget = case name {
        | TypedBuiltinName methodKey -> qualifiedMethodEvidenceTarget context methodKey info
        | other -> False
      }.
      visibilityFailures = if qualifiedMethodTarget then [] else validateVisibleNameInNamespaces [TypedValueNamespace, TypedConstructorNamespace] context path name.
      contractFailures = case lookupLexicalContract modulePath name dataEntries {
        | Just contract -> validateValueContract path info contract
        | Nothing -> case name {
          | TypedBuiltinName identifier -> if qualifiedMethodTarget then case qualifiedMethodValueContractFrom context identifier (nodeEvidenceSelections info) {
            | Nothing -> []
            | Just contract -> validateValueContract path info contract
          } else validateBuiltinValueContract context path info identifier
          | TypedResolvedName origin TypedValueNamespace identifier -> case lookupSchemeByName modulePath name schemes {
            | Just scheme -> validateVariableSchemeContract modulePath path info scheme
            | Nothing -> []
          }
          | TypedResolvedName origin TypedConstructorNamespace identifier -> case lookupConstructorContractForName modulePath name dataEntries {
            | Nothing -> []
            | Just contract -> validateConstructorExpressionContract modulePath path info contract
          }
          | other -> []
        }
      }.
      listAppend visibilityFailures contractFailures.
    }
  }.

  typeArgumentsContain :: TypedTypeParameterId -> TypedType -> [TypedTypeArgument] -> Bool.
  typeArgumentsContain = \(expectedParameter, expectedType, arguments) -> case arguments {
    | [] -> False
    | [TypedTypeArgument parameterId typeValue | rest] ->
      if typeParameterIdEqual expectedParameter parameterId then
        typeEqual expectedType typeValue
      else typeArgumentsContain expectedParameter expectedType rest
  }.

  explicitInstantiationMatches :: TypedBinderId -> TypedTypeParameterId -> TypedSpan -> TypedType -> TypedInstantiation -> Bool.
  explicitInstantiationMatches = \(owner, firstParameter, explicitSpan, typeArgument, instantiation) -> case instantiation {
    | TypedInstantiation candidateOwner arguments maybeSpan -> if binderIdEqual owner candidateOwner then case maybeSpan {
      | Nothing -> False
      | Just candidateSpan -> if spanEqual explicitSpan candidateSpan then typeArgumentsContain firstParameter typeArgument arguments else False
    } else False
  }.

  anyExplicitInstantiationMatches :: TypedBinderId -> TypedTypeParameterId -> TypedSpan -> TypedType -> [TypedInstantiation] -> Bool.
  anyExplicitInstantiationMatches = \(owner, firstParameter, explicitSpan, typeArgument, instantiations) -> case instantiations {
    | [] -> False
    | [first | rest] ->
      if explicitInstantiationMatches owner firstParameter explicitSpan typeArgument first then
        True
      else anyExplicitInstantiationMatches owner firstParameter explicitSpan typeArgument rest
  }.

  schemeOwner :: TypedScheme -> TypedBinderId.
  schemeOwner = \(scheme) -> case scheme {
    | TypedScheme owner parameters evidence primitive resultType resultRecipe -> owner
  }.

  operatorSchemeOwners :: ModuleContext -> TypedOperatorRef -> [TypedBinderId].
  operatorSchemeOwners = \(context, operator) -> case (context, operator) {
    | (ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope, TypedBuiltinOperator symbol) -> []
    | (ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope, TypedResolvedOperator name symbol) -> case lookupSchemeByName modulePath name schemes {
      | Nothing -> []
      | Just scheme -> [schemeOwner scheme]
    }
  }.

  constructorContractOwner :: ConstructorContract -> TypedBinderId.
  constructorContractOwner = \(contract) -> case contract {
    | ConstructorContract owner dataPath dataIdentifier parameters fields -> owner
  }.

  variableInstantiationOwners :: [Text] -> TypedCoreName -> [SchemeEntry] -> [DataEntry] -> [TypedBinderId].
  variableInstantiationOwners = \(modulePath, name, schemes, dataEntries) -> listAppend
    (case lookupSchemeByName modulePath name schemes {
      | Nothing -> []
      | Just scheme -> [schemeOwner scheme]
    })
    (case lookupConstructorContractForName modulePath name dataEntries {
      | Nothing -> []
      | Just contract -> [constructorContractOwner contract]
    }).

  expressionInstantiationOwners :: ModuleContext -> TypedExpr -> [TypedBinderId].
  expressionInstantiationOwners = \(context, expression) -> case context {
    | ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope -> case expression {
      | TypedVariableExpr info name -> variableInstantiationOwners modulePath name schemes dataEntries
      | TypedOperatorValueExpr info operator -> operatorSchemeOwners context operator
      | TypedApplyExpr info function argument -> expressionInstantiationOwners context function
      | TypedTypeApplicationExpr info function span typeArgument -> expressionInstantiationOwners context function
      | TypedBinaryExpr info operator left right -> operatorSchemeOwners context operator
      | TypedLeftSectionExpr info left operator -> operatorSchemeOwners context operator
      | TypedRightSectionExpr info operator right -> operatorSchemeOwners context operator
      | other -> []
    }
  }.

  bindingExpressionInstantiationOwners :: ModuleContext -> TypedExpr -> [TypedBinderId].
  bindingExpressionInstantiationOwners = \(context, expression) -> case (context, expression) {
    | (ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope, TypedVariableExpr info name) ->
      variableInstantiationOwners modulePath name schemes dataEntries
    | (contextValue, TypedOperatorValueExpr info operator) -> operatorSchemeOwners contextValue operator
    | other -> []
  }.

  validateInstantiationOwnersFrom :: ModuleContext -> TypedCoreValidationPath -> Bool -> Maybe(TypedSpan) -> [TypedBinderId] -> [TypedInstantiation] -> [TypedCoreValidationFailure].
  validateInstantiationOwnersFrom = \(context, path, allowAnyExplicitSpan, parentExplicitSpan, allowedOwners, instantiations) -> case (context, instantiations) {
    | (ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope, []) -> []
    | (ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope, [TypedInstantiation owner arguments maybeSpan | rest]) -> listAppend
      (case lookupInstantiationContract owner schemes dataEntries {
        | Nothing -> []
        | Just contract ->
          if binderIdMember owner allowedOwners then
            if allowAnyExplicitSpan then [] else case maybeSpan {
              | Nothing -> []
              | Just explicitSpan -> case parentExplicitSpan {
                | Just expectedSpan -> if spanEqual expectedSpan explicitSpan then [] else [failure path TypedInstantiationMismatch (TypedBinderDetail owner)]
                | Nothing -> [failure path TypedInstantiationMismatch (TypedBinderDetail owner)]
              }
            }
          else [failure path TypedInstantiationMismatch (TypedBinderDetail owner)]
      })
      (validateInstantiationOwnersFrom context path allowAnyExplicitSpan parentExplicitSpan allowedOwners rest)
  }.

  validateExpressionInstantiationOwners :: Maybe(TypedSpan) -> ModuleContext -> TypedCoreValidationPath -> TypedExpr -> [TypedCoreValidationFailure].
  validateExpressionInstantiationOwners = \(parentExplicitSpan, context, path, expression) -> case expression {
    | TypedTypeApplicationExpr info function span typeArgument ->
      validateInstantiationOwnersFrom context path True Nothing (bindingExpressionInstantiationOwners context function) (nodeInstantiations info)
    | other -> validateInstantiationOwnersFrom context path False parentExplicitSpan (expressionInstantiationOwners context expression) (nodeInstantiations (expressionInfo expression))
  }.

  validateTypeApplicationValueContract :: TypedCoreValidationPath -> TypedNodeInfo -> ValueContract -> [TypedCoreValidationFailure].
  validateTypeApplicationValueContract = \(path, info, contract) -> case contract {
    | ValueContract expectedType expectedRecipe ->
      if typeEqual expectedType (nodeType info) then
        if recipeEqual expectedRecipe (nodeRecipe info) then [] else [failure path TypedApplicationResultMismatch (TypedRecipeDetail expectedRecipe (nodeRecipe info))]
      else [failure path TypedApplicationResultMismatch (TypedTypeDetail expectedType (nodeType info))]
  }.

  validateTypeApplicationResultContract :: [Text] -> TypedCoreValidationPath -> TypedNodeInfo -> TypedScheme -> [TypedCoreValidationFailure].
  validateTypeApplicationResultContract = \(modulePath, path, info, scheme) -> case schemeValueContract modulePath info scheme {
    | Nothing -> []
    | Just contract -> validateTypeApplicationValueContract path info contract
  }.

  validateExplicitSchemeApplication :: [Text] -> [SchemeEntry] -> TypedCoreValidationPath -> TypedNodeInfo -> TypedSpan -> TypedType -> Maybe(TypedScheme) -> [TypedCoreValidationFailure].
  validateExplicitSchemeApplication = \(modulePath, schemes, path, info, explicitSpan, typeArgument, maybeScheme) -> case maybeScheme {
    | Nothing -> [failure path TypedInstantiationMismatch TypedNoValidationDetail]
    | Just scheme -> case scheme {
      | TypedScheme owner parameters evidence primitive resultType resultRecipe -> case parameters {
        | [] -> [failure path TypedInstantiationMismatch (TypedBinderDetail owner)]
        | [firstParameter | remainingParameters] ->
          if anyExplicitInstantiationMatches owner firstParameter explicitSpan typeArgument (nodeInstantiations info) then validateTypeApplicationResultContract modulePath path info scheme else [failure path TypedInstantiationMismatch (TypedBinderDetail owner)]
      }
    }
  }.

  qualifiedMethodEvidenceContract :: ModuleContext -> Text -> TypedType -> TypedEvidenceUse -> Maybe(ValueContract).
  qualifiedMethodEvidenceContract = \(context, methodKey, typeArgument, evidenceUse) -> case (context, evidenceUse) {
    | (ModuleContext currentModulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope, TypedEvidenceUse parameterRef constraint implId maybeMethodId) -> case constraint {
      | TypedCapabilityConstraint capability maybeConstraintMethod targetType -> case maybeConstraintMethod {
        | Nothing -> Nothing
        | Just constraintMethod -> case implId {
          | TypedImplId implPath capabilityName targetTypes -> case (targetTypes, maybeMethodId) {
            | ([implTarget], Just methodId) -> case (capabilityName, methodId) {
              | (TypedResolvedName capabilityOrigin TypedCapabilityNamespace capabilityIdentifier, TypedMethodId methodImpl selectedMethod) -> {
                capabilityPath = originModulePath currentModulePath capabilityOrigin.
                capabilityVisible = nameEntryMember (NameEntry capabilityPath TypedCapabilityNamespace capabilityIdentifier) visibleNames.
                if implIdEqual methodImpl implId then
                  if capability == capabilityIdentifier then
                    if typeEqual targetType typeArgument then
                      if typeEqual implTarget targetType then
                        if methodKeyMatches capability constraintMethod methodKey then
                          if methodKeyMatches capability selectedMethod methodKey then
                            if capabilityVisible then case lookupCapabilityContract capabilityPath capabilityIdentifier dataEntries {
                              | Just contract -> case contract {
                                | CapabilityContract [classParameter] methods -> case qualifiedMethodContractForKey capability methodKey methods {
                                  | Just scheme -> case scheme {
                                    | TypedScheme owner parameters evidence primitive resultType resultRecipe -> {
                                      ownerPath = binderModulePathValue owner.
                                      qualifiedType = if textListEqual ownerPath currentModulePath then resultType else qualifyExternalType ownerPath resultType.
                                      qualifiedRecipe = if textListEqual ownerPath currentModulePath then resultRecipe else qualifyExternalRecipe ownerPath resultRecipe.
                                      substitutions = [(classParameter, typeArgument)].
                                      Just (ValueContract (substituteTypeParameters substitutions qualifiedType) (substituteRepresentationParameters substitutions qualifiedRecipe)).
                                    }
                                  }
                                  | Nothing -> Nothing
                                }
                                | other -> Nothing
                              }
                              | Nothing -> Nothing
                            } else Nothing
                          else Nothing
                        else Nothing
                      else Nothing
                    else Nothing
                  else Nothing
                else Nothing.
              }
              | other -> Nothing
            }
            | other -> Nothing
          }
        }
      }
    }
  }.

  qualifiedMethodApplicationContracts :: ModuleContext -> Text -> TypedType -> [TypedEvidenceSelection] -> [ValueContract].
  qualifiedMethodApplicationContracts = \(context, methodKey, typeArgument, selections) -> case selections {
    | [] -> []
    | [selection | rest] -> case selection {
      | TypedSelectedEvidence evidenceUse -> case qualifiedMethodEvidenceContract context methodKey typeArgument evidenceUse {
        | Nothing -> qualifiedMethodApplicationContracts context methodKey typeArgument rest
        | Just contract -> listPrepend contract (qualifiedMethodApplicationContracts context methodKey typeArgument rest)
      }
      | other -> qualifiedMethodApplicationContracts context methodKey typeArgument rest
    }
  }.

  validateQualifiedMethodApplication :: ModuleContext -> TypedCoreValidationPath -> TypedNodeInfo -> Text -> TypedType -> [TypedCoreValidationFailure].
  validateQualifiedMethodApplication = \(context, path, info, methodKey, typeArgument) -> case info {
    | TypedNodeInfo typeValue recipe instantiations evidenceSelections -> case qualifiedMethodApplicationContracts context methodKey typeArgument evidenceSelections {
      | [contract] -> validateTypeApplicationValueContract path info contract
      | other -> [failure path TypedInstantiationMismatch TypedNoValidationDetail]
    }
  }.

  validateExplicitTypeApplication :: ModuleContext -> TypedCoreValidationPath -> TypedNodeInfo -> TypedExpr -> TypedSpan -> TypedType -> [TypedCoreValidationFailure].
  validateExplicitTypeApplication = \(context, path, info, function, explicitSpan, typeArgument) -> case context {
    | ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope -> case function {
      | TypedVariableExpr functionInfo name -> case lookupSchemeByName modulePath name schemes {
        | Just scheme -> validateExplicitSchemeApplication modulePath schemes path info explicitSpan typeArgument (Just scheme)
        | Nothing -> case name {
          | TypedBuiltinName methodKey -> validateQualifiedMethodApplication context path info methodKey typeArgument
          | other -> [failure path TypedInstantiationMismatch TypedNoValidationDetail]
        }
      }
      | TypedOperatorValueExpr functionInfo operator -> case operator {
        | TypedResolvedOperator name symbol -> validateExplicitSchemeApplication modulePath schemes path info explicitSpan typeArgument (lookupSchemeByName modulePath name schemes)
        | TypedBuiltinOperator builtin -> [failure path TypedInstantiationMismatch TypedNoValidationDetail]
      }
      | other -> [failure path TypedInstantiationMismatch TypedNoValidationDetail]
    }
  }.

  validateExpressionOwned :: ModuleContext -> Int -> [Int] -> TypedCoreValidationPath -> TypedExpr -> [TypedCoreValidationFailure].
  validateExpressionOwned = \(context, statementIndex, expressionPath, path, expression) -> case expression {
    | TypedLiteralExpr info literal -> validateLiteral path info literal
    | TypedVariableExpr info name -> validateVariableExpression context path info name
    | TypedLambdaExpr info binder name body -> listConcat [validateLocalDefinitionName context [TypedValueNamespace] path name, validateBinderDefinition context path binder name, validateLambdaResult path info body]
    | TypedOperatorValueExpr info operator -> validateOperatorValue context path info operator
    | TypedListExpr info expressions -> validateListShape path info expressions
    | TypedTupleExpr info expressions -> validateTupleShape path info expressions
    | TypedApplyExpr info function argument -> validateApplication path info function argument
    | TypedTypeApplicationExpr info function span typeArgument -> case context {
      | ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope -> listConcat
        [ validateType path typeScope typeArgument,
          validateDataTypeApplications context path typeArgument,
          validateSourceDataTypeApplications context path typeArgument,
          validateExplicitTypeApplication context path info function span typeArgument
        ]
    }
    | TypedIfExpr info condition thenExpression elseExpression -> validateConditional path info condition thenExpression elseExpression
    | TypedPatternCaseExpr info scrutinee arms -> listAppend
      (if listLength arms == 0 then [failure path TypedPatternShapeMismatch (TypedArityDetail 1 0)] else [])
      (validateCaseArms context statementIndex expressionPath (nodeType (expressionInfo scrutinee)) (nodeType info) arms 0)
    | TypedBinaryExpr info operator left right -> validateBinaryOperator context path info operator left right
    | TypedLeftSectionExpr info left operator -> validateLeftSectionOperator context path info left operator
    | TypedRightSectionExpr info operator right -> validateRightSectionOperator context path info operator right
    | TypedBlockExpr info statements -> validateBlockResult path info statements
  }.

  patternBoundNames :: TypedPattern -> [TypedCoreName].
  patternBoundNames = \(pattern) -> case pattern {
    | TypedVariablePattern info binder name -> [name]
    | TypedConstructorPattern info name patterns -> listConcat (listMap patternBoundNames patterns)
    | TypedListPattern info patterns -> listConcat (listMap patternBoundNames patterns)
    | TypedConsListPattern info head tail -> listAppend (patternBoundNames head) (patternBoundNames tail)
    | TypedTuplePattern info patterns -> listConcat (listMap patternBoundNames patterns)
    | TypedAsPattern info binder name nested -> listPrepend name (patternBoundNames nested)
    | TypedOrPattern info alternatives -> case alternatives {
      | [] -> []
      | [first | rest] -> patternBoundNames first
    }
    | other -> []
  }.

  withPatternContractList :: [TypedPattern] -> ModuleContext -> ModuleContext.
  withPatternContractList = \(patterns, context) -> case patterns {
    | [] -> context
    | [first | rest] -> withPatternContractList rest (withPatternContracts first context)
  }.

  withPatternContracts :: TypedPattern -> ModuleContext -> ModuleContext.
  withPatternContracts = \(pattern, context) -> case pattern {
    | TypedVariablePattern info binder name -> withLexicalContract name (nodeType info) (nodeRecipe info) context
    | TypedConstructorPattern info name patterns -> withPatternContractList patterns context
    | TypedListPattern info patterns -> withPatternContractList patterns context
    | TypedConsListPattern info head tail -> withPatternContracts tail (withPatternContracts head context)
    | TypedTuplePattern info patterns -> withPatternContractList patterns context
    | TypedAsPattern info binder name nested -> withPatternContracts nested (withLexicalContract name (nodeType info) (nodeRecipe info) context)
    | TypedOrPattern info alternatives -> case alternatives {
      | [] -> context
      | [first | rest] -> withPatternContracts first context
    }
    | other -> context
  }.

  withLambdaContract :: TypedNodeInfo -> TypedCoreName -> ModuleContext -> ModuleContext.
  withLambdaContract = \(info, name, context) -> case nodeType info {
    | TypedFunctionType argument result -> case expectedRecipe argument {
      | Nothing -> withVisibleName name context
      | Just argumentRecipe -> withLexicalContract name argument argumentRecipe context
    }
    | other -> withVisibleName name context
  }.

  constructorNames :: [TypedConstructorDeclaration] -> [TypedCoreName].
  constructorNames = \(constructors) -> case constructors {
    | [] -> []
    | [TypedConstructorDeclaration binder name fields recipes | rest] -> listPrepend name (constructorNames rest)
  }.

  signatureNames :: [TypedMethodSignature] -> [TypedCoreName].
  signatureNames = \(methods) -> case methods {
    | [] -> []
    | [TypedMethodSignature name span scheme | rest] -> listPrepend name (signatureNames rest)
  }.

  statementDefinedNames :: TypedStatement -> [TypedCoreName].
  statementDefinedNames = \(statement) -> case statement {
    | TypedLetStatement binder name span scheme expression -> [name]
    | TypedSignatureStatement binder name span scheme -> []
    | TypedDataStatement declaration -> case declaration {
      | TypedDataDeclaration span name parameters constructors -> listPrepend name (constructorNames constructors)
    }
    | TypedClassStatement declaration -> case declaration {
      | TypedClassDeclaration span name parameters methods -> [name]
    }
    | TypedImplStatement declaration -> []
    | TypedExpressionStatement span expression -> []
  }.

  statementsDefinedNames :: [TypedStatement] -> [TypedCoreName].
  statementsDefinedNames = \(statements) -> listConcat (listMap statementDefinedNames statements).

  typeMentionsParameter :: TypedTypeParameterId -> TypedType -> Bool.
  typeMentionsParameter = \(parameter, typeValue) -> case typeValue {
    | TypedListType elementType -> typeMentionsParameter parameter elementType
    | TypedTupleType elementTypes -> typeListMentionsParameter parameter elementTypes
    | TypedDataType name arguments -> typeListMentionsParameter parameter arguments
    | TypedFunctionType argument result -> if typeMentionsParameter parameter argument then True else typeMentionsParameter parameter result
    | TypedTypeParameterType candidate -> typeParameterIdEqual parameter candidate
    | other -> False
  }.

  typeListMentionsParameter :: TypedTypeParameterId -> [TypedType] -> Bool.
  typeListMentionsParameter = \(parameter, typeValues) -> case typeValues {
    | [] -> False
    | [first | rest] -> if typeMentionsParameter parameter first then True else typeListMentionsParameter parameter rest
  }.

  recipeMentionsParameter :: TypedTypeParameterId -> TypedRepresentationRecipe -> Bool.
  recipeMentionsParameter = \(parameter, recipe) -> case recipe {
    | TypedManagedListRecipe elementRecipe -> recipeMentionsParameter parameter elementRecipe
    | TypedManagedProductRecipe elementRecipes -> recipeListMentionsParameter parameter elementRecipes
    | TypedClosureRecipe parameterRecipes resultRecipe ->
      if recipeListMentionsParameter parameter parameterRecipes then True else recipeMentionsParameter parameter resultRecipe
    | TypedRepresentationParameterRecipe candidate -> typeParameterIdEqual parameter candidate
    | other -> False
  }.

  recipeListMentionsParameter :: TypedTypeParameterId -> [TypedRepresentationRecipe] -> Bool.
  recipeListMentionsParameter = \(parameter, recipes) -> case recipes {
    | [] -> False
    | [first | rest] -> if recipeMentionsParameter parameter first then True else recipeListMentionsParameter parameter rest
  }.

  evidenceMentionsParameter :: TypedTypeParameterId -> [TypedEvidenceParameter] -> Bool.
  evidenceMentionsParameter = \(parameter, evidence) -> case evidence {
    | [] -> False
    | [TypedEvidenceParameter evidenceId constraint | rest] -> case constraint {
      | TypedCapabilityConstraint capability method targetType ->
        if typeMentionsParameter parameter targetType then True else evidenceMentionsParameter parameter rest
    }
  }.

  primitiveMentionsParameter :: TypedTypeParameterId -> [TypedPrimitiveConstraint] -> Bool.
  primitiveMentionsParameter = \(parameter, primitive) -> case primitive {
    | [] -> False
    | [first | rest] -> case first {
      | TypedNumericPrimitiveConstraint numericConstraint targetType ->
        if typeMentionsParameter parameter targetType then True else primitiveMentionsParameter parameter rest
      | TypedStrictEqualityPrimitiveConstraint targetType ->
        if typeMentionsParameter parameter targetType then True else primitiveMentionsParameter parameter rest
    }
  }.

  schemeMentionsParameter :: TypedTypeParameterId -> [TypedEvidenceParameter] -> [TypedPrimitiveConstraint] -> TypedType -> TypedRepresentationRecipe -> Bool.
  schemeMentionsParameter = \(parameter, evidence, primitive, resultType, resultRecipe) ->
    if typeMentionsParameter parameter resultType then True else
      if recipeMentionsParameter parameter resultRecipe then True else
        if evidenceMentionsParameter parameter evidence then True else primitiveMentionsParameter parameter primitive.

  usedClassParameters :: [TypedTypeParameterId] -> [TypedTypeParameterId] -> [TypedEvidenceParameter] -> [TypedPrimitiveConstraint] -> TypedType -> TypedRepresentationRecipe -> [TypedTypeParameterId].
  usedClassParameters = \(classParameters, methodParameters, evidence, primitive, resultType, resultRecipe) -> case classParameters {
    | [] -> []
    | [first | rest] -> {
      remaining = usedClassParameters rest methodParameters evidence primitive resultType resultRecipe.
      if typeParameterIdMember first methodParameters then remaining else
        if schemeMentionsParameter first evidence primitive resultType resultRecipe then listPrepend first remaining else remaining.
    }
  }.

  generalizeClassMethodScheme :: [TypedTypeParameterId] -> TypedScheme -> TypedScheme.
  generalizeClassMethodScheme = \(classParameters, scheme) -> case scheme {
    | TypedScheme binder methodParameters evidence primitive resultType resultRecipe -> TypedScheme
      binder
      (listAppend (usedClassParameters classParameters methodParameters evidence primitive resultType resultRecipe) methodParameters)
      evidence
      primitive
      resultType
      resultRecipe
  }.

  methodSchemeEntries :: [TypedTypeParameterId] -> [TypedMethodSignature] -> [SchemeEntry].
  methodSchemeEntries = \(classParameters, methods) -> case methods {
    | [] -> []
    | [TypedMethodSignature name span scheme | rest] -> case scheme {
      | TypedScheme binder parameters evidence primitive resultType resultRecipe ->
        listPrepend (SchemeEntry binder (generalizeClassMethodScheme classParameters scheme)) (methodSchemeEntries classParameters rest)
    }
  }.

  methodContractEntries :: [TypedMethodSignature] -> [MethodContract].
  methodContractEntries = \(methods) -> case methods {
    | [] -> []
    | [TypedMethodSignature name span scheme | rest] -> case coreNameIdentifier name {
      | Nothing -> methodContractEntries rest
      | Just identifier -> listPrepend (MethodContract identifier scheme) (methodContractEntries rest)
    }
  }.

  statementSchemeEntries :: TypedStatement -> [SchemeEntry].
  statementSchemeEntries = \(statement) -> case statement {
    | TypedLetStatement binder name span scheme expression -> [SchemeEntry binder scheme]
    | TypedSignatureStatement binder name span scheme -> []
    | other -> []
  }.

  moduleSchemeEntries :: [TypedStatement] -> [SchemeEntry].
  moduleSchemeEntries = \(statements) -> case statements {
    | [] -> []
    | [first | rest] -> listAppend (statementSchemeEntries first) (moduleSchemeEntries rest)
  }.

  capabilityNameEntriesFrom :: [DataEntry] -> [NameEntry] -> [NameEntry].
  capabilityNameEntriesFrom = \(entries, names) -> case entries {
    | [] -> names
    | [first | rest] -> case first {
      | CapabilityEntry modulePath identifier parameters methods -> {
        entry = NameEntry modulePath TypedCapabilityNamespace identifier.
        capabilityNameEntriesFrom rest (if nameEntryMember entry names then names else listAppend names [entry]).
      }
      | other -> capabilityNameEntriesFrom rest names
    }
  }.

  capabilityNameEntries :: [DataEntry] -> [NameEntry].
  capabilityNameEntries = \(entries) -> capabilityNameEntriesFrom entries [].

  matchingCapabilityNames :: Text -> [NameEntry] -> [NameEntry].
  matchingCapabilityNames = \(identifier, names) -> case names {
    | [] -> []
    | [first | rest] -> case first {
      | NameEntry modulePath TypedCapabilityNamespace candidate ->
        if identifier == candidate then listPrepend first (matchingCapabilityNames identifier rest) else matchingCapabilityNames identifier rest
      | other -> matchingCapabilityNames identifier rest
    }
  }.

  evidenceCapabilityEntriesFromParameters :: TypedBinderId -> [TypedEvidenceParameter] -> [NameEntry] -> [DataEntry].
  evidenceCapabilityEntriesFromParameters = \(owner, parameters, eligibleCapabilities) -> case parameters {
    | [] -> []
    | [TypedEvidenceParameter parameterId constraint | rest] -> case constraint {
      | TypedCapabilityConstraint capability method targetType -> case matchingCapabilityNames capability eligibleCapabilities {
        | [NameEntry modulePath TypedCapabilityNamespace identifier] -> listPrepend
          (EvidenceCapabilityEntry (TypedEvidenceParameterRef owner parameterId) modulePath identifier)
          (evidenceCapabilityEntriesFromParameters owner rest eligibleCapabilities)
        | other -> evidenceCapabilityEntriesFromParameters owner rest eligibleCapabilities
      }
    }
  }.

  evidenceCapabilityEntries :: [SchemeEntry] -> [NameEntry] -> [DataEntry].
  evidenceCapabilityEntries = \(schemes, eligibleCapabilities) -> case schemes {
    | [] -> []
    | [SchemeEntry owner scheme | rest] -> case scheme {
      | TypedScheme schemeOwner parameters evidence primitive resultType resultRecipe -> listAppend
        (evidenceCapabilityEntriesFromParameters owner evidence eligibleCapabilities)
        (evidenceCapabilityEntries rest eligibleCapabilities)
    }
  }.

  visibleCapabilityNames :: [NameEntry] -> [DataEntry] -> [NameEntry].
  visibleCapabilityNames = \(visibleNames, dataEntries) ->
    listFilter (\(entry) -> nameEntryMember entry visibleNames) (capabilityNameEntries dataEntries).

  appendDefinitionNames :: [Text] -> [TypedCoreName] -> [NameEntry] -> [NameEntry].
  appendDefinitionNames = \(modulePath, names, entries) -> case names {
    | [] -> entries
    | [first | rest] -> appendDefinitionNames modulePath rest (appendDefinitionNameEntry modulePath first entries)
  }.

  localNameEntries :: [Text] -> [TypedStatement] -> [NameEntry].
  localNameEntries = \(modulePath, statements) -> appendDefinitionNames modulePath (statementsDefinedNames statements) [].

  localImplIds :: [TypedStatement] -> [TypedImplId].
  localImplIds = \(statements) -> case statements {
    | [] -> []
    | [first | rest] -> case first {
      | TypedImplStatement declaration -> case declaration {
        | TypedImplDeclaration span implId methods -> listPrepend implId (localImplIds rest)
      }
      | other -> localImplIds rest
    }
  }.

  localConstructorEntries :: [Text] -> Text -> [TypedTypeParameterId] -> [TypedConstructorDeclaration] -> [DataEntry].
  localConstructorEntries = \(modulePath, dataIdentifier, parameters, constructors) -> case constructors {
    | [] -> []
    | [TypedConstructorDeclaration binder name fields recipes | rest] -> case coreNameIdentifier name {
      | Nothing -> localConstructorEntries modulePath dataIdentifier parameters rest
      | Just constructorIdentifier -> listPrepend
        (ConstructorEntry modulePath constructorIdentifier binder dataIdentifier parameters fields)
        (localConstructorEntries modulePath dataIdentifier parameters rest)
    }
  }.

  methodDefinitionKeys :: [TypedMethodDefinition] -> [Text].
  methodDefinitionKeys = \(methods) -> case methods {
    | [] -> []
    | [TypedMethodDefinition methodId binder name span expression | rest] -> case methodId {
      | TypedMethodId implId methodKey -> listPrepend methodKey (methodDefinitionKeys rest)
    }
  }.

  localDataEntries :: [Text] -> [TypedStatement] -> [DataEntry].
  localDataEntries = \(modulePath, statements) -> case statements {
    | [] -> []
    | [first | rest] -> case first {
      | TypedDataStatement declaration -> case declaration {
        | TypedDataDeclaration span name parameters constructors -> {
          dataIdentifier = case coreNameIdentifier name { | Just identifier -> identifier | Nothing -> "" }.
          listConcat
            [ [ DataEntry modulePath dataIdentifier (listLength parameters),
                DataContractEntry modulePath dataIdentifier parameters (listMap (\(constructor) -> case constructor { | TypedConstructorDeclaration binder constructorName fields recipes -> fields }) constructors)
              ],
              localConstructorEntries modulePath dataIdentifier parameters constructors,
              localDataEntries modulePath rest
            ].
        }
        }
      | TypedClassStatement declaration -> case declaration {
        | TypedClassDeclaration span name parameters methods -> case coreNameIdentifier name {
          | Nothing -> localDataEntries modulePath rest
          | Just identifier -> listPrepend (CapabilityEntry modulePath identifier parameters (methodContractEntries methods)) (localDataEntries modulePath rest)
        }
      }
      | TypedImplStatement declaration -> case declaration {
        | TypedImplDeclaration span implId methods -> listPrepend (ImplMethodEntry implId (methodDefinitionKeys methods)) (localDataEntries modulePath rest)
      }
      | other -> localDataEntries modulePath rest
    }
  }.

  withBlockDeclarations :: [TypedStatement] -> ModuleContext -> ModuleContext.
  withBlockDeclarations = \(statements, context) -> case context {
    | ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope -> {
      localSchemes = moduleSchemeEntries statements.
      combinedVisibleNames = listAppend (localNameEntries modulePath statements) visibleNames.
      combinedDataEntries = listAppend (localDataEntries modulePath statements) dataEntries.
      localEvidenceEntries = evidenceCapabilityEntries localSchemes (visibleCapabilityNames combinedVisibleNames combinedDataEntries).
      ModuleContext
        modulePath
        visibleModules
        (listAppend localSchemes schemes)
        statementIndices
        combinedVisibleNames
        (listAppend (localImplIds statements) visibleImpls)
        (listConcat [localEvidenceEntries, combinedDataEntries])
        typeScope.
    }
  }.

  appendResolvedNameEntries :: [Text] -> [TypedCoreName] -> [NameEntry] -> [NameEntry].
  appendResolvedNameEntries = \(modulePath, names, entries) -> case names {
    | [] -> entries
    | [first | rest] -> appendResolvedNameEntries modulePath rest (appendResolvedNameEntry modulePath first entries)
  }.

  freeNameMatches :: ModuleContext -> NameEntry -> [NameEntry] -> TypedCoreName -> Bool.
  freeNameMatches = \(context, target, boundNames, name) -> case context {
    | ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope -> case resolvedNameEntry modulePath name {
      | Nothing -> False
      | Just entry -> if nameEntryEqual target entry then if nameEntryMember entry boundNames then False else True else False
    }
  }.

  operatorReferencesName :: ModuleContext -> NameEntry -> [NameEntry] -> TypedOperatorRef -> Bool.
  operatorReferencesName = \(context, target, boundNames, operator) -> case operator {
    | TypedBuiltinOperator symbol -> False
    | TypedResolvedOperator name symbol -> freeNameMatches context target boundNames name
  }.

  expressionListReferencesName :: ModuleContext -> NameEntry -> [NameEntry] -> [TypedExpr] -> Bool.
  expressionListReferencesName = \(context, target, boundNames, expressions) -> case expressions {
    | [] -> False
    | [first | rest] -> if expressionReferencesName context target boundNames first then True else expressionListReferencesName context target boundNames rest
  }.

  maybeExpressionReferencesName :: ModuleContext -> NameEntry -> [NameEntry] -> Maybe(TypedExpr) -> Bool.
  maybeExpressionReferencesName = \(context, target, boundNames, expression) -> case expression {
    | Nothing -> False
    | Just value -> expressionReferencesName context target boundNames value
  }.

  caseArmsReferenceName :: ModuleContext -> NameEntry -> [NameEntry] -> [TypedCaseArm] -> Bool.
  caseArmsReferenceName = \(context, target, boundNames, arms) -> case (context, arms) {
    | (otherContext, []) -> False
    | (ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope, [TypedCaseArm pattern maybeGuard result | rest]) -> {
      armBoundNames = appendResolvedNameEntries modulePath (patternBoundNames pattern) boundNames.
      if maybeExpressionReferencesName context target armBoundNames maybeGuard then True else
        if expressionReferencesName context target armBoundNames result then True else caseArmsReferenceName context target boundNames rest.
    }
  }.

  methodDefinitionsReferenceName :: ModuleContext -> NameEntry -> [NameEntry] -> [TypedMethodDefinition] -> Bool.
  methodDefinitionsReferenceName = \(context, target, boundNames, methods) -> case methods {
    | [] -> False
    | [TypedMethodDefinition methodId binder name span expression | rest] ->
      if expressionReferencesName context target boundNames expression then True else methodDefinitionsReferenceName context target boundNames rest
  }.

  statementReferencesName :: ModuleContext -> NameEntry -> [NameEntry] -> TypedStatement -> Bool.
  statementReferencesName = \(context, target, boundNames, statement) -> case statement {
    | TypedLetStatement binder name span scheme expression -> expressionReferencesName context target boundNames expression
    | TypedImplStatement declaration -> case declaration {
      | TypedImplDeclaration span implId methods -> methodDefinitionsReferenceName context target boundNames methods
    }
    | TypedExpressionStatement span expression -> expressionReferencesName context target boundNames expression
    | other -> False
  }.

  statementsReferenceName :: ModuleContext -> NameEntry -> [NameEntry] -> [TypedStatement] -> Bool.
  statementsReferenceName = \(context, target, boundNames, statements) -> case statements {
    | [] -> False
    | [first | rest] -> if statementReferencesName context target boundNames first then True else statementsReferenceName context target boundNames rest
  }.

  expressionReferencesName :: ModuleContext -> NameEntry -> [NameEntry] -> TypedExpr -> Bool.
  expressionReferencesName = \(context, target, boundNames, expression) -> case (context, expression) {
    | (otherContext, TypedLiteralExpr info literal) -> False
    | (otherContext, TypedVariableExpr info name) -> freeNameMatches context target boundNames name
    | (ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope, TypedLambdaExpr info binder name body) ->
      expressionReferencesName context target (appendResolvedNameEntry modulePath name boundNames) body
    | (otherContext, TypedOperatorValueExpr info operator) -> operatorReferencesName context target boundNames operator
    | (otherContext, TypedListExpr info expressions) -> expressionListReferencesName context target boundNames expressions
    | (otherContext, TypedTupleExpr info expressions) -> expressionListReferencesName context target boundNames expressions
    | (otherContext, TypedApplyExpr info function argument) ->
      if expressionReferencesName context target boundNames function then True else expressionReferencesName context target boundNames argument
    | (otherContext, TypedTypeApplicationExpr info function span typeArgument) -> expressionReferencesName context target boundNames function
    | (otherContext, TypedIfExpr info condition thenExpression elseExpression) ->
      if expressionReferencesName context target boundNames condition then True else
        if expressionReferencesName context target boundNames thenExpression then True else expressionReferencesName context target boundNames elseExpression
    | (otherContext, TypedPatternCaseExpr info scrutinee arms) ->
      if expressionReferencesName context target boundNames scrutinee then True else caseArmsReferenceName context target boundNames arms
    | (otherContext, TypedBinaryExpr info operator left right) ->
      if operatorReferencesName context target boundNames operator then True else
        if expressionReferencesName context target boundNames left then True else expressionReferencesName context target boundNames right
    | (otherContext, TypedLeftSectionExpr info left operator) ->
      if expressionReferencesName context target boundNames left then True else operatorReferencesName context target boundNames operator
    | (otherContext, TypedRightSectionExpr info operator right) ->
      if operatorReferencesName context target boundNames operator then True else expressionReferencesName context target boundNames right
    | (ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope, TypedBlockExpr info statements) -> {
      nestedBoundNames = appendDefinitionNames modulePath (statementsDefinedNames statements) boundNames.
      statementsReferenceName context target nestedBoundNames statements.
    }
  }.

  emptyAliasSummary :: AliasSummary.
  emptyAliasSummary = AliasSummary False False.

  combineAliasSummaries :: AliasSummary -> AliasSummary -> AliasSummary.
  combineAliasSummaries = \(left, right) -> case (left, right) {
    | (AliasSummary leftAlias leftNonAlias, AliasSummary rightAlias rightNonAlias) ->
      AliasSummary (if leftAlias then True else rightAlias) (if leftNonAlias then True else rightNonAlias)
  }.

  aliasSummaryIsAliasOnly :: AliasSummary -> Bool.
  aliasSummaryIsAliasOnly = \(summary) -> case summary {
    | AliasSummary hasAlias hasNonAlias -> if hasAlias then if hasNonAlias then False else True else False
  }.

  lookupAliasBinding :: NameEntry -> [AliasBinding] -> Maybe(TypedExpr).
  lookupAliasBinding = \(target, bindings) -> case bindings {
    | [] -> Nothing
    | [AliasBinding candidate expression | rest] ->
      if nameEntryEqual target candidate then Just expression else lookupAliasBinding target rest
  }.

  collectAliasBindingsFrom :: [Text] -> [TypedStatement] -> [AliasBinding] -> [AliasBinding].
  collectAliasBindingsFrom = \(modulePath, statements, bindings) -> case statements {
    | [] -> bindings
    | [first | rest] -> case first {
      | TypedLetStatement binder name span scheme expression -> case resolvedNameEntry modulePath name {
        | Nothing -> collectAliasBindingsFrom modulePath rest bindings
        | Just entry -> collectAliasBindingsFrom modulePath rest (listPrepend (AliasBinding entry expression) bindings)
      }
      | other -> collectAliasBindingsFrom modulePath rest bindings
    }
  }.

  variableAliasSummary :: Bool -> ModuleContext -> NameEntry -> [NameEntry] -> [AliasBinding] -> [NameEntry] -> TypedCoreName -> AliasSummary.
  variableAliasSummary = \(aliasPosition, context, target, boundNames, scopeBindings, visitedBindings, name) -> case context {
    | ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope -> case resolvedNameEntry modulePath name {
      | Nothing -> emptyAliasSummary
      | Just entry ->
        if nameEntryMember entry boundNames then emptyAliasSummary else case lookupAliasBinding entry scopeBindings {
          | Just bindingExpression ->
            if nameEntryMember entry visitedBindings then emptyAliasSummary else
              expressionAliasSummary aliasPosition context target boundNames scopeBindings (listPrepend entry visitedBindings) bindingExpression
          | Nothing ->
            if nameEntryEqual target entry then
              if aliasPosition then AliasSummary True False else AliasSummary False True
            else emptyAliasSummary
        }
    }
  }.

  operatorAliasSummary :: Bool -> ModuleContext -> NameEntry -> [NameEntry] -> TypedOperatorRef -> AliasSummary.
  operatorAliasSummary = \(aliasPosition, context, target, boundNames, operator) ->
    if aliasPosition then case operator {
      | TypedBuiltinOperator symbol -> emptyAliasSummary
      | TypedResolvedOperator name symbol -> case context {
        | ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope -> case resolvedNameEntry modulePath name {
          | Nothing -> emptyAliasSummary
          | Just entry ->
            if nameEntryMember entry boundNames then emptyAliasSummary else
              if nameEntryEqual target entry then AliasSummary True False else emptyAliasSummary
        }
      }
    } else emptyAliasSummary.

  expressionListAliasSummary :: Bool -> ModuleContext -> NameEntry -> [NameEntry] -> [AliasBinding] -> [NameEntry] -> [TypedExpr] -> AliasSummary.
  expressionListAliasSummary = \(aliasPosition, context, target, boundNames, scopeBindings, visitedBindings, expressions) -> case expressions {
    | [] -> emptyAliasSummary
    | [first | rest] ->
      combineAliasSummaries
        (expressionAliasSummary aliasPosition context target boundNames scopeBindings visitedBindings first)
        (expressionListAliasSummary aliasPosition context target boundNames scopeBindings visitedBindings rest)
  }.

  maybeExpressionAliasSummary :: ModuleContext -> NameEntry -> [NameEntry] -> [AliasBinding] -> [NameEntry] -> Maybe(TypedExpr) -> AliasSummary.
  maybeExpressionAliasSummary = \(context, target, boundNames, scopeBindings, visitedBindings, expression) -> case expression {
    | Nothing -> emptyAliasSummary
    | Just value -> expressionAliasSummary False context target boundNames scopeBindings visitedBindings value
  }.

  caseArmsAliasSummary :: Bool -> ModuleContext -> NameEntry -> [NameEntry] -> [AliasBinding] -> [NameEntry] -> [TypedCaseArm] -> AliasSummary.
  caseArmsAliasSummary = \(aliasPosition, context, target, boundNames, scopeBindings, visitedBindings, arms) -> case (context, arms) {
    | (otherContext, []) -> emptyAliasSummary
    | (ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope, [TypedCaseArm pattern maybeGuard result | rest]) -> {
      armBoundNames = appendResolvedNameEntries modulePath (patternBoundNames pattern) boundNames.
      currentSummary = combineAliasSummaries
        (maybeExpressionAliasSummary context target armBoundNames scopeBindings visitedBindings maybeGuard)
        (expressionAliasSummary aliasPosition context target armBoundNames scopeBindings visitedBindings result).
      combineAliasSummaries currentSummary (caseArmsAliasSummary aliasPosition context target boundNames scopeBindings visitedBindings rest).
    }
  }.

  statementNonAliasSummary :: ModuleContext -> NameEntry -> [NameEntry] -> [AliasBinding] -> TypedStatement -> AliasSummary.
  statementNonAliasSummary = \(context, target, boundNames, scopeBindings, statement) -> case statement {
    | TypedLetStatement binder name span scheme expression ->
      expressionAliasSummary False context target boundNames scopeBindings [] expression
    | TypedExpressionStatement span expression ->
      expressionAliasSummary False context target boundNames scopeBindings [] expression
    | other -> emptyAliasSummary
  }.

  statementsNonAliasSummary :: ModuleContext -> NameEntry -> [NameEntry] -> [AliasBinding] -> [TypedStatement] -> AliasSummary.
  statementsNonAliasSummary = \(context, target, boundNames, scopeBindings, statements) -> case statements {
    | [] -> emptyAliasSummary
    | [first | rest] ->
      combineAliasSummaries
        (statementNonAliasSummary context target boundNames scopeBindings first)
        (statementsNonAliasSummary context target boundNames scopeBindings rest)
  }.

  blockAliasSummary :: Bool -> ModuleContext -> NameEntry -> [NameEntry] -> [AliasBinding] -> [NameEntry] -> [TypedStatement] -> AliasSummary.
  blockAliasSummary = \(aliasPosition, context, target, boundNames, scopeBindings, visitedBindings, statements) -> case context {
    | ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope -> {
      localBindings = collectAliasBindingsFrom modulePath statements [].
      blockScopeBindings = listAppend localBindings scopeBindings.
      if aliasPosition then case listReverse statements {
        | [TypedExpressionStatement span terminal | reversedLeadingStatements] ->
          combineAliasSummaries
            (expressionAliasSummary True context target boundNames blockScopeBindings visitedBindings terminal)
            (statementsNonAliasSummary context target boundNames blockScopeBindings reversedLeadingStatements)
        | other -> statementsNonAliasSummary context target boundNames blockScopeBindings statements
      } else statementsNonAliasSummary context target boundNames blockScopeBindings statements.
    }
  }.

  expressionAliasSummary :: Bool -> ModuleContext -> NameEntry -> [NameEntry] -> [AliasBinding] -> [NameEntry] -> TypedExpr -> AliasSummary.
  expressionAliasSummary = \(aliasPosition, context, target, boundNames, scopeBindings, visitedBindings, expression) -> case expression {
    | TypedLiteralExpr info literal -> emptyAliasSummary
    | TypedVariableExpr info name ->
      variableAliasSummary aliasPosition context target boundNames scopeBindings visitedBindings name
    | TypedLambdaExpr info binder name body -> emptyAliasSummary
    | TypedOperatorValueExpr info operator ->
      operatorAliasSummary aliasPosition context target boundNames operator
    | TypedListExpr info expressions ->
      expressionListAliasSummary False context target boundNames scopeBindings visitedBindings expressions
    | TypedTupleExpr info expressions ->
      expressionListAliasSummary False context target boundNames scopeBindings visitedBindings expressions
    | TypedApplyExpr info function argument ->
      expressionListAliasSummary False context target boundNames scopeBindings visitedBindings [function, argument]
    | TypedTypeApplicationExpr info function span typeArgument ->
      expressionAliasSummary aliasPosition context target boundNames scopeBindings visitedBindings function
    | TypedIfExpr info condition thenExpression elseExpression ->
      combineAliasSummaries
        (expressionAliasSummary False context target boundNames scopeBindings visitedBindings condition)
        (combineAliasSummaries
          (expressionAliasSummary aliasPosition context target boundNames scopeBindings visitedBindings thenExpression)
          (expressionAliasSummary aliasPosition context target boundNames scopeBindings visitedBindings elseExpression))
    | TypedPatternCaseExpr info scrutinee arms ->
      combineAliasSummaries
        (expressionAliasSummary False context target boundNames scopeBindings visitedBindings scrutinee)
        (caseArmsAliasSummary aliasPosition context target boundNames scopeBindings visitedBindings arms)
    | TypedBinaryExpr info operator left right ->
      expressionListAliasSummary False context target boundNames scopeBindings visitedBindings [left, right]
    | TypedLeftSectionExpr info left operator ->
      expressionAliasSummary False context target boundNames scopeBindings visitedBindings left
    | TypedRightSectionExpr info operator right ->
      expressionAliasSummary False context target boundNames scopeBindings visitedBindings right
    | TypedBlockExpr info statements ->
      blockAliasSummary aliasPosition context target boundNames scopeBindings visitedBindings statements
  }.

  expressionCanBeRecursive :: ModuleContext -> NameEntry -> TypedExpr -> Bool.
  expressionCanBeRecursive = \(context, bindingName, expression) ->
    if isFunctionType (nodeType (expressionInfo expression)) then True else
      aliasSummaryIsAliasOnly (expressionAliasSummary True context bindingName [] [] [] expression).

  letStatementName :: TypedStatement -> Maybe(TypedCoreName).
  letStatementName = \(statement) -> case statement {
    | TypedLetStatement binder name span scheme expression -> Just name
    | other -> Nothing
  }.

  statementAtIndexFrom :: [TypedStatement] -> Int -> Int -> Maybe(TypedStatement).
  statementAtIndexFrom = \(statements, targetIndex, currentIndex) -> case statements {
    | [] -> Nothing
    | [first | rest] -> if targetIndex == currentIndex then Just first else statementAtIndexFrom rest targetIndex (currentIndex + 1)
  }.

  nearestPriorDeclarationIndexFrom :: TypedCoreName -> Int -> [(Int, TypedStatement)] -> Maybe(Int) -> Maybe(Int).
  nearestPriorDeclarationIndexFrom = \(targetName, statementIndex, indexedStatements, found) -> case indexedStatements {
    | [] -> found
    | [(candidateIndex, statement) | rest] ->
      if candidateIndex < statementIndex then case letStatementName statement {
        | Just candidateName -> if coreNameEqual targetName candidateName then nearestPriorDeclarationIndexFrom targetName statementIndex rest (Just candidateIndex) else nearestPriorDeclarationIndexFrom targetName statementIndex rest found
        | Nothing -> nearestPriorDeclarationIndexFrom targetName statementIndex rest found
      } else found
  }.

  firstFutureDeclarationIndexFrom :: TypedCoreName -> Int -> [(Int, TypedStatement)] -> Maybe(Int).
  firstFutureDeclarationIndexFrom = \(targetName, statementIndex, indexedStatements) -> case indexedStatements {
    | [] -> Nothing
    | [(candidateIndex, statement) | rest] ->
      if candidateIndex > statementIndex then case letStatementName statement {
        | Just candidateName -> if coreNameEqual targetName candidateName then Just candidateIndex else firstFutureDeclarationIndexFrom targetName statementIndex rest
        | Nothing -> firstFutureDeclarationIndexFrom targetName statementIndex rest
      } else firstFutureDeclarationIndexFrom targetName statementIndex rest
  }.

  nameVisibleInContext :: ModuleContext -> TypedCoreName -> Bool.
  nameVisibleInContext = \(context, name) -> case context {
    | ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope -> case resolvedNameEntry modulePath name {
      | Nothing -> False
      | Just entry -> nameEntryMember entry visibleNames
    }
  }.

  resolvedDependencyIndex :: ModuleContext -> [TypedStatement] -> Int -> TypedCoreName -> TypedExpr -> TypedCoreName -> Maybe(Int).
  resolvedDependencyIndex = \(context, statements, statementIndex, ownName, expression, targetName) -> case context {
    | ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope -> case resolvedNameEntry modulePath targetName {
      | Nothing -> Nothing
      | Just targetEntry -> if expressionReferencesName context targetEntry [] expression then case nearestPriorDeclarationIndexFrom targetName statementIndex (listIndexed statements) Nothing {
        | Just priorIndex -> Just priorIndex
        | Nothing -> if nameVisibleInContext context targetName then Nothing else
          if coreNameEqual targetName ownName then if expressionCanBeRecursive context targetEntry expression then Just statementIndex else Nothing else
            firstFutureDeclarationIndexFrom targetName statementIndex (listIndexed statements)
      } else Nothing
    }
  }.

  dependencyIndicesFrom :: ModuleContext -> [TypedStatement] -> Int -> TypedCoreName -> TypedExpr -> [(Int, TypedStatement)] -> [Int].
  dependencyIndicesFrom = \(context, statements, statementIndex, ownName, expression, indexedStatements) -> case indexedStatements {
    | [] -> []
    | [(candidateIndex, statement) | rest] -> case letStatementName statement {
      | Nothing -> dependencyIndicesFrom context statements statementIndex ownName expression rest
      | Just candidateName -> case resolvedDependencyIndex context statements statementIndex ownName expression candidateName {
        | Just dependencyIndex -> if dependencyIndex == candidateIndex then listPrepend dependencyIndex (dependencyIndicesFrom context statements statementIndex ownName expression rest) else dependencyIndicesFrom context statements statementIndex ownName expression rest
        | Nothing -> dependencyIndicesFrom context statements statementIndex ownName expression rest
      }
    }
  }.

  statementDependencyIndices :: ModuleContext -> [TypedStatement] -> Int -> [Int].
  statementDependencyIndices = \(context, statements, statementIndex) -> case statementAtIndexFrom statements statementIndex 0 {
    | Just statement -> case statement {
      | TypedLetStatement binder name span scheme expression -> dependencyIndicesFrom context statements statementIndex name expression (listIndexed statements)
      | other -> []
    }
    | Nothing -> []
  }.

  dependencyReachableFrom :: ModuleContext -> [TypedStatement] -> Int -> [Int] -> [Int] -> Bool.
  dependencyReachableFrom = \(context, statements, target, seen, pending) -> case pending {
    | [] -> False
    | [current | rest] -> if current == target then True else
      if listContains current seen then dependencyReachableFrom context statements target seen rest else
        dependencyReachableFrom context statements target (listPrepend current seen) (listAppend (statementDependencyIndices context statements current) rest)
  }.

  dependencyReachable :: ModuleContext -> [TypedStatement] -> Int -> Int -> Bool.
  dependencyReachable = \(context, statements, source, target) -> dependencyReachableFrom context statements target [] [source].

  recursiveGroupMembersFrom :: ModuleContext -> [TypedStatement] -> Int -> [(Int, TypedStatement)] -> [TypedStatement].
  recursiveGroupMembersFrom = \(context, statements, statementIndex, indexedStatements) -> case indexedStatements {
    | [] -> []
    | [(candidateIndex, statement) | rest] -> case letStatementName statement {
      | Nothing -> recursiveGroupMembersFrom context statements statementIndex rest
      | Just candidateName ->
        if dependencyReachable context statements statementIndex candidateIndex then
          if dependencyReachable context statements candidateIndex statementIndex then listPrepend statement (recursiveGroupMembersFrom context statements statementIndex rest) else recursiveGroupMembersFrom context statements statementIndex rest
        else recursiveGroupMembersFrom context statements statementIndex rest
    }
  }.

  blockRecursiveGroupStatements :: ModuleContext -> [TypedStatement] -> Int -> [TypedStatement].
  blockRecursiveGroupStatements = \(context, statements, statementIndex) -> {
    directDependencies = statementDependencyIndices context statements statementIndex.
    members = recursiveGroupMembersFrom context statements statementIndex (listIndexed statements).
    if listLength members > 1 then members else if listContains statementIndex directDependencies then members else [].
  }.

  contextStatementIndices :: ModuleContext -> [StatementIndexEntry].
  contextStatementIndices = \(context) -> case context {
    | ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope -> statementIndices
  }.

  contextModulePath :: ModuleContext -> [Text].
  contextModulePath = \(context) -> case context {
    | ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope -> modulePath
  }.

  typeParameterIdListEqualForScheme :: [TypedTypeParameterId] -> [TypedTypeParameterId] -> Bool.
  typeParameterIdListEqualForScheme = typeParameterIdListEqual.

  numericConstraintEqual :: TypedNumericConstraint -> TypedNumericConstraint -> Bool.
  numericConstraintEqual = \(left, right) -> case (left, right) {
    | (TypedAnyNumericConstraint, TypedAnyNumericConstraint) -> True
    | (TypedRuntimeArithmeticNumericConstraint, TypedRuntimeArithmeticNumericConstraint) -> True
    | (TypedRuntimeComparisonNumericConstraint, TypedRuntimeComparisonNumericConstraint) -> True
    | (TypedIntegralNumericConstraint, TypedIntegralNumericConstraint) -> True
    | (TypedIntegralLiteralNumericConstraint leftLower leftUpper, TypedIntegralLiteralNumericConstraint rightLower rightUpper) -> if leftLower == rightLower then leftUpper == rightUpper else False
    | other -> False
  }.

  primitiveConstraintEqual :: TypedPrimitiveConstraint -> TypedPrimitiveConstraint -> Bool.
  primitiveConstraintEqual = \(left, right) -> case (left, right) {
    | (TypedNumericPrimitiveConstraint leftConstraint leftType, TypedNumericPrimitiveConstraint rightConstraint rightType) -> if numericConstraintEqual leftConstraint rightConstraint then typeEqual leftType rightType else False
    | (TypedStrictEqualityPrimitiveConstraint leftType, TypedStrictEqualityPrimitiveConstraint rightType) -> typeEqual leftType rightType
    | other -> False
  }.

  primitiveConstraintListEqual :: [TypedPrimitiveConstraint] -> [TypedPrimitiveConstraint] -> Bool.
  primitiveConstraintListEqual = \(left, right) -> case (left, right) {
    | ([], []) -> True
    | ([leftFirst | leftRest], [rightFirst | rightRest]) -> if primitiveConstraintEqual leftFirst rightFirst then primitiveConstraintListEqual leftRest rightRest else False
    | other -> False
  }.

  evidenceParameterEqual :: TypedEvidenceParameter -> TypedEvidenceParameter -> Bool.
  evidenceParameterEqual = \(left, right) -> case (left, right) {
    | (TypedEvidenceParameter leftId leftConstraint, TypedEvidenceParameter rightId rightConstraint) -> if evidenceParameterIdEqual leftId rightId then capabilityConstraintEqual leftConstraint rightConstraint else False
  }.

  evidenceParameterListEqual :: [TypedEvidenceParameter] -> [TypedEvidenceParameter] -> Bool.
  evidenceParameterListEqual = \(left, right) -> case (left, right) {
    | ([], []) -> True
    | ([leftFirst | leftRest], [rightFirst | rightRest]) -> if evidenceParameterEqual leftFirst rightFirst then evidenceParameterListEqual leftRest rightRest else False
    | other -> False
  }.

  schemeEqual :: TypedScheme -> TypedScheme -> Bool.
  schemeEqual = \(left, right) -> case (left, right) {
    | (TypedScheme leftOwner leftTypes leftEvidence leftPrimitive leftResult leftRecipe, TypedScheme rightOwner rightTypes rightEvidence rightPrimitive rightResult rightRecipe) ->
      if binderIdEqual leftOwner rightOwner then
        if typeParameterIdListEqualForScheme leftTypes rightTypes then
          if evidenceParameterListEqual leftEvidence rightEvidence then
            if primitiveConstraintListEqual leftPrimitive rightPrimitive then
              if typeEqual leftResult rightResult then recipeEqual leftRecipe rightRecipe else False
            else False
          else False
        else False
      else False
  }.

  validateSignatureBindingScheme :: TypedCoreValidationPath -> TypedScheme -> TypedScheme -> [TypedCoreValidationFailure].
  validateSignatureBindingScheme = \(path, signatureScheme, bindingScheme) -> case (signatureScheme, bindingScheme) {
    | (TypedScheme signatureOwner signatureParameters signatureEvidence signaturePrimitive signatureType signatureRecipe, TypedScheme bindingOwner bindingParameters bindingEvidence bindingPrimitive bindingType bindingRecipe) ->
      if typeParameterIdListEqual signatureParameters bindingParameters == False then
        [failure path TypedBindingValueMismatch (TypedArityDetail (listLength signatureParameters) (listLength bindingParameters))]
      else if evidenceParameterListEqual signatureEvidence bindingEvidence == False then
        [failure path TypedBindingValueMismatch TypedNoValidationDetail]
      else if primitiveConstraintListEqual signaturePrimitive bindingPrimitive == False then
        [failure path TypedBindingValueMismatch TypedNoValidationDetail]
      else if typeEqual signatureType bindingType == False then
        [failure path TypedBindingValueMismatch (TypedTypeDetail signatureType bindingType)]
      else if recipeEqual signatureRecipe bindingRecipe == False then
        [failure path TypedBindingValueMismatch (TypedRecipeDetail signatureRecipe bindingRecipe)]
      else
        []
  }.

  validateAttachedSignature :: ModuleContext -> Int -> TypedCoreValidationPath -> TypedStatement -> [TypedStatement] -> [TypedCoreValidationFailure].
  validateAttachedSignature = \(context, statementIndex, path, statement, remainingStatements) -> case (statement, remainingStatements) {
    | (TypedSignatureStatement signatureBinder signatureName signatureSpan signatureScheme, [TypedLetStatement bindingBinder bindingName bindingSpan bindingScheme expression | rest]) ->
      if coreNameEqual signatureName bindingName then validateSignatureBindingScheme path signatureScheme bindingScheme else
        if listLength (validateStatement context statementIndex statement) == 0 then [failure path TypedBindingValueMismatch (TypedNameDetail signatureName)] else []
    | (TypedSignatureStatement signatureBinder signatureName signatureSpan signatureScheme, other) ->
      if listLength (validateStatement context statementIndex statement) == 0 then [failure path TypedBindingValueMismatch (TypedNameDetail signatureName)] else []
    | other -> []
  }.

  validateCaseChildExpressions :: ModuleContext -> Int -> [Int] -> [TypedCaseArm] -> Int -> [TypedCoreValidationFailure].
  validateCaseChildExpressions = \(context, statementIndex, expressionPath, arms, childIndex) -> case arms {
    | [] -> []
    | [TypedCaseArm pattern maybeGuard result | rest] -> {
      armContext = withPatternContracts pattern context.
      case maybeGuard {
      | Nothing -> listAppend
        (validateExpression armContext statementIndex (listAppend expressionPath [childIndex]) result)
        (validateCaseChildExpressions context statementIndex expressionPath rest (childIndex + 1))
      | Just guard -> listConcat
        [ validateExpression armContext statementIndex (listAppend expressionPath [childIndex]) guard,
          validateExpression armContext statementIndex (listAppend expressionPath [childIndex + 1]) result,
          validateCaseChildExpressions context statementIndex expressionPath rest (childIndex + 2)
        ]
      }.
    }
  }.

  blockStatementScopeDetail :: TypedStatement -> Maybe(Text).
  blockStatementScopeDetail = \(statement) -> case statement {
    | TypedDataStatement declaration -> Just "data declaration"
    | TypedClassStatement declaration -> Just "class declaration"
    | TypedImplStatement declaration -> Just "impl declaration"
    | other -> Nothing
  }.

  validateBlockStatementsInOrderFrom :: ModuleContext -> ModuleContext -> Int -> [Int] -> [Int] -> [TypedStatement] -> [TypedStatement] -> Int -> [TypedCoreValidationFailure].
  validateBlockStatementsInOrderFrom = \(initialContext, visibleContext, statementIndex, statementLocation, expressionPath, allStatements, remainingStatements, blockIndex) -> case remainingStatements {
    | [] -> []
    | [statement | rest] -> {
      nestedStatementIndex = statementIndexFor (nestedStatementLocation statementLocation expressionPath blockIndex) (contextStatementIndices initialContext).
      case blockStatementScopeDetail statement {
        | Just detail -> listAppend
          [failure (TypedStatementPath (contextModulePath initialContext) nestedStatementIndex) TypedBlockResultMismatch (TypedTextDetail detail)]
          (validateBlockStatementsInOrderFrom initialContext visibleContext statementIndex statementLocation expressionPath allStatements rest (blockIndex + 1))
        | Nothing -> {
          recursiveGroup = blockRecursiveGroupStatements initialContext allStatements blockIndex.
          statementContext = case statement {
            | TypedLetStatement binder name span scheme expression -> if listLength recursiveGroup == 0 then visibleContext else withBlockDeclarations recursiveGroup visibleContext
            | other -> withBlockDeclarations [statement] visibleContext
          }.
          listConcat
            [ validateAttachedSignature initialContext nestedStatementIndex (TypedStatementPath (contextModulePath initialContext) nestedStatementIndex) statement rest,
              validateStatement statementContext nestedStatementIndex statement,
              validateBlockStatementsInOrderFrom initialContext (withBlockDeclarations [statement] visibleContext) statementIndex statementLocation expressionPath allStatements rest (blockIndex + 1)
            ].
        }
      }.
    }
  }.

  validateBlockStatementsInOrder :: ModuleContext -> Int -> [Int] -> [TypedStatement] -> [TypedCoreValidationFailure].
  validateBlockStatementsInOrder = \(context, statementIndex, expressionPath, statements) -> case context {
    | ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope -> {
      statementLocation = statementLocationFor statementIndex statementIndices.
      validateBlockStatementsInOrderFrom context context statementIndex statementLocation expressionPath statements statements 0.
    }
  }.

  blockConstructorBinders :: [TypedConstructorDeclaration] -> [TypedBinderId].
  blockConstructorBinders = \(constructors) -> case constructors {
    | [] -> []
    | [TypedConstructorDeclaration binder name fields recipes | rest] -> listPrepend binder (blockConstructorBinders rest)
  }.

  blockMethodSignatureBinders :: [TypedMethodSignature] -> [TypedBinderId].
  blockMethodSignatureBinders = \(methods) -> case methods {
    | [] -> []
    | [TypedMethodSignature name span scheme | rest] -> case scheme {
      | TypedScheme binder parameters evidence primitive resultType resultRecipe -> listPrepend binder (blockMethodSignatureBinders rest)
    }
  }.

  blockMethodDefinitionBinders :: [TypedMethodDefinition] -> [TypedBinderId].
  blockMethodDefinitionBinders = \(methods) -> case methods {
    | [] -> []
    | [TypedMethodDefinition methodId binder name span expression | rest] -> listPrepend binder (blockMethodDefinitionBinders rest)
  }.

  blockStatementBinderDefinitions :: TypedStatement -> [TypedBinderId].
  blockStatementBinderDefinitions = \(statement) -> case statement {
    | TypedLetStatement binder name span scheme expression -> [binder]
    | TypedSignatureStatement binder name span scheme -> [binder]
    | TypedDataStatement declaration -> case declaration {
      | TypedDataDeclaration span name parameters constructors -> blockConstructorBinders constructors
    }
    | TypedClassStatement declaration -> case declaration {
      | TypedClassDeclaration span name parameters methods -> blockMethodSignatureBinders methods
    }
    | TypedImplStatement declaration -> case declaration {
      | TypedImplDeclaration span implId methods -> blockMethodDefinitionBinders methods
    }
    | TypedExpressionStatement span expression -> []
  }.

  duplicateBlockBindersAt :: [Text] -> Int -> [TypedBinderId] -> [TypedBinderId] -> ([TypedBinderId], [TypedCoreValidationFailure]).
  duplicateBlockBindersAt = \(modulePath, statementIndex, binders, seen) -> case binders {
    | [] -> (seen, [])
    | [first | rest] -> case duplicateBlockBindersAt modulePath statementIndex rest (if binderIdMember first seen then seen else listPrepend first seen) {
      | (laterSeen, laterFailures) -> (laterSeen, listAppend (if binderIdMember first seen then [failure (TypedStatementPath modulePath statementIndex) TypedDuplicateBinder (TypedBinderDetail first)] else []) laterFailures)
    }
  }.

  duplicateBlockBinderFailuresFrom :: ModuleContext -> [Int] -> [Int] -> [TypedStatement] -> Int -> [TypedBinderId] -> [TypedCoreValidationFailure].
  duplicateBlockBinderFailuresFrom = \(context, statementLocation, expressionPath, statements, blockIndex, seen) -> case (context, statements) {
    | (ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope, []) -> []
    | (ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope, [first | rest]) -> {
      nestedIndex = statementIndexFor (nestedStatementLocation statementLocation expressionPath blockIndex) statementIndices.
      case duplicateBlockBindersAt modulePath nestedIndex (blockStatementBinderDefinitions first) seen {
        | (laterSeen, currentFailures) -> listAppend
          currentFailures
          (duplicateBlockBinderFailuresFrom context statementLocation expressionPath rest (blockIndex + 1) laterSeen)
      }.
    }
  }.

  duplicateBlockBinderFailures :: ModuleContext -> Int -> [Int] -> [TypedStatement] -> [TypedCoreValidationFailure].
  duplicateBlockBinderFailures = \(context, statementIndex, expressionPath, statements) -> case context {
    | ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope ->
      duplicateBlockBinderFailuresFrom context (statementLocationFor statementIndex statementIndices) expressionPath statements 0 []
  }.

  declarationEntryForName :: [Text] -> TypedCoreName -> Maybe(TypedBinderId) -> [DeclarationEntry].
  declarationEntryForName = \(modulePath, name, binder) -> case resolvedNameEntry modulePath name {
    | Nothing -> []
    | Just entry -> [DeclarationEntry entry name binder]
  }.

  constructorDeclarationEntries :: [Text] -> [TypedConstructorDeclaration] -> [DeclarationEntry].
  constructorDeclarationEntries = \(modulePath, constructors) -> case constructors {
    | [] -> []
    | [TypedConstructorDeclaration binder name fields recipes | rest] -> listAppend
      (declarationEntryForName modulePath name (Just binder))
      (constructorDeclarationEntries modulePath rest)
  }.

  methodDeclarationEntries :: [Text] -> [TypedMethodSignature] -> [DeclarationEntry].
  methodDeclarationEntries = \(modulePath, methods) -> case methods {
    | [] -> []
    | [TypedMethodSignature name span scheme | rest] -> case scheme {
      | TypedScheme binder parameters evidence primitive resultType resultRecipe -> listAppend
        (declarationEntryForName modulePath name (Just binder))
        (methodDeclarationEntries modulePath rest)
    }
  }.

  statementDeclarationEntries :: [Text] -> TypedStatement -> [DeclarationEntry].
  statementDeclarationEntries = \(modulePath, statement) -> case statement {
    | TypedLetStatement binder name span scheme expression -> []
    | TypedSignatureStatement binder name span scheme -> declarationEntryForName modulePath name (Just binder)
    | TypedDataStatement declaration -> case declaration {
      | TypedDataDeclaration span name parameters constructors -> listAppend
        (declarationEntryForName modulePath name Nothing)
        (constructorDeclarationEntries modulePath constructors)
    }
    | TypedClassStatement declaration -> case declaration {
      | TypedClassDeclaration span name parameters methods -> listAppend
        (declarationEntryForName modulePath name Nothing)
        (methodDeclarationEntries modulePath methods)
    }
    | TypedImplStatement declaration -> case declaration {
      | TypedImplDeclaration span implId methods -> [ImplDeclarationEntry implId]
    }
    | other -> []
  }.

  declarationEntryMatches :: DeclarationEntry -> DeclarationEntry -> Bool.
  declarationEntryMatches = \(expected, candidate) -> case (expected, candidate) {
    | (DeclarationEntry expectedName expectedCoreName expectedBinder, DeclarationEntry candidateName candidateCoreName candidateBinder) -> nameEntryEqual expectedName candidateName
    | (ImplDeclarationEntry expectedImpl, ImplDeclarationEntry candidateImpl) -> implIdEqual expectedImpl candidateImpl
    | other -> False
  }.

  lookupDeclarationEntry :: DeclarationEntry -> [DeclarationEntry] -> Maybe(DeclarationEntry).
  lookupDeclarationEntry = \(expected, entries) -> case entries {
    | [] -> Nothing
    | [first | rest] -> if declarationEntryMatches expected first then Just first else lookupDeclarationEntry expected rest
  }.

  declarationBinderEqual :: Maybe(TypedBinderId) -> Maybe(TypedBinderId) -> Bool.
  declarationBinderEqual = \(left, right) -> case (left, right) {
    | (Just leftBinder, Just rightBinder) -> binderIdEqual leftBinder rightBinder
    | other -> False
  }.

  duplicateDeclarationsAt :: TypedCoreValidationPath -> [DeclarationEntry] -> [DeclarationEntry] -> ([DeclarationEntry], [TypedCoreValidationFailure]).
  duplicateDeclarationsAt = \(path, declarations, seen) -> case declarations {
    | [] -> (seen, [])
    | [first | rest] -> case first {
      | DeclarationEntry nameEntry name binder -> case lookupDeclarationEntry first seen {
        | Nothing -> duplicateDeclarationsAt path rest (listPrepend first seen)
        | Just previous -> case previous {
          | DeclarationEntry previousName previousCoreName previousBinder -> case duplicateDeclarationsAt path rest seen {
            | (laterSeen, laterFailures) -> (laterSeen, listAppend (if declarationBinderEqual previousBinder binder then [] else [failure path TypedDuplicateDeclaration (TypedNameDetail name)]) laterFailures)
          }
          | ImplDeclarationEntry previousImpl -> duplicateDeclarationsAt path rest seen
        }
      }
      | ImplDeclarationEntry implId -> case lookupDeclarationEntry first seen {
        | Nothing -> duplicateDeclarationsAt path rest (listPrepend first seen)
        | Just previous -> case duplicateDeclarationsAt path rest seen {
          | (laterSeen, laterFailures) -> (laterSeen, listPrepend (failure path TypedDuplicateDeclaration (TypedImplDetail implId)) laterFailures)
        }
      }
    }
  }.

  duplicateBlockDeclarationFailuresFrom :: ModuleContext -> [Int] -> [Int] -> [TypedStatement] -> Int -> [DeclarationEntry] -> [TypedCoreValidationFailure].
  duplicateBlockDeclarationFailuresFrom = \(context, statementLocation, expressionPath, statements, blockIndex, seen) -> case (context, statements) {
    | (ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope, []) -> []
    | (ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope, [first | rest]) -> {
      nestedIndex = statementIndexFor (nestedStatementLocation statementLocation expressionPath blockIndex) statementIndices.
      case duplicateDeclarationsAt (TypedStatementPath modulePath nestedIndex) (statementDeclarationEntries modulePath first) seen {
        | (laterSeen, currentFailures) -> listAppend currentFailures (duplicateBlockDeclarationFailuresFrom context statementLocation expressionPath rest (blockIndex + 1) laterSeen)
      }.
    }
  }.

  duplicateBlockDeclarationFailures :: ModuleContext -> Int -> [Int] -> [TypedStatement] -> [TypedCoreValidationFailure].
  duplicateBlockDeclarationFailures = \(context, statementIndex, expressionPath, statements) -> case context {
    | ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope ->
      duplicateBlockDeclarationFailuresFrom context (statementLocationFor statementIndex statementIndices) expressionPath statements 0 []
  }.

  validateExpression :: ModuleContext -> Int -> [Int] -> TypedExpr -> [TypedCoreValidationFailure].
  validateExpression = \(context, statementIndex, expressionPath, expression) ->
    validateExpressionWithParentSpan context statementIndex expressionPath Nothing expression.

  validateExpressionWithParentSpan :: ModuleContext -> Int -> [Int] -> Maybe(TypedSpan) -> TypedExpr -> [TypedCoreValidationFailure].
  validateExpressionWithParentSpan = \(context, statementIndex, expressionPath, parentExplicitSpan, expression) -> case context {
    | ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope -> {
      path = TypedExpressionPath modulePath statementIndex expressionPath.
      childFailures = case expression {
        | TypedLambdaExpr info binder name body -> validateExpressionWithParentSpan (withLambdaContract info name context) statementIndex (listAppend expressionPath [0]) Nothing body
        | TypedListExpr info expressions -> listConcat (listMap (\(indexed) -> case indexed {
          | (index, child) -> validateExpressionWithParentSpan context statementIndex (listAppend expressionPath [index]) Nothing child
        }) (listIndexed expressions))
        | TypedTupleExpr info expressions -> listConcat (listMap (\(indexed) -> case indexed {
          | (index, child) -> validateExpressionWithParentSpan context statementIndex (listAppend expressionPath [index]) Nothing child
        }) (listIndexed expressions))
        | TypedApplyExpr info function argument -> listAppend
          (validateExpressionWithParentSpan context statementIndex (listAppend expressionPath [0]) parentExplicitSpan function)
          (validateExpressionWithParentSpan context statementIndex (listAppend expressionPath [1]) Nothing argument)
        | TypedTypeApplicationExpr info function span typeArgument -> validateExpressionWithParentSpan context statementIndex (listAppend expressionPath [0]) (Just span) function
        | TypedIfExpr info condition thenExpression elseExpression -> listConcat
          [ validateExpressionWithParentSpan context statementIndex (listAppend expressionPath [0]) Nothing condition,
            validateExpressionWithParentSpan context statementIndex (listAppend expressionPath [1]) Nothing thenExpression,
            validateExpressionWithParentSpan context statementIndex (listAppend expressionPath [2]) Nothing elseExpression
          ]
        | TypedPatternCaseExpr info scrutinee arms -> listAppend
          (validateExpressionWithParentSpan context statementIndex (listAppend expressionPath [0]) Nothing scrutinee)
          (validateCaseChildExpressions context statementIndex expressionPath arms 1)
        | TypedBinaryExpr info operator left right -> listAppend
          (validateExpressionWithParentSpan context statementIndex (listAppend expressionPath [0]) Nothing left)
          (validateExpressionWithParentSpan context statementIndex (listAppend expressionPath [1]) Nothing right)
        | TypedLeftSectionExpr info left operator -> validateExpressionWithParentSpan context statementIndex (listAppend expressionPath [0]) Nothing left
        | TypedRightSectionExpr info operator right -> validateExpressionWithParentSpan context statementIndex (listAppend expressionPath [0]) Nothing right
        | TypedBlockExpr info statements ->
          listAppend
            (duplicateBlockDeclarationFailures (withBlockDeclarations statements context) statementIndex expressionPath statements)
            (validateBlockStatementsInOrder context statementIndex expressionPath statements)
        | other -> []
      }.
      listConcat
        [ validateNodeInfo context path typeScope True (qualifiedMethodExpressionKey expression) (qualifiedMethodCandidateKey expression) (expressionInfo expression),
          validateExpressionInstantiationOwners parentExplicitSpan context path expression,
          validateExpressionOwned context statementIndex expressionPath path expression,
          childFailures
        ].
    }
  }.

  constructorDeclarationEqual :: TypedConstructorDeclaration -> TypedConstructorDeclaration -> Bool.
  constructorDeclarationEqual = \(left, right) -> case (left, right) {
    | (TypedConstructorDeclaration leftBinder leftName leftFields leftRecipes, TypedConstructorDeclaration rightBinder rightName rightFields rightRecipes) -> if binderIdEqual leftBinder rightBinder then if coreNameEqual leftName rightName then if typeListEqual leftFields rightFields then recipeListEqual leftRecipes rightRecipes else False else False else False
  }.

  constructorDeclarationListEqual :: [TypedConstructorDeclaration] -> [TypedConstructorDeclaration] -> Bool.
  constructorDeclarationListEqual = \(left, right) -> case (left, right) {
    | ([], []) -> True
    | ([leftFirst | leftRest], [rightFirst | rightRest]) -> if constructorDeclarationEqual leftFirst rightFirst then constructorDeclarationListEqual leftRest rightRest else False
    | other -> False
  }.

  spanEqual :: TypedSpan -> TypedSpan -> Bool.
  spanEqual = \(left, right) -> case (left, right) {
    | (TypedSpan leftLine leftColumn, TypedSpan rightLine rightColumn) -> if leftLine == rightLine then leftColumn == rightColumn else False
  }.

  dataDeclarationEqual :: TypedDataDeclaration -> TypedDataDeclaration -> Bool.
  dataDeclarationEqual = \(left, right) -> case (left, right) {
    | (TypedDataDeclaration leftSpan leftName leftParameters leftConstructors, TypedDataDeclaration rightSpan rightName rightParameters rightConstructors) -> if spanEqual leftSpan rightSpan then if coreNameEqual leftName rightName then if typeParameterIdListEqual leftParameters rightParameters then constructorDeclarationListEqual leftConstructors rightConstructors else False else False else False
  }.

  methodSignatureEqual :: TypedMethodSignature -> TypedMethodSignature -> Bool.
  methodSignatureEqual = \(left, right) -> case (left, right) {
    | (TypedMethodSignature leftName leftSpan leftScheme, TypedMethodSignature rightName rightSpan rightScheme) -> if coreNameEqual leftName rightName then if spanEqual leftSpan rightSpan then schemeEqual leftScheme rightScheme else False else False
  }.

  methodSignatureListEqual :: [TypedMethodSignature] -> [TypedMethodSignature] -> Bool.
  methodSignatureListEqual = \(left, right) -> case (left, right) {
    | ([], []) -> True
    | ([leftFirst | leftRest], [rightFirst | rightRest]) -> if methodSignatureEqual leftFirst rightFirst then methodSignatureListEqual leftRest rightRest else False
    | other -> False
  }.

  classDeclarationEqual :: TypedClassDeclaration -> TypedClassDeclaration -> Bool.
  classDeclarationEqual = \(left, right) -> case (left, right) {
    | (TypedClassDeclaration leftSpan leftName leftParameters leftMethods, TypedClassDeclaration rightSpan rightName rightParameters rightMethods) -> if spanEqual leftSpan rightSpan then if coreNameEqual leftName rightName then if typeParameterIdListEqual leftParameters rightParameters then methodSignatureListEqual leftMethods rightMethods else False else False else False
  }.

  constructorBinders :: [TypedConstructorDeclaration] -> [TypedBinderId].
  constructorBinders = \(constructors) -> case constructors {
    | [] -> []
    | [TypedConstructorDeclaration binder name fields recipes | rest] -> listPrepend binder (constructorBinders rest)
  }.

  methodSignatureBinders :: [TypedMethodSignature] -> [TypedBinderId].
  methodSignatureBinders = \(methods) -> case methods {
    | [] -> []
    | [TypedMethodSignature name span scheme | rest] -> case scheme {
      | TypedScheme binder parameters evidence primitive resultType resultRecipe -> listPrepend binder (methodSignatureBinders rest)
    }
  }.

  methodDefinitionBinders :: [TypedMethodDefinition] -> [TypedBinderId].
  methodDefinitionBinders = \(methods) -> case methods {
    | [] -> []
    | [TypedMethodDefinition methodId binder name span expression | rest] -> listPrepend binder (methodDefinitionBinders rest)
  }.

  statementBinderDefinitions :: TypedStatement -> [TypedBinderId].
  statementBinderDefinitions = \(statement) -> case statement {
    | TypedLetStatement binder name span scheme expression -> [binder]
    | TypedSignatureStatement binder name span scheme -> [binder]
    | TypedDataStatement declaration -> case declaration {
      | TypedDataDeclaration span name parameters constructors -> constructorBinders constructors
    }
    | TypedClassStatement declaration -> case declaration {
      | TypedClassDeclaration span name parameters methods -> methodSignatureBinders methods
    }
    | TypedImplStatement declaration -> case declaration {
      | TypedImplDeclaration span implId methods -> methodDefinitionBinders methods
    }
    | TypedExpressionStatement span expression -> []
  }.

  binderOccurrencesAt :: TypedCoreValidationPath -> [TypedBinderId] -> [BinderOccurrence].
  binderOccurrencesAt = \(path, binders) -> listMap (\(binder) -> BinderOccurrence path binder) binders.

  patternBinderOccurrences :: [Text] -> Int -> [Int] -> TypedPattern -> [BinderOccurrence].
  patternBinderOccurrences = \(modulePath, statementIndex, patternPath, pattern) -> {
    path = TypedPatternPath modulePath statementIndex patternPath.
    owned = case pattern {
      | TypedVariablePattern info binder name -> [BinderOccurrence path binder]
      | TypedAsPattern info binder name nested -> [BinderOccurrence path binder]
      | other -> []
    }.
    children = case pattern {
      | TypedConstructorPattern info name patterns -> patternListBinderOccurrences modulePath statementIndex patternPath patterns 0
      | TypedListPattern info patterns -> patternListBinderOccurrences modulePath statementIndex patternPath patterns 0
      | TypedConsListPattern info headPattern tailPattern -> patternListBinderOccurrences modulePath statementIndex patternPath [headPattern, tailPattern] 0
      | TypedTuplePattern info patterns -> patternListBinderOccurrences modulePath statementIndex patternPath patterns 0
      | TypedAsPattern info binder name nested -> patternBinderOccurrences modulePath statementIndex (listAppend patternPath [0]) nested
      | TypedOrPattern info alternatives -> patternListBinderOccurrences modulePath statementIndex patternPath alternatives 0
      | other -> []
    }.
    listAppend owned children.
  }.

  patternListBinderOccurrences :: [Text] -> Int -> [Int] -> [TypedPattern] -> Int -> [BinderOccurrence].
  patternListBinderOccurrences = \(modulePath, statementIndex, parentPath, patterns, childIndex) -> case patterns {
    | [] -> []
    | [first | rest] -> listAppend
      (patternBinderOccurrences modulePath statementIndex (listAppend parentPath [childIndex]) first)
      (patternListBinderOccurrences modulePath statementIndex parentPath rest (childIndex + 1))
  }.

  expressionListBinderOccurrences :: ModuleContext -> Int -> [Int] -> [TypedExpr] -> Int -> [BinderOccurrence].
  expressionListBinderOccurrences = \(context, statementIndex, parentPath, expressions, childIndex) -> case expressions {
    | [] -> []
    | [first | rest] -> listAppend
      (expressionBinderOccurrences context statementIndex (listAppend parentPath [childIndex]) first)
      (expressionListBinderOccurrences context statementIndex parentPath rest (childIndex + 1))
  }.

  caseArmBinderOccurrences :: ModuleContext -> Int -> [Int] -> [TypedCaseArm] -> Int -> Int -> [BinderOccurrence].
  caseArmBinderOccurrences = \(context, statementIndex, expressionPath, arms, armIndex, childIndex) -> case (context, arms) {
    | (ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope, []) -> []
    | (ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope, [TypedCaseArm pattern maybeGuard result | rest]) -> listConcat
      [ patternBinderOccurrences modulePath statementIndex (listAppend expressionPath [armIndex]) pattern,
        case maybeGuard {
          | Nothing -> listAppend
            (expressionBinderOccurrences context statementIndex (listAppend expressionPath [childIndex]) result)
            (caseArmBinderOccurrences context statementIndex expressionPath rest (armIndex + 1) (childIndex + 1))
          | Just guard -> listConcat
            [ expressionBinderOccurrences context statementIndex (listAppend expressionPath [childIndex]) guard,
              expressionBinderOccurrences context statementIndex (listAppend expressionPath [childIndex + 1]) result,
              caseArmBinderOccurrences context statementIndex expressionPath rest (armIndex + 1) (childIndex + 2)
            ]
        }
      ]
  }.

  blockStatementBinderOccurrences :: ModuleContext -> Int -> [Int] -> [TypedStatement] -> Int -> [BinderOccurrence].
  blockStatementBinderOccurrences = \(context, statementIndex, expressionPath, statements, blockIndex) -> case (context, statements) {
    | (ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope, []) -> []
    | (ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope, [first | rest]) -> {
      statementLocation = statementLocationFor statementIndex statementIndices.
      nestedIndex = statementIndexFor (nestedStatementLocation statementLocation expressionPath blockIndex) statementIndices.
      listAppend
        (statementBinderOccurrences context nestedIndex first)
        (blockStatementBinderOccurrences context statementIndex expressionPath rest (blockIndex + 1)).
    }
  }.

  expressionBinderOccurrences :: ModuleContext -> Int -> [Int] -> TypedExpr -> [BinderOccurrence].
  expressionBinderOccurrences = \(context, statementIndex, expressionPath, expression) -> case context {
    | ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope -> {
      path = TypedExpressionPath modulePath statementIndex expressionPath.
      owned = case expression {
        | TypedLambdaExpr info binder name body -> [BinderOccurrence path binder]
        | other -> []
      }.
      children = case expression {
        | TypedLambdaExpr info binder name body -> expressionBinderOccurrences context statementIndex (listAppend expressionPath [0]) body
        | TypedListExpr info expressions -> expressionListBinderOccurrences context statementIndex expressionPath expressions 0
        | TypedTupleExpr info expressions -> expressionListBinderOccurrences context statementIndex expressionPath expressions 0
        | TypedApplyExpr info function argument -> expressionListBinderOccurrences context statementIndex expressionPath [function, argument] 0
        | TypedTypeApplicationExpr info function span typeArgument -> expressionBinderOccurrences context statementIndex (listAppend expressionPath [0]) function
        | TypedIfExpr info condition thenExpression elseExpression -> expressionListBinderOccurrences context statementIndex expressionPath [condition, thenExpression, elseExpression] 0
        | TypedPatternCaseExpr info scrutinee arms -> listAppend
          (expressionBinderOccurrences context statementIndex (listAppend expressionPath [0]) scrutinee)
          (caseArmBinderOccurrences context statementIndex expressionPath arms 0 1)
        | TypedBinaryExpr info operator left right -> expressionListBinderOccurrences context statementIndex expressionPath [left, right] 0
        | TypedLeftSectionExpr info left operator -> expressionBinderOccurrences context statementIndex (listAppend expressionPath [0]) left
        | TypedRightSectionExpr info operator right -> expressionBinderOccurrences context statementIndex (listAppend expressionPath [0]) right
        | TypedBlockExpr info statements -> blockStatementBinderOccurrences context statementIndex expressionPath statements 0
        | other -> []
      }.
      listAppend owned children.
    }
  }.

  methodExpressionBinderOccurrences :: ModuleContext -> Int -> [TypedMethodDefinition] -> Int -> [BinderOccurrence].
  methodExpressionBinderOccurrences = \(context, statementIndex, methods, methodIndex) -> case methods {
    | [] -> []
    | [TypedMethodDefinition methodId binder name span expression | rest] -> listAppend
      (expressionBinderOccurrences context statementIndex [methodIndex] expression)
      (methodExpressionBinderOccurrences context statementIndex rest (methodIndex + 1))
  }.

  statementBinderOccurrences :: ModuleContext -> Int -> TypedStatement -> [BinderOccurrence].
  statementBinderOccurrences = \(context, statementIndex, statement) -> case context {
    | ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope -> listAppend
      (binderOccurrencesAt (TypedStatementPath modulePath statementIndex) (statementBinderDefinitions statement))
      (case statement {
        | TypedLetStatement binder name span scheme expression -> expressionBinderOccurrences context statementIndex [0] expression
        | TypedImplStatement declaration -> case declaration {
          | TypedImplDeclaration span implId methods -> methodExpressionBinderOccurrences context statementIndex methods 0
        }
        | TypedExpressionStatement span expression -> expressionBinderOccurrences context statementIndex [0] expression
        | other -> []
      })
  }.

  moduleBinderOccurrences :: ModuleContext -> [TypedStatement] -> Int -> [BinderOccurrence].
  moduleBinderOccurrences = \(context, statements, statementIndex) -> case statements {
    | [] -> []
    | [first | rest] -> listAppend
      (statementBinderOccurrences context statementIndex first)
      (moduleBinderOccurrences context rest (statementIndex + 1))
  }.

  duplicateBinderOccurrenceFailures :: [BinderOccurrence] -> [TypedBinderId] -> [TypedCoreValidationFailure].
  duplicateBinderOccurrenceFailures = \(occurrences, seen) -> case occurrences {
    | [] -> []
    | [BinderOccurrence path binder | rest] -> if binderIdMember binder seen then
      listPrepend (failure path TypedDuplicateBinder (TypedBinderDetail binder)) (duplicateBinderOccurrenceFailures rest seen)
    else duplicateBinderOccurrenceFailures rest (listPrepend binder seen)
  }.

  duplicateModuleBinderFailures :: ModuleContext -> [TypedStatement] -> [TypedCoreValidationFailure].
  duplicateModuleBinderFailures = \(context, statements) -> duplicateBinderOccurrenceFailures (moduleBinderOccurrences context statements 0) [].

  duplicateModuleDeclarationFailuresFrom :: ModuleContext -> [TypedStatement] -> Int -> [DeclarationEntry] -> [TypedCoreValidationFailure].
  duplicateModuleDeclarationFailuresFrom = \(context, statements, statementIndex, seen) -> case (context, statements) {
    | (ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope, []) -> []
    | (ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope, [first | rest]) -> case duplicateDeclarationsAt (TypedStatementPath modulePath statementIndex) (statementDeclarationEntries modulePath first) seen {
      | (laterSeen, currentFailures) -> listAppend currentFailures (duplicateModuleDeclarationFailuresFrom context rest (statementIndex + 1) laterSeen)
    }
  }.

  duplicateModuleDeclarationFailures :: ModuleContext -> [TypedStatement] -> [TypedCoreValidationFailure].
  duplicateModuleDeclarationFailures = \(context, statements) -> duplicateModuleDeclarationFailuresFrom context statements 0 [].

  dataRecipePairFailures :: TypedCoreValidationPath -> [(TypedType, TypedRepresentationRecipe)] -> [TypedCoreValidationFailure].
  dataRecipePairFailures = \(path, pairs) -> case pairs {
    | [] -> []
    | [(typeValue, recipe) | rest] -> listAppend
      (case expectedRecipe typeValue {
        | Nothing -> []
        | Just expected -> if recipeWidthValid recipe then if recipeEqual expected recipe then [] else [failure path TypedDataRecipeMismatch (TypedRecipeDetail expected recipe)] else []
      })
      (dataRecipePairFailures path rest)
  }.

  validateConstructorDeclaration :: ModuleContext -> TypedCoreValidationPath -> [TypedTypeParameterId] -> TypedConstructorDeclaration -> [TypedCoreValidationFailure].
  validateConstructorDeclaration = \(context, path, scope, declaration) -> case declaration {
    | TypedConstructorDeclaration binder name fields recipes -> listConcat
      [ validateLocalDefinitionName context [TypedConstructorNamespace] path name,
        validateBinderDefinition context path binder name,
        validateTypes path scope fields,
        listConcat (listMap (\(field) -> validateDataTypeApplications context path field) fields),
        listConcat (listMap (\(field) -> validateSourceDataTypeApplications context path field) fields),
        validateRecipes path scope recipes,
        if listLength fields == listLength recipes then dataRecipePairFailures path (listZip fields recipes) else [failure path TypedDataRecipeMismatch (TypedArityDetail (listLength fields) (listLength recipes))]
      ]
  }.

  validateConstructorDeclarations :: ModuleContext -> TypedCoreValidationPath -> [TypedTypeParameterId] -> [TypedConstructorDeclaration] -> [TypedCoreValidationFailure].
  validateConstructorDeclarations = \(context, path, scope, declarations) -> case declarations {
    | [] -> []
    | [first | rest] -> listAppend (validateConstructorDeclaration context path scope first) (validateConstructorDeclarations context path scope rest)
  }.

  validateDataDeclaration :: ModuleContext -> TypedCoreValidationPath -> TypedDataDeclaration -> [TypedCoreValidationFailure].
  validateDataDeclaration = \(context, path, declaration) -> case declaration {
    | TypedDataDeclaration span name parameters constructors -> listConcat
      [ validateLocalDefinitionName context [TypedTypeNamespace] path name,
        validateOrderedTypeParameters path parameters,
        if listLength constructors == 0 then [failure path TypedDataRecipeMismatch (TypedArityDetail 1 0)] else [],
        validateConstructorDeclarations context path parameters constructors
      ]
  }.

  validateEvidenceParameterDataTypes :: ModuleContext -> TypedCoreValidationPath -> [TypedEvidenceParameter] -> [TypedCoreValidationFailure].
  validateEvidenceParameterDataTypes = \(context, path, parameters) -> case parameters {
    | [] -> []
    | [TypedEvidenceParameter parameterId constraint | rest] -> case constraint {
      | TypedCapabilityConstraint capability method targetType -> listAppend (validateDataTypeApplications context path targetType) (validateEvidenceParameterDataTypes context path rest)
    }
  }.

  validatePrimitiveDataTypes :: ModuleContext -> TypedCoreValidationPath -> [TypedPrimitiveConstraint] -> [TypedCoreValidationFailure].
  validatePrimitiveDataTypes = \(context, path, constraints) -> case constraints {
    | [] -> []
    | [first | rest] -> listAppend
      (case first {
        | TypedNumericPrimitiveConstraint numericConstraint typeValue -> validateDataTypeApplications context path typeValue
        | TypedStrictEqualityPrimitiveConstraint typeValue -> validateDataTypeApplications context path typeValue
      })
      (validatePrimitiveDataTypes context path rest)
  }.

  validateSchemeDataTypes :: ModuleContext -> TypedCoreValidationPath -> TypedScheme -> [TypedCoreValidationFailure].
  validateSchemeDataTypes = \(context, path, scheme) -> case scheme {
    | TypedScheme owner parameters evidence primitive resultType resultRecipe -> listConcat
      [ validateDataTypeApplications context path resultType,
        validateEvidenceParameterDataTypes context path evidence,
        validatePrimitiveDataTypes context path primitive
      ]
  }.

  validateSourceEvidenceParameterDataTypes :: ModuleContext -> TypedCoreValidationPath -> [TypedEvidenceParameter] -> [TypedCoreValidationFailure].
  validateSourceEvidenceParameterDataTypes = \(context, path, parameters) -> case parameters {
    | [] -> []
    | [TypedEvidenceParameter parameterId constraint | rest] -> case constraint {
      | TypedCapabilityConstraint capability method targetType -> listAppend (validateSourceDataTypeApplications context path targetType) (validateSourceEvidenceParameterDataTypes context path rest)
    }
  }.

  validateSourcePrimitiveDataTypes :: ModuleContext -> TypedCoreValidationPath -> [TypedPrimitiveConstraint] -> [TypedCoreValidationFailure].
  validateSourcePrimitiveDataTypes = \(context, path, constraints) -> case constraints {
    | [] -> []
    | [first | rest] -> listAppend
      (case first {
        | TypedNumericPrimitiveConstraint numericConstraint typeValue -> validateSourceDataTypeApplications context path typeValue
        | TypedStrictEqualityPrimitiveConstraint typeValue -> validateSourceDataTypeApplications context path typeValue
      })
      (validateSourcePrimitiveDataTypes context path rest)
  }.

  validateSourceSchemeDataTypes :: ModuleContext -> TypedCoreValidationPath -> TypedScheme -> [TypedCoreValidationFailure].
  validateSourceSchemeDataTypes = \(context, path, scheme) -> case scheme {
    | TypedScheme owner parameters evidence primitive resultType resultRecipe -> listConcat
      [ validateSourceDataTypeApplications context path resultType,
        validateSourceEvidenceParameterDataTypes context path evidence,
        validateSourcePrimitiveDataTypes context path primitive
      ]
  }.

  validateMethodSignatures :: ModuleContext -> TypedCoreValidationPath -> [TypedTypeParameterId] -> [TypedMethodSignature] -> [TypedCoreValidationFailure].
  validateMethodSignatures = \(context, path, outerScope, methods) -> case methods {
    | [] -> []
    | [TypedMethodSignature name span scheme | rest] -> case scheme {
      | TypedScheme binder parameters evidence primitive resultType resultRecipe -> listConcat
        [ validateLocalDefinitionName context [TypedValueNamespace] path name,
          validateBinderDefinition context path binder name,
          if listLength parameters + listLength evidence + listLength primitive == 0 then [] else [failure path TypedBindingValueMismatch (TypedArityDetail 0 (listLength parameters + listLength evidence + listLength primitive))],
          validateSchemeWithOuterScope context path binder outerScope scheme,
          validateSchemeDataTypes context path scheme,
          validateSourceSchemeDataTypes context path scheme,
          validateMethodSignatures context path outerScope rest
        ]
    }
  }.

  externalVisibleCapabilityIdentifierPresent :: [Text] -> Text -> [NameEntry] -> Bool.
  externalVisibleCapabilityIdentifierPresent = \(currentModulePath, expectedIdentifier, entries) -> case entries {
    | [] -> False
    | [first | rest] -> case first {
      | NameEntry candidatePath TypedCapabilityNamespace candidateIdentifier ->
        if textListEqual candidatePath currentModulePath then externalVisibleCapabilityIdentifierPresent currentModulePath expectedIdentifier rest
        else if candidateIdentifier == expectedIdentifier then True
        else externalVisibleCapabilityIdentifierPresent currentModulePath expectedIdentifier rest
      | other -> externalVisibleCapabilityIdentifierPresent currentModulePath expectedIdentifier rest
    }
  }.

  visibleClassCollisionFailures :: ModuleContext -> TypedCoreValidationPath -> TypedCoreName -> [TypedCoreValidationFailure].
  visibleClassCollisionFailures = \(context, path, name) -> case (context, name) {
    | (ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope, TypedResolvedName TypedCurrentModule TypedCapabilityNamespace identifier) ->
      if externalVisibleCapabilityIdentifierPresent modulePath identifier visibleNames then [failure path TypedDuplicateDeclaration (TypedNameDetail name)] else []
    | (ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope, TypedResolvedName TypedAmbientPrelude TypedCapabilityNamespace identifier) ->
      if textListEqual modulePath ["Prelude"] then
        if externalVisibleCapabilityIdentifierPresent modulePath identifier visibleNames then [failure path TypedDuplicateDeclaration (TypedNameDetail name)] else []
      else []
    | other -> []
  }.

  validateClassDeclaration :: ModuleContext -> TypedCoreValidationPath -> TypedClassDeclaration -> [TypedCoreValidationFailure].
  validateClassDeclaration = \(context, path, declaration) -> case declaration {
    | TypedClassDeclaration span name parameters methods -> listConcat
      [ validateLocalDefinitionName context [TypedCapabilityNamespace] path name,
        visibleClassCollisionFailures context path name,
        if listLength parameters == 1 then [] else [failure path TypedMethodSelectionMismatch (TypedArityDetail 1 (listLength parameters))],
        validateOrderedTypeParameters path parameters,
        validateMethodSignatures context path parameters methods
      ]
  }.

  lookupMethodContract :: Text -> [MethodContract] -> Maybe(TypedScheme).
  lookupMethodContract = \(methodName, methods) -> case methods {
    | [] -> Nothing
    | [MethodContract candidateName scheme | rest] -> if methodName == candidateName then Just scheme else lookupMethodContract methodName rest
  }.

  implMethodScheme :: ModuleContext -> TypedImplId -> Text -> Maybe(([TypedTypeParameterId], TypedScheme)).
  implMethodScheme = \(context, implId, methodName) -> case implId {
    | TypedImplId modulePath capability targets -> case capabilityContractForName context capability {
      | Nothing -> Nothing
      | Just contract -> case contract {
        | CapabilityContract parameters methods -> case lookupMethodContract methodName methods {
          | Nothing -> Nothing
          | Just scheme -> Just (parameters, scheme)
        }
      }
    }
  }.

  validateImplMethodContract :: ModuleContext -> TypedCoreValidationPath -> TypedImplId -> Text -> TypedNodeInfo -> [TypedCoreValidationFailure].
  validateImplMethodContract = \(context, path, implId, methodName, info) -> case (context, implId) {
    | (ModuleContext currentModulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope, TypedImplId implPath capability targets) -> case capabilityContractForName context capability {
      | Nothing -> []
      | Just contract -> case contract {
        | CapabilityContract parameters methods -> case lookupMethodContract methodName methods {
          | Nothing -> [failure path TypedMethodSelectionMismatch (TypedTextDetail methodName)]
          | Just scheme -> case scheme {
            | TypedScheme owner schemeParameters evidence primitive resultType resultRecipe -> if listLength parameters == listLength targets then {
              substitutions = listZip parameters targets.
              ownerPath = binderModulePathValue owner.
              qualifiedType = if textListEqual ownerPath currentModulePath then resultType else qualifyExternalType ownerPath resultType.
              qualifiedRecipe = if textListEqual ownerPath currentModulePath then resultRecipe else qualifyExternalRecipe ownerPath resultRecipe.
              validateValueContract path info (ValueContract (substituteTypeParameters substitutions qualifiedType) (substituteRepresentationParameters substitutions qualifiedRecipe)).
            } else []
          }
        }
      }
    }
  }.

  implMethodContext :: ModuleContext -> TypedImplId -> Text -> ModuleContext.
  implMethodContext = \(context, implId, methodName) -> case implMethodScheme context implId methodName {
    | Nothing -> context
    | Just value -> case value {
      | (parameters, scheme) -> withSchemeScope scheme context
    }
  }.

  validateMethodDefinitions :: ModuleContext -> Int -> TypedCoreValidationPath -> TypedImplId -> [TypedMethodDefinition] -> Int -> [TypedCoreValidationFailure].
  validateMethodDefinitions = \(context, statementIndex, path, enclosingImpl, methods, methodIndex) -> case methods {
    | [] -> []
    | [TypedMethodDefinition methodId binder name span expression | rest] -> listConcat
      [ validateMethodId context path [] methodId,
        case methodId {
          | TypedMethodId methodImpl methodName -> listAppend
            (if implIdEqual methodImpl enclosingImpl then [] else [failure path TypedMethodSelectionMismatch (TypedImplDetail methodImpl)])
            (case coreNameIdentifier name {
              | Nothing -> [failure path TypedMethodSelectionMismatch (TypedTextDetail methodName)]
              | Just publishedName -> if methodName == publishedName then [] else [failure path TypedMethodSelectionMismatch (TypedTextDetail methodName)]
            })
        },
        validateLocalDefinitionName context [TypedValueNamespace] path name,
        validateBinderDefinition context path binder name,
        case methodId {
          | TypedMethodId methodImpl methodName -> validateImplMethodContract context path enclosingImpl methodName (expressionInfo expression)
        },
        case methodId {
          | TypedMethodId methodImpl methodName -> validateExpression (implMethodContext context enclosingImpl methodName) statementIndex [methodIndex] expression
        },
        validateMethodDefinitions context statementIndex path enclosingImpl rest (methodIndex + 1)
      ]
  }.

  duplicateImplMethodFailuresFrom :: TypedCoreValidationPath -> [TypedMethodDefinition] -> [Text] -> [TypedCoreValidationFailure].
  duplicateImplMethodFailuresFrom = \(path, methods, seen) -> case methods {
    | [] -> []
    | [TypedMethodDefinition methodId binder name span expression | rest] -> case methodId {
      | TypedMethodId implId methodKey -> listAppend
        (if listContains methodKey seen then [failure path TypedDuplicateDeclaration (TypedNameDetail name)] else [])
        (duplicateImplMethodFailuresFrom path rest (if listContains methodKey seen then seen else listPrepend methodKey seen))
    }
  }.

  duplicateImplMethodFailures :: TypedCoreValidationPath -> [TypedMethodDefinition] -> [TypedCoreValidationFailure].
  duplicateImplMethodFailures = \(path, methods) -> duplicateImplMethodFailuresFrom path methods [].

  implMethodDefinitionKeys :: [TypedMethodDefinition] -> [Text].
  implMethodDefinitionKeys = \(methods) -> case methods {
    | [] -> []
    | [TypedMethodDefinition methodId binder name span expression | rest] -> case methodId {
      | TypedMethodId implId methodKey -> listPrepend methodKey (implMethodDefinitionKeys rest)
    }
  }.

  methodContractKeys :: [MethodContract] -> [Text].
  methodContractKeys = \(contracts) -> case contracts {
    | [] -> []
    | [MethodContract methodKey scheme | rest] -> listPrepend methodKey (methodContractKeys rest)
  }.

  missingMethodKeyFailures :: TypedCoreValidationPath -> [Text] -> [Text] -> [TypedCoreValidationFailure].
  missingMethodKeyFailures = \(path, methodKeys, providedMethodKeys) -> case methodKeys {
    | [] -> []
    | [methodKey | rest] -> listAppend
      (if listContains methodKey providedMethodKeys then [] else [failure path TypedMethodSelectionMismatch (TypedTextDetail methodKey)])
      (missingMethodKeyFailures path rest providedMethodKeys)
  }.

  missingImplMethodFailures :: ModuleContext -> TypedCoreValidationPath -> TypedImplId -> [TypedMethodDefinition] -> [TypedCoreValidationFailure].
  missingImplMethodFailures = \(context, path, implId, methods) -> case implId {
    | TypedImplId modulePath capability targets -> case capabilityContractForName context capability {
      | Nothing -> []
      | Just contract -> case contract {
        | CapabilityContract parameters methodContracts ->
          if listLength targets == listLength parameters then
            missingMethodKeyFailures path (listSort (methodContractKeys methodContracts)) (implMethodDefinitionKeys methods)
          else
            []
      }
    }
  }.

  validateImplDeclaration :: ModuleContext -> Int -> TypedCoreValidationPath -> TypedImplDeclaration -> [TypedCoreValidationFailure].
  validateImplDeclaration = \(context, statementIndex, path, declaration) -> case context {
    | ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope -> case declaration {
      | TypedImplDeclaration span implId methods -> listConcat
        [ if textListEqual (implModulePath implId) modulePath then [] else [failure path TypedInvisibleImpl (TypedImplDetail implId)],
          validateImplId context path [] implId,
          validateImplDataTypes context path implId,
          listConcat (listMap (\(targetType) -> validateSourceDataTypeApplications context path targetType) (implTargetTypes implId)),
          duplicateImplMethodFailures path methods,
          missingImplMethodFailures context path implId methods,
          validateMethodDefinitions context statementIndex path implId methods 0
        ]
    }
  }.

  validateBindingValue :: TypedCoreValidationPath -> TypedScheme -> TypedNodeInfo -> [TypedCoreValidationFailure].
  validateBindingValue = \(path, scheme, info) -> case scheme {
    | TypedScheme owner parameters evidence primitive resultType resultRecipe ->
      if typeEqual resultType (nodeType info) then
        if recipeEqual resultRecipe (nodeRecipe info) then [] else [failure path TypedBindingValueMismatch (TypedRecipeDetail resultRecipe (nodeRecipe info))]
      else [failure path TypedBindingValueMismatch (TypedTypeDetail resultType (nodeType info))]
  }.

  validateStatement :: ModuleContext -> Int -> TypedStatement -> [TypedCoreValidationFailure].
  validateStatement = \(context, statementIndex, statement) -> case context {
    | ModuleContext modulePath visibleModules schemes statementIndices visibleNames visibleImpls dataEntries typeScope -> {
      path = TypedStatementPath modulePath statementIndex.
      case statement {
        | TypedLetStatement binder name span scheme expression -> listConcat
          [ validateLocalDefinitionName context [TypedValueNamespace] path name,
            validateBinderDefinition context path binder name,
            validateSchemeWithOuterScope context path binder typeScope scheme,
            validateSchemeDataTypes context path scheme,
            validateBindingValue path scheme (expressionInfo expression),
            validateExpression (withSchemeScope scheme context) statementIndex [0] expression
          ]
        | TypedSignatureStatement binder name span scheme -> listConcat [validateLocalDefinitionName context [TypedValueNamespace] path name, validateBinderDefinition context path binder name, validateSchemeWithOuterScope context path binder typeScope scheme, validateSchemeDataTypes context path scheme, validateSourceSchemeDataTypes context path scheme]
        | TypedDataStatement declaration -> validateDataDeclaration context path declaration
        | TypedClassStatement declaration -> validateClassDeclaration context path declaration
        | TypedImplStatement declaration -> validateImplDeclaration context statementIndex path declaration
        | TypedExpressionStatement span expression -> validateExpression context statementIndex [0] expression
      }.
    }
  }.

  isModuleMetadataStatement :: TypedStatement -> Bool.
  isModuleMetadataStatement = \(statement) -> case statement {
    | TypedDataStatement declaration -> True
    | other -> False
  }.

  validateModuleStatementsInOrderFrom :: ModuleContext -> ModuleContext -> [TypedStatement] -> [TypedStatement] -> Int -> [TypedCoreValidationFailure].
  validateModuleStatementsInOrderFrom = \(initialContext, visibleContext, allStatements, remainingStatements, statementIndex) -> case remainingStatements {
    | [] -> []
    | [statement | rest] -> {
      recursiveGroup = blockRecursiveGroupStatements initialContext allStatements statementIndex.
      statementContext = case statement {
        | TypedLetStatement binder name span scheme expression ->
          if listLength recursiveGroup == 0 then visibleContext else withBlockDeclarations recursiveGroup visibleContext
        | other -> if isModuleMetadataStatement statement then visibleContext else withBlockDeclarations [statement] visibleContext
      }.
      nextContext = if isModuleMetadataStatement statement then visibleContext else withBlockDeclarations [statement] visibleContext.
      listConcat
        [ validateAttachedSignature initialContext statementIndex (TypedStatementPath (contextModulePath initialContext) statementIndex) statement rest,
          validateStatement statementContext statementIndex statement,
          validateModuleStatementsInOrderFrom initialContext nextContext allStatements rest (statementIndex + 1)
        ].
    }
  }.

  validateModuleStatementsInOrder :: ModuleContext -> [TypedStatement] -> [TypedCoreValidationFailure].
  validateModuleStatementsInOrder = \(context, statements) ->
    validateModuleStatementsInOrderFrom context context statements statements 0.

  activeDeclaredValueMatches :: TypedCoreName -> TypedScheme -> [TypedStatement] -> Bool.
  activeDeclaredValueMatches = \(name, scheme, statements) -> case statements {
    | [] -> False
    | [first | rest] -> case first {
      | TypedLetStatement binder candidateName span candidateScheme expression ->
        if coreNameEqual name candidateName then schemeEqual scheme candidateScheme else activeDeclaredValueMatches name scheme rest
      | other -> activeDeclaredValueMatches name scheme rest
    }
  }.

  declaredValueMatches :: TypedCoreName -> TypedScheme -> [TypedStatement] -> Bool.
  declaredValueMatches = \(name, scheme, statements) ->
    activeDeclaredValueMatches name scheme (listReverse statements).

  declaredDataMatches :: TypedDataDeclaration -> [TypedStatement] -> Bool.
  declaredDataMatches = \(declaration, statements) -> case statements {
    | [] -> False
    | [first | rest] -> case first {
      | TypedDataStatement candidate -> if dataDeclarationEqual declaration candidate then True else declaredDataMatches declaration rest
      | other -> declaredDataMatches declaration rest
    }
  }.

  declaredClassMatches :: TypedClassDeclaration -> [TypedStatement] -> Bool.
  declaredClassMatches = \(declaration, statements) -> case statements {
    | [] -> False
    | [first | rest] -> case first {
      | TypedClassStatement candidate -> if classDeclarationEqual declaration candidate then True else declaredClassMatches declaration rest
      | other -> declaredClassMatches declaration rest
    }
  }.

  declaredImplMatches :: TypedImplId -> [TypedStatement] -> Bool.
  declaredImplMatches = \(implId, statements) -> case statements {
    | [] -> False
    | [first | rest] -> case first {
      | TypedImplStatement declaration -> case declaration {
        | TypedImplDeclaration span candidate methods -> if implIdEqual implId candidate then True else declaredImplMatches implId rest
      }
      | other -> declaredImplMatches implId rest
    }
  }.

  moduleExportsName :: TypedNameNamespace -> TypedCoreName -> [TypedModuleExport] -> Bool.
  moduleExportsName = \(namespace, name, exports) -> case (coreNameIdentifier name, exports) {
    | (Nothing, other) -> False
    | (Just identifier, []) -> False
    | (Just identifier, [TypedModuleExport candidateNamespace candidateName | rest]) ->
      if nameNamespaceEqual namespace candidateNamespace then if identifier == candidateName then True else moduleExportsName namespace name rest else moduleExportsName namespace name rest
  }.

  coreNameMember :: TypedCoreName -> [TypedCoreName] -> Bool.
  coreNameMember = \(candidate, names) -> case names {
    | [] -> False
    | [first | rest] -> if coreNameEqual candidate first then True else coreNameMember candidate rest
  }.

  uniqueCoreNames :: [TypedCoreName] -> [TypedCoreName] -> [TypedCoreName].
  uniqueCoreNames = \(names, seen) -> case names {
    | [] -> []
    | [first | rest] -> if coreNameMember first seen then uniqueCoreNames rest seen else
      listPrepend first (uniqueCoreNames rest (listPrepend first seen))
  }.

  uniqueTexts :: [Text] -> [Text] -> [Text].
  uniqueTexts = \(values, seen) -> case values {
    | [] -> []
    | [first | rest] -> if listContains first seen then uniqueTexts rest seen else
      listPrepend first (uniqueTexts rest (listPrepend first seen))
  }.

  localDataDependencies :: TypedType -> [TypedCoreName].
  localDataDependencies = \(typeValue) -> case typeValue {
    | TypedListType elementType -> localDataDependencies elementType
    | TypedTupleType elementTypes -> listConcat (listMap localDataDependencies elementTypes)
    | TypedDataType name arguments -> case name {
      | TypedResolvedName TypedCurrentModule TypedTypeNamespace identifier -> listPrepend name (listConcat (listMap localDataDependencies arguments))
      | other -> listConcat (listMap localDataDependencies arguments)
    }
    | TypedFunctionType argument result -> listAppend (localDataDependencies argument) (localDataDependencies result)
    | other -> []
  }.

  schemeLocalDataDependencies :: TypedScheme -> [TypedCoreName].
  schemeLocalDataDependencies = \(scheme) -> case scheme {
    | TypedScheme owner parameters evidence primitive resultType resultRecipe -> {
      evidenceTypes = listMap
        (\(parameter) -> case parameter {
          | TypedEvidenceParameter parameterId constraint -> case constraint {
            | TypedCapabilityConstraint capability method targetType -> targetType
          }
        })
        evidence.
      primitiveTypes = listMap
        (\(constraint) -> case constraint {
          | TypedNumericPrimitiveConstraint numericConstraint typeValue -> typeValue
          | TypedStrictEqualityPrimitiveConstraint typeValue -> typeValue
        })
        primitive.
      uniqueCoreNames
        (listConcat (listMap localDataDependencies (listConcat [[resultType], evidenceTypes, primitiveTypes])))
        [].
    }
  }.

  dataInterfaceMatches :: TypedCoreName -> [TypedDataInterface] -> Bool.
  dataInterfaceMatches = \(expected, interfaces) -> case interfaces {
    | [] -> False
    | [TypedDataInterface declaration | rest] -> case declaration {
      | TypedDataDeclaration span actual parameters constructors ->
        if coreNameEqual expected actual then True else dataInterfaceMatches expected rest
    }
  }.

  localCapabilityDeclared :: Text -> [TypedStatement] -> Bool.
  localCapabilityDeclared = \(capability, statements) -> case statements {
    | [] -> False
    | [first | rest] -> case first {
      | TypedClassStatement declaration -> case declaration {
        | TypedClassDeclaration span name parameters methods ->
          if coreNameIdentifierEqual capability name then True else localCapabilityDeclared capability rest
      }
      | other -> localCapabilityDeclared capability rest
    }
  }.

  schemeLocalCapabilityDependenciesFrom :: [TypedStatement] -> [TypedEvidenceParameter] -> [Text].
  schemeLocalCapabilityDependenciesFrom = \(statements, evidence) -> case evidence {
    | [] -> []
    | [TypedEvidenceParameter parameterId constraint | rest] -> case constraint {
      | TypedCapabilityConstraint capability method targetType ->
        if localCapabilityDeclared capability statements then listPrepend capability (schemeLocalCapabilityDependenciesFrom statements rest) else schemeLocalCapabilityDependenciesFrom statements rest
    }
  }.

  schemeLocalCapabilityDependencies :: [TypedStatement] -> TypedScheme -> [Text].
  schemeLocalCapabilityDependencies = \(statements, scheme) -> case scheme {
    | TypedScheme owner parameters evidence primitive resultType resultRecipe ->
      uniqueTexts (schemeLocalCapabilityDependenciesFrom statements evidence) []
  }.

  classInterfaceMatches :: Text -> [TypedClassInterface] -> Bool.
  classInterfaceMatches = \(expected, interfaces) -> case interfaces {
    | [] -> False
    | [TypedClassInterface declaration | rest] -> case declaration {
      | TypedClassDeclaration span name parameters methods ->
        if coreNameIdentifierEqual expected name then True else classInterfaceMatches expected rest
    }
  }.

  interfaceEvidenceCapabilityIdentifiers :: [TypedEvidenceParameter] -> [Text].
  interfaceEvidenceCapabilityIdentifiers = \(parameters) -> case parameters {
    | [] -> []
    | [TypedEvidenceParameter parameterId constraint | rest] -> case constraint {
      | TypedCapabilityConstraint capability method targetType -> listPrepend capability (interfaceEvidenceCapabilityIdentifiers rest)
    }
  }.

  evidenceCapabilityIdentifiersFromScheme :: TypedScheme -> [Text].
  evidenceCapabilityIdentifiersFromScheme = \(scheme) -> case scheme {
    | TypedScheme owner parameters evidence primitive resultType resultRecipe -> interfaceEvidenceCapabilityIdentifiers evidence
  }.

  methodContractListsEqual :: [MethodContract] -> [MethodContract] -> Bool.
  methodContractListsEqual = \(left, right) -> case (left, right) {
    | ([], []) -> True
    | ([MethodContract leftName leftScheme | leftRest], [MethodContract rightName rightScheme | rightRest]) ->
      if leftName == rightName then if schemeEqual leftScheme rightScheme then methodContractListsEqual leftRest rightRest else False else False
    | other -> False
  }.

  retainedCapabilityMatches :: [Text] -> TypedClassDeclaration -> [DataEntry] -> Bool.
  retainedCapabilityMatches = \(modulePath, retained, externalDataEntries) -> case retained {
    | TypedClassDeclaration span name parameters methods -> case resolvedNameEntry modulePath name {
      | Nothing -> False
      | Just entry -> case entry {
        | GeneratedNameEntry kind -> False
        | NameEntry capabilityPath namespace identifier -> case lookupCapabilityContract capabilityPath identifier externalDataEntries {
          | Nothing -> False
          | Just contract -> case contract {
            | CapabilityContract externalParameters externalMethods ->
              if typeParameterIdListEqual parameters externalParameters then
                methodContractListsEqual (methodContractEntries methods) externalMethods
              else False
          }
        }
      }
    }
  }.

  retainedCapabilityIdentifierPresent :: [Text] -> Text -> [TypedClassInterface] -> [DataEntry] -> Bool.
  retainedCapabilityIdentifierPresent = \(modulePath, capability, classes, externalDataEntries) -> case classes {
    | [] -> False
    | [TypedClassInterface declaration | rest] -> case declaration {
      | TypedClassDeclaration span name parameters methods ->
        if coreNameIdentifierEqual capability name then
          if retainedCapabilityMatches modulePath declaration externalDataEntries then True else retainedCapabilityIdentifierPresent modulePath capability rest externalDataEntries
        else retainedCapabilityIdentifierPresent modulePath capability rest externalDataEntries
    }
  }.

  validateValueInterfaceDependencies :: TypedCoreValidationPath -> [Text] -> [TypedStatement] -> [DataEntry] -> [NameEntry] -> [TypedDataInterface] -> [TypedClassInterface] -> TypedScheme -> [TypedCoreValidationFailure].
  validateValueInterfaceDependencies = \(path, modulePath, statements, externalDataEntries, externalNames, datas, classes, scheme) -> listConcat
    [ listMap
        (\(dependencyName) -> failure path TypedModuleInterfaceMismatch (TypedNameDetail dependencyName))
        (listFilter (\(dependencyName) -> dataInterfaceMatches dependencyName datas == False) (schemeLocalDataDependencies scheme)),
      listMap
        (\(capability) -> failure path TypedModuleInterfaceMismatch (TypedNameDetail (TypedResolvedName TypedCurrentModule TypedCapabilityNamespace capability)))
        (listFilter (\(capability) -> classInterfaceMatches capability classes == False) (schemeLocalCapabilityDependencies statements scheme)),
      listMap
        (\(capability) -> failure path TypedModuleInterfaceMismatch (TypedNameDetail (TypedResolvedName TypedCurrentModule TypedCapabilityNamespace capability)))
        (listFilter
          (\(capability) ->
            if localCapabilityDeclared capability statements then False else
              if externalVisibleCapabilityIdentifierPresent modulePath capability externalNames then
                retainedCapabilityIdentifierPresent modulePath capability classes externalDataEntries == False
              else False)
          (uniqueTexts (evidenceCapabilityIdentifiersFromScheme scheme) []))
    ].

  validateValueInterfaces :: TypedCoreValidationPath -> [Text] -> [TypedStatement] -> [DataEntry] -> [NameEntry] -> [TypedModuleExport] -> [TypedDataInterface] -> [TypedClassInterface] -> [TypedValueInterface] -> [TypedCoreValidationFailure].
  validateValueInterfaces = \(path, modulePath, statements, externalDataEntries, externalNames, exports, datas, classes, interfaces) -> case interfaces {
    | [] -> []
    | [TypedValueInterface name scheme | rest] -> listAppend
      (if declaredValueMatches name scheme statements then
        if moduleExportsName TypedValueNamespace name exports then validateValueInterfaceDependencies path modulePath statements externalDataEntries externalNames datas classes scheme else [failure path TypedModuleInterfaceMismatch (TypedNameDetail name)]
      else [failure path TypedModuleInterfaceMismatch (TypedNameDetail name)])
      (validateValueInterfaces path modulePath statements externalDataEntries externalNames exports datas classes rest)
  }.

  constructorLocalDataDependencies :: TypedConstructorDeclaration -> [TypedCoreName].
  constructorLocalDataDependencies = \(constructor) -> case constructor {
    | TypedConstructorDeclaration binder name fields recipes -> listConcat (listMap localDataDependencies fields)
  }.

  dataInterfaceLocalDependencies :: TypedDataDeclaration -> [TypedCoreName].
  dataInterfaceLocalDependencies = \(declaration) -> case declaration {
    | TypedDataDeclaration span name parameters constructors ->
      uniqueCoreNames (listConcat (listMap constructorLocalDataDependencies constructors)) []
  }.

  validateDataInterfaceDependencies :: TypedCoreValidationPath -> [TypedDataInterface] -> TypedDataDeclaration -> [TypedCoreValidationFailure].
  validateDataInterfaceDependencies = \(path, datas, declaration) ->
    listMap
      (\(dependencyName) -> failure path TypedModuleInterfaceMismatch (TypedNameDetail dependencyName))
      (listFilter (\(dependencyName) -> dataInterfaceMatches dependencyName datas == False) (dataInterfaceLocalDependencies declaration)).

  validateDataInterfaces :: TypedCoreValidationPath -> [TypedStatement] -> [TypedDataInterface] -> [TypedDataInterface] -> [TypedCoreValidationFailure].
  validateDataInterfaces = \(path, statements, datas, interfaces) -> case interfaces {
    | [] -> []
    | [TypedDataInterface declaration | rest] -> case declaration {
      | TypedDataDeclaration span name parameters constructors -> listAppend
        (if declaredDataMatches declaration statements then validateDataInterfaceDependencies path datas declaration else [failure path TypedModuleInterfaceMismatch (TypedNameDetail name)])
        (validateDataInterfaces path statements datas rest)
    }
  }.

  validateClassMethodInterfaceDependencies :: TypedCoreValidationPath -> [Text] -> [TypedStatement] -> [DataEntry] -> [NameEntry] -> [TypedDataInterface] -> [TypedClassInterface] -> [TypedMethodSignature] -> [TypedCoreValidationFailure].
  validateClassMethodInterfaceDependencies = \(path, modulePath, statements, externalDataEntries, externalNames, datas, classes, methods) -> case methods {
    | [] -> []
    | [TypedMethodSignature name span scheme | rest] -> listAppend
      (validateValueInterfaceDependencies path modulePath statements externalDataEntries externalNames datas classes scheme)
      (validateClassMethodInterfaceDependencies path modulePath statements externalDataEntries externalNames datas classes rest)
  }.

  validateClassInterfaces :: TypedCoreValidationPath -> [Text] -> [TypedStatement] -> [DataEntry] -> [NameEntry] -> [TypedDataInterface] -> [TypedClassInterface] -> [TypedClassInterface] -> [TypedCoreValidationFailure].
  validateClassInterfaces = \(path, modulePath, statements, externalDataEntries, externalNames, datas, classes, interfaces) -> case interfaces {
    | [] -> []
    | [TypedClassInterface declaration | rest] -> case declaration {
      | TypedClassDeclaration span name parameters methods -> listAppend
        (if declaredClassMatches declaration statements then validateClassMethodInterfaceDependencies path modulePath statements externalDataEntries externalNames datas classes methods else
          if retainedCapabilityMatches modulePath declaration externalDataEntries then [] else [failure path TypedModuleInterfaceMismatch (TypedNameDetail name)])
        (validateClassInterfaces path modulePath statements externalDataEntries externalNames datas classes rest)
    }
  }.

  validateImplInterfaces :: TypedCoreValidationPath -> [TypedStatement] -> [TypedImplId] -> [TypedImplInterface] -> [TypedCoreValidationFailure].
  validateImplInterfaces = \(path, statements, externalImpls, interfaces) -> case interfaces {
    | [] -> []
    | [TypedImplInterface implId | rest] -> listAppend
      (if declaredImplMatches implId statements then [] else if implIdMember implId externalImpls then [] else [failure path TypedModuleInterfaceMismatch (TypedImplDetail implId)])
      (validateImplInterfaces path statements externalImpls rest)
  }.

  implInterfacePresent :: TypedImplId -> [TypedImplInterface] -> Bool.
  implInterfacePresent = \(implId, interfaces) -> case interfaces {
    | [] -> False
    | [TypedImplInterface candidate | rest] -> if implIdEqual implId candidate then True else implInterfacePresent implId rest
  }.

  classInterfaceMatchesImpl :: [Text] -> TypedImplId -> [TypedClassInterface] -> Bool.
  classInterfaceMatchesImpl = \(modulePath, implId, classes) -> case (implId, classes) {
    | (other, []) -> False
    | (TypedImplId implPath capability targets, [TypedClassInterface declaration | rest]) -> case declaration {
      | TypedClassDeclaration span name parameters methods -> case (resolvedNameEntry modulePath capability, resolvedNameEntry modulePath name) {
        | (Just capabilityEntry, Just classEntry) -> if nameEntryEqual capabilityEntry classEntry then True else classInterfaceMatchesImpl modulePath implId rest
        | other -> classInterfaceMatchesImpl modulePath implId rest
      }
    }
  }.

  missingImplInterfaceFailures :: TypedCoreValidationPath -> [Text] -> [TypedStatement] -> [TypedClassInterface] -> [TypedImplInterface] -> [TypedCoreValidationFailure].
  missingImplInterfaceFailures = \(path, modulePath, statements, classes, impls) -> case statements {
    | [] -> []
    | [first | rest] -> case first {
      | TypedImplStatement declaration -> case declaration {
        | TypedImplDeclaration span implId methods -> listAppend
          (if classInterfaceMatchesImpl modulePath implId classes then
            if implInterfacePresent implId impls then [] else [failure path TypedModuleInterfaceMismatch (TypedImplDetail implId)]
          else [])
          (missingImplInterfaceFailures path modulePath rest classes impls)
      }
      | other -> missingImplInterfaceFailures path modulePath rest classes impls
    }
  }.

  valueExportPresent :: Text -> [TypedValueInterface] -> Bool.
  valueExportPresent = \(expected, interfaces) -> case interfaces {
    | [] -> False
    | [TypedValueInterface name scheme | rest] -> if coreNameIdentifierEqual expected name then True else valueExportPresent expected rest
  }.

  dataExportPresent :: Text -> [TypedDataInterface] -> Bool.
  dataExportPresent = \(expected, interfaces) -> case interfaces {
    | [] -> False
    | [TypedDataInterface declaration | rest] -> case declaration {
      | TypedDataDeclaration span name parameters constructors -> if coreNameIdentifierEqual expected name then True else dataExportPresent expected rest
    }
  }.

  classExportPresent :: Text -> [TypedClassInterface] -> Bool.
  classExportPresent = \(expected, interfaces) -> case interfaces {
    | [] -> False
    | [TypedClassInterface declaration | rest] -> case declaration {
      | TypedClassDeclaration span name parameters methods -> if coreNameIdentifierEqual expected name then True else classExportPresent expected rest
    }
  }.

  methodExportPresent :: Text -> [TypedMethodSignature] -> Bool.
  methodExportPresent = \(expected, methods) -> case methods {
    | [] -> False
    | [TypedMethodSignature name span scheme | rest] -> if coreNameIdentifierEqual expected name then True else methodExportPresent expected rest
  }.

  classMethodExportPresent :: Text -> [TypedClassInterface] -> Bool.
  classMethodExportPresent = \(expected, interfaces) -> case interfaces {
    | [] -> False
    | [TypedClassInterface declaration | rest] -> case declaration {
      | TypedClassDeclaration span name parameters methods -> if methodExportPresent expected methods then True else classMethodExportPresent expected rest
    }
  }.

  constructorExportPresentIn :: Text -> [TypedConstructorDeclaration] -> Bool.
  constructorExportPresentIn = \(expected, constructors) -> case constructors {
    | [] -> False
    | [TypedConstructorDeclaration binder name fields recipes | rest] -> if coreNameIdentifierEqual expected name then True else constructorExportPresentIn expected rest
  }.

  constructorExportPresent :: Text -> [TypedDataInterface] -> Bool.
  constructorExportPresent = \(expected, interfaces) -> case interfaces {
    | [] -> False
    | [TypedDataInterface declaration | rest] -> case declaration {
      | TypedDataDeclaration span name parameters constructors -> if constructorExportPresentIn expected constructors then True else constructorExportPresent expected rest
    }
  }.

  exportPresent :: TypedModuleExport -> TypedModuleInterface -> Bool.
  exportPresent = \(export, interface) -> case (export, interface) {
    | (TypedModuleExport namespace name, TypedModuleInterface values datas classes impls) -> case namespace {
      | TypedValueNamespace -> if valueExportPresent name values then True else classMethodExportPresent name classes
      | TypedTypeNamespace -> if dataExportPresent name datas then True else classExportPresent name classes
      | TypedConstructorNamespace -> constructorExportPresent name datas
      | TypedCapabilityNamespace -> classExportPresent name classes
    }
  }.

  validateExports :: TypedCoreValidationPath -> [TypedStatement] -> TypedModuleInterface -> [TypedModuleExport] -> [TypedCoreValidationFailure].
  validateExports = \(path, statements, interface, exports) -> case exports {
    | [] -> []
    | [export | rest] -> case export {
      | TypedModuleExport namespace name -> listAppend
        (if exportPresent export interface then
          if nameNamespaceEqual namespace TypedCapabilityNamespace then
            if localCapabilityDeclared name statements then [] else [failure path TypedModuleInterfaceMismatch (TypedNameDetail (TypedResolvedName TypedCurrentModule namespace name))]
          else []
        else [failure path TypedModuleInterfaceMismatch (TypedNameDetail (TypedResolvedName TypedCurrentModule namespace name))])
        (validateExports path statements interface rest)
    }
  }.

  validateModuleInterface :: [Text] -> [DataEntry] -> [TypedImplId] -> [NameEntry] -> TypedModuleInterface -> [TypedStatement] -> [TypedModuleExport] -> [TypedCoreValidationFailure].
  validateModuleInterface = \(modulePath, externalDataEntries, externalImpls, externalNames, interface, statements, exports) -> case interface {
    | TypedModuleInterface values datas classes impls -> {
      path = TypedInterfacePath modulePath.
      listConcat
        [ validateValueInterfaces path modulePath statements externalDataEntries externalNames exports datas classes values,
          validateDataInterfaces path statements datas datas,
          validateClassInterfaces path modulePath statements externalDataEntries externalNames datas classes classes,
          validateImplInterfaces path statements externalImpls impls,
          missingImplInterfaceFailures path modulePath statements classes impls,
          validateExports path statements interface exports
        ].
    }
  }.

  sourceSegmentsValid :: [Text] -> Bool.
  sourceSegmentsValid = \(segments) -> case segments {
    | [] -> True
    | [first | rest] -> if textIsEmpty first then False else if first == "." then False else if first == ".." then False else sourceSegmentsValid rest
  }.

  driveAbsolute :: Text -> Bool.
  driveAbsolute = \(sourcePath) -> case textToChars sourcePath {
    | [first | [':' | rest]] -> True
    | other -> False
  }.

  validRelativeSourcePath :: Text -> Bool.
  validRelativeSourcePath = \(sourcePath) -> if textIsEmpty sourcePath then False else
    if textStartsWith "/" sourcePath then False else
      if textContains "\\" sourcePath then False else if driveAbsolute sourcePath then False else sourceSegmentsValid (textSplit "/" sourcePath).

  validateSourcePath :: [Text] -> TypedSourcePath -> [TypedCoreValidationFailure].
  validateSourcePath = \(modulePath, sourcePathValue) -> case sourcePathValue {
    | TypedSourcePath sourcePath -> if validRelativeSourcePath sourcePath then [] else [failure (TypedModulePath modulePath) TypedInvalidSourcePath (TypedTextDetail sourcePath)]
  }.

  validModulePathSegments :: [Text] -> Bool.
  validModulePathSegments = \(segments) -> case segments {
    | [] -> True
    | [first | rest] ->
      if textIsEmpty first then False else
        if textContains "::" first then False else validModulePathSegments rest
  }.

  validateModulePath :: [Text] -> [TypedCoreValidationFailure].
  validateModulePath = \(modulePath) -> case modulePath {
    | [] -> [failure (TypedModulePath modulePath) TypedModuleInterfaceMismatch (TypedTextDetail (modulePathText modulePath))]
    | segments -> if validModulePathSegments segments then [] else [failure (TypedModulePath modulePath) TypedModuleInterfaceMismatch (TypedTextDetail (modulePathText modulePath))]
  }.

  resolvedImportPaths :: [TypedResolvedImport] -> [[Text]].
  resolvedImportPaths = \(imports) -> case imports {
    | [] -> []
    | [TypedResolvedImport span modulePath alias names | rest] -> listPrepend modulePath (resolvedImportPaths rest)
  }.

  typedModulePath :: TypedModule -> [Text].
  typedModulePath = \(moduleValue) -> case moduleValue {
    | TypedModule modulePath sourcePath imports exports interface statements info -> modulePath
  }.

  modulePaths :: [TypedModule] -> [[Text]].
  modulePaths = \(modules) -> case modules {
    | [] -> []
    | [first | rest] -> listPrepend (typedModulePath first) (modulePaths rest)
  }.

  allModules :: Maybe(TypedModule) -> [TypedModule] -> [TypedModule].
  allModules = \(prelude, modules) -> case prelude {
    | Nothing -> modules
    | Just preludeModule -> listPrepend preludeModule modules
  }.

  findModule :: [Text] -> [TypedModule] -> Maybe(TypedModule).
  findModule = \(modulePath, modules) -> case modules {
    | [] -> Nothing
    | [first | rest] -> if textListEqual modulePath (typedModulePath first) then Just first else findModule modulePath rest
  }.

  typedModuleImports :: TypedModule -> [TypedResolvedImport].
  typedModuleImports = \(moduleValue) -> case moduleValue {
    | TypedModule modulePath sourcePath imports exports interface statements info -> imports
  }.

  anyImportPathReaches :: [TypedModule] -> [[Text]] -> [TypedResolvedImport] -> [Text] -> Bool.
  anyImportPathReaches = \(completeModules, seen, imports, targetPath) -> case imports {
    | [] -> False
    | [TypedResolvedImport span importPath alias names | rest] ->
      if modulePathReachable completeModules seen importPath targetPath then
        True
      else
        anyImportPathReaches completeModules seen rest targetPath
  }.

  modulePathReachable :: [TypedModule] -> [[Text]] -> [Text] -> [Text] -> Bool.
  modulePathReachable = \(completeModules, seen, currentPath, targetPath) ->
    if textListEqual currentPath targetPath then
      True
    else if modulePathMember currentPath seen then
      False
    else case findModule currentPath completeModules {
      | Nothing -> False
      | Just moduleValue ->
        anyImportPathReaches completeModules (listPrepend currentPath seen) (typedModuleImports moduleValue) targetPath
    }.

  importCycleFailuresForImports :: [TypedModule] -> [Text] -> [TypedResolvedImport] -> [[Text]] -> [TypedCoreValidationFailure].
  importCycleFailuresForImports = \(completeModules, modulePath, imports, seenImports) -> case imports {
    | [] -> []
    | [TypedResolvedImport span importPath alias names | rest] ->
      if modulePathMember importPath seenImports then
        importCycleFailuresForImports completeModules modulePath rest seenImports
      else
        listAppend
          (if modulePathReachable completeModules [] importPath modulePath then
            [failure (TypedModulePath modulePath) TypedModuleInterfaceMismatch (TypedTextDetail (modulePathText importPath))]
          else
            [])
          (importCycleFailuresForImports completeModules modulePath rest (listPrepend importPath seenImports))
  }.

  importCycleFailuresFrom :: [TypedModule] -> [TypedModule] -> [TypedCoreValidationFailure].
  importCycleFailuresFrom = \(completeModules, remainingModules) -> case remainingModules {
    | [] -> []
    | [first | rest] -> listAppend
      (importCycleFailuresForImports completeModules (typedModulePath first) (typedModuleImports first) [])
      (importCycleFailuresFrom completeModules rest)
  }.

  importCycleFailures :: [TypedModule] -> [TypedCoreValidationFailure].
  importCycleFailures = \(completeModules) ->
    importCycleFailuresFrom completeModules completeModules.

  moduleOrderFailuresForImports :: [TypedModule] -> [[Text]] -> [Text] -> [TypedResolvedImport] -> [[Text]] -> [TypedCoreValidationFailure].
  moduleOrderFailuresForImports = \(completeModules, precedingPaths, modulePath, imports, seenImports) -> case imports {
    | [] -> []
    | [TypedResolvedImport span importPath alias names | rest] ->
      if modulePathMember importPath seenImports then
        moduleOrderFailuresForImports completeModules precedingPaths modulePath rest seenImports
      else
        listAppend
          (case findModule importPath completeModules {
            | Nothing -> []
            | Just importedModule ->
              if modulePathMember importPath precedingPaths then [] else
                if modulePathReachable completeModules [] importPath modulePath then [] else
                  [failure (TypedModulePath modulePath) TypedModuleInterfaceMismatch (TypedTextDetail (modulePathText importPath))]
          })
          (moduleOrderFailuresForImports completeModules precedingPaths modulePath rest (listPrepend importPath seenImports))
  }.

  moduleOrderFailuresFrom :: [TypedModule] -> [[Text]] -> [TypedModule] -> [TypedCoreValidationFailure].
  moduleOrderFailuresFrom = \(completeModules, precedingPaths, remainingModules) -> case remainingModules {
    | [] -> []
    | [first | rest] -> listAppend
      (moduleOrderFailuresForImports completeModules precedingPaths (typedModulePath first) (typedModuleImports first) [])
      (moduleOrderFailuresFrom completeModules (listPrepend (typedModulePath first) precedingPaths) rest)
  }.

  moduleOrderFailures :: [TypedModule] -> [TypedCoreValidationFailure].
  moduleOrderFailures = \(completeModules) ->
    moduleOrderFailuresFrom completeModules [] completeModules.

  selectedImportNamePresentInExports :: Text -> TypedModuleInterface -> [TypedModuleExport] -> Bool.
  selectedImportNamePresentInExports = \(selectedName, interface, exports) -> case exports {
    | [] -> False
    | [first | rest] -> case first {
      | TypedModuleExport namespace exportedName ->
        if selectedName == exportedName then
          if nameNamespaceEqual namespace TypedValueNamespace then if exportPresent first interface then True else selectedImportNamePresentInExports selectedName interface rest else
          if nameNamespaceEqual namespace TypedConstructorNamespace then if exportPresent first interface then True else selectedImportNamePresentInExports selectedName interface rest else
          if nameNamespaceEqual namespace TypedCapabilityNamespace then if exportPresent first interface then True else selectedImportNamePresentInExports selectedName interface rest else
          selectedImportNamePresentInExports selectedName interface rest
        else selectedImportNamePresentInExports selectedName interface rest
    }
  }.

  selectedImportNamePresent :: Text -> TypedModule -> Bool.
  selectedImportNamePresent = \(selectedName, moduleValue) -> case moduleValue {
    | TypedModule modulePath sourcePath imports exports interface statements info -> selectedImportNamePresentInExports selectedName interface exports
  }.

  validateSelectedImportNames :: [Text] -> TypedModule -> [Text] -> [TypedCoreValidationFailure].
  validateSelectedImportNames = \(currentModulePath, importedModule, selectedNames) -> case selectedNames {
    | [] -> []
    | [first | rest] -> listAppend
      (if selectedImportNamePresent first importedModule then [] else [failure (TypedModulePath currentModulePath) TypedModuleInterfaceMismatch (TypedTextDetail first)])
      (validateSelectedImportNames currentModulePath importedModule rest)
  }.

  validateResolvedImports :: [TypedModule] -> [Text] -> [TypedResolvedImport] -> [TypedCoreValidationFailure].
  validateResolvedImports = \(completeModules, currentModulePath, imports) -> case imports {
    | [] -> []
    | [TypedResolvedImport span importPath alias names | rest] -> listAppend
      (case findModule importPath completeModules {
        | Nothing -> [failure (TypedModulePath currentModulePath) TypedModuleInterfaceMismatch (TypedTextDetail (modulePathText importPath))]
        | Just moduleValue -> case names {
          | Nothing -> []
          | Just selectedNames -> validateSelectedImportNames currentModulePath moduleValue selectedNames
        }
      })
      (validateResolvedImports completeModules currentModulePath rest)
  }.

  selectedNameAllowed :: Maybe([Text]) -> TypedCoreName -> Bool.
  selectedNameAllowed = \(selectedNames, name) -> case selectedNames {
    | Nothing -> True
    | Just names -> case coreNameIdentifier name {
      | Nothing -> False
      | Just identifier -> listContains identifier names
    }
  }.

  importedVisibleModules :: [TypedResolvedImport] -> [TypedModule] -> [VisibleModule].
  importedVisibleModules = \(imports, completeModules) -> case imports {
    | [] -> []
    | [TypedResolvedImport span modulePath alias names | rest] -> case findModule modulePath completeModules {
      | Nothing -> importedVisibleModules rest completeModules
      | Just moduleValue -> listPrepend (VisibleModule names moduleValue) (importedVisibleModules rest completeModules)
    }
  }.

  visibleModulesFor :: Bool -> Maybe(TypedModule) -> [TypedResolvedImport] -> [TypedModule] -> [VisibleModule].
  visibleModulesFor = \(isPrelude, prelude, imports, completeModules) -> {
    imported = importedVisibleModules imports completeModules.
    if isPrelude then imported else case prelude {
      | Nothing -> imported
      | Just preludeModule -> listPrepend (VisibleModule Nothing preludeModule) imported
    }.
  }.

  valueInterfaceSchemeEntries :: Maybe([Text]) -> [TypedModuleExport] -> [TypedValueInterface] -> [SchemeEntry].
  valueInterfaceSchemeEntries = \(selectedNames, exports, values) -> case values {
    | [] -> []
    | [TypedValueInterface name scheme | rest] -> case scheme {
      | TypedScheme binder parameters evidence primitive resultType resultRecipe ->
        if selectedNameAllowed selectedNames name then if moduleExportsName TypedValueNamespace name exports then listPrepend (SchemeEntry binder scheme) (valueInterfaceSchemeEntries selectedNames exports rest) else valueInterfaceSchemeEntries selectedNames exports rest else valueInterfaceSchemeEntries selectedNames exports rest
    }
  }.

  selectedMethodSchemeEntries :: Maybe([Text]) -> [TypedModuleExport] -> [TypedTypeParameterId] -> [TypedMethodSignature] -> [SchemeEntry].
  selectedMethodSchemeEntries = \(selectedNames, exports, classParameters, methods) -> case methods {
    | [] -> []
    | [TypedMethodSignature name span scheme | rest] -> case scheme {
      | TypedScheme binder parameters evidence primitive resultType resultRecipe ->
        if selectedNameAllowed selectedNames name then if moduleExportsName TypedValueNamespace name exports then listPrepend (SchemeEntry binder (generalizeClassMethodScheme classParameters scheme)) (selectedMethodSchemeEntries selectedNames exports classParameters rest) else selectedMethodSchemeEntries selectedNames exports classParameters rest else selectedMethodSchemeEntries selectedNames exports classParameters rest
    }
  }.

  classInterfaceSchemeEntries :: Maybe([Text]) -> [TypedModuleExport] -> [TypedClassInterface] -> [SchemeEntry].
  classInterfaceSchemeEntries = \(selectedNames, exports, classes) -> case classes {
    | [] -> []
    | [TypedClassInterface declaration | rest] -> case declaration {
      | TypedClassDeclaration span name parameters methods -> listAppend (selectedMethodSchemeEntries selectedNames exports parameters methods) (classInterfaceSchemeEntries selectedNames exports rest)
    }
  }.

  interfaceSchemeEntries :: VisibleModule -> [SchemeEntry].
  interfaceSchemeEntries = \(visibleModule) -> case visibleModule {
    | VisibleModule selectedNames moduleValue -> case moduleValue {
      | TypedModule modulePath sourcePath imports exports interface statements info -> case interface {
        | TypedModuleInterface values datas classes impls -> listAppend (valueInterfaceSchemeEntries selectedNames exports values) (classInterfaceSchemeEntries selectedNames exports classes)
      }
    }
  }.

  visibleModuleSchemeEntries :: [VisibleModule] -> [SchemeEntry].
  visibleModuleSchemeEntries = \(modules) -> listConcat (listMap interfaceSchemeEntries modules).

  constructorInterfaceNameEntries :: [Text] -> Maybe([Text]) -> [TypedModuleExport] -> [TypedConstructorDeclaration] -> [NameEntry] -> [NameEntry].
  constructorInterfaceNameEntries = \(modulePath, selectedNames, exports, constructors, entries) -> case constructors {
    | [] -> entries
    | [TypedConstructorDeclaration binder name fields recipes | rest] -> constructorInterfaceNameEntries modulePath selectedNames exports rest (if selectedNameAllowed selectedNames name then if moduleExportsName TypedConstructorNamespace name exports then appendDefinitionNameEntry modulePath name entries else entries else entries)
  }.

  dataInterfaceNameEntries :: [Text] -> Maybe([Text]) -> [TypedModuleExport] -> [TypedDataInterface] -> [NameEntry] -> [NameEntry].
  dataInterfaceNameEntries = \(modulePath, selectedNames, exports, datas, entries) -> case datas {
    | [] -> entries
    | [TypedDataInterface declaration | rest] -> case declaration {
      | TypedDataDeclaration span name parameters constructors -> dataInterfaceNameEntries modulePath selectedNames exports rest
        (constructorInterfaceNameEntries modulePath selectedNames exports constructors (if selectedNameAllowed selectedNames name then if moduleExportsName TypedTypeNamespace name exports then appendDefinitionNameEntry modulePath name entries else entries else entries))
    }
  }.

  methodInterfaceNameEntries :: [Text] -> Maybe([Text]) -> [TypedModuleExport] -> [TypedMethodSignature] -> [NameEntry] -> [NameEntry].
  methodInterfaceNameEntries = \(modulePath, selectedNames, exports, methods, entries) -> case methods {
    | [] -> entries
    | [TypedMethodSignature name span scheme | rest] -> methodInterfaceNameEntries modulePath selectedNames exports rest (if selectedNameAllowed selectedNames name then if moduleExportsName TypedValueNamespace name exports then appendDefinitionNameEntry modulePath name entries else entries else entries)
  }.

  methodInterfaceImported :: Maybe([Text]) -> [TypedModuleExport] -> [TypedMethodSignature] -> Bool.
  methodInterfaceImported = \(selectedNames, exports, methods) -> case methods {
    | [] -> False
    | [TypedMethodSignature name span scheme | rest] -> if selectedNameAllowed selectedNames name then if moduleExportsName TypedValueNamespace name exports then True else methodInterfaceImported selectedNames exports rest else methodInterfaceImported selectedNames exports rest
  }.

  evidenceCapabilityIdentifiers :: [TypedEvidenceParameter] -> [Text].
  evidenceCapabilityIdentifiers = \(parameters) -> case parameters {
    | [] -> []
    | [TypedEvidenceParameter parameterId constraint | rest] -> case constraint {
      | TypedCapabilityConstraint capability method targetType -> listPrepend capability (evidenceCapabilityIdentifiers rest)
    }
  }.

  schemeEntryCapabilityIdentifiers :: [SchemeEntry] -> [Text].
  schemeEntryCapabilityIdentifiers = \(entries) -> case entries {
    | [] -> []
    | [SchemeEntry binder scheme | rest] -> case scheme {
      | TypedScheme owner parameters evidence primitive resultType resultRecipe -> listAppend (evidenceCapabilityIdentifiers evidence) (schemeEntryCapabilityIdentifiers rest)
    }
  }.

  interfaceCapabilityNameDirectlyIncluded :: Maybe([Text]) -> [TypedModuleExport] -> TypedCoreName -> Bool.
  interfaceCapabilityNameDirectlyIncluded = \(selectedNames, exports, name) ->
    if selectedNameAllowed selectedNames name then
      if moduleExportsName TypedCapabilityNamespace name exports then True else moduleExportsName TypedTypeNamespace name exports
    else False.

  interfaceCapabilityNameIncluded :: Maybe([Text]) -> [TypedModuleExport] -> TypedCoreName -> [TypedMethodSignature] -> Bool.
  interfaceCapabilityNameIncluded = \(selectedNames, exports, name, methods) -> {
    directlyImported = interfaceCapabilityNameDirectlyIncluded selectedNames exports name.
    if directlyImported then True else methodInterfaceImported selectedNames exports methods.
  }.

  interfaceCapabilityIncluded :: Maybe([Text]) -> [TypedModuleExport] -> [Text] -> TypedCoreName -> [TypedMethodSignature] -> Bool.
  interfaceCapabilityIncluded = \(selectedNames, exports, requiredCapabilities, name, methods) -> {
    required = case coreNameIdentifier name {
      | Nothing -> False
      | Just identifier -> listContains identifier requiredCapabilities
    }.
    if interfaceCapabilityNameIncluded selectedNames exports name methods then True else required.
  }.

  includedCapabilitySchemeEntries :: Maybe([Text]) -> [TypedModuleExport] -> [Text] -> [TypedClassInterface] -> [SchemeEntry].
  includedCapabilitySchemeEntries = \(selectedNames, exports, requiredCapabilities, classes) -> case classes {
    | [] -> []
    | [TypedClassInterface declaration | rest] -> case declaration {
      | TypedClassDeclaration span name parameters methods ->
        if interfaceCapabilityIncluded selectedNames exports requiredCapabilities name methods then
          listAppend (methodSchemeEntries parameters methods) (includedCapabilitySchemeEntries selectedNames exports requiredCapabilities rest)
        else includedCapabilitySchemeEntries selectedNames exports requiredCapabilities rest
    }
  }.

  classInterfaceNameEntries :: [Text] -> Maybe([Text]) -> [TypedModuleExport] -> [Text] -> [TypedClassInterface] -> [NameEntry] -> [NameEntry].
  classInterfaceNameEntries = \(modulePath, selectedNames, exports, requiredCapabilities, classes, entries) -> case classes {
    | [] -> entries
    | [TypedClassInterface declaration | rest] -> case declaration {
      | TypedClassDeclaration span name parameters methods -> classInterfaceNameEntries modulePath selectedNames exports requiredCapabilities rest
        (methodInterfaceNameEntries modulePath selectedNames exports methods (if interfaceCapabilityNameDirectlyIncluded selectedNames exports name then appendDefinitionNameEntry modulePath name entries else entries))
    }
  }.

  valueInterfaceNameEntries :: [Text] -> Maybe([Text]) -> [TypedModuleExport] -> [TypedValueInterface] -> [NameEntry] -> [NameEntry].
  valueInterfaceNameEntries = \(modulePath, selectedNames, exports, values, entries) -> case values {
    | [] -> entries
    | [TypedValueInterface name scheme | rest] -> valueInterfaceNameEntries modulePath selectedNames exports rest (if selectedNameAllowed selectedNames name then if moduleExportsName TypedValueNamespace name exports then appendDefinitionNameEntry modulePath name entries else entries else entries)
  }.

  interfaceNameEntries :: VisibleModule -> [NameEntry].
  interfaceNameEntries = \(visibleModule) -> case visibleModule {
    | VisibleModule selectedNames moduleValue -> case moduleValue {
      | TypedModule modulePath sourcePath imports exports interface statements info -> case interface {
        | TypedModuleInterface values datas classes impls -> {
          requiredCapabilities = schemeEntryCapabilityIdentifiers (interfaceSchemeEntries visibleModule).
          classInterfaceNameEntries modulePath selectedNames exports requiredCapabilities classes
            (dataInterfaceNameEntries modulePath selectedNames exports datas (valueInterfaceNameEntries modulePath selectedNames exports values [])).
        }
      }
    }
  }.

  visibleModuleNameEntries :: [VisibleModule] -> [NameEntry].
  visibleModuleNameEntries = \(modules) -> listConcat (listMap interfaceNameEntries modules).

  importCollisionIdentifier :: Bool -> NameEntry -> Maybe(Text).
  importCollisionIdentifier = \(typeBinding, entry) -> case entry {
    | NameEntry modulePath namespace identifier ->
      if typeBinding then
        if nameNamespaceEqual namespace TypedTypeNamespace then Just identifier else Nothing
      else
        if nameNamespaceEqual namespace TypedValueNamespace then Just identifier else
          if nameNamespaceEqual namespace TypedConstructorNamespace then Just identifier else
            if nameNamespaceEqual namespace TypedCapabilityNamespace then Just identifier else Nothing
    | GeneratedNameEntry kind -> Nothing
  }.

  uniqueImportCollisionIdentifiers :: Bool -> [NameEntry] -> [Text] -> [Text].
  uniqueImportCollisionIdentifiers = \(typeBinding, entries, identifiers) -> case entries {
    | [] -> identifiers
    | [first | rest] -> case importCollisionIdentifier typeBinding first {
      | Nothing -> uniqueImportCollisionIdentifiers typeBinding rest identifiers
      | Just identifier -> uniqueImportCollisionIdentifiers typeBinding rest (if listContains identifier identifiers then identifiers else listAppend identifiers [identifier])
    }
  }.

  lookupImportNameOrigin :: Text -> [ImportNameOrigin] -> Maybe([Text]).
  lookupImportNameOrigin = \(identifier, origins) -> case origins {
    | [] -> Nothing
    | [ImportNameOrigin candidate path | rest] -> if identifier == candidate then Just path else lookupImportNameOrigin identifier rest
  }.

  checkImportCollisionIdentifiers :: [Text] -> [Text] -> [Text] -> [ImportNameOrigin] -> ([ImportNameOrigin], [TypedCoreValidationFailure]).
  checkImportCollisionIdentifiers = \(currentModulePath, importPath, identifiers, origins) -> case identifiers {
    | [] -> (origins, [])
    | [identifier | rest] -> case lookupImportNameOrigin identifier origins {
      | Nothing -> checkImportCollisionIdentifiers currentModulePath importPath rest (listPrepend (ImportNameOrigin identifier importPath) origins)
      | Just originalPath -> case checkImportCollisionIdentifiers currentModulePath importPath rest origins {
        | (laterOrigins, laterFailures) ->
          ( laterOrigins,
            listAppend
              (if textListEqual originalPath importPath then [] else [failure (TypedModulePath currentModulePath) TypedDuplicateDeclaration (TypedTextDetail identifier)])
              laterFailures
          )
      }
    }
  }.

  importBindingCollisionFailuresFrom :: [TypedModule] -> [Text] -> [TypedResolvedImport] -> Bool -> [ImportNameOrigin] -> [TypedCoreValidationFailure].
  importBindingCollisionFailuresFrom = \(completeModules, currentModulePath, imports, typeBinding, origins) -> case imports {
    | [] -> []
    | [TypedResolvedImport span importPath alias names | rest] -> case alias {
      | Just aliasName -> importBindingCollisionFailuresFrom completeModules currentModulePath rest typeBinding origins
      | Nothing -> case findModule importPath completeModules {
        | Nothing -> importBindingCollisionFailuresFrom completeModules currentModulePath rest typeBinding origins
        | Just importedModule -> {
          identifiers = uniqueImportCollisionIdentifiers typeBinding (interfaceNameEntries (VisibleModule names importedModule)) [].
          case checkImportCollisionIdentifiers currentModulePath importPath identifiers origins {
            | (laterOrigins, currentFailures) -> listAppend currentFailures (importBindingCollisionFailuresFrom completeModules currentModulePath rest typeBinding laterOrigins)
          }.
        }
      }
    }
  }.

  importAliasCollisionFailuresFrom :: [Text] -> [TypedResolvedImport] -> [ImportNameOrigin] -> [TypedCoreValidationFailure].
  importAliasCollisionFailuresFrom = \(currentModulePath, imports, origins) -> case imports {
    | [] -> []
    | [TypedResolvedImport span importPath alias names | rest] -> case alias {
      | Nothing -> importAliasCollisionFailuresFrom currentModulePath rest origins
      | Just aliasName -> case lookupImportNameOrigin aliasName origins {
        | Nothing -> importAliasCollisionFailuresFrom currentModulePath rest (listPrepend (ImportNameOrigin aliasName importPath) origins)
        | Just originalPath -> listPrepend
          (failure (TypedModulePath currentModulePath) TypedDuplicateDeclaration (TypedTextDetail aliasName))
          (importAliasCollisionFailuresFrom currentModulePath rest origins)
      }
    }
  }.

  importBindingCollisionFailures :: [TypedModule] -> [Text] -> [TypedResolvedImport] -> [TypedCoreValidationFailure].
  importBindingCollisionFailures = \(completeModules, currentModulePath, imports) ->
    listConcat
      [ importAliasCollisionFailuresFrom currentModulePath imports [],
        importBindingCollisionFailuresFrom completeModules currentModulePath imports False [],
        importBindingCollisionFailuresFrom completeModules currentModulePath imports True []
      ].

  implImportAllowed :: Maybe([Text]) -> [TypedModuleExport] -> [Text] -> [TypedClassInterface] -> TypedImplId -> Bool.
  implImportAllowed = \(selectedNames, exports, requiredCapabilities, classes, implId) -> case (classes, implId) {
    | ([], other) -> False
    | ([TypedClassInterface declaration | rest], TypedImplId implPath capability targets) -> case declaration {
      | TypedClassDeclaration span name parameters methods ->
        if coreNameIdentifier name == coreNameIdentifier capability then
          interfaceCapabilityIncluded selectedNames exports requiredCapabilities name methods
        else implImportAllowed selectedNames exports requiredCapabilities rest implId
    }
  }.

  implDeclarationMethods :: TypedImplId -> [TypedStatement] -> Maybe([TypedMethodDefinition]).
  implDeclarationMethods = \(expectedImpl, statements) -> case statements {
    | [] -> Nothing
    | [first | rest] -> case first {
      | TypedImplStatement declaration -> case declaration {
        | TypedImplDeclaration span candidateImpl methods -> if implIdEqual expectedImpl candidateImpl then Just methods else implDeclarationMethods expectedImpl rest
      }
      | other -> implDeclarationMethods expectedImpl rest
    }
  }.

  interfaceImplIdsFrom :: [Text] -> Maybe([Text]) -> [TypedModuleExport] -> [Text] -> [TypedClassInterface] -> [TypedImplInterface] -> [TypedStatement] -> [TypedImplId].
  interfaceImplIdsFrom = \(modulePath, selectedNames, exports, requiredCapabilities, classes, impls, statements) -> case impls {
    | [] -> []
    | [TypedImplInterface implId | rest] ->
      if implImportAllowed selectedNames exports requiredCapabilities classes implId then
        listPrepend (qualifyExternalImplId modulePath implId) (interfaceImplIdsFrom modulePath selectedNames exports requiredCapabilities classes rest statements)
      else interfaceImplIdsFrom modulePath selectedNames exports requiredCapabilities classes rest statements
  }.

  interfaceImplIds :: VisibleModule -> [TypedImplId].
  interfaceImplIds = \(visibleModule) -> case visibleModule {
    | VisibleModule selectedNames moduleValue -> case moduleValue {
      | TypedModule modulePath sourcePath imports exports interface statements info -> case interface {
        | TypedModuleInterface values datas classes impls -> {
          requiredCapabilities = schemeEntryCapabilityIdentifiers (interfaceSchemeEntries visibleModule).
          interfaceImplIdsFrom modulePath selectedNames exports requiredCapabilities classes impls statements.
        }
      }
    }
  }.

  visibleModuleImplIds :: [VisibleModule] -> [TypedImplId].
  visibleModuleImplIds = \(modules) -> listConcat (listMap interfaceImplIds modules).

  appendDataEntry :: [Text] -> TypedCoreName -> [TypedTypeParameterId] -> [DataEntry] -> [DataEntry].
  appendDataEntry = \(modulePath, name, parameters, entries) -> case coreNameIdentifier name {
    | Nothing -> entries
    | Just identifier -> listAppend entries [DataEntry modulePath identifier (listLength parameters)]
  }.

  selectedConstructorAllowed :: Maybe([Text]) -> [TypedModuleExport] -> [TypedConstructorDeclaration] -> Bool.
  selectedConstructorAllowed = \(selectedNames, exports, constructors) -> case constructors {
    | [] -> False
    | [TypedConstructorDeclaration binder name fields recipes | rest] ->
      if selectedNameAllowed selectedNames name then if moduleExportsName TypedConstructorNamespace name exports then True else selectedConstructorAllowed selectedNames exports rest else selectedConstructorAllowed selectedNames exports rest
  }.

  typeDataNameEntries :: [Text] -> TypedType -> [NameEntry].
  typeDataNameEntries = \(modulePath, typeValue) -> case typeValue {
    | TypedListType elementType -> typeDataNameEntries modulePath elementType
    | TypedTupleType elementTypes -> listConcat (listMap (typeDataNameEntries modulePath) elementTypes)
    | TypedDataType name arguments -> case resolvedNameEntry modulePath name {
      | Nothing -> listConcat (listMap (typeDataNameEntries modulePath) arguments)
      | Just entry -> listPrepend entry (listConcat (listMap (typeDataNameEntries modulePath) arguments))
    }
    | TypedFunctionType argument result -> listAppend (typeDataNameEntries modulePath argument) (typeDataNameEntries modulePath result)
    | other -> []
  }.

  primitiveConstraintTypes :: [TypedPrimitiveConstraint] -> [TypedType].
  primitiveConstraintTypes = \(constraints) -> case constraints {
    | [] -> []
    | [first | rest] -> case first {
      | TypedNumericPrimitiveConstraint numericConstraint typeValue -> listPrepend typeValue (primitiveConstraintTypes rest)
      | TypedStrictEqualityPrimitiveConstraint typeValue -> listPrepend typeValue (primitiveConstraintTypes rest)
    }
  }.

  evidenceParameterTypes :: [TypedEvidenceParameter] -> [TypedType].
  evidenceParameterTypes = \(parameters) -> case parameters {
    | [] -> []
    | [TypedEvidenceParameter parameterId constraint | rest] -> case constraint {
      | TypedCapabilityConstraint capability method targetType -> listPrepend targetType (evidenceParameterTypes rest)
    }
  }.

  schemeDataNameEntries :: [Text] -> TypedScheme -> [NameEntry].
  schemeDataNameEntries = \(modulePath, scheme) -> case scheme {
    | TypedScheme owner parameters evidence primitive resultType resultRecipe -> listConcat
      (listMap (typeDataNameEntries modulePath) (listConcat [[resultType], evidenceParameterTypes evidence, primitiveConstraintTypes primitive]))
  }.

  schemeEntryDataNameEntries :: [Text] -> [SchemeEntry] -> [NameEntry].
  schemeEntryDataNameEntries = \(modulePath, entries) -> case entries {
    | [] -> []
    | [SchemeEntry binder scheme | rest] -> listAppend (schemeDataNameEntries modulePath scheme) (schemeEntryDataNameEntries modulePath rest)
  }.

  interfaceConstructorEntriesFrom :: [Text] -> Maybe([Text]) -> [TypedModuleExport] -> Text -> [TypedTypeParameterId] -> [TypedConstructorDeclaration] -> [DataEntry].
  interfaceConstructorEntriesFrom = \(modulePath, selectedNames, exports, dataIdentifier, parameters, constructors) -> case constructors {
    | [] -> []
    | [TypedConstructorDeclaration binder name fields recipes | rest] -> case coreNameIdentifier name {
      | Nothing -> interfaceConstructorEntriesFrom modulePath selectedNames exports dataIdentifier parameters rest
      | Just constructorIdentifier -> if selectedNameAllowed selectedNames name then if moduleExportsName TypedConstructorNamespace name exports then listPrepend
        (ConstructorEntry modulePath constructorIdentifier binder dataIdentifier parameters (listMap (\(field) -> qualifyExternalType modulePath field) fields))
        (interfaceConstructorEntriesFrom modulePath selectedNames exports dataIdentifier parameters rest)
      else interfaceConstructorEntriesFrom modulePath selectedNames exports dataIdentifier parameters rest else interfaceConstructorEntriesFrom modulePath selectedNames exports dataIdentifier parameters rest
    }
  }.

  selectedDataNameEntriesFrom :: [Text] -> Maybe([Text]) -> [TypedModuleExport] -> [TypedDataInterface] -> [NameEntry].
  selectedDataNameEntriesFrom = \(modulePath, selectedNames, exports, datas) -> case datas {
    | [] -> []
    | [TypedDataInterface declaration | rest] -> case declaration {
      | TypedDataDeclaration span name parameters constructors -> {
        includeData = if selectedNameAllowed selectedNames name then moduleExportsName TypedTypeNamespace name exports else selectedConstructorAllowed selectedNames exports constructors.
        case definitionNameEntry modulePath name {
          | Nothing -> selectedDataNameEntriesFrom modulePath selectedNames exports rest
          | Just entry -> if includeData then listPrepend entry (selectedDataNameEntriesFrom modulePath selectedNames exports rest) else selectedDataNameEntriesFrom modulePath selectedNames exports rest
        }.
      }
    }
  }.

  findDataMetadataInInterfaces :: [Text] -> Text -> [TypedDataInterface] -> Maybe(DataMetadataDeclaration).
  findDataMetadataInInterfaces = \(modulePath, expected, datas) -> case datas {
    | [] -> Nothing
    | [TypedDataInterface declaration | rest] -> case declaration {
      | TypedDataDeclaration span name parameters constructors ->
        if coreNameIdentifierEqual expected name then Just (DataMetadataDeclaration modulePath declaration) else findDataMetadataInInterfaces modulePath expected rest
    }
  }.

  findDataMetadataDeclaration :: NameEntry -> [TypedModule] -> Maybe(DataMetadataDeclaration).
  findDataMetadataDeclaration = \(expected, modules) -> case (expected, modules) {
    | (NameEntry expectedPath TypedTypeNamespace expectedIdentifier, []) -> Nothing
    | (NameEntry expectedPath TypedTypeNamespace expectedIdentifier, [TypedModule modulePath sourcePath imports exports interface statements info | rest]) ->
      if textListEqual expectedPath modulePath then case interface {
        | TypedModuleInterface values datas classes impls -> findDataMetadataInInterfaces modulePath expectedIdentifier datas
      } else findDataMetadataDeclaration expected rest
    | other -> Nothing
  }.

  dataDeclarationDependencies :: [Text] -> [TypedConstructorDeclaration] -> [NameEntry].
  dataDeclarationDependencies = \(modulePath, constructors) -> case constructors {
    | [] -> []
    | [TypedConstructorDeclaration binder name fields recipes | rest] ->
      listAppend
        (listConcat (listMap (typeDataNameEntries modulePath) fields))
        (dataDeclarationDependencies modulePath rest)
  }.

  dataMetadataEntriesFrom :: [TypedModule] -> [NameEntry] -> [NameEntry] -> [DataEntry].
  dataMetadataEntriesFrom = \(completeModules, pending, seen) -> case pending {
    | [] -> []
    | [first | rest] -> if nameEntryMember first seen then dataMetadataEntriesFrom completeModules rest seen else case findDataMetadataDeclaration first completeModules {
      | Nothing -> dataMetadataEntriesFrom completeModules rest (listPrepend first seen)
      | Just metadata -> case metadata {
        | DataMetadataDeclaration modulePath declaration -> case declaration {
          | TypedDataDeclaration span name parameters constructors -> case coreNameIdentifier name {
            | Nothing -> dataMetadataEntriesFrom completeModules rest (listPrepend first seen)
            | Just identifier -> {
              qualifiedConstructors = listMap
                (\(constructor) -> case constructor {
                  | TypedConstructorDeclaration binder constructorName fields recipes -> listMap (\(field) -> qualifyExternalType modulePath field) fields
                })
                constructors.
              dependencies = dataDeclarationDependencies modulePath constructors.
              listAppend
                [DataEntry modulePath identifier (listLength parameters), DataContractEntry modulePath identifier parameters qualifiedConstructors]
                (dataMetadataEntriesFrom completeModules (listAppend dependencies rest) (listPrepend first seen)).
            }
          }
        }
      }
    }
  }.

  interfaceConstructorEntries :: [Text] -> Maybe([Text]) -> [TypedModuleExport] -> [TypedDataInterface] -> [DataEntry].
  interfaceConstructorEntries = \(modulePath, selectedNames, exports, datas) -> case datas {
    | [] -> []
    | [TypedDataInterface declaration | rest] -> case declaration {
      | TypedDataDeclaration span name parameters constructors -> case coreNameIdentifier name {
        | Nothing -> interfaceConstructorEntries modulePath selectedNames exports rest
        | Just identifier -> listAppend
          (interfaceConstructorEntriesFrom modulePath selectedNames exports identifier parameters constructors)
          (interfaceConstructorEntries modulePath selectedNames exports rest)
      }
    }
  }.

  interfaceImplMethodEntriesFrom :: [Text] -> Maybe([Text]) -> [TypedModuleExport] -> [Text] -> [TypedClassInterface] -> [TypedImplInterface] -> [TypedStatement] -> [DataEntry].
  interfaceImplMethodEntriesFrom = \(modulePath, selectedNames, exports, requiredCapabilities, classes, impls, statements) -> case impls {
    | [] -> []
    | [TypedImplInterface implId | rest] -> case implDeclarationMethods implId statements {
      | Nothing -> interfaceImplMethodEntriesFrom modulePath selectedNames exports requiredCapabilities classes rest statements
      | Just methods -> if implImportAllowed selectedNames exports requiredCapabilities classes implId then
        listPrepend (ImplMethodEntry (qualifyExternalImplId modulePath implId) (methodDefinitionKeys methods)) (interfaceImplMethodEntriesFrom modulePath selectedNames exports requiredCapabilities classes rest statements)
      else interfaceImplMethodEntriesFrom modulePath selectedNames exports requiredCapabilities classes rest statements
    }
  }.

  interfaceCapabilityEntriesFrom :: [Text] -> Maybe([Text]) -> [TypedModuleExport] -> [Text] -> [TypedClassInterface] -> [DataEntry].
  interfaceCapabilityEntriesFrom = \(modulePath, selectedNames, exports, requiredCapabilities, classes) -> case classes {
    | [] -> []
    | [TypedClassInterface declaration | rest] -> case declaration {
      | TypedClassDeclaration span name parameters methods -> case resolvedNameEntry modulePath name {
        | Nothing -> interfaceCapabilityEntriesFrom modulePath selectedNames exports requiredCapabilities rest
        | Just entry -> case entry {
          | GeneratedNameEntry kind -> interfaceCapabilityEntriesFrom modulePath selectedNames exports requiredCapabilities rest
          | NameEntry capabilityPath namespace identifier -> {
            includeCapability = interfaceCapabilityIncluded selectedNames exports requiredCapabilities name methods.
            if includeCapability then
              listPrepend (CapabilityEntry capabilityPath identifier parameters (methodContractEntries methods)) (interfaceCapabilityEntriesFrom modulePath selectedNames exports requiredCapabilities rest)
            else interfaceCapabilityEntriesFrom modulePath selectedNames exports requiredCapabilities rest.
          }
        }
      }
    }
  }.

  interfaceDataEntries :: [TypedModule] -> VisibleModule -> [DataEntry].
  interfaceDataEntries = \(completeModules, visibleModule) -> case visibleModule {
    | VisibleModule selectedNames moduleValue -> case moduleValue {
      | TypedModule modulePath sourcePath imports exports interface statements info -> case interface {
        | TypedModuleInterface values datas classes impls -> {
          selectedSchemeEntries = interfaceSchemeEntries visibleModule.
          requiredCapabilities = schemeEntryCapabilityIdentifiers selectedSchemeEntries.
          capabilitySchemeEntries = includedCapabilitySchemeEntries selectedNames exports requiredCapabilities classes.
          capabilityEntries = interfaceCapabilityEntriesFrom modulePath selectedNames exports requiredCapabilities classes.
          dataRoots = listAppend
            (selectedDataNameEntriesFrom modulePath selectedNames exports datas)
            (schemeEntryDataNameEntries modulePath (listAppend selectedSchemeEntries capabilitySchemeEntries)).
          listConcat
            [ dataMetadataEntriesFrom completeModules dataRoots [],
              interfaceConstructorEntries modulePath selectedNames exports datas,
              capabilityEntries,
              evidenceCapabilityEntries selectedSchemeEntries (capabilityNameEntries capabilityEntries),
              interfaceImplMethodEntriesFrom modulePath selectedNames exports requiredCapabilities classes impls statements
            ].
        }
      }
    }
  }.

  visibleModuleDataEntries :: [TypedModule] -> [VisibleModule] -> [DataEntry].
  visibleModuleDataEntries = \(completeModules, modules) -> listConcat (listMap (interfaceDataEntries completeModules) modules).

  duplicateModuleFailuresFrom :: [TypedModule] -> [[Text]] -> [TypedCoreValidationFailure] -> [TypedCoreValidationFailure].
  duplicateModuleFailuresFrom = \(modules, seen, reversed) -> case modules {
    | [] -> listReverse reversed
    | [first | rest] -> {
      modulePath = typedModulePath first.
      if modulePathMember modulePath seen then
        duplicateModuleFailuresFrom rest seen (listPrepend (failure (TypedModulePath modulePath) TypedDuplicateModule (TypedTextDetail (modulePathText modulePath))) reversed)
      else duplicateModuleFailuresFrom rest (listPrepend modulePath seen) reversed.
    }
  }.

  typeArgumentEqual :: TypedTypeArgument -> TypedTypeArgument -> Bool.
  typeArgumentEqual = \(left, right) -> case (left, right) {
    | (TypedTypeArgument leftParameter leftType, TypedTypeArgument rightParameter rightType) ->
      if typeParameterIdEqual leftParameter rightParameter then typeEqual leftType rightType else False
  }.

  typeArgumentListEqual :: [TypedTypeArgument] -> [TypedTypeArgument] -> Bool.
  typeArgumentListEqual = \(left, right) -> case (left, right) {
    | ([], []) -> True
    | ([leftFirst | leftRest], [rightFirst | rightRest]) ->
      if typeArgumentEqual leftFirst rightFirst then typeArgumentListEqual leftRest rightRest else False
    | other -> False
  }.

  maybeSpanEqual :: Maybe(TypedSpan) -> Maybe(TypedSpan) -> Bool.
  maybeSpanEqual = \(left, right) -> case (left, right) {
    | (Nothing, Nothing) -> True
    | (Just leftSpan, Just rightSpan) -> spanEqual leftSpan rightSpan
    | other -> False
  }.

  instantiationEqual :: TypedInstantiation -> TypedInstantiation -> Bool.
  instantiationEqual = \(left, right) -> case (left, right) {
    | (TypedInstantiation leftOwner leftArguments leftSpan, TypedInstantiation rightOwner rightArguments rightSpan) ->
      if binderIdEqual leftOwner rightOwner then
        if typeArgumentListEqual leftArguments rightArguments then maybeSpanEqual leftSpan rightSpan else False
      else False
  }.

  instantiationListEqual :: [TypedInstantiation] -> [TypedInstantiation] -> Bool.
  instantiationListEqual = \(left, right) -> case (left, right) {
    | ([], []) -> True
    | ([leftFirst | leftRest], [rightFirst | rightRest]) ->
      if instantiationEqual leftFirst rightFirst then instantiationListEqual leftRest rightRest else False
    | other -> False
  }.

  maybeEvidenceParameterRefEqual :: Maybe(TypedEvidenceParameterRef) -> Maybe(TypedEvidenceParameterRef) -> Bool.
  maybeEvidenceParameterRefEqual = \(left, right) -> case (left, right) {
    | (Nothing, Nothing) -> True
    | (Just leftRef, Just rightRef) -> evidenceParameterRefEqual leftRef rightRef
    | other -> False
  }.

  maybeMethodIdEqual :: Maybe(TypedMethodId) -> Maybe(TypedMethodId) -> Bool.
  maybeMethodIdEqual = \(left, right) -> case (left, right) {
    | (Nothing, Nothing) -> True
    | (Just leftMethod, Just rightMethod) -> methodIdEqual leftMethod rightMethod
    | other -> False
  }.

  evidenceUseEqual :: TypedEvidenceUse -> TypedEvidenceUse -> Bool.
  evidenceUseEqual = \(left, right) -> case (left, right) {
    | (TypedEvidenceUse leftParameter leftConstraint leftImpl leftMethod, TypedEvidenceUse rightParameter rightConstraint rightImpl rightMethod) ->
      if maybeEvidenceParameterRefEqual leftParameter rightParameter then
        if capabilityConstraintEqual leftConstraint rightConstraint then
          if implIdEqual leftImpl rightImpl then maybeMethodIdEqual leftMethod rightMethod else False
        else False
      else False
  }.

  evidenceCandidateEqual :: TypedEvidenceCandidate -> TypedEvidenceCandidate -> Bool.
  evidenceCandidateEqual = \(left, right) -> case (left, right) {
    | (TypedEvidenceCandidate leftImpl leftMethod, TypedEvidenceCandidate rightImpl rightMethod) ->
      if implIdEqual leftImpl rightImpl then maybeMethodIdEqual leftMethod rightMethod else False
  }.

  evidenceCandidateListEqual :: [TypedEvidenceCandidate] -> [TypedEvidenceCandidate] -> Bool.
  evidenceCandidateListEqual = \(left, right) -> case (left, right) {
    | ([], []) -> True
    | ([leftFirst | leftRest], [rightFirst | rightRest]) ->
      if evidenceCandidateEqual leftFirst rightFirst then evidenceCandidateListEqual leftRest rightRest else False
    | other -> False
  }.

  evidenceSelectionEqual :: TypedEvidenceSelection -> TypedEvidenceSelection -> Bool.
  evidenceSelectionEqual = \(left, right) -> case (left, right) {
    | (TypedSelectedEvidence leftUse, TypedSelectedEvidence rightUse) -> evidenceUseEqual leftUse rightUse
    | (TypedEvidenceCandidates leftConstraint leftCandidates, TypedEvidenceCandidates rightConstraint rightCandidates) ->
      if capabilityConstraintEqual leftConstraint rightConstraint then evidenceCandidateListEqual leftCandidates rightCandidates else False
    | other -> False
  }.

  evidenceSelectionListEqual :: [TypedEvidenceSelection] -> [TypedEvidenceSelection] -> Bool.
  evidenceSelectionListEqual = \(left, right) -> case (left, right) {
    | ([], []) -> True
    | ([leftFirst | leftRest], [rightFirst | rightRest]) ->
      if evidenceSelectionEqual leftFirst rightFirst then evidenceSelectionListEqual leftRest rightRest else False
    | other -> False
  }.

  nodeInfoContractEqual :: TypedNodeInfo -> TypedNodeInfo -> Bool.
  nodeInfoContractEqual = \(left, right) -> if typeEqual (nodeType left) (nodeType right) then recipeEqual (nodeRecipe left) (nodeRecipe right) else False.

  nodeInfoEqual :: TypedNodeInfo -> TypedNodeInfo -> Bool.
  nodeInfoEqual = \(left, right) -> case (left, right) {
    | (TypedNodeInfo leftType leftRecipe leftInstantiations leftEvidence, TypedNodeInfo rightType rightRecipe rightInstantiations rightEvidence) ->
      if typeEqual leftType rightType then
        if recipeEqual leftRecipe rightRecipe then
          if instantiationListEqual leftInstantiations rightInstantiations then evidenceSelectionListEqual leftEvidence rightEvidence else False
        else False
      else False
  }.

  validateModuleInfo :: ModuleContext -> TypedCoreValidationPath -> [TypedStatement] -> TypedNodeInfo -> [TypedCoreValidationFailure].
  validateModuleInfo = \(context, path, statements, moduleInfo) -> case terminalExpressionInfo statements {
    | Just terminalInfo -> if nodeInfoEqual moduleInfo terminalInfo then [] else validateNodeInfo context path [] False Nothing Nothing moduleInfo
    | Nothing -> validateNodeInfo context path [] False Nothing Nothing moduleInfo
  }.

  moduleInfoNoResultContract :: TypedNodeInfo -> Bool.
  moduleInfoNoResultContract = \(info) -> case info {
    | TypedNodeInfo typeValue recipe instantiations evidence ->
      if typeEqual typeValue (TypedTupleType []) then
        if recipeEqual recipe TypedUnitRecipe then
          if listLength instantiations == 0 then listLength evidence == 0 else False
        else False
      else False
  }.

  validateModuleResult :: Bool -> [Text] -> [TypedStatement] -> TypedNodeInfo -> [TypedCoreValidationFailure].
  validateModuleResult = \(compareMetadata, modulePath, statements, moduleInfo) -> case terminalExpressionInfo statements {
    | Nothing -> if moduleInfoNoResultContract moduleInfo then [] else [failure (TypedModulePath modulePath) TypedModuleResultMismatch TypedNoValidationDetail]
    | Just terminalInfo -> if nodeInfoIntrinsicValid moduleInfo then if nodeInfoIntrinsicValid terminalInfo then
      if nodeInfoEqual moduleInfo terminalInfo then [] else
        if typeEqual (nodeType moduleInfo) (nodeType terminalInfo) then
          if recipeEqual (nodeRecipe moduleInfo) (nodeRecipe terminalInfo) then
            if compareMetadata then [failure (TypedModulePath modulePath) TypedModuleResultMismatch TypedNoValidationDetail] else []
          else [failure (TypedModulePath modulePath) TypedModuleResultMismatch (TypedRecipeDetail (nodeRecipe moduleInfo) (nodeRecipe terminalInfo))]
        else [failure (TypedModulePath modulePath) TypedModuleResultMismatch (TypedTypeDetail (nodeType moduleInfo) (nodeType terminalInfo))]
    else [] else []
  }.

  moduleMetadataStatements :: [TypedStatement] -> [TypedStatement].
  moduleMetadataStatements = \(statements) -> case statements {
    | [] -> []
    | [first | rest] ->
      if isModuleMetadataStatement first then listPrepend first (moduleMetadataStatements rest) else moduleMetadataStatements rest
  }.

  validateModule :: [TypedModule] -> Maybe(TypedModule) -> Bool -> TypedModule -> [TypedCoreValidationFailure].
  validateModule = \(completeModules, prelude, isPrelude, moduleValue) -> case moduleValue {
    | TypedModule modulePath sourcePath imports exports interface statements moduleInfo -> {
      externalModules = visibleModulesFor isPrelude prelude imports completeModules.
      visibleModules = listAppend [modulePath, ["Prelude"]] (resolvedImportPaths imports).
      schemes = visibleModuleSchemeEntries externalModules.
      externalNames = visibleModuleNameEntries externalModules.
      visibleNames = externalNames.
      visibleImpls = visibleModuleImplIds externalModules.
      dataEntries = visibleModuleDataEntries completeModules externalModules.
      externalContext = ModuleContext modulePath visibleModules schemes (statementIndexEntries statements) visibleNames visibleImpls dataEntries [].
      baseContext = withBlockDeclarations (moduleMetadataStatements statements) externalContext.
      context = withBlockDeclarations statements externalContext.
      moduleValidationPath = if isPrelude then TypedPreludePath else TypedModulePath modulePath.
      statementFailures = validateModuleStatementsInOrder baseContext statements.
      moduleInfoFailures = validateModuleInfo context moduleValidationPath statements moduleInfo.
      listConcat
        [ validateModulePath modulePath,
          validateSourcePath modulePath sourcePath,
          validateResolvedImports completeModules modulePath imports,
          importBindingCollisionFailures completeModules modulePath imports,
          validateModuleInterface modulePath dataEntries visibleImpls externalNames interface statements exports,
          duplicateModuleDeclarationFailures context statements,
          duplicateModuleBinderFailures context statements,
          statementFailures,
          moduleInfoFailures,
          validateModuleResult (if listLength statementFailures == 0 then listLength moduleInfoFailures == 0 else False) modulePath statements moduleInfo
        ].
    }
  }.

  validateModules :: [TypedModule] -> Maybe(TypedModule) -> [TypedModule] -> [TypedCoreValidationFailure].
  validateModules = \(completeModules, prelude, modules) -> case modules {
    | [] -> []
    | [first | rest] -> listAppend (validateModule completeModules prelude False first) (validateModules completeModules prelude rest)
  }.

  validatePrelude :: [TypedModule] -> Maybe(TypedModule) -> [TypedCoreValidationFailure].
  validatePrelude = \(completeModules, prelude) -> case prelude {
    | Nothing -> []
    | Just preludeModule -> validateModule completeModules prelude True preludeModule
  }.

  validatePreludePath :: Maybe(TypedModule) -> [TypedCoreValidationFailure].
  validatePreludePath = \(prelude) -> case prelude {
    | Nothing -> []
    | Just preludeModule -> {
      preludePath = typedModulePath preludeModule.
      if textListEqual preludePath ["Prelude"] then [] else [failure TypedPreludePath TypedModuleInterfaceMismatch (TypedTextDetail (modulePathText preludePath))].
    }
  }.

  regularPreludePathFailures :: [TypedModule] -> [TypedCoreValidationFailure].
  regularPreludePathFailures = \(modules) -> case modules {
    | [] -> []
    | [first | rest] ->
      if textListEqual (typedModulePath first) ["Prelude"] then
        [failure (TypedModulePath ["Prelude"]) TypedModuleInterfaceMismatch (TypedTextDetail "Prelude")]
      else regularPreludePathFailures rest
  }.

  validateProgram :: TypedProgram -> [TypedCoreValidationFailure].
  validateProgram = \(program) -> case program {
    | TypedProgram prelude modules entryModule -> {
      completeModules = allModules prelude modules.
      paths = modulePaths completeModules.
      listConcat
        [ duplicateModuleFailuresFrom completeModules [] [],
          importCycleFailures completeModules,
          moduleOrderFailures completeModules,
          validatePreludePath prelude,
          regularPreludePathFailures modules,
          if modulePathMember entryModule paths then [] else [failure TypedProgramPath TypedUnknownEntryModule (TypedTextDetail (modulePathText entryModule))],
          validatePrelude completeModules prelude,
          validateModules completeModules prelude modules
        ].
    }
  }.
}
