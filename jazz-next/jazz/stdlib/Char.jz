module Char (
  value charToUInt32,
  value charFromUInt32,
  value charIsAlpha,
  value charIsAlphaNum,
  value charIsDigit,
  value charIsSpace,
  value charIsHexDigit,
  value charIsLower,
  value charIsUpper,
  value charToLower,
  value charToUpper,
  value charIsNewline
) {
  import Maybe.

  charToUInt32 :: Char -> UInt32.
  charToUInt32 = __kernel_charToUInt32.

  charFromUInt32 :: UInt32 -> Maybe(Char).
  charFromUInt32 = \(scalar) -> case __kernel_charFromUInt32Raw scalar {
    | [] -> Nothing
    | [item] -> Just item
  }.

  charIsAlpha :: Char -> Bool.
  charIsAlpha = __kernel_charIsAlpha.

  charIsAlphaNum :: Char -> Bool.
  charIsAlphaNum = __kernel_charIsAlphaNum.

  charIsDigit :: Char -> Bool.
  charIsDigit = __kernel_charIsDigit.

  charIsSpace :: Char -> Bool.
  charIsSpace = __kernel_charIsSpace.

  charIsHexDigit :: Char -> Bool.
  charIsHexDigit = __kernel_charIsHexDigit.

  charIsLower :: Char -> Bool.
  charIsLower = __kernel_charIsLower.

  charIsUpper :: Char -> Bool.
  charIsUpper = __kernel_charIsUpper.

  charToLower :: Char -> Char.
  charToLower = __kernel_charToLower.

  charToUpper :: Char -> Char.
  charToUpper = __kernel_charToUpper.

  charIsNewline :: Char -> Bool.
  charIsNewline = \(item) -> if item == '\n' then True else item == '\r'.
}
