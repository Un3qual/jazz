module IOError (
  type IOErrorCategory,
  constructor NotFound,
  constructor PermissionDenied,
  constructor AlreadyExists,
  constructor InvalidData,
  constructor ResourceExhausted,
  constructor Interrupted,
  constructor Unsupported,
  constructor Other,
  type IOError,
  constructor IOError
) {
  import Maybe.

  data IOErrorCategory = NotFound | PermissionDenied | AlreadyExists | InvalidData | ResourceExhausted | Interrupted | Unsupported | Other.

  data IOError = IOError IOErrorCategory Maybe(Text) Text.
}
