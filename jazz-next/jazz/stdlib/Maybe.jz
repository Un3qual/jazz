module Maybe (
  type Maybe(..),
  value maybeMap,
  value maybeAndThen,
  value maybeWithDefault,
  value maybeOrElse,
  value maybeFilter,
  value maybeIsJust,
  value maybeIsNothing,
  value maybeToList,
  value maybeFromList
) {
  data Maybe a = Nothing | Just a.

  maybeMap :: (a -> b) -> Maybe(a) -> Maybe(b).
  maybeMap _ Nothing = Nothing.
  maybeMap transform (Just item) = Just (transform item).

  maybeAndThen :: (a -> Maybe(b)) -> Maybe(a) -> Maybe(b).
  maybeAndThen _ Nothing = Nothing.
  maybeAndThen transform (Just item) = transform item.

  maybeWithDefault :: a -> Maybe(a) -> a.
  maybeWithDefault defaultValue Nothing = defaultValue.
  maybeWithDefault _ (Just item) = item.

  maybeOrElse :: Maybe(a) -> Maybe(a) -> Maybe(a).
  maybeOrElse fallback Nothing = fallback.
  maybeOrElse _ (Just item) = Just item.

  maybeFilter :: (a -> Bool) -> Maybe(a) -> Maybe(a).
  maybeFilter _ Nothing = Nothing.
  maybeFilter predicate (Just item) =
    if predicate item then Just item else Nothing.

  maybeIsJust :: Maybe(a) -> Bool.
  maybeIsJust Nothing = False.
  maybeIsJust (Just _) = True.

  maybeIsNothing :: Maybe(a) -> Bool.
  maybeIsNothing Nothing = True.
  maybeIsNothing (Just _) = False.

  maybeToList :: Maybe(a) -> [a].
  maybeToList Nothing = [].
  maybeToList (Just item) = [item].

  maybeFromList :: [a] -> Maybe(a).
  maybeFromList [] = Nothing.
  maybeFromList [first | _] = Just first.
}
