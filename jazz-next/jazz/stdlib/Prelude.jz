data Ordering = LT | EQ | GT.

class Eq(a) {
equals :: a -> a -> Bool.
}.
class Ord(a) {
compare :: a -> a -> Ordering.
}.
class Num(a) { }.
class Integral(a) { }.
class Fractional(a) { }.
class Showable(a) {
show :: a -> Text.
}.
class Default(a) {
defaultValue :: a.
}.

__prelude_compareText :: Text -> Text -> Ordering.
__prelude_compareText = \(left, right) -> case __kernel_textUnconsRaw left {
| [] -> case __kernel_textUnconsRaw right {
  | [] -> EQ
  | [(rightFirst, rightRest)] -> LT
  }
| [(leftFirst, leftRest)] -> case __kernel_textUnconsRaw right {
  | [] -> GT
  | [(rightFirst, rightRest)] -> if __kernel_charToUInt32 leftFirst < __kernel_charToUInt32 rightFirst then LT else if __kernel_charToUInt32 leftFirst > __kernel_charToUInt32 rightFirst then GT else __prelude_compareText leftRest rightRest
  }
}.

impl Eq(Int) {
equals = \(left, right) -> left == right.
}.
impl Eq(Float) {
equals = \(left, right) -> left == right.
}.
impl Eq(Bool) {
equals = \(left, right) -> left == right.
}.
impl Eq(Char) {
equals = \(left, right) -> left == right.
}.
impl Eq(Text) {
equals = \(left, right) -> left == right.
}.
impl Ord(Int) {
compare = \(left, right) -> if left < right then LT else if left > right then GT else EQ.
}.
impl Ord(Float) {
compare = \(left, right) -> if left < right then LT else if left > right then GT else EQ.
}.
impl Ord(Char) {
compare = \(left, right) -> if __kernel_charToUInt32 left < __kernel_charToUInt32 right then LT else if __kernel_charToUInt32 left > __kernel_charToUInt32 right then GT else EQ.
}.
impl Ord(Text) {
compare = __prelude_compareText.
}.
impl Num(Int) { }.
impl Num(Float) { }.
impl Integral(Int) { }.
impl Fractional(Float) { }.
impl Default(Int) {
defaultValue = 0.
}.
impl Default(Float) {
defaultValue = 0.0.
}.
impl Default(Bool) {
defaultValue = False.
}.
impl Default(Char) {
defaultValue = '\0'.
}.
impl Default(Text) {
defaultValue = "".
}.
