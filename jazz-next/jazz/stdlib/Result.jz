module Result (
  type Result(..),
  value resultMap,
  value resultMapError,
  value resultAndThen,
  value resultRecover,
  value resultWithDefault,
  value resultIsOk,
  value resultIsErr,
  value resultToMaybe,
  value resultErrorToMaybe,
  value resultFromMaybe
) {
  import Maybe.

  data Result e a = Err e | Ok a.

  resultMap :: (a -> b) -> Result(e, a) -> Result(e, b).
  resultMap _ (Err error) = Err error.
  resultMap transform (Ok item) = Ok (transform item).

  resultMapError :: (e -> f) -> Result(e, a) -> Result(f, a).
  resultMapError transform (Err error) = Err (transform error).
  resultMapError _ (Ok item) = Ok item.

  resultAndThen :: (a -> Result(e, b)) -> Result(e, a) -> Result(e, b).
  resultAndThen _ (Err error) = Err error.
  resultAndThen transform (Ok item) = transform item.

  resultRecover :: (e -> Result(f, a)) -> Result(e, a) -> Result(f, a).
  resultRecover recover (Err error) = recover error.
  resultRecover _ (Ok item) = Ok item.

  resultWithDefault :: a -> Result(e, a) -> a.
  resultWithDefault defaultValue (Err _) = defaultValue.
  resultWithDefault _ (Ok item) = item.

  resultIsOk :: Result(e, a) -> Bool.
  resultIsOk (Err _) = False.
  resultIsOk (Ok _) = True.

  resultIsErr :: Result(e, a) -> Bool.
  resultIsErr (Err _) = True.
  resultIsErr (Ok _) = False.

  resultToMaybe :: Result(e, a) -> Maybe(a).
  resultToMaybe (Err _) = Nothing.
  resultToMaybe (Ok item) = Just item.

  resultErrorToMaybe :: Result(e, a) -> Maybe(e).
  resultErrorToMaybe (Err error) = Just error.
  resultErrorToMaybe (Ok _) = Nothing.

  resultFromMaybe :: e -> Maybe(a) -> Result(e, a).
  resultFromMaybe error Nothing = Err error.
  resultFromMaybe _ (Just item) = Ok item.
}
