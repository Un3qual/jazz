module Expression {
  import List.

  data Expression
    = Literal Int
    | Add Expression Expression
    | Multiply Expression Expression
    | Negate Expression
    | Variable Text
    | Let Text Expression Expression.

  data EvaluationResult = Evaluated Int | UnknownVariable Text.

  lookupVariable :: Text -> [(Text, Int)] -> EvaluationResult.
  lookupVariable = \(name, environment) -> case environment {
    | [] -> UnknownVariable name
    | [(candidate, item) | rest] -> if candidate == name then Evaluated item else lookupVariable name rest
  }.

  evaluateBinary :: (Int -> Int -> Int) -> [(Text, Int)] -> Expression -> Expression -> EvaluationResult.
  evaluateBinary = \(combine, environment, left, right) -> case evaluate environment left {
    | UnknownVariable name -> UnknownVariable name
    | Evaluated leftValue -> case evaluate environment right {
      | UnknownVariable name -> UnknownVariable name
      | Evaluated rightValue -> Evaluated (combine leftValue rightValue)
    }
  }.

  evaluate :: [(Text, Int)] -> Expression -> EvaluationResult.
  evaluate = \(environment, expression) -> case expression {
    | Literal item -> Evaluated item
    | Add left right -> evaluateBinary (\(leftValue, rightValue) -> leftValue + rightValue) environment left right
    | Multiply left right -> evaluateBinary (\(leftValue, rightValue) -> leftValue * rightValue) environment left right
    | Negate item -> case evaluate environment item {
      | UnknownVariable name -> UnknownVariable name
      | Evaluated result -> Evaluated (0 - result)
    }
    | Variable name -> lookupVariable name environment
    | Let name item body -> case evaluate environment item {
      | UnknownVariable missing -> UnknownVariable missing
      | Evaluated result -> evaluate (listPrepend (name, result) environment) body
    }
  }.
}
