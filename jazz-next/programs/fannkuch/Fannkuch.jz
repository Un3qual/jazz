module Fannkuch (value maximumFlips) {
  import List.

  integerRangeFrom =
    \(current, upper) ->
      if current > upper then
        []
      else
        listPrepend current $ integerRangeFrom (current + 1) upper.

  insertionsFrom =
    \(item, reversedPrefix, remainingItems) ->
      case remainingItems {
        | [] ->
          [listAppend (listReverse reversedPrefix) [item]]
        | remaining@[first | rest] ->
          listPrepend
            (listAppend (listReverse reversedPrefix) (listPrepend item remaining)) $
            insertionsFrom item (listPrepend first reversedPrefix) rest
      }.

  insertEverywhere =
    \(item, items) ->
      insertionsFrom item [] items.

  permutations =
    \(items) ->
      case items {
        | [] -> [[]]
        | [first | rest] ->
          listConcat $ listMap (insertEverywhere first) $ permutations rest
      }.

  reversePrefix =
    \(count, items) ->
      listAppend (listReverse (listTake count items)) (listDrop count items).

  flipCountFrom =
    \(permutation, count) ->
      case permutation {
        | [1 | _] -> count
        | permutationValue@[first | _] ->
          flipCountFrom (reversePrefix first permutationValue) (count + 1)
      }.

  flipCount =
    \(permutation) ->
      flipCountFrom permutation 0.

  maximumFrom =
    \(current, items) ->
      case items {
        | [] -> current
        | [item | rest] ->
          maximumFrom (if item > current then item else current) rest
      }.

  maximumFlips =
    \(size) ->
      maximumFrom 0 $
        listMap flipCount $ permutations $ integerRangeFrom 1 size.
}
