module Fannkuch (value maximumFlips) {
  import List.

  integerRangeFrom current upper =
    if current > upper then
      []
    else
      listPrepend current $ integerRangeFrom (current + 1) upper.

  insertionsFrom item reversedPrefix [] =
    [listAppend (listReverse reversedPrefix) [item]].
  insertionsFrom item reversedPrefix remaining@[first | rest] =
    listPrepend
      (listAppend (listReverse reversedPrefix) (listPrepend item remaining)) $
      insertionsFrom item (listPrepend first reversedPrefix) rest.

  insertEverywhere item items = insertionsFrom item [] items.

  permutations [] = [[]].
  permutations [first | rest] =
    listConcat $ listMap (insertEverywhere first) $ permutations rest.

  reversePrefix count items =
    listAppend (listReverse (listTake count items)) (listDrop count items).

  flipCountFrom [1 | _] count = count.
  flipCountFrom permutation@[first | _] count =
    flipCountFrom (reversePrefix first permutation) (count + 1).

  flipCount permutation = flipCountFrom permutation 0.

  maximumFrom current [] = current.
  maximumFrom current [item | rest] =
    maximumFrom (if item > current then item else current) rest.

  maximumFlips size =
    maximumFrom 0 $
      listMap flipCount $ permutations $ integerRangeFrom 1 size.
}
