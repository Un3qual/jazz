module Evaluation {
  import List.
  import Syntax.

  data EvaluationResult = Evaluated Int | UnboundName Text.

  lookupName :: Text -> [(Text, Int)] -> EvaluationResult.
  lookupName = \(name, environment) -> case environment {
    | [] -> UnboundName name
    | [(candidate, item) | rest] -> if candidate == name then Evaluated item else lookupName name rest
  }.

  evaluate :: [(Text, Int)] -> Expression(Int) -> EvaluationResult.
  evaluate = \(environment, expression) -> case expression {
    | Literal item -> Evaluated item
    | Add left right -> case evaluate environment left {
      | UnboundName name -> UnboundName name
      | Evaluated leftValue -> case evaluate environment right {
        | UnboundName name -> UnboundName name
        | Evaluated rightValue -> Evaluated (leftValue + rightValue)
      }
    }
    | Reference name -> lookupName name environment
    | LetExpression name item body -> case evaluate environment item {
      | UnboundName missing -> UnboundName missing
      | Evaluated result -> evaluate (listPrepend (name, result) environment) body
    }
  }.
}
