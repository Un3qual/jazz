module Sieve (value primeSummary) {
  import List.

  integerRangeFrom =
    \(current, upper) ->
      if current > upper then
        []
      else
        listPrepend current $ integerRangeFrom (current + 1) upper.

  remainder =
    \(number, divisor) ->
      if number < divisor then number else remainder (number - divisor) divisor.

  sieve =
    \(items) ->
      case items {
        | [] -> []
        | [prime | rest] ->
          listPrepend prime $
            sieve $ listFilter (\(candidate) -> remainder candidate prime != 0) rest
      }.

  lastItem =
    \(items) ->
      case items {
        | [item] -> item
        | [_ | rest] -> lastItem rest
      }.

  sumItems = listFoldLeft (+) 0.

  primeSummary =
    case sieve (integerRangeFrom 2 2000) {
      | primes -> (listLength primes, lastItem primes, sumItems primes)
    }.
}
