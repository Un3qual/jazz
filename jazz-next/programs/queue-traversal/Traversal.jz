module Traversal (value breadthFirst) {
  import List.
  import Maybe.
  import Queue.

  breadthFirstFrom = \(pending, reversedVisited) -> case queueDequeue pending {
    | Nothing -> listReverse reversedVisited
    | Just (item, remaining) -> if item >= 8
      then breadthFirstFrom remaining (listPrepend item reversedVisited)
      else breadthFirstFrom
        (queueEnqueueAll remaining [item * 2, item * 2 + 1])
        (listPrepend item reversedVisited)
  }.

  breadthFirst = \(root) -> breadthFirstFrom (queueSingleton root) [].
}
