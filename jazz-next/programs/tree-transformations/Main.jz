module Main {
  import Tree.

  sourceTree :: Tree(Int).
  sourceTree = buildTree 7 1.

  mappedTree :: Tree(Int).
  mappedTree = mapTree (\(value) -> value + 1) sourceTree.

  leafCount :: Int.
  leafCount = foldTree (\(value) -> 1) (\(left, right) -> left + right) mappedTree.

  total :: Int.
  total = foldTree (\(value) -> value) (\(left, right) -> left + right) mappedTree.

  (leafCount, total).
}
