module List (value listPrepend, value listReverse, value listLength) {
  listPrepend :: a -> [a] -> [a].
  listPrepend = __kernel_listPrependRaw.

  listReverseInto :: [a] -> [a] -> [a].
  listReverseInto = \(items) -> \(reversed) -> case items {
    | [] -> reversed
    | [first | rest] -> listReverseInto rest (listPrepend first reversed)
  }.

  listReverse :: [a] -> [a].
  listReverse = \(items) -> listReverseInto items [].

  listLengthFrom :: [a] -> Int -> Int.
  listLengthFrom = \(items) -> \(length) -> case items {
    | [] -> length
    | [_ | rest] -> listLengthFrom rest (length + 1)
  }.

  listLength :: [a] -> Int.
  listLength = \(items) -> listLengthFrom items 0.
}
