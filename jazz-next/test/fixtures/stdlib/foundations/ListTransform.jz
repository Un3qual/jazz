module Stdlib::Foundations::ListTransform {
  import List.
  import Maybe.
  values = [1, 2, 3].
  pairs = [(1, "a"), (2, "b")].
  (listAppend [1, 2] [3, 4], listConcat [[1, 2], [], [3, 4]],
   listRepeat 3 1, listIntersperse 0 values, listIntercalate [0] [[1, 2], [3, 4]],
   listMap (\(item) -> item * 2) values,
   listFilter (\(item) -> item > 1) values,
   listFilterMap (\(item) -> if item == 2 then Nothing else Just (item * 10)) values,
   listPartition (\(item) -> item == 2) values,
   listFoldLeft (\(total, item) -> total + item) 4 values,
   listFoldRight (\(item, total) -> item + total) 4 values,
   listScanLeft (\(total, item) -> total + item) 0 values,
   listAny (\(item) -> item == 2) values,
   listAll (\(item) -> item > 0) values,
   listContains 2 values, listFind (\(item) -> item > 2) values,
   listFindIndex (\(item) -> item == 3) values,
   listZip [1, 2, 3] ["a", "b"], listUnzip pairs, listIndexed ["a", "b"]).
}
