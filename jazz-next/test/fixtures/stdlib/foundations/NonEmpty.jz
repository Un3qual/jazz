module Stdlib::Foundations::NonEmpty {
  import NonEmpty.
  import Maybe.
  item = NonEmpty 1 [2, 3].
  singleton = nonEmptySingleton 7.
  (nonEmptyToList singleton, nonEmptyLast singleton,
   nonEmptyFromList [1, 2, 3], nonEmptyFromList [],
   nonEmptyToList item, nonEmptyHead item, nonEmptyTail item, nonEmptyLast item,
   nonEmptyToList (nonEmptyPrepend 0 item),
   nonEmptyToList (nonEmptyAppendList item [4]),
   nonEmptyToList (nonEmptyMap (\(item) -> item * 2) item),
   nonEmptyLength item,
   nonEmptyFoldLeft (\(total, item) -> total + item) 0 item,
   nonEmptyFoldRight (\(item, total) -> item + total) 0 item).
}
