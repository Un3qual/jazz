module Stdlib::LinearCollections::Dictionary {
  import Dictionary.
  import Maybe.
  import Text.
  start = dictionaryFromList [("first", 1), ("second", 2), ("first", 3)].
  replaced = dictionaryInsert start "second" 20.
  removed = dictionaryRemove replaced "first".
  reinserted = dictionaryInsert removed "first" 30.
  updated = dictionaryUpdate reinserted "second" (\(current) -> case current {
    | Nothing -> Nothing
    | Just value -> Just (value + 1)
  }).
  insertedByUpdate = dictionaryUpdate updated "third" (\(current) -> Just 40).
  unchanged = dictionaryUpdate insertedByUpdate "missing" (\(current) -> Nothing).
  removedByUpdate = dictionaryUpdate unchanged "first" (\(current) -> Nothing).
  replacedPresent = dictionaryReplace start "second" 22.
  replacedMissing = dictionaryReplace start "missing" 0.
  (dictionaryToList dictionaryEmpty, dictionarySize dictionaryEmpty, dictionaryIsEmpty dictionaryEmpty,
   dictionaryToList (dictionarySingleton "only" 7), dictionaryToList start,
   dictionaryLookup start "first", dictionaryLookup start "missing",
   dictionaryGetOr start "missing" 9, dictionaryContainsKey start "second",
   dictionaryToList replaced,
   maybeMap dictionaryToList replacedPresent, replacedMissing,
   dictionaryToList removed, dictionaryToList reinserted, dictionaryToList removedByUpdate,
   dictionaryKeys start, dictionaryValues start,
   dictionaryToList (dictionaryMapValues start (\(value) -> value * 10)),
   dictionaryToList (dictionaryFilter start (\(key, value) -> value > 2)),
   dictionaryFoldLeft start "" (\(result, key, value) -> textAppend result key),
   dictionaryFoldRight start "" (\(key, value, result) -> textAppend key result)).
}
