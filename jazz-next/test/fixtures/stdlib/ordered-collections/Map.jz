module Stdlib::OrderedCollections::Map {
  import Map.
  start = mapFromList [(3, "three"), (1, "one"), (2, "two"), (2, "TWO")].
  (mapToList mapEmpty, mapSize mapEmpty, mapIsEmpty mapEmpty,
   mapToList (mapSingleton 9 "nine"), mapToList start, mapSize start,
   mapLookup start 2, mapLookup start 8, mapGetOr start 8 "fallback", mapContainsKey start 3).
}
