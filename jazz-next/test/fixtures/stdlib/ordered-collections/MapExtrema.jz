module Stdlib::OrderedCollections::MapExtrema {
  import Map.
  import Maybe.
  start = mapFromList [(3, "three"), (1, "one"), (2, "TWO")].
  popView = \(result) -> case result {
    | Nothing -> Nothing
    | Just ((key, value), remaining) -> Just ((key, value), mapToList remaining)
  }.
  (mapMinimum start, mapMaximum start,
   popView (mapPopMinimum start), popView (mapPopMaximum start)).
}
