module Stdlib::OrderedCollections::MapTraversal {
  import Map.
  import Text.
  start = mapFromList [(3, "three"), (1, "one"), (2, "TWO")].
  (mapKeys start, mapValues start,
   mapToList (mapMapValues start (\(item) -> textAppend item "!")),
   mapToList (mapFilter start (\(key, item) -> key > 1)),
   mapFoldLeft start "" (\(result, key, item) -> textAppend result (Showable::show key)),
   mapFoldRight start "" (\(key, item, result) -> textAppend (Showable::show key) result)).
}
