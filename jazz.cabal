cabal-version: 3.0
name: jazz
version: 0.1.0.0
build-type: Simple
synopsis: A statically typed functional language with practical syntax
description: The Jazz compiler, module loader, analyzer, interpreter, and command-line interface.
homepage: https://un3qual.github.io/jazz/
bug-reports: https://github.com/un3qual/jazz/issues
author: un3qual
maintainer: un3qual
category: Language
stability: Experimental
tested-with: GHC == 9.14.1
license: GPL-3.0-only
license-file: LICENSE

extra-doc-files:
    README.md
    CHANGELOG.md
    CONTRIBUTING.md
    SECURITY.md
    RELEASING.md
    PERFORMANCE.md
    docs/**/*.md
    rfcs/**/*.md

extra-source-files:
    .gitignore
    examples/README.md
    examples/**/*.jz
    jazz/stdlib/*.jz
    jazz/compiler/*.jz
    jazz/stdlib/README.md
    programs/README.md
    programs/corpus.json
    programs/**/*.jz
    programs/**/*.stdout
    editors/vscode-jazz/README.md
    editors/vscode-jazz/LICENSE
    editors/vscode-jazz/package.json
    editors/vscode-jazz/icon.png
    editors/vscode-jazz/language-configuration.json
    editors/vscode-jazz/syntaxes/*.json
    editors/vscode-jazz/fixtures/*.jz
    editors/vscode-jazz/fixtures/*.jz.txt
    test/fixtures/runtime-observation/**/*.jz
    AGENTS.md
    flake.nix
    flake.lock
    cabal.project
    cabal.project.profile-hotspots
    cabal.project.profile-stages
    scripts/*.py
    scripts/*.sh

source-repository head
  type: git
  location: https://github.com/un3qual/jazz.git

flag development
  description: Treat compiler warnings as build failures in the repository workspace.
  default: False
  manual: True

flag profiling-workflow
  description: Link opt-in profiling executables with unrestricted RTS options.
  default: False
  manual: True

flag full-parser-scale
  description: Build exhaustive hosted parser scale test components.
  default: False
  manual: True

common warning-settings
  ghc-options:
      -Wall
      -Wcompat
      -Widentities
      -Wincomplete-record-updates
      -Wincomplete-uni-patterns
      -Wredundant-constraints
  if flag(development)
    ghc-options: -Werror

library jazz-internal
  import: warning-settings
  visibility: private
  hs-source-dirs: src
  default-language: Haskell2010
  exposed-modules:
      Jazz.CLI.Main
      Jazz.Compiler.AST
      Jazz.Compiler.Analyzer
      Jazz.Compiler.Analyzer.UnusedBindings
      Jazz.Compiler.BuiltinCatalog
      Jazz.Compiler.BundledPrelude
      Jazz.Compiler.CapabilityFacts
      Jazz.Compiler.Diagnostics
      Jazz.Compiler.Diagnostics.Render
      Jazz.Compiler.Diagnostics.Strictness
      Jazz.Compiler.DiagnosticCatalog
      Jazz.Compiler.Driver
      Jazz.Compiler.Force
      Jazz.Compiler.FractionalLiteral
      Jazz.Compiler.LoweredIR
      Jazz.Compiler.LoweredIR.Lower
      Jazz.Compiler.LoweredIR.Lower.Emit
      Jazz.Compiler.LoweredIR.Lower.Requirements
      Jazz.Compiler.LoweredIR.Lower.Shapes
      Jazz.Compiler.LoweredIR.Lower.Types
      Jazz.Compiler.LoweredIR.RuntimeServiceCatalog
      Jazz.Compiler.LoweredIR.Validate
      Jazz.Compiler.TypedCore
      Jazz.Compiler.TypedCore.Validate
      Jazz.Compiler.ModuleGraph
      Jazz.Compiler.ModuleExports
      Jazz.Compiler.ModuleInterface
      Jazz.Compiler.ModuleCompiler
      Jazz.Compiler.ModuleResolver
      Jazz.Compiler.ModuleRuntime
      Jazz.Compiler.Name
      Jazz.Compiler.Parser
      Jazz.Compiler.Parser.AST
      Jazz.Compiler.Parser.Context
      Jazz.Compiler.Parser.Declaration
      Jazz.Compiler.Parser.Expression
      Jazz.Compiler.Parser.Failure
      Jazz.Compiler.Parser.Lexer
      Jazz.Compiler.Parser.Lower
      Jazz.Compiler.Parser.Operator
      Jazz.Compiler.Parser.Pattern
      Jazz.Compiler.Parser.Signature
      Jazz.Compiler.Parser.TokenParser
      Jazz.Compiler.Parser.TokenStream
      Jazz.Compiler.Pattern
      Jazz.Compiler.PatternCoverage
      Jazz.Compiler.PreludeContract
      Jazz.Compiler.Prelude
      Jazz.Compiler.Profiling
      Jazz.Compiler.Purity
      Jazz.Compiler.RecursiveBindings
      Jazz.Compiler.Runtime
      Jazz.Compiler.Runtime.Engine
      Jazz.Compiler.Runtime.HostEvaluation
      Jazz.Compiler.Runtime.Outcome
      Jazz.Compiler.Runtime.Observation
      Jazz.Compiler.Runtime.Observation.Profile
      Jazz.Compiler.Runtime.Observation.Render
      Jazz.Compiler.Runtime.Primitives
      Jazz.Compiler.Runtime.Request
      Jazz.Compiler.Runtime.ScopePlan
      Jazz.Compiler.Runtime.Semantics
      Jazz.Compiler.Runtime.Types
      Jazz.Compiler.RuntimeHost
      Jazz.Compiler.RuntimeHints
      Jazz.Compiler.SignatureRendering
      Jazz.Compiler.SourceProgram
      Jazz.Compiler.TypeInference
      Jazz.Compiler.TypeInference.Capabilities
      Jazz.Compiler.TypeInference.Diagnostics
      Jazz.Compiler.TypeInference.Elaboration
      Jazz.Compiler.TypeInference.Elaboration.Finalize
      Jazz.Compiler.TypeInference.Elaboration.Profiles
      Jazz.Compiler.TypeInference.Elaboration.Specialize
      Jazz.Compiler.TypeInference.Elaboration.Types
      Jazz.Compiler.TypeInference.Operator
      Jazz.Compiler.TypeInference.Pattern
      Jazz.Compiler.TypeInference.Result
      Jazz.Compiler.TypeInference.Scope
      Jazz.Compiler.TypeInference.Signature
      Jazz.Compiler.TypeInference.State
      Jazz.Compiler.TypeInference.Solver
      Jazz.Compiler.TypeInference.Traversal
      Jazz.Compiler.TypeInference.TypeOps
      Jazz.Compiler.TypeInference.Types
      Jazz.Compiler.WarningConfig
  build-depends:
      aeson >= 2.2 && < 2.3,
      base >= 4.22 && < 4.23,
      bytestring >= 0.12 && < 0.13,
      containers >= 0.8 && < 0.9,
      directory >= 1.3 && < 1.4,
      filepath >= 1.5 && < 1.6,
      megaparsec >= 9 && < 10,
      text >= 2.1 && < 2.2,
      transformers >= 0.6 && < 0.7,
      vector >= 0.13 && < 0.14
  if flag(profiling-workflow)
    cpp-options: -DJAZZ_GHC_PROFILING

executable jazz
  import: warning-settings
  hs-source-dirs: app
  main-is: Main.hs
  default-language: Haskell2010
  build-depends:
      base >= 4.22 && < 4.23,
      jazz:jazz-internal
  if flag(profiling-workflow)
    ghc-options: -rtsopts

common test-common
  import: warning-settings
  hs-source-dirs: test
  default-extensions: MultilineStrings
  other-modules:
      Jazz.TestHarness
  default-language: Haskell2010
  build-depends:
      base >= 4.22 && < 4.23,
      bytestring >= 0.12 && < 0.13,
      containers >= 0.8 && < 0.9,
      directory >= 1.3 && < 1.4,
      filepath >= 1.5 && < 1.6,
      jazz:jazz-internal,
      text >= 2.1 && < 2.2,
      transformers >= 0.6 && < 0.7

common program-support
  hs-source-dirs: program-support
  other-modules:
      Jazz.ProgramCorpus.Manifest
      Jazz.ProgramCorpus.Runner
      Jazz.ProgramCorpus.Types
  build-depends:
      aeson >= 2.2 && < 2.3,
      base >= 4.22 && < 4.23,
      bytestring >= 0.12 && < 0.13,
      directory >= 1.3 && < 1.4,
      filepath >= 1.5 && < 1.6,
      jazz:jazz-internal,
      text >= 2.1 && < 2.2

test-suite program-corpus-spec
  import: test-common, program-support
  type: exitcode-stdio-1.0
  main-is: Jazz/ProgramCorpus/ProgramCorpusSpec.hs

benchmark jazz-bench
  import: warning-settings, program-support
  type: exitcode-stdio-1.0
  hs-source-dirs: benchmark
  main-is: Main.hs
  other-modules:
      Jazz.Benchmark.Force
      Jazz.Benchmark.Metadata
      Jazz.Benchmark.ScaleCases
      Jazz.Benchmark.StageInputs
      Jazz.Benchmark.Stages
      Paths_jazz
  autogen-modules: Paths_jazz
  default-language: Haskell2010
  ghc-options: -fproc-alignment=64
  if flag(profiling-workflow)
    ghc-options: -rtsopts
  build-depends:
      aeson >= 2.2 && < 2.3,
      base >= 4.22 && < 4.23,
      bytestring >= 0.12 && < 0.13,
      containers >= 0.8 && < 0.9,
      deepseq >= 1.5 && < 1.6,
      directory >= 1.3 && < 1.4,
      filepath >= 1.5 && < 1.6,
      jazz:jazz-internal,
      process >= 1.6 && < 1.7,
      tasty >= 1.5 && < 1.6,
      tasty-bench >= 0.4.1 && < 0.6,
      text >= 2.1 && < 2.2,
      time >= 1.15 && < 1.16

