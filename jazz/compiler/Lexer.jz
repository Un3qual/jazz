module Lexer (value lexSource) {
  import List.
  import Char.
  import Dictionary.
  import Text.
  import Maybe.
  import LexerTypes.

  data ScanResult = Scanned CanonicalToken Text Int Int | ScanFailed CanonicalLexError.

  data TextRun = TextRun Text Text.

  data QuoteMode = QuoteNormal | QuoteEscape | QuoteUnicodeOpen | QuoteUnicodeDigits Text.

  zeroUInt32 :: UInt32.
  zeroUInt32 = 0.

  nextTabStop :: Int -> Int -> Int.
  nextTabStop = \(stop, column) -> if stop > column then stop else nextTabStop (stop + 8) column.

  advanceLine :: Char -> Int -> Int.
  advanceLine = \(item, line) -> if item == '\n' then line + 1 else line.

  advanceColumn :: Char -> Int -> Int.
  advanceColumn = \(item, column) -> if item == '\n' then
    1
    else if item == '\t' then
      nextTabStop 1 column
      else column + 1.

  isIdentifierStart :: Char -> Bool.
  isIdentifierStart = \(item) -> if (charIsAlpha item) then True else item == '_'.

  isIdentifierContinuation :: Char -> Bool.
  isIdentifierContinuation = \(item) -> if (charIsAlphaNum item) then
    True
    else if item == '_' then
      True
      else if item == '\'' then
        True
        else item == '!'.

  isSourceDigit :: Char -> Bool.
  isSourceDigit = \(item) -> if (charToUInt32 item) < (charToUInt32 '0') then
    False
    else (charToUInt32 item) <= (charToUInt32 '9').

  keywordKinds :: Dictionary(Text, CanonicalTokenKind).
  keywordKinds = dictionaryFromList [
    ("module", KeywordKind ModuleKeyword),
    ("import", KeywordKind ImportKeyword),
    ("as", KeywordKind AsKeyword),
    ("data", KeywordKind DataKeyword),
    ("value", KeywordKind ValueKeyword),
    ("if", KeywordKind IfKeyword),
    ("then", KeywordKind ThenKeyword),
    ("else", KeywordKind ElseKeyword),
    ("case", KeywordKind CaseKeyword)
  ].

  identifierKind :: Text -> CanonicalTokenKind.
  identifierKind = \(name) -> dictionaryGetOr keywordKinds name (IdentifierKind name).

  canonicalInteger :: Text -> Text.
  canonicalInteger = \(digits) -> case textUncons digits {
    | Nothing -> "0"
    | Just (first, rest) -> if first == '0' then canonicalInteger rest else digits
  }.

  operatorSymbols :: [Char].
  operatorSymbols = ['!', '%', '&', '*', '+', '-', '/', '<', '>', '?', '^', '|', '~'].

  isOperatorSymbol :: Char -> Bool.
  isOperatorSymbol = \(item) -> listContains item operatorSymbols.

  allHexDigits :: Text -> Bool.
  allHexDigits = \(digits) -> case textUncons digits {
    | Nothing -> True
    | Just (first, rest) -> if (charIsHexDigit first) then allHexDigits rest else False
  }.

  validUnicodeDigits :: Text -> Bool.
  validUnicodeDigits = \(digits) -> if (textLength digits) < 1 then
    False
    else if (textLength digits) > 6 then
      False
      else allHexDigits digits.

  hexDigitValue :: Char -> UInt32.
  hexDigitValue = \(digit) -> if (charToUInt32 digit) <= (charToUInt32 '9') then
    (charToUInt32 digit) - (charToUInt32 '0')
    else if (charToUInt32 digit) <= (charToUInt32 'F') then
      (charToUInt32 digit) - (charToUInt32 'A') + 10
      else (charToUInt32 digit) - (charToUInt32 'a') + 10.

  parseHex :: Text -> UInt32 -> UInt32.
  parseHex = \(digits, item) -> case textUncons digits {
    | Nothing -> item
    | Just (first, rest) -> parseHex rest (item * 16 + (hexDigitValue first))
  }.

  lexicalFailure :: CanonicalLexErrorReason -> Int -> Int -> ScanResult.
  lexicalFailure = \(reason, line, column) -> ScanFailed (CanonicalLexError "E0001" reason (CanonicalSpan line column)).

  singleToken :: CanonicalTokenKind -> Text -> Text -> Int -> Int -> ScanResult.
  singleToken = \(kind, raw, remaining, line, column) ->
    Scanned (CanonicalToken kind raw (CanonicalSpan line column)) remaining line (column + (textLength raw)).

  textFromReversedChars :: [Char] -> Text.
  textFromReversedChars = \(reversed) -> textFromChars (listReverse reversed).

  scanTextRun :: (Char -> Bool) -> Text -> [Char] -> TextRun.
  scanTextRun = \(accepts, remaining, reversed) -> case textUncons remaining {
    | Nothing -> TextRun (textFromReversedChars reversed) remaining
    | Just (current, rest) -> if (accepts current) then
      scanTextRun accepts rest (listPrepend current reversed)
      else TextRun (textFromReversedChars reversed) remaining
  }.

  scanIdentifier :: Text -> Int -> Int -> ScanResult.
  scanIdentifier = \(source, line, column) -> case scanTextRun isIdentifierContinuation source [] {
    | TextRun raw remaining -> Scanned (CanonicalToken (identifierKind raw) raw (CanonicalSpan line column)) remaining line (column + (textLength raw))
  }.

  scanInteger :: Text -> Int -> Int -> ScanResult.
  scanInteger = \(source, line, column) -> case scanTextRun isSourceDigit source [] {
    | TextRun raw remaining -> Scanned (CanonicalToken (IntegerKind (canonicalInteger raw)) raw (CanonicalSpan line column)) remaining line (column + (textLength raw))
  }.

  scanColon :: Text -> Int -> Int -> ScanResult.
  scanColon = \(remaining, line, column) -> case textUncons remaining {
    | Just (next, rest) -> if next == ':' then
      singleToken (PunctuationKind DoubleColonPunctuation) "::" rest line column
      else singleToken (PunctuationKind ColonPunctuation) ":" remaining line column
    | Nothing -> singleToken (PunctuationKind ColonPunctuation) ":" remaining line column
  }.

  scanEquals :: Text -> Int -> Int -> ScanResult.
  scanEquals = \(remaining, line, column) -> case textUncons remaining {
    | Just (next, rest) -> if next == '=' then
      singleToken (OperatorKind "==") "==" rest line column
      else if next == '>' then
        singleToken (OperatorKind "=>") "=>" rest line column
        else singleToken (PunctuationKind EqualsPunctuation) "=" remaining line column
    | Nothing -> singleToken (PunctuationKind EqualsPunctuation) "=" remaining line column
  }.

  scanOperatorRun :: Text -> Int -> Int -> ScanResult.
  scanOperatorRun = \(source, line, column) -> case scanTextRun isOperatorSymbol source [] {
    | TextRun raw remaining -> if raw == "->" then
      singleToken (PunctuationKind ArrowPunctuation) raw remaining line column
      else singleToken (OperatorKind raw) raw remaining line column
  }.

  scanBang :: Text -> Text -> Int -> Int -> ScanResult.
  scanBang = \(remaining, source, line, column) -> case textUncons remaining {
    | Just (next, rest) -> if next == '=' then
      singleToken (OperatorKind "!=") "!=" rest line column
      else scanOperatorRun source line column
    | Nothing -> scanOperatorRun source line column
  }.

  scanLess :: Text -> Text -> Int -> Int -> ScanResult.
  scanLess = \(remaining, source, line, column) -> case textUncons remaining {
    | Just (next, rest) -> if next == '=' then
      singleToken (OperatorKind "<=") "<=" rest line column
      else scanOperatorRun source line column
    | Nothing -> scanOperatorRun source line column
  }.

  scanGreater :: Text -> Text -> Int -> Int -> ScanResult.
  scanGreater = \(remaining, source, line, column) -> case textUncons remaining {
    | Just (next, rest) -> if next == '=' then
      singleToken (OperatorKind ">=") ">=" rest line column
      else scanOperatorRun source line column
    | Nothing -> scanOperatorRun source line column
  }.

  scanSymbol :: Text -> Int -> Int -> ScanResult.
  scanSymbol = \(source, line, column) -> case textUncons source {
    | Nothing -> lexicalFailure UnexpectedEndOfInput line column
    | Just (current, rest) -> if current == ':' then
      scanColon rest line column
      else if current == '=' then
        scanEquals rest line column
        else if current == '!' then
          scanBang rest source line column
          else if current == '<' then
            scanLess rest source line column
            else if current == '>' then
              scanGreater rest source line column
              else if (isOperatorSymbol current) then
                scanOperatorRun source line column
                else if current == '$' then
                  singleToken (OperatorKind "$") "$" rest line column
                  else if current == '@' then
                    singleToken (PunctuationKind AtPunctuation) "@" rest line column
                    else if current == '\\' then
                      singleToken (PunctuationKind LambdaPunctuation) "\\" rest line column
                      else if current == '.' then
                        singleToken (PunctuationKind DotPunctuation) "." rest line column
                        else if current == '{' then
                          singleToken (PunctuationKind LeftBracePunctuation) "{" rest line column
                          else if current == '}' then
                            singleToken (PunctuationKind RightBracePunctuation) "}" rest line column
                            else if current == '(' then
                              singleToken (PunctuationKind LeftParenPunctuation) "(" rest line column
                              else if current == ')' then
                                singleToken (PunctuationKind RightParenPunctuation) ")" rest line column
                                else if current == '[' then
                                  singleToken (PunctuationKind LeftBracketPunctuation) "[" rest line column
                                  else if current == ']' then
                                    singleToken (PunctuationKind RightBracketPunctuation) "]" rest line column
                                    else if current == ',' then
                                      singleToken (PunctuationKind CommaPunctuation) "," rest line column
                                      else lexicalFailure (UnexpectedCharacter current) line column
  }.

  finishQuoted :: CanonicalLiteralKind -> [Char] -> [Char] -> Int -> Text -> Int -> Int -> Int -> ScanResult.
  finishQuoted = \(literalKind, reversedRaw, reversedDecoded, count, remaining, line, startColumn, nextColumn) -> case literalKind {
    | CharacterLiteral -> if count == 1 then
      case textUncons (textFromReversedChars reversedDecoded) {
        | Just (item, _) -> Scanned (CanonicalToken (CharacterKind item) (textFromReversedChars reversedRaw) (CanonicalSpan line startColumn)) remaining line nextColumn
        | Nothing -> lexicalFailure (InvalidCharacterLength count) line startColumn
      }
      else lexicalFailure (InvalidCharacterLength count) line startColumn
    | TextLiteral -> Scanned (CanonicalToken (TextKind (textFromReversedChars reversedDecoded)) (textFromReversedChars reversedRaw) (CanonicalSpan line startColumn)) remaining line nextColumn
  }.

  scanQuoted :: QuoteMode -> CanonicalLiteralKind -> Char -> Text -> [Char] -> [Char] -> Int -> Int -> Int -> Int -> ScanResult.
  scanQuoted = \(mode, literalKind, delimiter, remaining, reversedRaw, reversedDecoded, count, line, startColumn, currentColumn) -> case textUncons remaining {
    | Nothing -> case mode {
      | QuoteNormal -> lexicalFailure (UnterminatedLiteral literalKind) line startColumn
      | QuoteEscape -> lexicalFailure (UnterminatedLiteral literalKind) line startColumn
      | QuoteUnicodeOpen -> lexicalFailure UnterminatedUnicodeEscape line startColumn
      | QuoteUnicodeDigits _ -> lexicalFailure UnterminatedUnicodeEscape line startColumn
    }
    | Just (current, rest) -> case mode {
      | QuoteNormal -> if current == delimiter then
        finishQuoted literalKind (listPrepend current reversedRaw) reversedDecoded count rest line startColumn (currentColumn + 1)
        else if current == '\\' then
          scanQuoted QuoteEscape literalKind delimiter rest (listPrepend current reversedRaw) reversedDecoded count line startColumn (currentColumn + 1)
          else if (charIsNewline current) then
            lexicalFailure (RawNewline literalKind) line startColumn
            else scanQuoted QuoteNormal literalKind delimiter rest (listPrepend current reversedRaw) (listPrepend current reversedDecoded) (count + 1) line startColumn (advanceColumn current currentColumn)
      | QuoteEscape -> if current == '\\' then
        scanQuoted QuoteNormal literalKind delimiter rest (listPrepend current reversedRaw) (listPrepend '\\' reversedDecoded) (count + 1) line startColumn (currentColumn + 1)
        else if current == '\'' then
          scanQuoted QuoteNormal literalKind delimiter rest (listPrepend current reversedRaw) (listPrepend '\'' reversedDecoded) (count + 1) line startColumn (currentColumn + 1)
          else if current == '"' then
            scanQuoted QuoteNormal literalKind delimiter rest (listPrepend current reversedRaw) (listPrepend '"' reversedDecoded) (count + 1) line startColumn (currentColumn + 1)
            else if current == 'n' then
              scanQuoted QuoteNormal literalKind delimiter rest (listPrepend current reversedRaw) (listPrepend '\n' reversedDecoded) (count + 1) line startColumn (currentColumn + 1)
              else if current == 'r' then
                scanQuoted QuoteNormal literalKind delimiter rest (listPrepend current reversedRaw) (listPrepend '\r' reversedDecoded) (count + 1) line startColumn (currentColumn + 1)
                else if current == 't' then
                  scanQuoted QuoteNormal literalKind delimiter rest (listPrepend current reversedRaw) (listPrepend '\t' reversedDecoded) (count + 1) line startColumn (currentColumn + 1)
                  else if current == '0' then
                    scanQuoted QuoteNormal literalKind delimiter rest (listPrepend current reversedRaw) (listPrepend '\0' reversedDecoded) (count + 1) line startColumn (currentColumn + 1)
                    else if current == 'u' then
                      scanQuoted QuoteUnicodeOpen literalKind delimiter rest (listPrepend current reversedRaw) reversedDecoded count line startColumn (currentColumn + 1)
                      else lexicalFailure (InvalidEscape current) line startColumn
      | QuoteUnicodeOpen -> if current == '{' then
        scanQuoted (QuoteUnicodeDigits "") literalKind delimiter rest (listPrepend current reversedRaw) reversedDecoded count line startColumn (currentColumn + 1)
        else lexicalFailure UnterminatedUnicodeEscape line startColumn
      | QuoteUnicodeDigits digits -> if current == '}' then
        if (validUnicodeDigits digits) then
          case charFromUInt32 (parseHex digits zeroUInt32) {
            | Nothing -> lexicalFailure (NonScalarUnicodeEscape digits) line startColumn
            | Just item -> scanQuoted QuoteNormal literalKind delimiter rest (listPrepend current reversedRaw) (listPrepend item reversedDecoded) (count + 1) line startColumn (currentColumn + 1)
          }
          else lexicalFailure (MalformedUnicodeEscape digits) line startColumn
        else scanQuoted (QuoteUnicodeDigits (textAppendChar digits current)) literalKind delimiter rest (listPrepend current reversedRaw) reversedDecoded count line startColumn (currentColumn + 1)
    }
  }.

  scanCharacter :: Text -> Int -> Int -> ScanResult.
  scanCharacter = \(source, line, column) -> case textUncons source {
    | Nothing -> lexicalFailure UnexpectedEndOfInput line column
    | Just (_, rest) -> scanQuoted QuoteNormal CharacterLiteral '\'' rest ['\''] [] 0 line column (column + 1)
  }.

  scanText :: Text -> Int -> Int -> ScanResult.
  scanText = \(source, line, column) -> case textUncons source {
    | Nothing -> lexicalFailure UnexpectedEndOfInput line column
    | Just (_, rest) -> scanQuoted QuoteNormal TextLiteral '"' rest ['"'] [] 0 line column (column + 1)
  }.

  scanToken :: Text -> Int -> Int -> ScanResult.
  scanToken = \(source, line, column) -> case textUncons source {
    | Nothing -> lexicalFailure UnexpectedEndOfInput line column
    | Just (current, _) -> if current == '\'' then
      scanCharacter source line column
      else if current == '"' then
        scanText source line column
        else if (isSourceDigit current) then
          scanInteger source line column
          else if (isIdentifierStart current) then
            scanIdentifier source line column
            else scanSymbol source line column
  }.

  lexLoop :: CanonicalSourcePath -> Text -> Int -> Int -> [CanonicalToken] -> Bool -> CanonicalLexResult.
  lexLoop = \(path, remaining, line, column, reversedTokens, inComment) -> case textUncons remaining {
    | Nothing -> CanonicalLexSuccess path (listReverse reversedTokens)
    | Just (current, rest) -> if inComment then
      if current == '\n' then
        lexLoop path rest (line + 1) 1 reversedTokens False
        else lexLoop path rest line (advanceColumn current column) reversedTokens True
      else if (charIsSpace current) then
        lexLoop path rest (advanceLine current line) (advanceColumn current column) reversedTokens False
        else if current == '#' then
          lexLoop path rest line (column + 1) reversedTokens True
          else case scanToken remaining line column {
            | ScanFailed error -> CanonicalLexFailure path error
            | Scanned token next nextLine nextColumn -> lexLoop path next nextLine nextColumn (listPrepend token reversedTokens) False
          }
  }.

  lexSource :: CanonicalSourcePath -> Text -> CanonicalLexResult.
  lexSource = \(path, source) -> lexLoop path source 1 1 [] False.
}
