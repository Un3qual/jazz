module ParserContext (
  type StatementContext(..),
  type ParserContext,
  value parserContextInitial,
  value parserContextModuleBody,
  value parserContextNestedBlock,
  value parserContextStatement,
  value parserContextHasAlias,
  value parserContextRegisterAlias,
  value parserContextRegisterAliases,
  value parserContextRegisterOperator,
  value parserContextLookupOperator,
  value parserContextIsNestedBlock,
  value parserContextStopsAtRightBrace
) {
  # Complete import keeps the abstract Set::Set type available in signatures.
  import List as List.
  import Maybe as Maybe.
  import Maybe (Nothing, Just).
  import ParserOperator.
  import Set as Set.

  data StatementContext = TopLevelContext | ModuleBodyContext | NestedBlockContext.

  data ParserContext = ParserContext StatementContext Set::Set(Text) [OperatorInfo].

  parserContextInitial :: ParserContext.
  parserContextInitial = ParserContext TopLevelContext Set::empty [].

  parserContextModuleBody :: ParserContext -> ParserContext.
  parserContextModuleBody = \(context) -> ParserContext ModuleBodyContext Set::empty [].

  parserContextNestedBlock :: ParserContext -> ParserContext.
  parserContextNestedBlock = \(context) -> case context {
    | ParserContext statementContext aliases operators -> ParserContext NestedBlockContext aliases operators
  }.

  parserContextStatement :: ParserContext -> StatementContext.
  parserContextStatement = \(context) -> case context {
    | ParserContext statementContext aliases operators -> statementContext
  }.

  parserContextHasAlias :: ParserContext -> Text -> Bool.
  parserContextHasAlias = \(context, alias) -> case context {
    | ParserContext statementContext aliases operators -> Set::contains aliases alias
  }.

  parserContextRegisterAlias :: ParserContext -> Text -> ParserContext.
  parserContextRegisterAlias = \(context, alias) -> case context {
    | ParserContext statementContext aliases operators -> ParserContext statementContext (Set::insert aliases alias) operators
  }.

  parserContextRegisterAliases :: ParserContext -> Set::Set(Text) -> ParserContext.
  parserContextRegisterAliases = \(context, collected) -> case context {
    | ParserContext statementContext aliases operators -> ParserContext statementContext (Set::union aliases collected) operators
  }.

  parserContextRegisterOperator :: ParserContext -> OperatorInfo -> ParserContext.
  parserContextRegisterOperator = \(context, operator) -> case context {
    | ParserContext statementContext aliases operators -> ParserContext statementContext aliases (List::prepend operator operators)
  }.

  parserContextLookupOperator :: ParserContext -> Text -> Maybe::Maybe(OperatorInfo).
  parserContextLookupOperator = \(context, symbol) -> case context {
    | ParserContext statementContext aliases operators -> operatorLookup operators symbol
  }.

  parserContextIsNestedBlock :: ParserContext -> Bool.
  parserContextIsNestedBlock = \(context) -> case parserContextStatement context {
    | NestedBlockContext -> True
    | other -> False
  }.

  parserContextStopsAtRightBrace :: ParserContext -> Bool.
  parserContextStopsAtRightBrace = \(context) -> case parserContextStatement context {
    | TopLevelContext -> False
    | ModuleBodyContext -> True
    | NestedBlockContext -> True
  }.
}
