module Char (
  value toUInt32,
  value fromUInt32,
  value isAlpha,
  value isAlphaNum,
  value isDigit,
  value isSpace,
  value isHexDigit,
  value isLower,
  value isUpper,
  value toLower,
  value toUpper,
  value isNewline
) {
  import Maybe as Maybe.
  import Maybe (Nothing, Just).

  toUInt32 :: Char -> UInt32.
  toUInt32 = __kernel_charToUInt32.

  fromUInt32 :: UInt32 -> Maybe::Maybe(Char).
  fromUInt32 = \(scalar) -> case __kernel_charFromUInt32Raw scalar {
    | [] -> Nothing
    | [item | _] -> Just item
  }.

  isAlpha :: Char -> Bool.
  isAlpha = __kernel_charIsAlpha.

  isAlphaNum :: Char -> Bool.
  isAlphaNum = __kernel_charIsAlphaNum.

  isDigit :: Char -> Bool.
  isDigit = __kernel_charIsDigit.

  isSpace :: Char -> Bool.
  isSpace = __kernel_charIsSpace.

  isHexDigit :: Char -> Bool.
  isHexDigit = __kernel_charIsHexDigit.

  isLower :: Char -> Bool.
  isLower = __kernel_charIsLower.

  isUpper :: Char -> Bool.
  isUpper = __kernel_charIsUpper.

  toLower :: Char -> Char.
  toLower = __kernel_charToLower.

  toUpper :: Char -> Char.
  toUpper = __kernel_charToUpper.

  isNewline :: Char -> Bool.
  isNewline = \(item) -> if item == '\n' then True else item == '\r'.
}
