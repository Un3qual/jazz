module Dictionary (
  type Dictionary,
  value dictionaryEmpty,
  value dictionarySingleton,
  value dictionaryFromList,
  value dictionaryToList,
  value dictionarySize,
  value dictionaryIsEmpty,
  value dictionaryLookup,
  value dictionaryGetOr,
  value dictionaryContainsKey,
  value dictionaryInsert,
  value dictionaryReplace,
  value dictionaryRemove,
  value dictionaryUpdate,
  value dictionaryKeys,
  value dictionaryValues,
  value dictionaryMapValues,
  value dictionaryFilter,
  value dictionaryFoldLeft,
  value dictionaryFoldRight
) {
  import List.
  import Maybe.

  data Dictionary k v = Dictionary Int [(k, v)].

  dictionaryEmpty :: Dictionary(k, v).
  dictionaryEmpty = Dictionary 0 [].

  dictionarySingleton :: k -> v -> Dictionary(k, v).
  dictionarySingleton = \(key, item) -> Dictionary 1 [(key, item)].

  dictionaryInsertEntries :: @{Eq(k)}: k -> v -> [(k, v)] -> [(k, v)] -> (Bool, [(k, v)]).
  dictionaryInsertEntries = \(key, item, remaining, reversedPrefix) -> case remaining {
    | [] -> (True, listAppend (listReverse reversedPrefix) [(key, item)])
    | [(candidate, current) | rest] -> if Eq::equals key candidate
      then (False, listAppend (listReverse reversedPrefix) (listPrepend (candidate, item) rest))
      else dictionaryInsertEntries key item rest (listPrepend (candidate, current) reversedPrefix)
  }.

  dictionaryInsert :: @{Eq(k)}: Dictionary(k, v) -> k -> v -> Dictionary(k, v).
  dictionaryInsert = \(dictionary, key, item) -> case dictionary {
    | Dictionary size entries -> case dictionaryInsertEntries key item entries [] {
      | (inserted, updatedEntries) -> Dictionary (if inserted then size + 1 else size) updatedEntries
    }
  }.

  dictionaryFromList :: @{Eq(k)}: [(k, v)] -> Dictionary(k, v).
  dictionaryFromList = \(entries) -> listFoldLeft (\(dictionary, entry) -> case entry {
    | (key, item) -> dictionaryInsert dictionary key item
  }) dictionaryEmpty entries.

  dictionaryToList :: Dictionary(k, v) -> [(k, v)].
  dictionaryToList = \(dictionary) -> case dictionary {
    | Dictionary size entries -> entries
  }.

  dictionarySize :: Dictionary(k, v) -> Int.
  dictionarySize = \(dictionary) -> case dictionary {
    | Dictionary size entries -> size
  }.

  dictionaryIsEmpty :: Dictionary(k, v) -> Bool.
  dictionaryIsEmpty = \(dictionary) -> dictionarySize dictionary == 0.

  dictionaryLookupEntries :: @{Eq(k)}: [(k, v)] -> k -> Maybe(v).
  dictionaryLookupEntries = \(entries, key) -> case entries {
    | [] -> Nothing
    | [(candidate, item) | rest] -> if Eq::equals key candidate then Just item else dictionaryLookupEntries rest key
  }.

  dictionaryLookup :: @{Eq(k)}: Dictionary(k, v) -> k -> Maybe(v).
  dictionaryLookup = \(dictionary, key) -> dictionaryLookupEntries (dictionaryToList dictionary) key.

  dictionaryGetOr :: @{Eq(k)}: Dictionary(k, v) -> k -> v -> v.
  dictionaryGetOr = \(dictionary, key, fallback) -> case dictionaryLookup dictionary key {
    | Nothing -> fallback
    | Just item -> item
  }.

  dictionaryContainsKey :: @{Eq(k)}: Dictionary(k, v) -> k -> Bool.
  dictionaryContainsKey = \(dictionary, key) -> maybeIsJust (dictionaryLookup dictionary key).

  dictionaryReplaceEntries :: @{Eq(k)}: k -> v -> [(k, v)] -> [(k, v)] -> Maybe([(k, v)]).
  dictionaryReplaceEntries = \(key, item, remaining, reversedPrefix) -> case remaining {
    | [] -> Nothing
    | [(candidate, current) | rest] -> if Eq::equals key candidate
      then Just (listAppend (listReverse reversedPrefix) (listPrepend (candidate, item) rest))
      else dictionaryReplaceEntries key item rest (listPrepend (candidate, current) reversedPrefix)
  }.

  dictionaryReplace :: @{Eq(k)}: Dictionary(k, v) -> k -> v -> Maybe(Dictionary(k, v)).
  dictionaryReplace = \(dictionary, key, item) -> case dictionary {
    | Dictionary size entries -> case dictionaryReplaceEntries key item entries [] {
      | Nothing -> Nothing
      | Just updatedEntries -> Just (Dictionary size updatedEntries)
    }
  }.

  dictionaryRemoveEntries :: @{Eq(k)}: k -> [(k, v)] -> [(k, v)] -> Maybe([(k, v)]).
  dictionaryRemoveEntries = \(key, remaining, reversedPrefix) -> case remaining {
    | [] -> Nothing
    | [(candidate, item) | rest] -> if Eq::equals key candidate
      then Just (listAppend (listReverse reversedPrefix) rest)
      else dictionaryRemoveEntries key rest (listPrepend (candidate, item) reversedPrefix)
  }.

  dictionaryRemove :: @{Eq(k)}: Dictionary(k, v) -> k -> Dictionary(k, v).
  dictionaryRemove = \(dictionary, key) -> case dictionary {
    | Dictionary size entries -> case dictionaryRemoveEntries key entries [] {
      | Nothing -> dictionary
      | Just updatedEntries -> Dictionary (size - 1) updatedEntries
    }
  }.

  dictionaryUpdate :: @{Eq(k)}: Dictionary(k, v) -> k -> (Maybe(v) -> Maybe(v)) -> Dictionary(k, v).
  dictionaryUpdate = \(dictionary, key, update) -> case dictionaryLookup dictionary key {
    | Nothing -> case update Nothing {
      | Nothing -> dictionary
      | Just item -> dictionaryInsert dictionary key item
    }
    | Just current -> case update (Just current) {
      | Nothing -> dictionaryRemove dictionary key
      | Just item -> dictionaryInsert dictionary key item
    }
  }.

  dictionaryKeys :: Dictionary(k, v) -> [k].
  dictionaryKeys = \(dictionary) -> listMap (\(entry) -> case entry {
    | (key, item) -> key
  }) (dictionaryToList dictionary).

  dictionaryValues :: Dictionary(k, v) -> [v].
  dictionaryValues = \(dictionary) -> listMap (\(entry) -> case entry {
    | (key, item) -> item
  }) (dictionaryToList dictionary).

  dictionaryMapValues :: Dictionary(k, v) -> (v -> w) -> Dictionary(k, w).
  dictionaryMapValues = \(dictionary, transform) -> case dictionary {
    | Dictionary size entries -> Dictionary size (listMap (\(entry) -> case entry {
      | (key, item) -> (key, transform item)
    }) entries)
  }.

  dictionaryFilterEntries :: (k -> v -> Bool) -> [(k, v)] -> Int -> [(k, v)] -> (Int, [(k, v)]).
  dictionaryFilterEntries = \(predicate, remaining, size, reversed) -> case remaining {
    | [] -> (size, listReverse reversed)
    | [(key, item) | rest] -> if predicate key item
      then dictionaryFilterEntries predicate rest (size + 1) (listPrepend (key, item) reversed)
      else dictionaryFilterEntries predicate rest size reversed
  }.

  dictionaryFilter :: Dictionary(k, v) -> (k -> v -> Bool) -> Dictionary(k, v).
  dictionaryFilter = \(dictionary, predicate) -> case dictionaryFilterEntries predicate (dictionaryToList dictionary) 0 [] {
    | (size, entries) -> Dictionary size entries
  }.

  dictionaryFoldLeft :: Dictionary(k, v) -> a -> (a -> k -> v -> a) -> a.
  dictionaryFoldLeft = \(dictionary, initial, combine) -> listFoldLeft (\(result, entry) -> case entry {
    | (key, item) -> combine result key item
  }) initial (dictionaryToList dictionary).

  dictionaryFoldRight :: Dictionary(k, v) -> a -> (k -> v -> a -> a) -> a.
  dictionaryFoldRight = \(dictionary, initial, combine) -> listFoldRight (\(entry, result) -> case entry {
    | (key, item) -> combine key item result
  }) initial (dictionaryToList dictionary).
}
