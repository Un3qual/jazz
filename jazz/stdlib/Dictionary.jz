module Dictionary (
  type Dictionary,
  value empty,
  value singleton,
  value fromList,
  value toList,
  value size,
  value isEmpty,
  value lookup,
  value getOr,
  value containsKey,
  value insert,
  value replace,
  value remove,
  value update,
  value keys,
  value values,
  value mapValues,
  value filter,
  value foldLeft,
  value foldRight
) {
  import List as List.
  import Maybe as Maybe.
  import Maybe (Nothing, Just).

  data Dictionary k v = Dictionary Int [(k, v)].

  empty :: Dictionary(k, v).
  empty = Dictionary 0 [].

  singleton :: k -> v -> Dictionary(k, v).
  singleton = \(key, item) -> Dictionary 1 [(key, item)].

  dictionaryInsertEntries :: @{Equatable(k)}: k -> v -> [(k, v)] -> [(k, v)] -> (Bool, [(k, v)]).
  dictionaryInsertEntries = \(key, item, remaining, reversedPrefix) -> case remaining {
    | [] -> (True, List::append (List::reverse reversedPrefix) [(key, item)])
    | [(candidate, current) | rest] -> if Equatable::equals key candidate
      then (False, List::append (List::reverse reversedPrefix) (List::prepend (candidate, item) rest))
      else dictionaryInsertEntries key item rest (List::prepend (candidate, current) reversedPrefix)
  }.

  insert :: @{Equatable(k)}: Dictionary(k, v) -> k -> v -> Dictionary(k, v).
  insert = \(dictionary, key, item) -> case dictionary {
    | Dictionary size entries -> case dictionaryInsertEntries key item entries [] {
      | (inserted, updatedEntries) -> Dictionary (if inserted then size + 1 else size) updatedEntries
    }
  }.

  fromList :: @{Equatable(k)}: [(k, v)] -> Dictionary(k, v).
  fromList = \(entries) -> List::foldLeft (\(dictionary, entry) -> case entry {
    | (key, item) -> insert dictionary key item
  }) empty entries.

  toList :: Dictionary(k, v) -> [(k, v)].
  toList = \(dictionary) -> case dictionary {
    | Dictionary size entries -> entries
  }.

  size :: Dictionary(k, v) -> Int.
  size = \(dictionary) -> case dictionary {
    | Dictionary size entries -> size
  }.

  isEmpty :: Dictionary(k, v) -> Bool.
  isEmpty = \(dictionary) -> size dictionary == 0.

  dictionaryLookupEntries :: @{Equatable(k)}: [(k, v)] -> k -> Maybe::Maybe(v).
  dictionaryLookupEntries = \(entries, key) -> case entries {
    | [] -> Nothing
    | [(candidate, item) | rest] -> if Equatable::equals key candidate then Just item else dictionaryLookupEntries rest key
  }.

  lookup :: @{Equatable(k)}: Dictionary(k, v) -> k -> Maybe::Maybe(v).
  lookup = \(dictionary, key) -> dictionaryLookupEntries (toList dictionary) key.

  getOr :: @{Equatable(k)}: Dictionary(k, v) -> k -> v -> v.
  getOr = \(dictionary, key, fallback) -> case lookup dictionary key {
    | Nothing -> fallback
    | Just item -> item
  }.

  containsKey :: @{Equatable(k)}: Dictionary(k, v) -> k -> Bool.
  containsKey = \(dictionary, key) -> Maybe::isJust (lookup dictionary key).

  dictionaryReplaceEntries :: @{Equatable(k)}: k -> v -> [(k, v)] -> [(k, v)] -> Maybe::Maybe([(k, v)]).
  dictionaryReplaceEntries = \(key, item, remaining, reversedPrefix) -> case remaining {
    | [] -> Nothing
    | [(candidate, current) | rest] -> if Equatable::equals key candidate
      then Just (List::append (List::reverse reversedPrefix) (List::prepend (candidate, item) rest))
      else dictionaryReplaceEntries key item rest (List::prepend (candidate, current) reversedPrefix)
  }.

  replace :: @{Equatable(k)}: Dictionary(k, v) -> k -> v -> Maybe::Maybe(Dictionary(k, v)).
  replace = \(dictionary, key, item) -> case dictionary {
    | Dictionary size entries -> case dictionaryReplaceEntries key item entries [] {
      | Nothing -> Nothing
      | Just updatedEntries -> Just (Dictionary size updatedEntries)
    }
  }.

  dictionaryRemoveEntries :: @{Equatable(k)}: k -> [(k, v)] -> [(k, v)] -> Maybe::Maybe([(k, v)]).
  dictionaryRemoveEntries = \(key, remaining, reversedPrefix) -> case remaining {
    | [] -> Nothing
    | [(candidate, item) | rest] -> if Equatable::equals key candidate
      then Just (List::append (List::reverse reversedPrefix) rest)
      else dictionaryRemoveEntries key rest (List::prepend (candidate, item) reversedPrefix)
  }.

  remove :: @{Equatable(k)}: Dictionary(k, v) -> k -> Dictionary(k, v).
  remove = \(dictionary, key) -> case dictionary {
    | Dictionary size entries -> case dictionaryRemoveEntries key entries [] {
      | Nothing -> dictionary
      | Just updatedEntries -> Dictionary (size - 1) updatedEntries
    }
  }.

  update :: @{Equatable(k)}: Dictionary(k, v) -> k -> (Maybe::Maybe(v) -> Maybe::Maybe(v)) -> Dictionary(k, v).
  update = \(dictionary, key, update) -> case lookup dictionary key {
    | Nothing -> case update Nothing {
      | Nothing -> dictionary
      | Just item -> insert dictionary key item
    }
    | Just current -> case update (Just current) {
      | Nothing -> remove dictionary key
      | Just item -> insert dictionary key item
    }
  }.

  keys :: Dictionary(k, v) -> [k].
  keys = \(dictionary) -> List::map (\(entry) -> case entry {
    | (key, item) -> key
  }) (toList dictionary).

  values :: Dictionary(k, v) -> [v].
  values = \(dictionary) -> List::map (\(entry) -> case entry {
    | (key, item) -> item
  }) (toList dictionary).

  mapValues :: Dictionary(k, v) -> (v -> w) -> Dictionary(k, w).
  mapValues = \(dictionary, transform) -> case dictionary {
    | Dictionary size entries -> Dictionary size (List::map (\(entry) -> case entry {
      | (key, item) -> (key, transform item)
    }) entries)
  }.

  dictionaryFilterEntries :: (k -> v -> Bool) -> [(k, v)] -> Int -> [(k, v)] -> (Int, [(k, v)]).
  dictionaryFilterEntries = \(predicate, remaining, size, reversed) -> case remaining {
    | [] -> (size, List::reverse reversed)
    | [(key, item) | rest] -> if predicate key item
      then dictionaryFilterEntries predicate rest (size + 1) (List::prepend (key, item) reversed)
      else dictionaryFilterEntries predicate rest size reversed
  }.

  filter :: Dictionary(k, v) -> (k -> v -> Bool) -> Dictionary(k, v).
  filter = \(dictionary, predicate) -> case dictionaryFilterEntries predicate (toList dictionary) 0 [] {
    | (size, entries) -> Dictionary size entries
  }.

  foldLeft :: Dictionary(k, v) -> a -> (a -> k -> v -> a) -> a.
  foldLeft = \(dictionary, initial, combine) -> List::foldLeft (\(result, entry) -> case entry {
    | (key, item) -> combine result key item
  }) initial (toList dictionary).

  foldRight :: Dictionary(k, v) -> a -> (k -> v -> a -> a) -> a.
  foldRight = \(dictionary, initial, combine) -> List::foldRight (\(entry, result) -> case entry {
    | (key, item) -> combine key item result
  }) initial (toList dictionary).

  impl Mappable(Dictionary(k)) { map = \(change, entries) -> mapValues entries change. }.
  impl Reducible(Dictionary(k)) {
    foldLeft = \(step, initial, entries) -> foldLeft entries initial (\(acc, key, item) -> step acc item).
    foldRight = \(step, initial, entries) -> foldRight entries initial (\(key, item, acc) -> step item acc).
  }.
}
