module List (
  value prepend,
  value reverse,
  value length,
  value isEmpty,
  value head,
  value tail,
  value last,
  value init,
  value at,
  value take,
  value drop,
  value splitAt,
  value append,
  value concat,
  value repeat,
  value intersperse,
  value intercalate,
  value map,
  value filter,
  value filterMap,
  value partition,
  value foldLeft,
  value foldRight,
  value scanLeft,
  value any,
  value all,
  value contains,
  value find,
  value findIndex,
  value zip,
  value unzip,
  value indexed,
  value distinct,
  value group,
  value groupBy,
  value minimum,
  value maximum,
  value sort,
  value sortBy
) {
  import Maybe as Maybe.
  import Maybe (Nothing, Just).

  prepend :: a -> [a] -> [a].
  prepend = __kernel_listPrependRaw.

  reverse :: [a] -> [a].
  reverse = __kernel_listReverseRaw.

  listLengthFrom :: [a] -> Int -> Int.
  listLengthFrom = \(items, length) -> case items {
    | [] -> length
    | [first | rest] -> listLengthFrom rest (length + 1)
  }.

  length :: [a] -> Int.
  length = \(items) -> listLengthFrom items 0.

  isEmpty :: [a] -> Bool.
  isEmpty = \(items) -> case items {
    | [] -> True
    | [first | rest] -> False
  }.

  head :: [a] -> Maybe::Maybe(a).
  head = \(items) -> case items {
    | [] -> Nothing
    | [first | rest] -> Just first
  }.

  tail :: [a] -> Maybe::Maybe([a]).
  tail = \(items) -> case items {
    | [] -> Nothing
    | [first | rest] -> Just rest
  }.

  last :: [a] -> Maybe::Maybe(a).
  last = \(items) -> head (reverse items).

  init :: [a] -> Maybe::Maybe([a]).
  init = \(items) -> case reverse items {
    | [] -> Nothing
    | [last | reversedInit] -> Just (reverse reversedInit)
  }.

  listAtFrom :: Int -> [a] -> Maybe::Maybe(a).
  listAtFrom = \(index, items) -> case items {
    | [] -> Nothing
    | [first | rest] -> if index == 0 then Just first else listAtFrom (index - 1) rest
  }.

  at :: Int -> [a] -> Maybe::Maybe(a).
  at = \(index, items) -> if index < 0 then Nothing else listAtFrom index items.

  listTakeFrom :: Int -> [a] -> [a] -> [a].
  listTakeFrom = \(count, items, reversed) -> if count <= 0 then reverse reversed else case items {
    | [] -> reverse reversed
    | [first | rest] -> listTakeFrom (count - 1) rest (prepend first reversed)
  }.

  take :: Int -> [a] -> [a].
  take = \(count, items) -> listTakeFrom count items [].

  drop :: Int -> [a] -> [a].
  drop = \(count, items) -> if count <= 0 then items else case items {
    | [] -> []
    | [first | rest] -> drop (count - 1) rest
  }.

  splitAt :: Int -> [a] -> ([a], [a]).
  splitAt = \(count, items) -> (take count items, drop count items).

  foldLeft :: (b -> a -> b) -> b -> [a] -> b.
  foldLeft = \(combine, accumulator, items) -> case items {
    | [] -> accumulator
    | [first | rest] -> foldLeft combine (combine accumulator first) rest
  }.

  foldRight :: (a -> b -> b) -> b -> [a] -> b.
  foldRight = \(combine, initial, items) -> foldLeft (\(accumulator, item) -> combine item accumulator) initial (reverse items).

  append :: [a] -> [a] -> [a].
  append = \(left, right) -> foldLeft (\(result, item) -> prepend item result) right (reverse left).

  concat :: [[a]] -> [a].
  concat = \(lists) -> foldRight append [] lists.

  listRepeatFrom :: Int -> a -> [a] -> [a].
  listRepeatFrom = \(count, item, reversed) -> if count <= 0 then reverse reversed else listRepeatFrom (count - 1) item (prepend item reversed).

  repeat :: Int -> a -> [a].
  repeat = \(count, item) -> listRepeatFrom count item [].

  listIntersperseFrom :: a -> [a] -> [a] -> [a].
  listIntersperseFrom = \(separator, items, reversed) -> case items {
    | [] -> reverse reversed
    | [first | rest] -> listIntersperseFrom separator rest (prepend first (prepend separator reversed))
  }.

  intersperse :: a -> [a] -> [a].
  intersperse = \(separator, items) -> case items {
    | [] -> []
    | [first | rest] -> listIntersperseFrom separator rest [first]
  }.

  intercalate :: [a] -> [[a]] -> [a].
  intercalate = \(separator, lists) -> concat (intersperse separator lists).

  listMapFrom :: (a -> b) -> [a] -> [b] -> [b].
  listMapFrom = \(transform, items, reversed) -> case items {
    | [] -> reverse reversed
    | [first | rest] -> listMapFrom transform rest (prepend (transform first) reversed)
  }.

  map :: (a -> b) -> [a] -> [b].
  map = \(transform, items) -> listMapFrom transform items [].

  listFilterFrom :: (a -> Bool) -> [a] -> [a] -> [a].
  listFilterFrom = \(predicate, items, reversed) -> case items {
    | [] -> reverse reversed
    | [first | rest] -> if predicate first then listFilterFrom predicate rest (prepend first reversed) else listFilterFrom predicate rest reversed
  }.

  filter :: (a -> Bool) -> [a] -> [a].
  filter = \(predicate, items) -> listFilterFrom predicate items [].

  listFilterMapFrom :: (a -> Maybe::Maybe(b)) -> [a] -> [b] -> [b].
  listFilterMapFrom = \(transform, items, reversed) -> case items {
    | [] -> reverse reversed
    | [first | rest] -> case transform first {
      | Nothing -> listFilterMapFrom transform rest reversed
      | Just item -> listFilterMapFrom transform rest (prepend item reversed)
    }
  }.

  filterMap :: (a -> Maybe::Maybe(b)) -> [a] -> [b].
  filterMap = \(transform, items) -> listFilterMapFrom transform items [].

  listPartitionFrom :: (a -> Bool) -> [a] -> [a] -> [a] -> ([a], [a]).
  listPartitionFrom = \(predicate, items, matching, rejected) -> case items {
    | [] -> (reverse matching, reverse rejected)
    | [first | rest] -> if predicate first then listPartitionFrom predicate rest (prepend first matching) rejected else listPartitionFrom predicate rest matching (prepend first rejected)
  }.

  partition :: (a -> Bool) -> [a] -> ([a], [a]).
  partition = \(predicate, items) -> listPartitionFrom predicate items [] [].

  listScanLeftFrom :: (b -> a -> b) -> b -> [a] -> [b] -> [b].
  listScanLeftFrom = \(combine, accumulator, items, reversed) -> case items {
    | [] -> reverse reversed
    | [first | rest] -> { next = combine accumulator first.
      listScanLeftFrom combine next rest (prepend next reversed).
    }
  }.

  scanLeft :: (b -> a -> b) -> b -> [a] -> [b].
  scanLeft = \(combine, initial, items) -> listScanLeftFrom combine initial items [initial].

  any :: (a -> Bool) -> [a] -> Bool.
  any = \(predicate, items) -> case items {
    | [] -> False
    | [first | rest] -> if predicate first then True else any predicate rest
  }.

  all :: (a -> Bool) -> [a] -> Bool.
  all = \(predicate, items) -> case items {
    | [] -> True
    | [first | rest] -> if predicate first then all predicate rest else False
  }.

  contains :: @{Equatable(a)}: a -> [a] -> Bool.
  contains = \(needle, items) -> any (\(item) -> Equatable::equals needle item) items.

  find :: (a -> Bool) -> [a] -> Maybe::Maybe(a).
  find = \(predicate, items) -> case items {
    | [] -> Nothing
    | [first | rest] -> if predicate first then Just first else find predicate rest
  }.

  listFindIndexFrom :: (a -> Bool) -> Int -> [a] -> Maybe::Maybe(Int).
  listFindIndexFrom = \(predicate, index, items) -> case items {
    | [] -> Nothing
    | [first | rest] -> if predicate first then Just index else listFindIndexFrom predicate (index + 1) rest
  }.

  findIndex :: (a -> Bool) -> [a] -> Maybe::Maybe(Int).
  findIndex = \(predicate, items) -> listFindIndexFrom predicate 0 items.

  listZipFrom :: [a] -> [b] -> [(a, b)] -> [(a, b)].
  listZipFrom = \(left, right, reversed) -> case left {
    | [] -> reverse reversed
    | [leftFirst | leftRest] -> case right {
      | [] -> reverse reversed
      | [rightFirst | rightRest] -> listZipFrom leftRest rightRest (prepend (leftFirst, rightFirst) reversed)
    }
  }.

  zip :: [a] -> [b] -> [(a, b)].
  zip = \(left, right) -> listZipFrom left right [].

  listUnzipFrom :: [(a, b)] -> [a] -> [b] -> ([a], [b]).
  listUnzipFrom = \(pairs, left, right) -> case pairs {
    | [] -> (reverse left, reverse right)
    | [(leftValue, rightValue) | rest] -> listUnzipFrom rest (prepend leftValue left) (prepend rightValue right)
  }.

  unzip :: [(a, b)] -> ([a], [b]).
  unzip = \(pairs) -> listUnzipFrom pairs [] [].

  listIndexedFrom :: Int -> [a] -> [(Int, a)] -> [(Int, a)].
  listIndexedFrom = \(index, items, reversed) -> case items {
    | [] -> reverse reversed
    | [first | rest] -> listIndexedFrom (index + 1) rest (prepend (index, first) reversed)
  }.

  indexed :: [a] -> [(Int, a)].
  indexed = \(items) -> listIndexedFrom 0 items [].

  distinct :: @{Equatable(a)}: [a] -> [a].
  distinct = \(items) -> foldLeft (\(result, item) -> if contains item result then result else append result [item]) [] items.

  groupBy :: (a -> a -> Bool) -> [a] -> [[a]].
  groupBy = \(related, items) -> foldRight (\(item, groups) -> case groups {
    | [] -> [[item]]
    | [group | restGroups] -> case group {
      | [] -> prepend [item] groups
      | [first | rest] -> if related item first then prepend (prepend item group) restGroups else prepend [item] groups
    }
  }) [] items.

  group :: @{Equatable(a)}: [a] -> [[a]].
  group = \(items) -> groupBy (\(left, right) -> Equatable::equals left right) items.

  minimum :: @{Comparable(a)}: [a] -> Maybe::Maybe(a).
  minimum = \(items) -> case items {
    | [] -> Nothing
    | [first | rest] -> Just (foldLeft (\(best, item) -> case Comparable::compare item best { | LT -> item | EQ -> best | GT -> best }) first rest)
  }.

  maximum :: @{Comparable(a)}: [a] -> Maybe::Maybe(a).
  maximum = \(items) -> case items {
    | [] -> Nothing
    | [first | rest] -> Just (foldLeft (\(best, item) -> case Comparable::compare item best { | LT -> best | EQ -> best | GT -> item }) first rest)
  }.

  listMergeByFrom :: (a -> a -> Ordering) -> [a] -> [a] -> [a] -> [a].
  listMergeByFrom = \(compare, left, right, reversed) -> case left {
    | [] -> foldLeft (\(result, item) -> prepend item result) right reversed
    | [leftFirst | leftRest] -> case right {
      | [] -> foldLeft (\(result, item) -> prepend item result) left reversed
      | [rightFirst | rightRest] -> case compare leftFirst rightFirst {
        | LT -> listMergeByFrom compare leftRest right (prepend leftFirst reversed)
        | EQ -> listMergeByFrom compare leftRest right (prepend leftFirst reversed)
        | GT -> listMergeByFrom compare left rightRest (prepend rightFirst reversed)
      }
    }
  }.

  listMergeBy :: (a -> a -> Ordering) -> [a] -> [a] -> [a].
  listMergeBy = \(compare, left, right) -> listMergeByFrom compare left right [].

  listMergePairsByFrom :: (a -> a -> Ordering) -> [[a]] -> [[a]] -> [[a]].
  listMergePairsByFrom = \(compare, runs, reversed) -> case runs {
    | [] -> reverse reversed
    | [first | remaining] -> case remaining {
      | [] -> reverse (prepend first reversed)
      | [second | rest] -> listMergePairsByFrom compare rest (prepend (listMergeBy compare first second) reversed)
    }
  }.

  listMergePairsBy :: (a -> a -> Ordering) -> [[a]] -> [[a]].
  listMergePairsBy = \(compare, runs) -> listMergePairsByFrom compare runs [].

  listMergeRunsBy :: (a -> a -> Ordering) -> [[a]] -> [a].
  listMergeRunsBy = \(compare, runs) -> case runs {
    | [] -> []
    | [first | remaining] -> case remaining {
      | [] -> first
      | [second | rest] -> listMergeRunsBy compare (listMergePairsBy compare runs)
    }
  }.

  sortBy :: (a -> a -> Ordering) -> [a] -> [a].
  sortBy = \(compare, items) -> listMergeRunsBy compare (map (\(item) -> [item]) items).

  sort :: @{Comparable(a)}: [a] -> [a].
  sort = \(items) -> sortBy (\(left, right) -> Comparable::compare left right) items.
}
