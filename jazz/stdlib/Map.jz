module Map (
  type Map,
  value empty,
  value singleton,
  value fromList,
  value toList,
  value size,
  value isEmpty,
  value lookup,
  value getOr,
  value containsKey,
  value insert,
  value replace,
  value remove,
  value update,
  value minimum,
  value maximum,
  value popMinimum,
  value popMaximum,
  value keys,
  value values,
  value mapValues,
  value filter,
  value foldLeft,
  value foldRight
) {
  import List as List.
  import Maybe as Maybe.
  import Maybe (Nothing, Just).

  data Map k v
    = MapEmpty
    | MapNode Int Int Map(k, v) k v Map(k, v).

  empty :: Map(k, v).
  empty = MapEmpty.

  mapHeight :: Map(k, v) -> Int.
  mapHeight = \(map) -> case map {
    | MapEmpty -> 0
    | MapNode height size left key item right -> height
  }.

  size :: Map(k, v) -> Int.
  size = \(map) -> case map {
    | MapEmpty -> 0
    | MapNode height size left key item right -> size
  }.

  isEmpty :: Map(k, v) -> Bool.
  isEmpty = \(map) -> size map == 0.

  mapMaximumInt :: Int -> Int -> Int.
  mapMaximumInt = \(left, right) -> if left > right then left else right.

  mapNode :: Map(k, v) -> k -> v -> Map(k, v) -> Map(k, v).
  mapNode = \(left, key, item, right) ->
    MapNode
      (1 + mapMaximumInt (mapHeight left) (mapHeight right))
      (1 + size left + size right)
      left
      key
      item
      right.

  singleton :: k -> v -> Map(k, v).
  singleton = \(key, item) -> mapNode empty key item empty.

  mapRotateLeft :: Map(k, v) -> k -> v -> Map(k, v) -> Map(k, v).
  mapRotateLeft = \(left, key, item, right) -> case right {
    | MapEmpty -> mapNode left key item right
    | MapNode rightHeight rightSize rightLeft rightKey rightValue rightRight ->
      mapNode (mapNode left key item rightLeft) rightKey rightValue rightRight
  }.

  mapRotateRight :: Map(k, v) -> k -> v -> Map(k, v) -> Map(k, v).
  mapRotateRight = \(left, key, item, right) -> case left {
    | MapEmpty -> mapNode left key item right
    | MapNode leftHeight leftSize leftLeft leftKey leftValue leftRight ->
      mapNode leftLeft leftKey leftValue (mapNode leftRight key item right)
  }.

  mapBalance :: Map(k, v) -> k -> v -> Map(k, v) -> Map(k, v).
  mapBalance = \(left, key, item, right) -> {
    balance = mapHeight left - mapHeight right.
    if balance > 1 then case left {
      | MapEmpty -> mapNode left key item right
      | MapNode leftHeight leftSize leftLeft leftKey leftValue leftRight ->
        if mapHeight leftLeft >= mapHeight leftRight
          then mapRotateRight left key item right
          else mapRotateRight (mapRotateLeft leftLeft leftKey leftValue leftRight) key item right
    } else if balance < (0 - 1) then case right {
      | MapEmpty -> mapNode left key item right
      | MapNode rightHeight rightSize rightLeft rightKey rightValue rightRight ->
        if mapHeight rightRight >= mapHeight rightLeft
          then mapRotateLeft left key item right
          else mapRotateLeft left key item (mapRotateRight rightLeft rightKey rightValue rightRight)
    } else mapNode left key item right.
  }.

  insert :: @{Comparable(k)}: Map(k, v) -> k -> v -> Map(k, v).
  insert = \(map, key, item) -> case map {
    | MapEmpty -> singleton key item
    | MapNode height size left currentKey currentValue right -> case Comparable::compare key currentKey {
      | LT -> mapBalance (insert left key item) currentKey currentValue right
      | EQ -> mapNode left currentKey item right
      | GT -> mapBalance left currentKey currentValue (insert right key item)
    }
  }.

  fromList :: @{Comparable(k)}: [(k, v)] -> Map(k, v).
  fromList = \(entries) -> List::foldLeft (\(map, entry) -> case entry {
    | (key, item) -> insert map key item
  }) empty entries.

  mapToListFrom :: Map(k, v) -> [(k, v)] -> [(k, v)].
  mapToListFrom = \(map, suffix) -> case map {
    | MapEmpty -> suffix
    | MapNode height size left key item right ->
      mapToListFrom left (List::prepend (key, item) (mapToListFrom right suffix))
  }.

  toList :: Map(k, v) -> [(k, v)].
  toList = \(map) -> mapToListFrom map [].

  lookup :: @{Comparable(k)}: Map(k, v) -> k -> Maybe::Maybe(v).
  lookup = \(map, key) -> case map {
    | MapEmpty -> Nothing
    | MapNode height size left currentKey item right -> case Comparable::compare key currentKey {
      | LT -> lookup left key
      | EQ -> Just item
      | GT -> lookup right key
    }
  }.

  getOr :: @{Comparable(k)}: Map(k, v) -> k -> v -> v.
  getOr = \(map, key, fallback) -> case lookup map key {
    | Nothing -> fallback
    | Just item -> item
  }.

  containsKey :: @{Comparable(k)}: Map(k, v) -> k -> Bool.
  containsKey = \(map, key) -> Maybe::isJust (lookup map key).

  replace :: @{Comparable(k)}: Map(k, v) -> k -> v -> Maybe::Maybe(Map(k, v)).
  replace = \(map, key, item) -> case map {
    | MapEmpty -> Nothing
    | MapNode height size left currentKey currentValue right -> case Comparable::compare key currentKey {
      | LT -> case replace left key item {
        | Nothing -> Nothing
        | Just updatedLeft -> Just (mapBalance updatedLeft currentKey currentValue right)
      }
      | EQ -> Just (mapNode left currentKey item right)
      | GT -> case replace right key item {
        | Nothing -> Nothing
        | Just updatedRight -> Just (mapBalance left currentKey currentValue updatedRight)
      }
    }
  }.

  minimum :: Map(k, v) -> Maybe::Maybe((k, v)).
  minimum = \(map) -> case map {
    | MapEmpty -> Nothing
    | MapNode height size left key item right -> case left {
      | MapEmpty -> Just (key, item)
      | MapNode leftHeight leftSize leftLeft leftKey leftValue leftRight -> minimum left
    }
  }.

  maximum :: Map(k, v) -> Maybe::Maybe((k, v)).
  maximum = \(map) -> case map {
    | MapEmpty -> Nothing
    | MapNode height size left key item right -> case right {
      | MapEmpty -> Just (key, item)
      | MapNode rightHeight rightSize rightLeft rightKey rightValue rightRight -> maximum right
    }
  }.

  popMinimum :: Map(k, v) -> Maybe::Maybe(((k, v), Map(k, v))).
  popMinimum = \(map) -> case map {
    | MapEmpty -> Nothing
    | MapNode height size left key item right -> case left {
      | MapEmpty -> Just ((key, item), right)
      | MapNode leftHeight leftSize leftLeft leftKey leftValue leftRight -> case popMinimum left {
        | Nothing -> Nothing
        | Just (entry, updatedLeft) -> Just (entry, mapBalance updatedLeft key item right)
      }
    }
  }.

  popMaximum :: Map(k, v) -> Maybe::Maybe(((k, v), Map(k, v))).
  popMaximum = \(map) -> case map {
    | MapEmpty -> Nothing
    | MapNode height size left key item right -> case right {
      | MapEmpty -> Just ((key, item), left)
      | MapNode rightHeight rightSize rightLeft rightKey rightValue rightRight -> case popMaximum right {
        | Nothing -> Nothing
        | Just (entry, updatedRight) -> Just (entry, mapBalance left key item updatedRight)
      }
    }
  }.

  remove :: @{Comparable(k)}: Map(k, v) -> k -> Map(k, v).
  remove = \(map, key) -> case map {
    | MapEmpty -> map
    | MapNode height size left currentKey currentValue right -> case Comparable::compare key currentKey {
      | LT -> mapBalance (remove left key) currentKey currentValue right
      | EQ -> case left {
        | MapEmpty -> right
        | MapNode leftHeight leftSize leftLeft leftKey leftValue leftRight -> case right {
          | MapEmpty -> left
          | MapNode rightHeight rightSize rightLeft rightKey rightValue rightRight -> case popMinimum right {
            | Nothing -> left
            | Just ((replacementKey, replacementValue), updatedRight) ->
              mapBalance left replacementKey replacementValue updatedRight
          }
        }
      }
      | GT -> mapBalance left currentKey currentValue (remove right key)
    }
  }.

  update :: @{Comparable(k)}: Map(k, v) -> k -> (Maybe::Maybe(v) -> Maybe::Maybe(v)) -> Map(k, v).
  update = \(map, key, update) -> case lookup map key {
    | Nothing -> case update Nothing {
      | Nothing -> map
      | Just item -> insert map key item
    }
    | Just current -> case update (Just current) {
      | Nothing -> remove map key
      | Just item -> insert map key item
    }
  }.

  keys :: Map(k, v) -> [k].
  keys = \(map) -> List::map (\(entry) -> case entry {
    | (key, item) -> key
  }) (toList map).

  values :: Map(k, v) -> [v].
  values = \(map) -> List::map (\(entry) -> case entry {
    | (key, item) -> item
  }) (toList map).

  mapValues :: Map(k, v) -> (v -> w) -> Map(k, w).
  mapValues = \(map, transform) -> case map {
    | MapEmpty -> MapEmpty
    | MapNode height size left key item right ->
      MapNode height size (mapValues left transform) key (transform item) (mapValues right transform)
  }.

  foldLeft :: Map(k, v) -> a -> (a -> k -> v -> a) -> a.
  foldLeft = \(map, initial, combine) -> case map {
    | MapEmpty -> initial
    | MapNode height size left key item right -> {
      afterLeft = foldLeft left initial combine.
      afterValue = combine afterLeft key item.
      foldLeft right afterValue combine.
    }
  }.

  foldRight :: Map(k, v) -> a -> (k -> v -> a -> a) -> a.
  foldRight = \(map, initial, combine) -> case map {
    | MapEmpty -> initial
    | MapNode height size left key item right -> {
      afterRight = foldRight right initial combine.
      afterValue = combine key item afterRight.
      foldRight left afterValue combine.
    }
  }.

  filter :: @{Comparable(k)}: Map(k, v) -> (k -> v -> Bool) -> Map(k, v).
  filter = \(map, predicate) -> foldLeft map empty (\(result, key, item) ->
    if predicate key item then insert result key item else result
  ).

  impl Mappable(Map(k)) { map = \(change, entries) -> mapValues entries change. }.
  impl Reducible(Map(k)) {
    foldLeft = \(step, initial, entries) -> foldLeft entries initial (\(acc, key, item) -> step acc item).
    foldRight = \(step, initial, entries) -> foldRight entries initial (\(key, item, acc) -> step item acc).
  }.
}
