module Map (
  type Map,
  value mapEmpty,
  value mapSingleton,
  value mapFromList,
  value mapToList,
  value mapSize,
  value mapIsEmpty,
  value mapLookup,
  value mapGetOr,
  value mapContainsKey,
  value mapInsert,
  value mapReplace,
  value mapRemove,
  value mapUpdate,
  value mapMinimum,
  value mapMaximum,
  value mapPopMinimum,
  value mapPopMaximum,
  value mapKeys,
  value mapValues,
  value mapMapValues,
  value mapFilter,
  value mapFoldLeft,
  value mapFoldRight
) {
  import List.
  import Maybe.

  data Map k v
    = MapEmpty
    | MapNode Int Int Map(k, v) k v Map(k, v).

  mapEmpty :: Map(k, v).
  mapEmpty = MapEmpty.

  mapHeight :: Map(k, v) -> Int.
  mapHeight = \(map) -> case map {
    | MapEmpty -> 0
    | MapNode height size left key item right -> height
  }.

  mapSize :: Map(k, v) -> Int.
  mapSize = \(map) -> case map {
    | MapEmpty -> 0
    | MapNode height size left key item right -> size
  }.

  mapIsEmpty :: Map(k, v) -> Bool.
  mapIsEmpty = \(map) -> mapSize map == 0.

  mapMaximumInt :: Int -> Int -> Int.
  mapMaximumInt = \(left, right) -> if left > right then left else right.

  mapNode :: Map(k, v) -> k -> v -> Map(k, v) -> Map(k, v).
  mapNode = \(left, key, item, right) ->
    MapNode
      (1 + mapMaximumInt (mapHeight left) (mapHeight right))
      (1 + mapSize left + mapSize right)
      left
      key
      item
      right.

  mapSingleton :: k -> v -> Map(k, v).
  mapSingleton = \(key, item) -> mapNode mapEmpty key item mapEmpty.

  mapRotateLeft :: Map(k, v) -> k -> v -> Map(k, v) -> Map(k, v).
  mapRotateLeft = \(left, key, item, right) -> case right {
    | MapEmpty -> mapNode left key item right
    | MapNode rightHeight rightSize rightLeft rightKey rightValue rightRight ->
      mapNode (mapNode left key item rightLeft) rightKey rightValue rightRight
  }.

  mapRotateRight :: Map(k, v) -> k -> v -> Map(k, v) -> Map(k, v).
  mapRotateRight = \(left, key, item, right) -> case left {
    | MapEmpty -> mapNode left key item right
    | MapNode leftHeight leftSize leftLeft leftKey leftValue leftRight ->
      mapNode leftLeft leftKey leftValue (mapNode leftRight key item right)
  }.

  mapBalance :: Map(k, v) -> k -> v -> Map(k, v) -> Map(k, v).
  mapBalance = \(left, key, item, right) -> {
    balance = mapHeight left - mapHeight right.
    if balance > 1 then case left {
      | MapEmpty -> mapNode left key item right
      | MapNode leftHeight leftSize leftLeft leftKey leftValue leftRight ->
        if mapHeight leftLeft >= mapHeight leftRight
          then mapRotateRight left key item right
          else mapRotateRight (mapRotateLeft leftLeft leftKey leftValue leftRight) key item right
    } else if balance < (0 - 1) then case right {
      | MapEmpty -> mapNode left key item right
      | MapNode rightHeight rightSize rightLeft rightKey rightValue rightRight ->
        if mapHeight rightRight >= mapHeight rightLeft
          then mapRotateLeft left key item right
          else mapRotateLeft left key item (mapRotateRight rightLeft rightKey rightValue rightRight)
    } else mapNode left key item right.
  }.

  mapInsert :: @{Ord(k)}: Map(k, v) -> k -> v -> Map(k, v).
  mapInsert = \(map, key, item) -> case map {
    | MapEmpty -> mapSingleton key item
    | MapNode height size left currentKey currentValue right -> case Ord::compare key currentKey {
      | LT -> mapBalance (mapInsert left key item) currentKey currentValue right
      | EQ -> mapNode left currentKey item right
      | GT -> mapBalance left currentKey currentValue (mapInsert right key item)
    }
  }.

  mapFromList :: @{Ord(k)}: [(k, v)] -> Map(k, v).
  mapFromList = \(entries) -> listFoldLeft (\(map, entry) -> case entry {
    | (key, item) -> mapInsert map key item
  }) mapEmpty entries.

  mapToListFrom :: Map(k, v) -> [(k, v)] -> [(k, v)].
  mapToListFrom = \(map, suffix) -> case map {
    | MapEmpty -> suffix
    | MapNode height size left key item right ->
      mapToListFrom left (listPrepend (key, item) (mapToListFrom right suffix))
  }.

  mapToList :: Map(k, v) -> [(k, v)].
  mapToList = \(map) -> mapToListFrom map [].

  mapLookup :: @{Ord(k)}: Map(k, v) -> k -> Maybe(v).
  mapLookup = \(map, key) -> case map {
    | MapEmpty -> Nothing
    | MapNode height size left currentKey item right -> case Ord::compare key currentKey {
      | LT -> mapLookup left key
      | EQ -> Just item
      | GT -> mapLookup right key
    }
  }.

  mapGetOr :: @{Ord(k)}: Map(k, v) -> k -> v -> v.
  mapGetOr = \(map, key, fallback) -> case mapLookup map key {
    | Nothing -> fallback
    | Just item -> item
  }.

  mapContainsKey :: @{Ord(k)}: Map(k, v) -> k -> Bool.
  mapContainsKey = \(map, key) -> maybeIsJust (mapLookup map key).

  mapReplace :: @{Ord(k)}: Map(k, v) -> k -> v -> Maybe(Map(k, v)).
  mapReplace = \(map, key, item) -> case map {
    | MapEmpty -> Nothing
    | MapNode height size left currentKey currentValue right -> case Ord::compare key currentKey {
      | LT -> case mapReplace left key item {
        | Nothing -> Nothing
        | Just updatedLeft -> Just (mapBalance updatedLeft currentKey currentValue right)
      }
      | EQ -> Just (mapNode left currentKey item right)
      | GT -> case mapReplace right key item {
        | Nothing -> Nothing
        | Just updatedRight -> Just (mapBalance left currentKey currentValue updatedRight)
      }
    }
  }.

  mapMinimum :: Map(k, v) -> Maybe((k, v)).
  mapMinimum = \(map) -> case map {
    | MapEmpty -> Nothing
    | MapNode height size left key item right -> case left {
      | MapEmpty -> Just (key, item)
      | MapNode leftHeight leftSize leftLeft leftKey leftValue leftRight -> mapMinimum left
    }
  }.

  mapMaximum :: Map(k, v) -> Maybe((k, v)).
  mapMaximum = \(map) -> case map {
    | MapEmpty -> Nothing
    | MapNode height size left key item right -> case right {
      | MapEmpty -> Just (key, item)
      | MapNode rightHeight rightSize rightLeft rightKey rightValue rightRight -> mapMaximum right
    }
  }.

  mapPopMinimum :: Map(k, v) -> Maybe(((k, v), Map(k, v))).
  mapPopMinimum = \(map) -> case map {
    | MapEmpty -> Nothing
    | MapNode height size left key item right -> case left {
      | MapEmpty -> Just ((key, item), right)
      | MapNode leftHeight leftSize leftLeft leftKey leftValue leftRight -> case mapPopMinimum left {
        | Nothing -> Nothing
        | Just (entry, updatedLeft) -> Just (entry, mapBalance updatedLeft key item right)
      }
    }
  }.

  mapPopMaximum :: Map(k, v) -> Maybe(((k, v), Map(k, v))).
  mapPopMaximum = \(map) -> case map {
    | MapEmpty -> Nothing
    | MapNode height size left key item right -> case right {
      | MapEmpty -> Just ((key, item), left)
      | MapNode rightHeight rightSize rightLeft rightKey rightValue rightRight -> case mapPopMaximum right {
        | Nothing -> Nothing
        | Just (entry, updatedRight) -> Just (entry, mapBalance left key item updatedRight)
      }
    }
  }.

  mapRemove :: @{Ord(k)}: Map(k, v) -> k -> Map(k, v).
  mapRemove = \(map, key) -> case map {
    | MapEmpty -> map
    | MapNode height size left currentKey currentValue right -> case Ord::compare key currentKey {
      | LT -> mapBalance (mapRemove left key) currentKey currentValue right
      | EQ -> case left {
        | MapEmpty -> right
        | MapNode leftHeight leftSize leftLeft leftKey leftValue leftRight -> case right {
          | MapEmpty -> left
          | MapNode rightHeight rightSize rightLeft rightKey rightValue rightRight -> case mapPopMinimum right {
            | Nothing -> left
            | Just ((replacementKey, replacementValue), updatedRight) ->
              mapBalance left replacementKey replacementValue updatedRight
          }
        }
      }
      | GT -> mapBalance left currentKey currentValue (mapRemove right key)
    }
  }.

  mapUpdate :: @{Ord(k)}: Map(k, v) -> k -> (Maybe(v) -> Maybe(v)) -> Map(k, v).
  mapUpdate = \(map, key, update) -> case mapLookup map key {
    | Nothing -> case update Nothing {
      | Nothing -> map
      | Just item -> mapInsert map key item
    }
    | Just current -> case update (Just current) {
      | Nothing -> mapRemove map key
      | Just item -> mapInsert map key item
    }
  }.

  mapKeys :: Map(k, v) -> [k].
  mapKeys = \(map) -> listMap (\(entry) -> case entry {
    | (key, item) -> key
  }) (mapToList map).

  mapValues :: Map(k, v) -> [v].
  mapValues = \(map) -> listMap (\(entry) -> case entry {
    | (key, item) -> item
  }) (mapToList map).

  mapMapValues :: Map(k, v) -> (v -> w) -> Map(k, w).
  mapMapValues = \(map, transform) -> case map {
    | MapEmpty -> MapEmpty
    | MapNode height size left key item right ->
      MapNode height size (mapMapValues left transform) key (transform item) (mapMapValues right transform)
  }.

  mapFoldLeft :: Map(k, v) -> a -> (a -> k -> v -> a) -> a.
  mapFoldLeft = \(map, initial, combine) -> case map {
    | MapEmpty -> initial
    | MapNode height size left key item right -> {
      afterLeft = mapFoldLeft left initial combine.
      afterValue = combine afterLeft key item.
      mapFoldLeft right afterValue combine.
    }
  }.

  mapFoldRight :: Map(k, v) -> a -> (k -> v -> a -> a) -> a.
  mapFoldRight = \(map, initial, combine) -> case map {
    | MapEmpty -> initial
    | MapNode height size left key item right -> {
      afterRight = mapFoldRight right initial combine.
      afterValue = combine key item afterRight.
      mapFoldRight left afterValue combine.
    }
  }.

  mapFilter :: @{Ord(k)}: Map(k, v) -> (k -> v -> Bool) -> Map(k, v).
  mapFilter = \(map, predicate) -> mapFoldLeft map mapEmpty (\(result, key, item) ->
    if predicate key item then mapInsert result key item else result
  ).
}
