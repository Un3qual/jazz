module Maybe (
  type Maybe(..),
  value maybeMap,
  value maybeAndThen,
  value maybeWithDefault,
  value maybeOrElse,
  value maybeFilter,
  value maybeIsJust,
  value maybeIsNothing,
  value maybeToList,
  value maybeFromList
) {
  data Maybe a = Nothing | Just a.

  maybeMap :: (a -> b) -> Maybe(a) -> Maybe(b).
  maybeMap = \(transform, maybeValue) -> case maybeValue {
    | Nothing -> Nothing
    | Just item -> Just (transform item)
  }.

  maybeAndThen :: (a -> Maybe(b)) -> Maybe(a) -> Maybe(b).
  maybeAndThen = \(transform, maybeValue) -> case maybeValue {
    | Nothing -> Nothing
    | Just item -> transform item
  }.

  maybeWithDefault :: a -> Maybe(a) -> a.
  maybeWithDefault = \(defaultValue, maybeValue) -> case maybeValue {
    | Nothing -> defaultValue
    | Just item -> item
  }.

  maybeOrElse :: Maybe(a) -> Maybe(a) -> Maybe(a).
  maybeOrElse = \(fallback, maybeValue) -> case maybeValue {
    | Nothing -> fallback
    | Just item -> Just item
  }.

  maybeFilter :: (a -> Bool) -> Maybe(a) -> Maybe(a).
  maybeFilter = \(predicate, maybeValue) -> case maybeValue {
    | Nothing -> Nothing
    | Just item -> if predicate item then Just item else Nothing
  }.

  maybeIsJust :: Maybe(a) -> Bool.
  maybeIsJust = \(maybeValue) -> case maybeValue {
    | Nothing -> False
    | Just item -> True
  }.

  maybeIsNothing :: Maybe(a) -> Bool.
  maybeIsNothing = \(maybeValue) -> case maybeValue {
    | Nothing -> True
    | Just item -> False
  }.

  maybeToList :: Maybe(a) -> [a].
  maybeToList = \(maybeValue) -> case maybeValue {
    | Nothing -> []
    | Just item -> [item]
  }.

  maybeFromList :: [a] -> Maybe(a).
  maybeFromList = \(values) -> case values {
    | [] -> Nothing
    | [first | rest] -> Just first
  }.
}
