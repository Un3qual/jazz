module NonEmpty (
  type NonEmpty(..),
  value singleton,
  value fromList,
  value toList,
  value head,
  value tail,
  value last,
  value prepend,
  value appendList,
  value map,
  value length,
  value foldLeft,
  value foldRight
) {
  import List as List.
  import Maybe as Maybe.
  import Maybe (Nothing, Just).

  data NonEmpty a = NonEmpty a [a].

  singleton :: a -> NonEmpty(a).
  singleton = \(item) -> NonEmpty item [].

  fromList :: [a] -> Maybe::Maybe(NonEmpty(a)).
  fromList = \(values) -> case values {
    | [] -> Nothing
    | [first | rest] -> Just (NonEmpty first rest)
  }.

  toList :: NonEmpty(a) -> [a].
  toList = \(nonEmpty) -> case nonEmpty {
    | NonEmpty first rest -> List::prepend first rest
  }.

  head :: NonEmpty(a) -> a.
  head = \(nonEmpty) -> case nonEmpty {
    | NonEmpty first rest -> first
  }.

  tail :: NonEmpty(a) -> [a].
  tail = \(nonEmpty) -> case nonEmpty {
    | NonEmpty first rest -> rest
  }.

  last :: NonEmpty(a) -> a.
  last = \(nonEmpty) -> case nonEmpty {
    | NonEmpty first rest -> case List::last rest {
      | Nothing -> first
      | Just item -> item
    }
  }.

  prepend :: a -> NonEmpty(a) -> NonEmpty(a).
  prepend = \(item, nonEmpty) -> NonEmpty item (toList nonEmpty).

  appendList :: NonEmpty(a) -> [a] -> NonEmpty(a).
  appendList = \(nonEmpty, suffix) -> case nonEmpty {
    | NonEmpty first rest -> NonEmpty first (List::append rest suffix)
  }.

  map :: (a -> b) -> NonEmpty(a) -> NonEmpty(b).
  map = \(transform, nonEmpty) -> case nonEmpty {
    | NonEmpty first rest -> NonEmpty (transform first) (List::map transform rest)
  }.

  length :: NonEmpty(a) -> Int.
  length = \(nonEmpty) -> 1 + (List::length (tail nonEmpty)).

  foldLeft :: (b -> a -> b) -> b -> NonEmpty(a) -> b.
  foldLeft = \(combine, initial, nonEmpty) -> case nonEmpty {
    | NonEmpty first rest -> List::foldLeft combine (combine initial first) rest
  }.

  foldRight :: (a -> b -> b) -> b -> NonEmpty(a) -> b.
  foldRight = \(combine, initial, nonEmpty) -> List::foldRight combine initial (toList nonEmpty).

  impl @{Equatable(a)}: Equatable(NonEmpty(a)) {
    equals = \(left, right) -> equals (toList left) (toList right).
  }.
  impl Mappable(NonEmpty) { map = map. }.
  impl Reducible(NonEmpty) { foldLeft = foldLeft. foldRight = foldRight. }.
  impl Combinable(NonEmpty(a)) {
    combine = \(left, right) -> appendList left (toList right).
  }.
}
