}.
impl Comparable(Int) {
compare = \(left, right) -> if __kernel_lessThan left right then LT else if __kernel_greaterThan left right then GT else EQ.
}.
impl Comparable(Float) {
compare = \(left, right) -> if __kernel_lessThan left right then LT else if __kernel_greaterThan left right then GT else EQ.
}.
impl Comparable(Char) {
compare = \(left, right) -> if __kernel_lessThan (__kernel_charToUInt32 left) (__kernel_charToUInt32 right) then LT else if __kernel_greaterThan (__kernel_charToUInt32 left) (__kernel_charToUInt32 right) then GT else EQ.
}.
impl Comparable(Text) {
compare = __prelude_compareText.
}.
