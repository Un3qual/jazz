module Queue (
  type Queue,
  value empty,
  value singleton,
  value fromList,
  value toList,
  value size,
  value isEmpty,
  value enqueue,
  value enqueueAll,
  value peek,
  value dequeue,
  value map,
  value foldLeft,
  value foldRight
) {
  import List as List.
  import Maybe as Maybe.
  import Maybe (Nothing, Just).

  data Queue a = Queue [a] [a] Int.

  empty :: Queue(a).
  empty = Queue [] [] 0.

  singleton :: a -> Queue(a).
  singleton = \(item) -> Queue [item] [] 1.

  fromList :: [a] -> Queue(a).
  fromList = \(values) -> Queue values [] (List::length values).

  toList :: Queue(a) -> [a].
  toList = \(queue) -> case queue {
    | Queue front reversedRear size -> List::append front (List::reverse reversedRear)
  }.

  size :: Queue(a) -> Int.
  size = \(queue) -> case queue {
    | Queue front reversedRear size -> size
  }.

  isEmpty :: Queue(a) -> Bool.
  isEmpty = \(queue) -> size queue == 0.

  enqueue :: Queue(a) -> a -> Queue(a).
  enqueue = \(queue, item) -> case queue {
    | Queue front reversedRear size -> Queue front (List::prepend item reversedRear) (size + 1)
  }.

  enqueueAll :: Queue(a) -> [a] -> Queue(a).
  enqueueAll = \(queue, values) -> List::foldLeft enqueue queue values.

  queueNormalize :: Queue(a) -> Queue(a).
  queueNormalize = \(queue) -> case queue {
    | Queue front reversedRear size -> case front {
      | [] -> case reversedRear {
        | [] -> queue
        | [first | rest] -> Queue (List::reverse reversedRear) [] size
      }
      | [first | rest] -> queue
    }
  }.

  peek :: Queue(a) -> Maybe::Maybe(a).
  peek = \(queue) -> case queueNormalize queue {
    | Queue front reversedRear size -> case front {
      | [] -> Nothing
      | [first | rest] -> Just first
    }
  }.

  dequeue :: Queue(a) -> Maybe::Maybe((a, Queue(a))).
  dequeue = \(queue) -> case queueNormalize queue {
    | Queue front reversedRear size -> case front {
      | [] -> Nothing
      | [first | rest] -> Just (first, Queue rest reversedRear (size - 1))
    }
  }.

  map :: Queue(a) -> (a -> b) -> Queue(b).
  map = \(queue, transform) -> case queue {
    | Queue front reversedRear size -> Queue (List::map transform front) (List::map transform reversedRear) size
  }.

  foldLeft :: Queue(a) -> b -> (b -> a -> b) -> b.
  foldLeft = \(queue, initial, combine) -> List::foldLeft combine initial (toList queue).

  foldRight :: Queue(a) -> b -> (a -> b -> b) -> b.
  foldRight = \(queue, initial, combine) -> List::foldRight combine initial (toList queue).

  impl @{Equatable(a)}: Equatable(Queue(a)) {
    equals = \(left, right) -> equals (toList left) (toList right).
  }.
  impl Mappable(Queue) { map = \(change, queue) -> map queue change. }.
  impl Reducible(Queue) {
    foldLeft = \(step, initial, queue) -> foldLeft queue initial step.
    foldRight = \(step, initial, queue) -> foldRight queue initial step.
  }.
  impl Combinable(Queue(a)) {
    combine = \(left, right) -> enqueueAll left (toList right).
  }.
}
