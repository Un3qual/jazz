module Result (
  type Result(..),
  value map,
  value mapError,
  value andThen,
  value recover,
  value withDefault,
  value isOk,
  value isErr,
  value toMaybe,
  value errorToMaybe,
  value fromMaybe
) {
  import Maybe as Maybe.
  import Maybe (Nothing, Just).

  data Result e a = Err e | Ok a.

  map :: (a -> b) -> Result(e, a) -> Result(e, b).
  map = \(transform, result) -> case result {
    | Err error -> Err error
    | Ok item -> Ok (transform item)
  }.

  mapError :: (e -> f) -> Result(e, a) -> Result(f, a).
  mapError = \(transform, result) -> case result {
    | Err error -> Err (transform error)
    | Ok item -> Ok item
  }.

  andThen :: (a -> Result(e, b)) -> Result(e, a) -> Result(e, b).
  andThen = \(transform, result) -> case result {
    | Err error -> Err error
    | Ok item -> transform item
  }.

  recover :: (e -> Result(f, a)) -> Result(e, a) -> Result(f, a).
  recover = \(recover, result) -> case result {
    | Err error -> recover error
    | Ok item -> Ok item
  }.

  withDefault :: a -> Result(e, a) -> a.
  withDefault = \(defaultValue, result) -> case result {
    | Err error -> defaultValue
    | Ok item -> item
  }.

  isOk :: Result(e, a) -> Bool.
  isOk = \(result) -> case result {
    | Err error -> False
    | Ok item -> True
  }.

  isErr :: Result(e, a) -> Bool.
  isErr = \(result) -> case result {
    | Err error -> True
    | Ok item -> False
  }.

  toMaybe :: Result(e, a) -> Maybe::Maybe(a).
  toMaybe = \(result) -> case result {
    | Err error -> Nothing
    | Ok item -> Just item
  }.

  errorToMaybe :: Result(e, a) -> Maybe::Maybe(e).
  errorToMaybe = \(result) -> case result {
    | Err error -> Just error
    | Ok item -> Nothing
  }.

  fromMaybe :: e -> Maybe::Maybe(a) -> Result(e, a).
  fromMaybe = \(error, maybeValue) -> case maybeValue {
    | Nothing -> Err error
    | Just item -> Ok item
  }.

  impl @{Equatable(e), Equatable(a)}: Equatable(Result(e, a)) {
    equals = \(left, right) -> case (left, right) {
      | (Err x, Err y) -> equals x y
      | (Ok x, Ok y) -> equals x y
      | _ -> False
    }.
  }.
  impl Mappable(Result(e)) { map = map. }.
  impl Reducible(Result(e)) {
    foldLeft = \(step, initial, item) -> case item {
      | Err error -> initial
      | Ok x -> step initial x
    }.
    foldRight = \(step, initial, item) -> case item {
      | Err error -> initial
      | Ok x -> step x initial
    }.
  }.
}
