module Set (
  type Set,
  value empty,
  value singleton,
  value fromList,
  value toList,
  value size,
  value isEmpty,
  value contains,
  value insert,
  value remove,
  value union,
  value intersection,
  value difference,
  value isSubset,
  value filter,
  value map,
  value foldLeft,
  value foldRight
) {
  import List as List.
  import Map as Map.

  data Set a = Set Map::Map(a, ()).

  empty :: Set(a).
  empty = Set Map::empty.

  singleton :: a -> Set(a).
  singleton = \(item) -> Set (Map::singleton item ()).

  insert :: @{Comparable(a)}: Set(a) -> a -> Set(a).
  insert = \(set, item) -> case set {
    | Set map -> Set (Map::insert map item ())
  }.

  fromList :: @{Comparable(a)}: [a] -> Set(a).
  fromList = \(values) -> List::foldLeft insert empty values.

  toList :: Set(a) -> [a].
  toList = \(set) -> case set {
    | Set map -> Map::keys map
  }.

  size :: Set(a) -> Int.
  size = \(set) -> case set {
    | Set map -> Map::size map
  }.

  isEmpty :: Set(a) -> Bool.
  isEmpty = \(set) -> size set == 0.

  contains :: @{Comparable(a)}: Set(a) -> a -> Bool.
  contains = \(set, item) -> case set {
    | Set map -> Map::containsKey map item
  }.

  remove :: @{Comparable(a)}: Set(a) -> a -> Set(a).
  remove = \(set, item) -> case set {
    | Set map -> Set (Map::remove map item)
  }.

  foldLeft :: Set(a) -> b -> (b -> a -> b) -> b.
  foldLeft = \(set, initial, combine) -> case set {
    | Set map -> Map::foldLeft map initial (\(result, key, unit) -> combine result key)
  }.

  foldRight :: Set(a) -> b -> (a -> b -> b) -> b.
  foldRight = \(set, initial, combine) -> case set {
    | Set map -> Map::foldRight map initial (\(key, unit, result) -> combine key result)
  }.

  union :: @{Comparable(a)}: Set(a) -> Set(a) -> Set(a).
  union = \(left, right) -> foldLeft right left (\(result, item) -> insert result item).

  filter :: @{Comparable(a)}: Set(a) -> (a -> Bool) -> Set(a).
  filter = \(set, predicate) -> case set {
    | Set map -> Set (Map::filter map (\(key, unit) -> predicate key))
  }.

  intersection :: @{Comparable(a)}: Set(a) -> Set(a) -> Set(a).
  intersection = \(left, right) -> filter left (\(item) -> contains right item).

  difference :: @{Comparable(a)}: Set(a) -> Set(a) -> Set(a).
  difference = \(left, right) -> filter left (\(item) -> if contains right item then False else True).

  isSubset :: @{Comparable(a)}: Set(a) -> Set(a) -> Bool.
  isSubset = \(subset, superset) -> foldLeft subset True (\(result, item) ->
    if result then contains superset item else False
  ).

  map :: @{Comparable(b)}: Set(a) -> (a -> b) -> Set(b).
  map = \(set, transform) -> foldLeft set empty (\(result, item) -> insert result (transform item)).

  impl Reducible(Set) {
    foldLeft = \(step, initial, items) -> foldLeft items initial step.
    foldRight = \(step, initial, items) -> foldRight items initial step.
  }.
  impl @{Comparable(a)}: Combinable(Set(a)) { combine = union. }.
}
