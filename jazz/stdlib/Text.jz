module Text (
  value map,
  value empty,
  value length,
  value isEmpty,
  value uncons,
  value append,
  value appendChar,
  value fromChars,
  value at,
  value take,
  value drop,
  value slice,
  value toChars,
  value reverse,
  value repeat,
  value concat,
  value join,
  value startsWith,
  value endsWith,
  value contains,
  value find,
  value split,
  value lines,
  value words,
  value replaceAll,
  value trim,
  value trimStart,
  value trimEnd,
  value padLeft,
  value padRight
) {
  import Char as Char.
  import List as List.
  import Maybe as Maybe.
  import Maybe (Nothing, Just).

  empty :: Text.
  empty = "".

  length :: Text -> Int.
  length = __kernel_textLength.

  isEmpty :: Text -> Bool.
  isEmpty = \(text) -> text == "".

  uncons :: Text -> Maybe::Maybe((Char, Text)).
  uncons = \(text) -> case __kernel_textUnconsRaw text {
    | [] -> Nothing
    | [(first, rest) | _] -> Just (first, rest)
  }.

  append :: Text -> Text -> Text.
  append = __kernel_textAppend.

  appendChar :: Text -> Char -> Text.
  appendChar = __kernel_textAppendChar.

  fromChars :: [Char] -> Text.
  fromChars = __kernel_textFromChars.

  textAtFrom :: Int -> Text -> Maybe::Maybe(Char).
  textAtFrom = \(index, text) -> case uncons text {
    | Nothing -> Nothing
    | Just (first, rest) -> if index == 0 then Just first else textAtFrom (index - 1) rest
  }.

  at :: Int -> Text -> Maybe::Maybe(Char).
  at = \(index, text) -> if index < 0 then Nothing else textAtFrom index text.

  textTakeFrom :: Int -> Text -> [Char] -> Text.
  textTakeFrom = \(count, text, reversed) -> if count <= 0 then fromChars (List::reverse reversed) else case uncons text {
    | Nothing -> fromChars (List::reverse reversed)
    | Just (first, rest) -> textTakeFrom (count - 1) rest (List::prepend first reversed)
  }.

  take :: Int -> Text -> Text.
  take = \(count, text) -> textTakeFrom count text [].

  drop :: Int -> Text -> Text.
  drop = \(count, text) -> if count <= 0 then text else case uncons text {
    | Nothing -> empty
    | Just (first, rest) -> drop (count - 1) rest
  }.

  slice :: Int -> Int -> Text -> Text.
  slice = \(start, count, text) -> take count (drop start text).

  textToCharsFrom :: Text -> [Char] -> [Char].
  textToCharsFrom = \(text, reversed) -> case uncons text {
    | Nothing -> List::reverse reversed
    | Just (first, rest) -> textToCharsFrom rest (List::prepend first reversed)
  }.

  toChars :: Text -> [Char].
  toChars = \(text) -> textToCharsFrom text [].

  reverse :: Text -> Text.
  reverse = \(text) -> fromChars (List::reverse (toChars text)).

  concat :: [Text] -> Text.
  concat = __kernel_textConcat.

  repeat :: Int -> Text -> Text.
  repeat = \(count, text) -> if count <= 0 then empty else concat (List::repeat count text).

  join :: Text -> [Text] -> Text.
  join = \(delimiter, fragments) -> concat (List::intersperse delimiter fragments).

  startsWith :: Text -> Text -> Bool.
  startsWith = \(prefix, text) -> case uncons prefix {
    | Nothing -> True
    | Just (prefixFirst, prefixRest) -> case uncons text {
      | Nothing -> False
      | Just (textFirst, textRest) -> if prefixFirst == textFirst then startsWith prefixRest textRest else False
    }
  }.

  endsWith :: Text -> Text -> Bool.
  endsWith = \(suffix, text) -> {
    suffixLength = length suffix.
    textLengthValue = length text.
    if suffixLength > textLengthValue then False else startsWith suffix (drop (textLengthValue - suffixLength) text).
  }.

  textFindFrom :: Text -> Text -> Int -> Maybe::Maybe(Int).
  textFindFrom = \(needle, text, index) -> if startsWith needle text then Just index else case uncons text {
    | Nothing -> Nothing
    | Just (first, rest) -> textFindFrom needle rest (index + 1)
  }.

  find :: Text -> Text -> Maybe::Maybe(Int).
  find = \(needle, text) -> textFindFrom needle text 0.

  contains :: Text -> Text -> Bool.
  contains = \(needle, text) -> Maybe::isJust (find needle text).

  textFromReversedChars :: [Char] -> Text.
  textFromReversedChars = \(reversed) -> fromChars (List::reverse reversed).

  textSplitFrom :: Text -> Int -> Text -> [Char] -> [Text] -> [Text].
  textSplitFrom = \(delimiter, delimiterLength, text, reversedCurrent, reversedFragments) ->
    if startsWith delimiter text
      then textSplitFrom delimiter delimiterLength (drop delimiterLength text) [] (List::prepend (textFromReversedChars reversedCurrent) reversedFragments)
      else case uncons text {
        | Nothing -> List::reverse (List::prepend (textFromReversedChars reversedCurrent) reversedFragments)
        | Just (first, rest) -> textSplitFrom delimiter delimiterLength rest (List::prepend first reversedCurrent) reversedFragments
      }.

  split :: Text -> Text -> [Text].
  split = \(delimiter, text) -> if isEmpty delimiter
    then List::map (\(item) -> fromChars [item]) (toChars text)
    else textSplitFrom delimiter (length delimiter) text [] [].

  textLinesFrom :: Text -> [Char] -> [Text] -> [Text].
  textLinesFrom = \(text, reversedCurrent, reversedLines) -> case uncons text {
    | Nothing -> if List::isEmpty reversedCurrent then List::reverse reversedLines else List::reverse (List::prepend (textFromReversedChars reversedCurrent) reversedLines)
    | Just (first, rest) -> if first == '\n'
      then textLinesFrom rest [] (List::prepend (textFromReversedChars reversedCurrent) reversedLines)
      else if first == '\r' then case uncons rest {
        | Nothing -> List::reverse (List::prepend (textFromReversedChars reversedCurrent) reversedLines)
        | Just (next, afterNext) -> if next == '\n'
          then textLinesFrom afterNext [] (List::prepend (textFromReversedChars reversedCurrent) reversedLines)
          else textLinesFrom rest [] (List::prepend (textFromReversedChars reversedCurrent) reversedLines)
      } else textLinesFrom rest (List::prepend first reversedCurrent) reversedLines
  }.

  lines :: Text -> [Text].
  lines = \(text) -> textLinesFrom text [] [].

  textWordsFrom :: Text -> [Char] -> [Text] -> [Text].
  textWordsFrom = \(text, reversedCurrent, reversedWords) -> case uncons text {
    | Nothing -> if List::isEmpty reversedCurrent then List::reverse reversedWords else List::reverse (List::prepend (textFromReversedChars reversedCurrent) reversedWords)
    | Just (first, rest) -> if Char::isSpace first
      then if List::isEmpty reversedCurrent
        then textWordsFrom rest [] reversedWords
        else textWordsFrom rest [] (List::prepend (textFromReversedChars reversedCurrent) reversedWords)
      else textWordsFrom rest (List::prepend first reversedCurrent) reversedWords
  }.

  words :: Text -> [Text].
  words = \(text) -> textWordsFrom text [] [].

  textReplaceAllFrom :: Text -> Int -> Text -> Text -> [Text] -> Text.
  textReplaceAllFrom = \(needle, needleLength, replacement, text, reversedFragments) ->
    if startsWith needle text
      then textReplaceAllFrom needle needleLength replacement (drop needleLength text) (List::prepend replacement reversedFragments)
      else case uncons text {
        | Nothing -> concat (List::reverse reversedFragments)
        | Just (first, rest) -> textReplaceAllFrom needle needleLength replacement rest (List::prepend (fromChars [first]) reversedFragments)
      }.

  replaceAll :: Text -> Text -> Text -> Text.
  replaceAll = \(needle, replacement, text) -> if isEmpty needle then text else textReplaceAllFrom needle (length needle) replacement text [].

  trimStart :: Text -> Text.
  trimStart = \(text) -> case uncons text {
    | Nothing -> empty
    | Just (first, rest) -> if Char::isSpace first then trimStart rest else text
  }.

  trimEnd :: Text -> Text.
  trimEnd = \(text) -> reverse (trimStart (reverse text)).

  trim :: Text -> Text.
  trim = \(text) -> trimEnd (trimStart text).

  padLeft :: Int -> Char -> Text -> Text.
  padLeft = \(width, padding, text) -> {
    count = width - length text.
    if count <= 0 then text else append (repeat count (fromChars [padding])) text.
  }.

  padRight :: Int -> Char -> Text -> Text.
  padRight = \(width, padding, text) -> {
    count = width - length text.
    if count <= 0 then text else append text (repeat count (fromChars [padding])).
  }.
  map :: (Char -> Char) -> Text -> Text.
  map = \(change, text) -> fromChars (Mappable::map change (toChars text)).
}
