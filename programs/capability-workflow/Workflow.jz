module Workflow {
  import List as List.
  import Text as Text.

  data Priority = Critical | Normal | Deferred.

  data WorkItem = WorkItem Text Priority.

  class Describable(a) {
    describe :: a -> Text.
  }.

  impl Describable(WorkItem) {
    describe = \(item) -> case item {
      | WorkItem name Critical -> Text::append "critical:" name
      | WorkItem name Normal -> Text::append "normal:" name
      | WorkItem name Deferred -> Text::append "deferred:" name
    }.
  }.

  describeAny :: @{Describable(a)}: a -> Text.
  describeAny = \(item) -> Describable::describe item.

  describeAllReversed :: [WorkItem] -> [Text] -> [Text].
  describeAllReversed = \(items, reversed) -> case items {
    | [] -> reversed
    | [item | rest] -> describeAllReversed rest (List::prepend (describeAny item) reversed)
  }.

  describeAll :: [WorkItem] -> [Text].
  describeAll = \(items) -> List::reverse (describeAllReversed items []).
}
