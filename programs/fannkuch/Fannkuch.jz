module Fannkuch (value maximumFlips) {
  import List as List.

  integerRangeFrom =
    \(current, upper) ->
      if current > upper then
        []
      else
        List::prepend current $ integerRangeFrom (current + 1) upper.

  insertionsFrom =
    \|(item, reversedPrefix, []) ->
      [List::append (List::reverse reversedPrefix) [item]]
     |(item, reversedPrefix, remaining@[first | rest]) ->
      List::prepend
        (List::append (List::reverse reversedPrefix) (List::prepend item remaining)) $
        insertionsFrom item (List::prepend first reversedPrefix) rest.

  insertEverywhere =
    \(item, items) ->
      insertionsFrom item [] items.

  permutations =
    \|([]) -> [[]]
     |([first | rest]) ->
      List::concat $ List::map (insertEverywhere first) $ permutations rest.

  reversePrefix =
    \(count, items) ->
      List::append (List::reverse (List::take count items)) (List::drop count items).

  flipCountFrom =
    \|([], count) -> count
     |([1 | _], count) -> count
     |(permutationValue@[first | _], count) ->
      flipCountFrom (reversePrefix first permutationValue) (count + 1).

  flipCount =
    \(permutation) ->
      flipCountFrom permutation 0.

  maximumFrom =
    \|(current, []) -> current
     |(current, [item | rest]) ->
      maximumFrom (if item > current then item else current) rest.

  maximumFlips =
    \(size) ->
      maximumFrom 0 $
        List::map flipCount $ permutations $ integerRangeFrom 1 size.
}
