module Main {
  import Char as Char.
  import Maybe as Maybe.
  import Maybe (Nothing, Just).
  import Text as Text.

  data IdentifierKind
    = Keyword Text
    | TypeIdentifier Text
    | ValueIdentifier Text
    | InvalidIdentifier Text.

  isKeyword :: Text -> Bool.
  isKeyword = \(name) -> if name == "module" then
    True
    else if name == "import" then
      True
      else if name == "data" then
        True
        else if name == "if" then
          True
          else if name == "then" then
            True
            else if name == "else" then
              True
              else name == "case".

  isIdentifierStart :: Char -> Bool.
  isIdentifierStart = \(item) -> if (Char::isAlpha item) then True else item == '_'.

  isIdentifierContinuation :: Char -> Bool.
  isIdentifierContinuation = \(item) -> if (Char::isAlphaNum item) then
    True
    else if item == '_' then
      True
      else if item == '\'' then
        True
        else item == '!'.

  allIdentifierContinuations :: Text -> Bool.
  allIdentifierContinuations = \(remaining) -> case Text::uncons remaining {
    | Nothing -> True
    | Just (current, rest) -> if (isIdentifierContinuation current) then allIdentifierContinuations rest else False
  }.

  isTypeStart :: Char -> Bool.
  isTypeStart = \(item) -> if (Char::isAlpha item) then Char::toUInt32 item < Char::toUInt32 'a' else False.

  classifyIdentifier :: Text -> IdentifierKind.
  classifyIdentifier = \(name) -> if (isKeyword name) then
    Keyword name
    else case Text::uncons name {
      | Nothing -> InvalidIdentifier name
      | Just (first, rest) -> if (isIdentifierStart first) then
        if (allIdentifierContinuations rest) then
          if (isTypeStart first) then TypeIdentifier name else ValueIdentifier name
          else InvalidIdentifier name
        else InvalidIdentifier name
    }.

  map classifyIdentifier ["module", "Point", "point2", "_private", "bad-name", "case", "result!"].
}
