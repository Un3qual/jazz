module MergeSort (value mergeSort, value mergeSortSummary) {
  import List as List.

  splitAlternating =
    \|([]) -> ([], [])
     |([item]) -> ([item], [])
     |([left | [right | rest]]) ->
      case splitAlternating rest {
        | (lefts, rights) ->
          (List::prepend left lefts, List::prepend right rights)
      }.

  merge =
    \|([], rights) -> rights
     |(lefts, []) -> lefts
     |([left | lefts], [right | rights]) ->
      if left <= right then
        List::prepend left $ merge lefts (List::prepend right rights)
      else
        List::prepend right $ merge (List::prepend left lefts) rights.

  mergeSort =
    \|([]) -> []
     |([item]) -> [item]
     |(other) ->
      case splitAlternating other {
        | (lefts, rights) -> merge (mergeSort lefts) (mergeSort rights)
      }.

  remainder =
    \(number, divisor) ->
      if number < divisor then number else remainder (number - divisor) divisor.

  nextItem =
    \(index) ->
      remainder (index * 73 + 19) 211.

  generateFrom =
    \(index, upper) ->
      if index > upper then
        []
      else
        List::prepend (nextItem index) $ generateFrom (index + 1) upper.

  firstItem =
    \|([]) -> 0
     |([item | _]) -> item.

  lastItem =
    \|([]) -> 0
     |([item]) -> item
     |([_ | rest]) -> lastItem rest.

  weightedChecksumFrom =
    \|(index, [], total) -> total
     |(index, [item | rest], total) ->
      weightedChecksumFrom (index + 1) rest (total + index * item).

  mergeSortSummary =
    case mergeSort (generateFrom 1 128) {
      | sorted ->
        ( List::length sorted,
          firstItem sorted,
          lastItem sorted,
          weightedChecksumFrom 1 sorted 0 )
    }.
}
