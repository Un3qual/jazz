module MergeSort (value mergeSort, value mergeSortSummary) {
  import List.

  splitAlternating =
    \|([]) -> ([], [])
     |([item]) -> ([item], [])
     |([left | [right | rest]]) ->
      case splitAlternating rest {
        | (lefts, rights) ->
          (listPrepend left lefts, listPrepend right rights)
      }.

  merge =
    \|([], rights) -> rights
     |(lefts, []) -> lefts
     |([left | lefts], [right | rights]) ->
      if left <= right then
        listPrepend left $ merge lefts (listPrepend right rights)
      else
        listPrepend right $ merge (listPrepend left lefts) rights.

  mergeSort =
    \|([]) -> []
     |([item]) -> [item]
     |(other) ->
      case splitAlternating other {
        | (lefts, rights) -> merge (mergeSort lefts) (mergeSort rights)
      }.

  remainder =
    \(number, divisor) ->
      if number < divisor then number else remainder (number - divisor) divisor.

  nextItem =
    \(index) ->
      remainder (index * 73 + 19) 211.

  generateFrom =
    \(index, upper) ->
      if index > upper then
        []
      else
        listPrepend (nextItem index) $ generateFrom (index + 1) upper.

  firstItem = \([item | _]) -> item.

  lastItem =
    \|([item]) -> item
     |([_ | rest]) -> lastItem rest.

  weightedChecksumFrom =
    \|(index, [], total) -> total
     |(index, [item | rest], total) ->
      weightedChecksumFrom (index + 1) rest (total + index * item).

  mergeSortSummary =
    case mergeSort (generateFrom 1 128) {
      | sorted ->
        ( listLength sorted,
          firstItem sorted,
          lastItem sorted,
          weightedChecksumFrom 1 sorted 0 )
    }.
}
