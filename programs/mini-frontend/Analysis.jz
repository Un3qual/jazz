module Analysis {
  import List.
  import Syntax.

  data Summary = Summary Int [Text].

  nodeCount :: Expression(a) -> Int.
  nodeCount = \(expression) -> case expression {
    | Literal item -> 1
    | Add left right -> 1 + nodeCount left + nodeCount right
    | Reference name -> 1
    | LetExpression name item body -> 1 + nodeCount item + nodeCount body
  }.

  collectReferences :: Expression(a) -> [Text] -> [Text].
  collectReferences = \(expression, reversed) -> case expression {
    | Literal item -> reversed
    | Add left right -> collectReferences right (collectReferences left reversed)
    | Reference name -> listPrepend name reversed
    | LetExpression name item body -> collectReferences body (collectReferences item reversed)
  }.

  analyze :: Expression(a) -> Summary.
  analyze = \(expression) -> Summary (nodeCount expression) (listReverse (collectReferences expression [])).
}
