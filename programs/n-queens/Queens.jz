module Queens (value solutionCount, value solutionProfile) {
  import List as List.

  absolute =
    \(number) ->
      if number < 0 then 0 - number else number.

  safe =
    \|(column, distance, []) -> True
     |(column, distance, [placed | rest]) ->
      if column == placed then
        False
      else if absolute (column - placed) == distance then
        False
      else
        safe column (distance + 1) rest.

  integerRangeFrom =
    \(current, upper) ->
      if current > upper then
        []
      else
        List::prepend current $ integerRangeFrom (current + 1) upper.

  integerRange =
    \(lower, upper) ->
      integerRangeFrom lower upper.

  place =
    \|(upper, 0, placed) -> [placed]
     |(upper, remaining, placed) ->
      List::concat $
        List::map
          (\(column) ->
            if safe column 1 placed then
              place upper (remaining - 1) (List::prepend column placed)
            else
              [])
          (integerRange 1 upper).

  solutionCount =
    \(size) ->
      List::length $ place size size [].

  placedQueenCount =
    List::foldLeft
      (\(total, placement) -> total + List::length placement)
      0.

  solutionProfile =
    \(size) ->
      case place size size [] {
        | placements -> (List::length placements, placedQueenCount placements)
      }.
}
