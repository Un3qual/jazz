module Sieve (value primeSummary) {
  import List as List.

  integerRangeFrom =
    \(current, upper) ->
      if current > upper then
        []
      else
        List::prepend current $ integerRangeFrom (current + 1) upper.

  remainder =
    \(number, divisor) ->
      if number < divisor then number else remainder (number - divisor) divisor.

  sieve =
    \|([]) -> []
     |([prime | rest]) ->
      List::prepend prime $
        sieve $ List::filter (\(candidate) -> remainder candidate prime != 0) rest.

  lastItem =
    \|([]) -> 0
     |([item]) -> item
     |([_ | rest]) -> lastItem rest.

  sumItems = List::foldLeft (+) 0.

  primeSummary =
    case sieve (integerRangeFrom 2 2000) {
      | primes -> (List::length primes, lastItem primes, sumItems primes)
    }.
}
