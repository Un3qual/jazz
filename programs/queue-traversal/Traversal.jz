module Traversal (value breadthFirst) {
  import List as List.
  import Maybe as Maybe.
  import Maybe (Nothing, Just).
  import Queue as Queue.

  breadthFirstFrom = \(pending, reversedVisited) -> case Queue::dequeue pending {
    | Nothing -> List::reverse reversedVisited
    | Just (item, remaining) -> if item >= 8
      then breadthFirstFrom remaining (List::prepend item reversedVisited)
      else breadthFirstFrom
        (Queue::enqueueAll remaining [item * 2, item * 2 + 1])
        (List::prepend item reversedVisited)
  }.

  breadthFirst = \(root) -> breadthFirstFrom (Queue::singleton root) [].
}
