module Index (value summarizeIndex) {
  import Map as Map.
  import Maybe as Maybe.
  import Maybe (Nothing, Just).
  import Set as Set.

  summarizeEntries :: [(Int, Text)] -> ([(Int, Text)], Maybe::Maybe((Int, Text)), Maybe::Maybe((Int, Text))).
  summarizeEntries = \(entries) -> {
    index = Map::fromList entries.
    (Map::toList index, Map::minimum index, Map::maximum index).
  }.

  summarizeIndex :: [(Int, Text)] -> [Text] -> ([(Int, Text)], Maybe::Maybe((Int, Text)), Maybe::Maybe((Int, Text)), [Text], [Text], [Text]).
  summarizeIndex = \(entries, labels) -> case summarizeEntries entries {
    | (ordered, first, last) -> {
      labelSet = Set::fromList labels.
      required = Set::fromList ["compiler", "runtime", "stdlib"].
      (ordered, first, last,
       Set::toList labelSet, Set::toList (Set::intersection labelSet required),
       Set::toList (Set::difference required labelSet)).
    }
  }.
}
