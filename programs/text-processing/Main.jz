module Main {
  import List as List.
  import Text as Text.

  raw = "  Jazz🙂Jazz\r\nfunctional  languages\nJAZZ  ".
  lowercaseNames = Text::replaceAll "JAZZ" "jazz" (Text::replaceAll "Jazz" "jazz" raw).
  cleanedLines = List::map Text::trim (Text::lines raw).
  (Text::words lowercaseNames,
   Text::join " | " cleanedLines,
   Text::split "" "🙂é",
   Text::padLeft 6 '.' "猫",
   Text::find "languages" raw,
   Text::contains "missing" raw).
}
