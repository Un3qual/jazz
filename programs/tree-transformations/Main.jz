module Main {
  import Tree.

  sourceTree :: Tree(Int).
  sourceTree = buildTree 7 1.

  mappedTree :: Tree(Int).
  mappedTree = mapTree (\(item) -> item + 1) sourceTree.

  leafCount :: Int.
  leafCount = foldTree (\(item) -> 1) (\(left, right) -> left + right) mappedTree.

  total :: Int.
  total = foldTree (\(item) -> item) (\(left, right) -> left + right) mappedTree.

  (leafCount, total).
}
