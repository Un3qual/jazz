module Main {
  import Dictionary as Dictionary.
  import List as List.
  import Maybe as Maybe.
  import Maybe (Nothing, Just).
  import Text as Text.

  increment :: Maybe::Maybe(Int) -> Maybe::Maybe(Int).
  increment = \(current) -> case current {
    | Nothing -> Just 1
    | Just count -> Just (count + 1)
  }.
  countWord :: Dictionary::Dictionary(Text, Int) -> Text -> Dictionary::Dictionary(Text, Int).
  countWord = \(frequencies, word) -> Dictionary::update frequencies word increment.
  words = Text::words "jazz makes jazz expressive\nand jazz stays readable".
  frequencies :: Dictionary::Dictionary(Text, Int).
  frequencies = List::foldLeft countWord Dictionary::empty words.
  (Dictionary::toList frequencies, Dictionary::size frequencies,
   Dictionary::lookup frequencies "jazz", Dictionary::keys frequencies).
}
