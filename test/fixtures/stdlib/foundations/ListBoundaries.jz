module Stdlib::Foundations::ListBoundaries {
  import List as List.
  import Maybe as Maybe.
  import Maybe (Nothing, Just).
  emptyInts :: [Int].
  emptyInts = [].
  emptyPairs :: [(Int, Text)].
  emptyPairs = [].
  values = [1, 2, 3].
  (List::prepend 0 values, List::reverse values, List::length values,
   List::last [1], List::init [1],
   List::take (0 - 1) values, List::drop (0 - 1) values, List::splitAt (0 - 1) values,
   List::append emptyInts values, List::concat [],
   List::repeat 0 1, List::repeat (0 - 1) 1,
   List::intersperse 0 emptyInts, List::intersperse 0 [1],
   List::intercalate [0] [], List::intercalate [0] [[1, 2]],
   List::map (\(item) -> item + 1) emptyInts,
   List::filter (\(item) -> item > 0) emptyInts,
   List::filterMap (\(item) -> Just item) emptyInts,
   List::partition (\(item) -> item > 0) emptyInts,
   List::foldLeft (\(total, item) -> total + item) 7 emptyInts,
   List::foldRight (\(item, total) -> item + total) 7 emptyInts,
   List::scanLeft (\(total, item) -> total + item) 7 emptyInts,
   List::any (\(item) -> item > 0) emptyInts,
   List::all (\(item) -> item > 0) emptyInts,
   List::contains 1 emptyInts,
   List::find (\(item) -> item > 0) emptyInts,
   List::findIndex (\(item) -> item > 0) emptyInts,
   List::zip emptyInts ["a"], List::unzip emptyPairs, List::indexed emptyInts,
   List::distinct emptyInts, List::group emptyInts,
   List::groupBy (\(left, right) -> left == right) emptyInts,
   List::sort emptyInts).
}
