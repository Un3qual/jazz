module Stdlib::Foundations::ListNormalize {
  import List.
  import Maybe.
  values = [1, 1, 2, 2, 1].
  emptyInts :: [Int].
  emptyInts = [].
  (listDistinct values,
   listGroup values,
   listGroupBy (\(left, right) -> (left - right) == (0 - 2)) [1, 3, 2, 4, 5],
   listMinimum [3, 1, 2], listMaximum [3, 1, 2],
   listMinimum emptyInts, listMaximum emptyInts,
   listSort [3, 1, 2, 1],
   listSortBy (\(left, right) -> Ord::compare right left) [3, 1, 2, 1]).
}
