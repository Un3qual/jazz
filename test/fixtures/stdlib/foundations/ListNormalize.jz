module Stdlib::Foundations::ListNormalize {
  import List as List.
  import Maybe as Maybe.
  import Maybe (Nothing, Just).
  values = [1, 1, 2, 2, 1].
  emptyInts :: [Int].
  emptyInts = [].
  (List::distinct values,
   List::group values,
   List::groupBy (\(left, right) -> (left - right) == (0 - 2)) [1, 3, 2, 4, 5],
   List::minimum [3, 1, 2], List::maximum [3, 1, 2],
   List::minimum emptyInts, List::maximum emptyInts,
   List::sort [3, 1, 2, 1],
   List::sortBy (\(left, right) -> Comparable::compare right left) [3, 1, 2, 1]).
}
