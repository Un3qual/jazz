module Stdlib::Foundations::ListPartialStable {
  import List as List.
  import Text as Text.
  doubleAll = List::map (\(item) -> item * 2).
  takeTwo = List::take 2.
  containsTwo = List::contains 2.
  compareByKey = \(left, right) -> case left {
    | (leftKey, leftLabel) -> case right {
      | (rightKey, rightLabel) -> Comparable::compare leftKey rightKey
    }
  }.
  addBang = List::map (\(item) -> Text::append item "!").
  (doubleAll [1, 2, 3], takeTwo [1, 2, 3], containsTwo [1, 2, 3],
   List::sortBy compareByKey [(2, "a"), (1, "b"), (2, "c"), (1, "d")],
   addBang ["Jazz", "list"]).
}
