module Stdlib::Foundations::ListTransform {
  import List as List.
  import Maybe as Maybe.
  import Maybe (Nothing, Just).
  values = [1, 2, 3].
  pairs = [(1, "a"), (2, "b")].
  (List::append [1, 2] [3, 4], List::concat [[1, 2], [], [3, 4]],
   List::repeat 3 1, List::intersperse 0 values, List::intercalate [0] [[1, 2], [3, 4]],
   List::map (\(item) -> item * 2) values,
   List::filter (\(item) -> item > 1) values,
   List::filterMap (\(item) -> if item == 2 then Nothing else Just (item * 10)) values,
   List::partition (\(item) -> item == 2) values,
   List::foldLeft (\(total, item) -> total + item) 4 values,
   List::foldRight (\(item, total) -> item + total) 4 values,
   List::scanLeft (\(total, item) -> total + item) 0 values,
   List::any (\(item) -> item == 2) values,
   List::all (\(item) -> item > 0) values,
   List::contains 2 values, List::find (\(item) -> item > 2) values,
   List::findIndex (\(item) -> item == 3) values,
   List::zip [1, 2, 3] ["a", "b"], List::unzip pairs, List::indexed ["a", "b"]).
}
