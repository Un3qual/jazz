module Stdlib::Foundations::MaybeResult {
  import Maybe.
  import Result.
  import Text.
  (maybeMap (\(item) -> item + 1) (Just 1),
   maybeAndThen (\(item) -> Just (item + 1)) (Just 2),
   maybeWithDefault 9 Nothing,
   maybeOrElse (Just 4) Nothing,
   maybeFilter (\(item) -> item > 1) (Just 2),
   maybeFilter (\(item) -> item > 2) (Just 2),
   maybeIsJust (Just 1), maybeIsNothing Nothing,
   maybeToList (Just 2), maybeFromList [4, 5],
   resultMap (\(item) -> item + 1) (Ok 1),
   resultMapError (\(error) -> textAppend error "!") (Err "bad"),
   resultAndThen (\(item) -> Ok (item + 1)) (Ok 2),
   resultRecover (\(error) -> Ok 4) (Err "bad"),
   resultWithDefault 9 (Err "bad"),
   resultIsOk (Ok 1), resultIsErr (Err "bad"),
   resultToMaybe (Ok 2), resultErrorToMaybe (Err "bad"),
   resultFromMaybe "missing" Nothing, resultFromMaybe "missing" (Just 5)).
}
