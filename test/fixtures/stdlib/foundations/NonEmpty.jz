module Stdlib::Foundations::NonEmpty {
  import NonEmpty as NonEmpty.
  import NonEmpty (NonEmpty).
  import Maybe as Maybe.
  import Maybe (Nothing, Just).
  item = NonEmpty 1 [2, 3].
  singleton = NonEmpty::singleton 7.
  (NonEmpty::toList singleton, NonEmpty::last singleton,
   NonEmpty::fromList [1, 2, 3], NonEmpty::fromList [],
   NonEmpty::toList item, NonEmpty::head item, NonEmpty::tail item, NonEmpty::last item,
   NonEmpty::toList (NonEmpty::prepend 0 item),
   NonEmpty::toList (NonEmpty::appendList item [4]),
   NonEmpty::toList (NonEmpty::map (\(item) -> item * 2) item),
   NonEmpty::length item,
   NonEmpty::foldLeft (\(total, item) -> total + item) 0 item,
   NonEmpty::foldRight (\(item, total) -> item + total) 0 item).
}
