module Stdlib::LinearCollections::Dictionary {
  import Dictionary as Dictionary.
  import Maybe as Maybe.
  import Maybe (Nothing, Just).
  import Text as Text.
  start = Dictionary::fromList [("first", 1), ("second", 2), ("first", 3)].
  replaced = Dictionary::insert start "second" 20.
  removed = Dictionary::remove replaced "first".
  reinserted = Dictionary::insert removed "first" 30.
  updated = Dictionary::update reinserted "second" (\(current) -> case current {
    | Nothing -> Nothing
    | Just item -> Just (item + 1)
  }).
  insertedByUpdate = Dictionary::update updated "third" (\(current) -> Just 40).
  unchanged = Dictionary::update insertedByUpdate "missing" (\(current) -> Nothing).
  removedByUpdate = Dictionary::update unchanged "first" (\(current) -> Nothing).
  replacedPresent = Dictionary::replace start "second" 22.
  replacedMissing = Dictionary::replace start "missing" 0.
  (Dictionary::toList Dictionary::empty, Dictionary::size Dictionary::empty, Dictionary::isEmpty Dictionary::empty,
   Dictionary::toList (Dictionary::singleton "only" 7), Dictionary::toList start,
   Dictionary::lookup start "first", Dictionary::lookup start "missing",
   Dictionary::getOr start "missing" 9, Dictionary::containsKey start "second",
   Dictionary::toList replaced,
   Maybe::map Dictionary::toList replacedPresent, replacedMissing,
   Dictionary::toList removed, Dictionary::toList reinserted, Dictionary::toList removedByUpdate,
   Dictionary::keys start, Dictionary::values start,
   Dictionary::toList (Dictionary::mapValues start (\(item) -> item * 10)),
   Dictionary::toList (Dictionary::filter start (\(key, item) -> item > 2)),
   Dictionary::foldLeft start "" (\(result, key, item) -> Text::append result key),
   Dictionary::foldRight start "" (\(key, item, result) -> Text::append key result)).
}
