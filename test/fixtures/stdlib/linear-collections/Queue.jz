module Stdlib::LinearCollections::Queue {
  import Queue as Queue.
  import Maybe as Maybe.
  import Maybe (Nothing, Just).
  import Text as Text.
  empty = Queue::empty.
  firstVersion = Queue::enqueue empty "a".
  secondVersion = Queue::enqueue firstVersion "b".
  all = Queue::enqueueAll firstVersion ["b", "c"].
  dequeueView = \(result) -> case result {
    | Nothing -> Nothing
    | Just (item, remaining) -> Just (item, Queue::toList remaining)
  }.
  pairs = Queue::fromList [(1, "x"), (2, "y")].
  (Queue::toList empty, Queue::size empty, Queue::isEmpty empty,
   Queue::toList (Queue::singleton 7), Queue::toList (Queue::fromList [1, 2, 3]),
   Queue::peek secondVersion, dequeueView (Queue::dequeue secondVersion),
   Queue::toList firstVersion, Queue::toList all,
   Queue::toList (Queue::map pairs (\(pair) -> pair)),
   Queue::foldLeft all "" (\(result, item) -> Text::append result item),
   Queue::foldRight all "" (\(item, result) -> Text::append item result)).
}
