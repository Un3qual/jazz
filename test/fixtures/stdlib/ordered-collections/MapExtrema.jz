module Stdlib::OrderedCollections::MapExtrema {
  import Map as Map.
  import Maybe as Maybe.
  import Maybe (Nothing, Just).
  start = Map::fromList [(3, "three"), (1, "one"), (2, "TWO")].
  popView = \(result) -> case result {
    | Nothing -> Nothing
    | Just ((key, item), remaining) -> Just ((key, item), Map::toList remaining)
  }.
  (Map::minimum start, Map::maximum start,
   popView (Map::popMinimum start), popView (Map::popMaximum start)).
}
