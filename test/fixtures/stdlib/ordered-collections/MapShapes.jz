module Stdlib::OrderedCollections::MapShapes {
  import Map as Map.
  leftLeft = Map::fromList [(3, "c"), (2, "b"), (1, "a")].
  rightRight = Map::fromList [(1, "a"), (2, "b"), (3, "c")].
  leftRight = Map::fromList [(3, "c"), (1, "a"), (2, "b")].
  rightLeft = Map::fromList [(1, "a"), (3, "c"), (2, "b")].
  leafSource = Map::fromList [(2, "b"), (1, "a"), (3, "c")].
  oneChildSource = Map::fromList [(2, "b"), (1, "a"), (3, "c"), (4, "d")].
  twoChildSource = Map::fromList [(2, "b"), (1, "a"), (4, "d"), (3, "c"), (5, "e")].
  repeated = Map::insert (Map::insert (Map::singleton 1 "a") 1 "b") 1 "c".
  (Map::toList leftLeft, Map::toList rightRight, Map::toList leftRight, Map::toList rightLeft,
   Map::toList (Map::remove leafSource 1),
   Map::toList (Map::remove oneChildSource 3),
   Map::toList (Map::remove twoChildSource 2),
   Map::toList repeated).
}
