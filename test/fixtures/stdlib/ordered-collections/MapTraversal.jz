module Stdlib::OrderedCollections::MapTraversal {
  import Map as Map.
  import Text as Text.
  start = Map::fromList [(3, "three"), (1, "one"), (2, "TWO")].
  (Map::keys start, Map::values start,
   Map::toList (Map::mapValues start (\(item) -> Text::append item "!")),
   Map::toList (Map::filter start (\(key, item) -> key > 1)),
   Map::foldLeft start "" (\(result, key, item) -> Text::append result (Showable::show key)),
   Map::foldRight start "" (\(key, item, result) -> Text::append (Showable::show key) result)).
}
