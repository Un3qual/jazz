module Stdlib::OrderedCollections::Set {
  import Set as Set.
  import Text as Text.
  start = Set::fromList [3, 1, 2, 2].
  (Set::toList Set::empty, Set::size Set::empty, Set::isEmpty Set::empty,
   Set::toList (Set::singleton 9), Set::toList start, Set::size start,
   Set::contains start 2, Set::contains start 8,
   Set::toList (Set::union start (Set::fromList [3, 4])),
   Set::toList (Set::intersection start (Set::fromList [2, 4])),
   Set::toList (Set::difference start (Set::fromList [2, 4])),
   Set::isSubset (Set::fromList [1, 2]) start, Set::isSubset start (Set::fromList [1, 2]),
   Set::toList (Set::filter start (\(item) -> item > 1)),
   Set::toList (Set::map start (\(item) -> if item < 3 then 0 else 1)),
   Set::foldLeft start "" (\(result, item) -> Text::append result (Showable::show item)),
   Set::foldRight start "" (\(item, result) -> Text::append (Showable::show item) result)).
}
