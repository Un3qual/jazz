module Stdlib::Text::Core {
  import Text as Text.

  (Text::at (0 - 1) "a🙂é", Text::at 0 "a🙂é", Text::at 1 "a🙂é", Text::at 2 "a🙂é", Text::at 3 "a🙂é",
   Text::take (0 - 2) "a🙂é", Text::take 2 "a🙂é", Text::take 9 "a🙂é",
   Text::drop (0 - 2) "a🙂é", Text::drop 2 "a🙂é", Text::drop 9 "a🙂é",
   Text::slice (0 - 2) 2 "a🙂é", Text::slice 1 2 "a🙂é", Text::slice 1 0 "a🙂é",
   Text::toChars "a🙂é", Text::reverse "a🙂é", Text::repeat 0 "Ja", Text::repeat 3 "Ja",
   Text::concat ["Ja", "zz", "🙂"], Text::concat [], Text::join "," ["a🙂é"],
   Text::join "-" ["a", "🙂", "é"],
   Text::padLeft 5 '.' "猫", Text::padRight 2 '.' "猫", Text::padLeft 0 '.' "猫").
}
