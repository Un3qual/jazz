module Stdlib::Text::LargeConcat {
  import List as List.
  import Text as Text.

  build = \(remaining, fragments) -> case remaining {
    | 0 -> fragments
    | _ -> build (remaining - 1) (List::prepend "Jazz" fragments)
  }.
  fragments = build 5000 [].
  joined = Text::join "-" (build 1000 []).
  first = Text::concat fragments.
  second = Text::concat fragments.
  (Text::length first, Text::length joined, first == second).
}
