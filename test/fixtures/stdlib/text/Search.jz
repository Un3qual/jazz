module Stdlib::Text::Search {
  import Text as Text.

  (Text::startsWith "🙂é" "🙂é🙂", Text::startsWith "" "Jazz", Text::startsWith "é" "🙂é",
   Text::endsWith "é🙂" "🙂é🙂", Text::endsWith "" "Jazz", Text::endsWith "🙂é" "🙂é🙂",
   Text::contains "é🙂" "🙂é🙂", Text::contains "z" "🙂é🙂",
   Text::find "é🙂" "🙂é🙂", Text::find "" "Jazz", Text::find "z" "🙂é🙂",
   Text::replaceAll "aa" "b" "aaaaa", Text::replaceAll "" "x" "unchanged",
   Text::replaceAll "é" "x" "🙂é🙂é").
}
