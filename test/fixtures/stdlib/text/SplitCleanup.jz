module Stdlib::Text::SplitCleanup {
  import Text as Text.

  (Text::split "," ",a,,b,", Text::split "" "a🙂é", Text::split "" "",
   Text::lines "", Text::lines "a\nb\r\nc\rd\n",
   Text::words "  Jazz\t🙂\nrocks  ",
   Text::trim "\u{A0} Jazz \t", Text::trimStart "  Jazz  \t", Text::trimEnd "  Jazz  \t").
}
