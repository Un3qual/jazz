{
  "name": "jazz-language-website",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "prestart": "node scripts/sync-factorial.mjs",
    "start": "docusaurus start",
    "build": "node scripts/sync-factorial.mjs && docusaurus build && pagefind --site build --output-subdir pagefind && node scripts/check-built-highlighting.mjs && node scripts/check-built-search.mjs && node scripts/check-built-type-links.mjs",
    "serve": "docusaurus serve",
    "typecheck": "tsc --noEmit",
    "clear": "docusaurus clear",
    "render:brand": "node scripts/render-social-card.mjs",
    "test:brand": "node --test scripts/test-brand-assets.mjs",
    "test:search": "node --test scripts/test-pagefind-search-model.mjs scripts/test-check-built-search.mjs",
    "test:signatures": "node --test scripts/test-jazz-signature-metadata.mjs scripts/test-jazz-type-links.mjs",
    "test:experience": "node --test scripts/test-experience.mjs",
    "check": "pnpm run typecheck && pnpm run build"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/plugin-content-docs": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-common": "3.10.2",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@mdx-js/react": "3.1.1",
    "clsx": "2.1.1",
    "prism-react-renderer": "2.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shiki": "4.4.2"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/react": "19.2.18",
    "fontkit": "2.0.4",
    "pagefind": "1.5.2",
    "remark-parse": "11.0.0",
    "sharp": "0.35.3",
    "typescript": "6.0.2",
    "unified": "11.0.5"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=22 <23"
  }
}
